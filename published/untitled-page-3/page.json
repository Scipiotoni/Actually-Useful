    {
      "name": "index.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Lobby Chat</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#071316;--panel:#0d1f24;--panel2:#12292f;--line:#1c3a41;\n  --ink:#dcefea;--mute:#6f8f8a;--mint:#3dffc4;--mint-d:#0f4d3e;\n  --pink:#ff4fa3;--bubble-me:#0f4d3e;--bubble:#15313a;--danger:#ff5d6c;\n  --glow:0 0 14px rgba(61,255,196,.35);\n}\n@media (prefers-color-scheme: light){\n  :root:not([data-theme=\"dark\"]){\n    --bg:#e9f3f0;--panel:#ffffff;--panel2:#f2f8f6;--line:#cfe2dc;\n    --ink:#0d2a26;--mute:#5b7a75;--mint:#00a877;--mint-d:#c9f4e5;\n    --pink:#d2257a;--bubble-me:#c9f4e5;--bubble:#ffffff;--danger:#d02a3a;--glow:none;\n  }\n}\n:root[data-theme=\"dark\"]{\n  --bg:#071316;--panel:#0d1f24;--panel2:#12292f;--line:#1c3a41;\n  --ink:#dcefea;--mute:#6f8f8a;--mint:#3dffc4;--mint-d:#0f4d3e;\n  --pink:#ff4fa3;--bubble-me:#0f4d3e;--bubble:#15313a;--danger:#ff5d6c;\n  --glow:0 0 14px rgba(61,255,196,.35);\n}\n*{box-sizing:border-box}\nhtml,body{height:100%;margin:0}\nbody{background:var(--bg);color:var(--ink);font:15px/1.45 Sora,system-ui,-apple-system,\"Segoe UI\",sans-serif;overflow:hidden}\nbutton,input{font:inherit;color:inherit}\nbutton{cursor:pointer}\n:focus-visible{outline:2px solid var(--mint);outline-offset:2px}\nimg{max-width:100%}\n.app{display:grid;grid-template-columns:minmax(260px,340px) 1fr;height:100vh;height:100dvh}\naside{background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}\n.me{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}\n.me b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tabs{display:flex;padding:8px;gap:6px;border-bottom:1px solid var(--line)}\n.tab{flex:1;background:none;border:1px solid transparent;border-radius:999px;padding:6px 10px;color:var(--mute)}\n.tab[aria-selected=\"true\"]{color:var(--mint);border-color:var(--mint);box-shadow:var(--glow)}\n.list{flex:1;overflow-y:auto;min-height:0}\n.row{display:flex;align-items:center;gap:12px;width:100%;padding:10px 16px;background:none;border:0;border-bottom:1px solid var(--line);text-align:left}\n.row:hover,.row.on{background:var(--panel2)}\n.row .txt{flex:1;min-width:0}\n.row .t1{display:flex;justify-content:space-between;gap:8px}\n.row .t1 span:first-child,.row .t2{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.row .t2{color:var(--mute);font-size:13px}\n.row time{color:var(--mute);font-size:12px;flex:none}\n.badge{background:var(--mint);color:#032;font-size:11px;font-weight:700;border-radius:999px;padding:1px 7px;margin-left:6px}\n.av{position:relative;flex:none;width:40px;height:40px}\n.av img{width:40px;height:40px;border-radius:50%;display:block;object-fit:cover}\n.av.sm,.av.sm img{width:28px;height:28px}\n.av .dot{position:absolute;right:0;bottom:0;width:11px;height:11px;border-radius:50%;background:var(--mint);border:2px solid var(--panel);box-shadow:var(--glow)}\n.grp{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--mint-d);color:var(--mint);font-weight:700}\n.newbtn{margin:10px 16px;padding:10px;border-radius:12px;border:1px dashed var(--mint);background:none;color:var(--mint)}\n.empty{padding:24px 16px;color:var(--mute)}\nmain{display:flex;flex-direction:column;min-width:0;min-height:0;position:relative}\n.head{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--panel);border-bottom:1px solid var(--line);min-height:61px}\n.head .txt{flex:1;min-width:0}\n.head h1{font-size:16px;margin:0;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.head p{margin:0;color:var(--mute);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.ghost{background:none;border:1px solid var(--line);border-radius:10px;padding:6px 12px}\n.ghost:hover{border-color:var(--mint);color:var(--mint)}\n.back{display:none}\n.msgs{flex:1;overflow-y:auto;padding:18px 6% 10px;display:flex;flex-direction:column;gap:4px;min-height:0;\n  background-image:radial-gradient(circle at 1px 1px,var(--line) 1px,transparent 0);background-size:22px 22px}\n.b{max-width:min(72%,560px);padding:7px 10px 5px;border-radius:12px;background:var(--bubble);align-self:flex-start;word-wrap:break-word;white-space:pre-wrap;border:1px solid var(--line)}\n.b.me{align-self:flex-end;background:var(--bubble-me);border-color:transparent}\n.b .who{font-size:12px;font-weight:600;margin-bottom:2px}\n.b time{display:block;text-align:right;font-size:11px;color:var(--mute);margin-top:2px}\n.b.gap{margin-top:8px}\n.sys{align-self:center;font-size:12px;color:var(--mute);background:var(--panel);border:1px solid var(--line);padding:3px 10px;border-radius:999px;margin:8px 0}\n.composer{display:flex;gap:8px;padding:10px 16px;background:var(--panel);border-top:1px solid var(--line)}\n.composer input{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:999px;padding:10px 16px;min-width:0}\n.composer input:focus{border-color:var(--mint);outline:none;box-shadow:var(--glow)}\n.send{border:0;border-radius:999px;background:var(--mint);color:#032;font-weight:700;padding:0 18px}\n.send:disabled{opacity:.4;cursor:default}\n.welcome{flex:1;display:grid;place-items:center;text-align:center;padding:24px;color:var(--mute)}\n.welcome h2{color:var(--ink);font-size:28px;margin:0 0 8px;letter-spacing:-.02em}\n.welcome kbd,.keys kbd{border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 5px;font:12px/1.6 inherit;color:var(--ink)}\n.keys{margin-top:18px;font-size:13px;line-height:2}\n.drawer{position:absolute;inset:0 0 0 auto;width:min(360px,100%);background:var(--panel);border-left:1px solid var(--line);display:flex;flex-direction:column;z-index:5;transform:translateX(100%);transition:transform .2s}\n.drawer.open{transform:none}\n.drawer .body{flex:1;overflow-y:auto;min-height:0}\n.sec{padding:12px 16px;border-bottom:1px solid var(--line)}\n.sec h3{margin:0 0 8px;font-size:13px;color:var(--mute);font-weight:500}\n.field{display:flex;gap:8px}\n.field input{flex:1;min-width:0;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:8px 10px}\n.tag{font-size:11px;color:var(--pink);border:1px solid var(--pink);border-radius:999px;padding:0 6px;margin-left:6px}\n.kick{background:none;border:1px solid var(--danger);color:var(--danger);border-radius:8px;padding:3px 10px;font-size:13px}\n.act{display:block;width:100%;text-align:left;background:none;border:0;padding:10px 16px;border-bottom:1px solid var(--line)}\n.act.red{color:var(--danger)}\n.act:hover{background:var(--panel2)}\ndialog{background:var(--panel);color:var(--ink);border:1px solid var(--mint);border-radius:16px;padding:0;width:min(440px,94vw);max-height:84vh;box-shadow:var(--glow)}\ndialog::backdrop{background:rgba(0,0,0,.55)}\ndialog form{display:flex;flex-direction:column;max-height:84vh}\ndialog header{padding:14px 16px;border-bottom:1px solid var(--line)}\ndialog header h2{margin:0 0 10px;font-size:17px}\ndialog .pick{flex:1;overflow-y:auto;min-height:120px}\ndialog .row[aria-pressed=\"true\"]{background:var(--mint-d)}\ndialog .row .chk{width:20px;height:20px;border-radius:6px;border:2px solid var(--line);flex:none}\ndialog .row[aria-pressed=\"true\"] .chk{background:var(--mint);border-color:var(--mint)}\ndialog footer{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;border-top:1px solid var(--line)}\n.toasts{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;z-index:20;pointer-events:none}\n.toast{background:var(--panel2);border:1px solid var(--mint);border-radius:10px;padding:8px 14px;box-shadow:var(--glow)}\n.offline{padding:40px;text-align:center;color:var(--mute)}\n@media (max-width:720px){\n  .app{grid-template-columns:1fr}\n  .app.chatting aside{display:none}\n  .app:not(.chatting) main{display:none}\n  .back{display:inline-block}\n}\n@media (prefers-reduced-motion:reduce){.drawer{transition:none}}\n</style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <aside>\n    <div class=\"me\" id=\"meBox\"><div class=\"grp\">…</div><b>Connecting</b></div>\n    <div class=\"tabs\" role=\"tablist\">\n      <button class=\"tab\" role=\"tab\" id=\"tabChats\" aria-selected=\"true\">Chats</button>\n      <button class=\"tab\" role=\"tab\" id=\"tabPeople\" aria-selected=\"false\">People</button>\n    </div>\n    <button class=\"newbtn\" id=\"newBtn\">New chat</button>\n    <div class=\"list\" id=\"list\"></div>\n  </aside>\n  <main id=\"main\">\n    <div class=\"welcome\" id=\"welcome\">\n      <div>\n        <h2>Everyone on this page, one tap away</h2>\n        <p>Pick someone in People, or start a group and invite them.</p>\n        <div class=\"keys\">\n          <kbd>Alt</kbd>+<kbd>N</kbd> new chat &nbsp; <kbd>Alt</kbd>+<kbd>↑</kbd><kbd>↓</kbd> switch chat<br>\n          <kbd>Alt</kbd>+<kbd>P</kbd> people &nbsp; <kbd>Alt</kbd>+<kbd>M</kbd> members &nbsp; <kbd>/</kbd> type &nbsp; <kbd>Esc</kbd> close\n        </div>\n      </div>\n    </div>\n    <div class=\"head\" id=\"head\" hidden>\n      <button class=\"ghost back\" id=\"backBtn\" aria-label=\"Back to chats\">‹</button>\n      <div id=\"headAv\"></div>\n      <div class=\"txt\"><h1 id=\"chatName\"></h1><p id=\"chatSub\"></p></div>\n      <button class=\"ghost\" id=\"membersBtn\">Members</button>\n    </div>\n    <div class=\"msgs\" id=\"msgs\" hidden aria-live=\"polite\"></div>\n    <form class=\"composer\" id=\"composer\" hidden>\n      <input id=\"input\" autocomplete=\"off\" maxlength=\"2000\" placeholder=\"Type a message\">\n      <button class=\"send\" id=\"sendBtn\" disabled>Send</button>\n    </form>\n    <div class=\"drawer\" id=\"drawer\" aria-label=\"Chat members\">\n      <div class=\"head\"><div class=\"txt\"><h1>Chat info</h1></div><button class=\"ghost\" id=\"closeDrawer\">Close</button></div>\n      <div class=\"body\" id=\"drawerBody\"></div>\n    </div>\n  </main>\n</div>\n\n<dialog id=\"dlg\">\n  <form method=\"dialog\" id=\"dlgForm\">\n    <header>\n      <h2 id=\"dlgTitle\">New chat</h2>\n      <div class=\"field\" id=\"nameField\" style=\"margin-bottom:8px\"><input id=\"dlgName\" maxlength=\"60\" placeholder=\"Group name (optional)\"></div>\n      <div class=\"field\"><input id=\"dlgSearch\" placeholder=\"Search people\"></div>\n    </header>\n    <div class=\"pick\" id=\"pick\"></div>\n    <footer>\n      <button type=\"button\" class=\"ghost\" id=\"dlgCancel\">Cancel</button>\n      <button type=\"button\" class=\"send\" id=\"dlgOk\" style=\"padding:8px 18px\">Create chat</button>\n    </footer>\n  </form>\n</dialog>\n<div class=\"toasts\" id=\"toasts\"></div>\n\n<script>\n(() => {\n\"use strict\";\nconst $ = (id) => document.getElementById(id);\nfunction h(tag, attrs, ...kids) {\n  const el = document.createElement(tag);\n  for (const k in attrs || {}) {\n    const v = attrs[k];\n    if (v == null || v === false) continue;\n    if (k === \"class\") el.className = v;\n    else if (k.startsWith(\"on\")) el.addEventListener(k.slice(2), v);\n    else el.setAttribute(k, v === true ? \"\" : v);\n  }\n  for (const kid of kids.flat()) if (kid != null && kid !== false) el.append(kid instanceof Node ? kid : String(kid));\n  return el;\n}\nconst S = {\n  db: null, user: null, room: null, me: null,\n  chats: [], people: [], online: new Set(), prof: {},\n  active: null, msgs: [], read: {}, tab: \"chats\", drawer: false,\n  unsubMsgs: null, knownChats: null,\n};\nconst name = (id) => (S.prof[id] && S.prof[id].name) || (id === S.me ? \"You\" : \"Someone\");\nconst fmt = (ts) => { const d = new Date(ts || 0); return d.toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\" }); };\nconst chatOf = (cid) => S.chats.find((c) => c.id === cid);\nconst isAdmin = (c) => c && c.admin === S.me;\n\nfunction toast(text) {\n  const t = h(\"div\", { class: \"toast\" }, text);\n  $(\"toasts\").append(t);\n  setTimeout(() => t.remove(), 3500);\n}\n\nfunction avatar(id, sm) {\n  const p = S.prof[id];\n  const wrap = h(\"div\", { class: \"av\" + (sm ? \" sm\" : \"\") });\n  if (p && p.avatarUrl) wrap.append(h(\"img\", { src: p.avatarUrl, alt: \"\" }));\n  else wrap.append(h(\"div\", { class: \"grp\" }, \"?\"));\n  if (S.online.has(id) && id !== S.me) wrap.append(h(\"span\", { class: \"dot\", title: \"Online now\" }));\n  return wrap;\n}\nfunction chatTitle(c) {\n  if (c.name) return c.name;\n  const others = c.members.filter((m) => m !== S.me);\n  if (!others.length) return \"Just you\";\n  return others.map(name).join(\", \");\n}\nfunction chatAvatar(c) {\n  const others = c.members.filter((m) => m !== S.me);\n  if (!c.name && others.length === 1) return avatar(others[0]);\n  return h(\"div\", { class: \"grp\" }, (c.name || \"#\").trim().charAt(0).toUpperCase() || \"#\");\n}\n\n/* ---------- render ---------- */\nlet renderTok = 0, renderQueued = false;\nfunction render() {\n  if (renderQueued) return;\n  renderQueued = true;\n  queueMicrotask(async () => {\n    renderQueued = false;\n    const tok = ++renderTok;\n    if (S.user) {\n      const ids = new Set([S.me, ...S.people, ...S.online]);\n      S.chats.forEach((c) => c.members.forEach((m) => ids.add(m)));\n      S.msgs.forEach((m) => { if (m.from) ids.add(m.from); if (m.target) ids.add(m.target); });\n      try { S.prof = await S.user.profiles([...ids].filter(Boolean)); } catch (e) { /* keep last */ }\n      if (tok !== renderTok) return;\n    }\n    paint();\n  });\n}\n\nfunction paint() {\n  // me\n  const mb = $(\"meBox\"); mb.replaceChildren(avatar(S.me), h(\"b\", null, name(S.me)),\n    h(\"span\", { style: \"color:var(--mute);font-size:12px\" }, S.online.size ? S.online.size + \" online\" : \"\"));\n  $(\"tabChats\").setAttribute(\"aria-selected\", S.tab === \"chats\");\n  $(\"tabPeople\").setAttribute(\"aria-selected\", S.tab === \"people\");\n  const list = $(\"list\"); list.replaceChildren();\n  if (S.tab === \"chats\") {\n    if (!S.chats.length) list.append(h(\"div\", { class: \"empty\" }, \"No chats yet. Open People and tap someone to start one.\"));\n    for (const c of S.chats) {\n      const unread = (c.updatedAt || 0) > (S.read[c.id] || 0) && c.last && c.last.from !== S.me && c.id !== S.active;\n      const last = c.last ? (c.last.sys ? c.last.text : (c.last.from === S.me ? \"You: \" : name(c.last.from) + \": \") + c.last.text) : \"No messages yet\";\n      list.append(h(\"button\", { class: \"row\" + (c.id === S.active ? \" on\" : \"\"), onclick: () => openChat(c.id) },\n        chatAvatar(c),\n        h(\"div\", { class: \"txt\" },\n          h(\"div\", { class: \"t1\" }, h(\"span\", null, chatTitle(c), isAdmin(c) ? h(\"span\", { class: \"tag\" }, \"admin\") : null), h(\"time\", null, c.updatedAt ? fmt(c.updatedAt) : \"\")),\n          h(\"div\", { class: \"t2\" }, last, unread ? h(\"span\", { class: \"badge\" }, \"new\") : null))));\n    }\n  } else {\n    const ids = [...new Set([...S.online, ...S.people])].filter((i) => i !== S.me);\n    ids.sort((a, b) => (S.online.has(b) - S.online.has(a)) || name(a).localeCompare(name(b)));\n    if (!ids.length) list.append(h(\"div\", { class: \"empty\" }, \"Nobody else has opened this page yet. Share the link and they'll show up here.\"));\n    for (const id of ids) {\n      list.append(h(\"button\", { class: \"row\", onclick: () => directChat(id) },\n        avatar(id),\n        h(\"div\", { class: \"txt\" }, h(\"div\", { class: \"t1\" }, h(\"span\", null, name(id))),\n          h(\"div\", { class: \"t2\" }, S.online.has(id) ? \"On the page now · tap to chat\" : \"Tap to chat\"))));\n    }\n  }\n  // chat pane\n  const c = chatOf(S.active);\n  $(\"app\").classList.toggle(\"chatting\", !!c);\n  $(\"welcome\").hidden = !!c; $(\"head\").hidden = !c; $(\"msgs\").hidden = !c; $(\"composer\").hidden = !c;\n  if (c) {\n    $(\"headAv\").replaceChildren(chatAvatar(c));\n    $(\"chatName\").textContent = chatTitle(c);\n    const on = c.members.filter((m) => S.online.has(m) && m !== S.me).length;\n    $(\"chatSub\").textContent = c.members.length + \" members\" + (on ? \" · \" + on + \" online\" : \"\") + \" · admin: \" + name(c.admin);\n    paintMsgs();\n  }\n  paintDrawer();\n}\n\nfunction paintMsgs() {\n  const box = $(\"msgs\");\n  const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;\n  box.replaceChildren();\n  const c = chatOf(S.active);\n  const group = c && c.members.length > 2;\n  let prev = null;\n  for (const m of S.msgs) {\n    if (m.sys) {\n      box.append(h(\"div\", { class: \"sys\" }, sysText(m)));\n      prev = null; continue;\n    }\n    const mine = m.from === S.me;\n    const first = !prev || prev.from !== m.from;\n    const p = S.prof[m.from];\n    box.append(h(\"div\", { class: \"b\" + (mine ? \" me\" : \"\") + (first ? \" gap\" : \"\") },\n      group && !mine && first ? h(\"div\", { class: \"who\", style: \"color:\" + ((p && p.color) || \"var(--pink)\") }, name(m.from)) : null,\n      m.text, h(\"time\", null, fmt(m.ts))));\n    prev = m;\n  }\n  if (!S.msgs.length) box.append(h(\"div\", { class: \"sys\" }, \"Say hi 👋\"));\n  if (atBottom || box.dataset.cid !== S.active) box.scrollTop = box.scrollHeight;\n  box.dataset.cid = S.active;\n}\nfunction sysText(m) {\n  const a = name(m.from), t = m.target ? name(m.target) : \"\";\n  switch (m.kind) {\n    case \"create\": return a + \" created the chat\";\n    case \"add\": return a + \" added \" + t;\n    case \"kick\": return a + \" removed \" + t;\n    case \"leave\": return a + \" left\";\n    case \"admin\": return t + \" is now admin\";\n    case \"rename\": return a + \" renamed the chat\";\n    default: return m.text || \"\";\n  }\n}\n\nfunction paintDrawer() {\n  const d = $(\"drawer\"), body = $(\"drawerBody\");\n  const c = chatOf(S.active);\n  d.classList.toggle(\"open\", S.drawer && !!c);\n  d.inert = !(S.drawer && c);\n  body.replaceChildren();\n  if (!c) return;\n  const admin = isAdmin(c);\n  if (admin) {\n    const inp = h(\"input\", { value: c.name || \"\", maxlength: 60, placeholder: \"Chat name\", \"aria-label\": \"Chat name\" });\n    body.append(h(\"div\", { class: \"sec\" }, h(\"h3\", null, \"Name\"),\n      h(\"div\", { class: \"field\" }, inp, h(\"button\", { class: \"ghost\", onclick: () => renameChat(c, inp.value) }, \"Save\"))));\n  }\n  const sec = h(\"div\", { class: \"sec\" }, h(\"h3\", null, c.members.length + \" members\"));\n  const sorted = [...c.members].sort((a, b) => (b === c.admin) - (a === c.admin));\n  for (const m of sorted) {\n    sec.append(h(\"div\", { class: \"row\", style: \"padding:8px 0;border:0\" }, avatar(m, true),\n      h(\"div\", { class: \"txt\" }, h(\"span\", null, name(m) + (m === S.me ? \" (you)\" : \"\")), m === c.admin ? h(\"span\", { class: \"tag\" }, \"admin\") : null),\n      admin && m !== S.me ? h(\"button\", { class: \"ghost\", style: \"padding:3px 8px;font-size:13px\", onclick: () => makeAdmin(c, m) }, \"Make admin\") : null,\n      admin && m !== S.me ? h(\"button\", { class: \"kick\", onclick: () => kick(c, m) }, \"Kick\") : null));\n  }\n  body.append(sec);\n  if (admin) body.append(h(\"button\", { class: \"act\", onclick: () => openPicker(\"add\") }, \"＋ Add people\"));\n  body.append(h(\"button\", { class: \"act red\", onclick: () => leave(c) }, \"Leave chat\"));\n  if (admin) body.append(h(\"button\", { class: \"act red\", onclick: () => deleteChat(c) }, \"Delete chat for everyone\"));\n}\n\n/* ---------- actions ---------- */\nasync function post(cid, msg) {\n  const data = Object.assign({ from: S.me, ts: Date.now() }, msg);\n  await S.db.collection(\"chats/\" + cid + \"/msgs\").add(data);\n  const last = msg.sys ? { sys: true, text: sysText(data), from: S.me } : { from: S.me, text: msg.text.slice(0, 120) };\n  await S.db.doc(\"chats/\" + cid).update({ updatedAt: data.ts, last }).catch(() => {});\n}\nfunction fail(e) {\n  console.error(e);\n  toast(e && e.code === \"quota_exceeded\" ? \"Storage is full. Ask an admin to delete an old chat.\" : \"That didn't go through. Try again.\");\n}\n\nasync function createChat(members, chatName) {\n  const ref = S.db.collection(\"chats\").doc();\n  const now = Date.now();\n  await ref.set({ name: chatName || \"\", admin: S.me, members: [S.me, ...members.filter((m) => m !== S.me)], createdAt: now, updatedAt: now, last: null });\n  S.active = ref.id; S.tab = \"chats\";\n  subscribeMsgs();\n  await post(ref.id, { sys: true, kind: \"create\" });\n  members.forEach(invitePing.bind(null, ref.id));\n  render();\n}\nfunction invitePing(cid, uid) {\n  if (S.room && uid !== S.me) S.room.emit(\"invite\", { to: uid, chat: cid }).catch(() => {});\n}\nasync function directChat(uid) {\n  const ex = S.chats.find((c) => !c.name && c.members.length === 2 && c.members.includes(uid));\n  if (ex) return openChat(ex.id);\n  try { await createChat([uid], \"\"); } catch (e) { fail(e); }\n}\nasync function addMembers(c, ids) {\n  const fresh = ids.filter((i) => !c.members.includes(i));\n  if (!fresh.length) return;\n  try {\n    await S.db.doc(\"chats/\" + c.id).update({ members: [...c.members, ...fresh] });\n    for (const id of fresh) { await post(c.id, { sys: true, kind: \"add\", target: id }); invitePing(c.id, id); }\n  } catch (e) { fail(e); }\n}\nasync function kick(c, uid) {\n  if (!isAdmin(c)) return;\n  if (!confirm(\"Remove \" + name(uid) + \" from this chat?\")) return;\n  try {\n    await S.db.doc(\"chats/\" + c.id).update({ members: c.members.filter((m) => m !== uid) });\n    await post(c.id, { sys: true, kind: \"kick\", target: uid });\n  } catch (e) { fail(e); }\n}\nasync function makeAdmin(c, uid) {\n  if (!isAdmin(c) || !confirm(\"Hand admin to \" + name(uid) + \"? You'll become a regular member.\")) return;\n  try { await S.db.doc(\"chats/\" + c.id).update({ admin: uid }); await post(c.id, { sys: true, kind: \"admin\", target: uid }); }\n  catch (e) { fail(e); }\n}\nasync function renameChat(c, v) {\n  v = v.trim().slice(0, 60);\n  if (!isAdmin(c) || v === (c.name || \"\")) return;\n  try { await S.db.doc(\"chats/\" + c.id).update({ name: v }); await post(c.id, { sys: true, kind: \"rename\" }); toast(\"Chat renamed\"); }\n  catch (e) { fail(e); }\n}\nasync function leave(c) {\n  if (!confirm(\"Leave this chat?\")) return;\n  const rest = c.members.filter((m) => m !== S.me);\n  try {\n    if (!rest.length) return deleteChat(c, true);\n    await post(c.id, { sys: true, kind: \"leave\" });\n    const patch = { members: rest };\n    if (c.admin === S.me) patch.admin = rest[0];\n    await S.db.doc(\"chats/\" + c.id).update(patch);\n    if (patch.admin) await post(c.id, { sys: true, kind: \"admin\", target: rest[0] }).catch(() => {});\n    S.active = null; S.drawer = false; stopMsgs(); render();\n  } catch (e) { fail(e); }\n}\nasync function deleteChat(c, silent) {\n  if (!silent && !confirm(\"Delete this chat and all its messages for everyone?\")) return;\n  try {\n    const snap = await S.db.collection(\"chats/\" + c.id + \"/msgs\").get();\n    for (const d of snap.docs) await S.db.doc(\"chats/\" + c.id + \"/msgs/\" + d.id).delete();\n    await S.db.doc(\"chats/\" + c.id).delete();\n    S.active = null; S.drawer = false; stopMsgs(); render();\n    toast(\"Chat deleted\");\n  } catch (e) { fail(e); }\n}\n\n/* ---------- read state ---------- */\nlet readTimer = null;\nfunction markRead() {\n  const c = chatOf(S.active);\n  if (!c || (S.read[c.id] || 0) >= (c.updatedAt || 0)) return;\n  S.read = Object.assign({}, S.read, { [c.id]: c.updatedAt });\n  clearTimeout(readTimer);\n  readTimer = setTimeout(() => {\n    S.db.doc(\"data/users/\" + S.me + \"/state\").set({ read: S.read }).catch(() => {});\n  }, 800);\n}\n\n/* ---------- subscriptions ---------- */\nfunction stopMsgs() { if (S.unsubMsgs) { S.unsubMsgs(); S.unsubMsgs = null; } S.msgs = []; }\nfunction subscribeMsgs() {\n  stopMsgs();\n  const cid = S.active;\n  if (!cid) return;\n  S.unsubMsgs = S.db.collection(\"chats/\" + cid + \"/msgs\").orderBy(\"ts\", \"desc\").limit(300).onSnapshot((snap) => {\n    if (S.active !== cid) return;\n    S.msgs = snap.docs.map((d) => d.data()).reverse();\n    markRead(); render();\n  }, () => {});\n}\nfunction openChat(cid) {\n  if (S.active === cid) return focusInput();\n  S.active = cid; S.drawer = false;\n  subscribeMsgs(); markRead(); render();\n  focusInput();\n}\nfunction focusInput() { setTimeout(() => $(\"input\").focus(), 0); }\n\n/* ---------- picker dialog ---------- */\nlet pickMode = \"new\", picked = new Set(), searchHits = [], searchTok = 0;\nfunction openPicker(mode) {\n  pickMode = mode; picked = new Set(); searchHits = [];\n  $(\"dlgTitle\").textContent = mode === \"new\" ? \"New chat\" : \"Add people\";\n  $(\"dlgOk\").textContent = mode === \"new\" ? \"Create chat\" : \"Add\";\n  $(\"nameField\").hidden = mode !== \"new\";\n  $(\"dlgName\").value = \"\"; $(\"dlgSearch\").value = \"\";\n  paintPick(); $(\"dlg\").showModal(); runSearch(\"\");\n  $(mode === \"new\" ? \"dlgName\" : \"dlgSearch\").focus();\n}\nasync function runSearch(q) {\n  if (!S.user || !S.user.search) return;\n  const t = ++searchTok;\n  const hits = await S.user.search(q);\n  if (t !== searchTok) return;\n  searchHits = hits || [];\n  hits.forEach((p) => { S.prof[p.id] = p; });\n  paintPick();\n}\nfunction paintPick() {\n  const q = $(\"dlgSearch\").value.trim().toLowerCase();\n  const exclude = pickMode === \"add\" ? new Set((chatOf(S.active) || { members: [] }).members) : new Set([S.me]);\n  const ids = [...new Set([...S.online, ...S.people, ...searchHits.map((p) => p.id), ...picked])]\n    .filter((i) => i && !exclude.has(i) && i !== S.me)\n    .filter((i) => !q || name(i).toLowerCase().includes(q) || searchHits.some((p) => p.id === i));\n  ids.sort((a, b) => (S.online.has(b) - S.online.has(a)) || name(a).localeCompare(name(b)));\n  const box = $(\"pick\"); box.replaceChildren();\n  if (!ids.length) box.append(h(\"div\", { class: \"empty\" }, \"No one to add. People appear here once they open the page.\"));\n  for (const id of ids) {\n    box.append(h(\"button\", { type: \"button\", class: \"row\", \"aria-pressed\": picked.has(id), onclick: () => { picked.has(id) ? picked.delete(id) : picked.add(id); paintPick(); } },\n      avatar(id), h(\"div\", { class: \"txt\" }, h(\"div\", null, name(id)), h(\"div\", { class: \"t2\" }, S.online.has(id) ? \"On the page now\" : \"\")), h(\"span\", { class: \"chk\" })));\n  }\n  $(\"dlgOk\").disabled = !picked.size;\n}\nlet sDeb;\n$(\"dlgSearch\").addEventListener(\"input\", (e) => { paintPick(); clearTimeout(sDeb); sDeb = setTimeout(() => runSearch(e.target.value.trim()), 250); });\n$(\"dlgSearch\").addEventListener(\"keydown\", (e) => { if (e.key === \"ArrowDown\") { e.preventDefault(); const f = $(\"pick\").querySelector(\".row\"); f && f.focus(); } });\n$(\"pick\").addEventListener(\"keydown\", (e) => {\n  const rows = [...$(\"pick\").querySelectorAll(\".row\")], i = rows.indexOf(document.activeElement);\n  if (e.key === \"ArrowDown\" && i >= 0) { e.preventDefault(); (rows[i + 1] || rows[i]).focus(); }\n  if (e.key === \"ArrowUp\" && i >= 0) { e.preventDefault(); (rows[i - 1] || $(\"dlgSearch\")).focus(); }\n});\n$(\"dlgCancel\").onclick = () => $(\"dlg\").close();\n$(\"dlgOk\").onclick = async () => {\n  if (!picked.size) return;\n  const ids = [...picked];\n  $(\"dlg\").close();\n  if (pickMode === \"new\") {\n    try { await createChat(ids, ids.length > 1 ? ($(\"dlgName\").value.trim() || \"New group\") : $(\"dlgName\").value.trim()); }\n    catch (e) { fail(e); }\n  } else { const c = chatOf(S.active); if (c && isAdmin(c)) addMembers(c, ids); }\n};\n$(\"dlg\").addEventListener(\"keydown\", (e) => { if (e.key === \"Enter\" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); $(\"dlgOk\").click(); } });\n\n/* ---------- UI wiring ---------- */\n$(\"tabChats\").onclick = () => { S.tab = \"chats\"; render(); };\n$(\"tabPeople\").onclick = () => { S.tab = \"people\"; render(); };\n$(\"newBtn\").onclick = () => S.db && openPicker(\"new\");\n$(\"membersBtn\").onclick = () => { S.drawer = !S.drawer; render(); };\n$(\"closeDrawer\").onclick = () => { S.drawer = false; render(); };\n$(\"backBtn\").onclick = () => { S.active = null; S.drawer = false; stopMsgs(); render(); };\n$(\"input\").addEventListener(\"input\", (e) => { $(\"sendBtn\").disabled = !e.target.value.trim(); });\n$(\"composer\").addEventListener(\"submit\", async (e) => {\n  e.preventDefault();\n  const inp = $(\"input\"), text = inp.value.trim();\n  const c = chatOf(S.active);\n  if (!text || !c) return;\n  inp.value = \"\"; $(\"sendBtn\").disabled = true;\n  try { await post(c.id, { text: text.slice(0, 2000) }); }\n  catch (err) { inp.value = text; $(\"sendBtn\").disabled = false; fail(err); }\n});\ndocument.addEventListener(\"keydown\", (e) => {\n  if ($(\"dlg\").open) return;\n  const typing = /INPUT|TEXTAREA/.test(document.activeElement && document.activeElement.tagName);\n  if (e.key === \"Escape\") {\n    if (S.drawer) { S.drawer = false; render(); }\n    else if (S.active) { document.activeElement.blur(); }\n    return;\n  }\n  if (e.altKey && !e.ctrlKey) {\n    const k = e.key.toLowerCase();\n    if (k === \"n\" || e.code === \"KeyN\") { e.preventDefault(); if (S.db) openPicker(\"new\"); }\n    else if (k === \"p\" || e.code === \"KeyP\") { e.preventDefault(); S.tab = S.tab === \"people\" ? \"chats\" : \"people\"; render(); }\n    else if ((k === \"m\" || e.code === \"KeyM\") && S.active) { e.preventDefault(); S.drawer = !S.drawer; render(); }\n    else if (e.key === \"ArrowUp\" || e.key === \"ArrowDown\") {\n      e.preventDefault();\n      if (!S.chats.length) return;\n      const i = S.chats.findIndex((c) => c.id === S.active);\n      const n = e.key === \"ArrowDown\" ? (i + 1) % S.chats.length : (i <= 0 ? S.chats.length - 1 : i - 1);\n      S.tab = \"chats\"; openChat(S.chats[n].id);\n    }\n    return;\n  }\n  if (e.key === \"/\" && !typing && S.active) { e.preventDefault(); focusInput(); }\n});\n\n/* ---------- boot ---------- */\nfunction offline(msg) {\n  document.body.replaceChildren(h(\"div\", { class: \"offline\" }, h(\"h2\", { style: \"color:var(--ink)\" }, \"Chat needs the published page\"), h(\"p\", null, msg)));\n}\nasync function boot() {\n  if (!window.claude || typeof window.claude.use !== \"function\") return offline(\"Open this page from its claude.ai link, signed in, to see who's here and chat.\");\n  const [db, user, room] = await Promise.all([\"db\", \"user\", \"room\"].map((n) => window.claude.use(n).catch(() => null)));\n  if (!db || !user) return offline(\"Chat storage isn't available in this view. Open the page from its claude.ai link while signed in.\");\n  const me = await user.id();\n  if (!me) return offline(\"Sign in to claude.ai to join the chat.\");\n  Object.assign(S, { db, user, room, me });\n\n  db.doc(\"people/\" + me).set({ seen: Date.now() }).catch(() => {});\n  db.collection(\"people\").orderBy(\"seen\", \"desc\").limit(300).onSnapshot((s) => { S.people = s.docs.map((d) => d.id); render(); }, () => {});\n  db.doc(\"data/users/\" + me + \"/state\").onSnapshot((s) => {\n    const d = s.exists ? s.data() : null;\n    S.read = Object.assign({}, (d && d.read) || {}, S.read);\n    render();\n  }, () => {});\n  db.collection(\"chats\").where(\"members\", \"array-contains\", me).onSnapshot((s) => {\n    const prev = S.knownChats;\n    S.chats = s.docs.map((d) => Object.assign({ id: d.id }, d.data(), { members: (d.data().members || []).slice() }))\n      .sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));\n    const ids = new Set(S.chats.map((c) => c.id));\n    if (prev && !s.metadata.fromCache) {\n      for (const c of S.chats) if (!prev.has(c.id) && c.admin !== me) toast(\"You were added to \" + (c.name || \"a chat\"));\n      if (S.active && prev.has(S.active) && !ids.has(S.active)) {\n        toast(\"You're no longer in that chat\");\n        S.active = null; S.drawer = false; stopMsgs();\n      }\n    }\n    if (!s.metadata.fromCache || !prev) S.knownChats = ids;\n    if (S.active) markRead();\n    render();\n  }, (e) => { console.error(e); toast(\"Lost connection to chats. Reload the page.\"); });\n\n  if (room) {\n    const sync = () => {\n      S.online = new Set(room.peers().map((p) => p.presence && p.presence.uid).filter((u) => typeof u === \"string\"));\n      render();\n    };\n    room.presence({ uid: me }).catch(() => {});\n    room.onPeers(sync, () => {});\n    sync();\n    room.on(\"invite\", (m) => {\n      const d = m.data || {};\n      if (d.to === me && !m.isMe && typeof d.chat === \"string\") {\n        const c = chatOf(d.chat);\n        if (c && S.active !== c.id) toast(name(c.admin) + \" invited you to \" + chatTitle(c));\n      }\n    });\n  }\n  render();\n}\npaint();\nboot();\n})();\n</script>\n</body>\n</html>"
