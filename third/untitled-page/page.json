    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>STRIKE OPS 4 — Urban Siege</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{overflow:hidden;background:#04070b;color:#e9eff4;font-family:Inter,Arial,sans-serif}\n  canvas{display:block}\n\n  .overlay{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:linear-gradient(155deg,#060b11,#101b25 55%,#04070b)}\n  .lobby{width:min(1160px,96vw);height:min(740px,94vh);display:flex;background:#0a1117;border:1px solid #25303b;border-radius:18px;overflow:hidden;box-shadow:0 40px 120px #000}\n  .side{width:260px;background:#070d12;border-right:1px solid #212c36;padding:22px 16px;display:flex;flex-direction:column;gap:8px}\n  .logo{font-size:27px;font-weight:900;color:#ffcc33;letter-spacing:3px;margin-bottom:16px}\n  .nav{padding:12px 14px;border-radius:10px;background:#101a23;color:#a7b6c2;cursor:pointer;border:1px solid transparent;font-weight:800}\n  .nav.active{background:#182430;color:#fff;border-color:#35485c}\n  .grow{flex:1}\n  .profile{background:#101a23;border:1px solid #26323e;border-radius:12px;padding:12px}\n  .credits{color:#ffcc33;font-weight:900;font-size:21px}\n\n  .main{flex:1;padding:26px;overflow:auto}\n  .tab{display:none}.tab.active{display:block}\n  h1{font-size:30px;letter-spacing:2px}\n  h2{color:#ffcc33;margin:20px 0 10px;font-size:18px}\n  .muted{color:#93a4b1;font-size:13.5px;margin-top:5px}\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(265px,1fr));gap:13px;margin-top:12px}\n  .card{background:#101a23;border:1px solid #26323e;border-radius:13px;padding:15px}\n  .card h3{font-size:16px}\n  .card p{font-size:12.5px;color:#9cadba;margin:6px 0 10px;line-height:1.45}\n  .row{display:flex;gap:8px;justify-content:space-between;align-items:center;flex-wrap:wrap}\n  .tag{font-size:11px;color:#8dffb0;background:#12251a;border:1px solid #234a33;padding:3px 7px;border-radius:6px}\n  .tag.blue{color:#8fc4ff;background:#101f30;border-color:#264563}\n  .tag.red{color:#ff9b9b;background:#2b1517;border-color:#5a2a2e}\n  button{border:none;border-radius:8px;padding:9px 13px;font-weight:800;cursor:pointer;background:#8dffb0;color:#06120b;transition:.15s}\n  button:hover:not(:disabled){transform:translateY(-1px)}\n  button:disabled{opacity:.4;cursor:not-allowed}\n  button.ghost{background:#212e3b;color:#dce6ee}\n  button.gold{background:#ffcc33;color:#231a03}\n  .deploy{width:100%;margin-top:22px;padding:16px;font-size:17px;letter-spacing:1px}\n  .selected{outline:2px solid #ffcc33;outline-offset:-2px}\n\n  #hud{position:fixed;inset:0;z-index:10;pointer-events:none;display:none}\n  #crosshair{position:absolute;left:50%;top:50%;width:30px;height:30px;transform:translate(-50%,-50%)}\n  #crosshair i{position:absolute;background:#8dffb0;box-shadow:0 0 2px #000}\n  #crosshair i:nth-child(1){left:14px;top:0;width:2px;height:9px}\n  #crosshair i:nth-child(2){left:14px;bottom:0;width:2px;height:9px}\n  #crosshair i:nth-child(3){top:14px;left:0;width:9px;height:2px}\n  #crosshair i:nth-child(4){top:14px;right:0;width:9px;height:2px}\n  .box{position:absolute;background:rgba(5,9,13,.72);border:1px solid #2b3743;border-radius:10px;padding:10px 14px}\n  #top{left:50%;top:15px;transform:translateX(-50%);font-size:14px}\n  #cash{right:22px;top:15px;color:#ffcc33;font-weight:900}\n  #stance{left:22px;top:15px;font-size:12px;color:#9cadba}\n  #hp{left:22px;bottom:22px;width:290px}\n  #ar{left:22px;bottom:82px;width:290px}\n  .bar{height:8px;background:#202a34;border-radius:5px;overflow:hidden;margin-top:5px}\n  .fill{height:100%;width:100%;transition:.12s}\n  #hpf{background:linear-gradient(90deg,#37d067,#8dffb0)}\n  #arf{background:linear-gradient(90deg,#3f8cff,#8fc4ff)}\n  #gun{right:22px;bottom:22px;text-align:right}\n  #ammo{font-size:32px;font-weight:900;color:#ffcc33}\n  #gunname{font-size:12px;color:#9cadba}\n  #mods{font-size:11px;color:#8dffb0;margin-top:3px}\n  #minimap{position:absolute;right:22px;top:58px;width:200px;height:200px;background:rgba(4,8,12,.72);border:1px solid #2b3743;border-radius:10px}\n  #feed{position:absolute;right:22px;top:275px;width:320px;font-size:12px;text-align:right}\n  .feed{background:rgba(5,9,13,.72);border-right:3px solid #ff5d5d;padding:6px 9px;margin-bottom:5px;border-radius:5px}\n  #hit{position:absolute;left:50%;top:50%;width:36px;height:36px;transform:translate(-50%,-50%) rotate(45deg);opacity:0}\n  #hit b{position:absolute;width:13px;height:2px;background:#fff}\n  #hit b:nth-child(1){left:0;top:0}\n  #hit b:nth-child(2){right:0;top:0;transform:rotate(90deg)}\n  #hit b:nth-child(3){left:0;bottom:0}\n  #hit b:nth-child(4){right:0;bottom:0;transform:rotate(90deg)}\n  #dmg{position:absolute;inset:0;background:radial-gradient(circle,transparent 38%,rgba(220,25,25,.55));opacity:0;transition:.2s}\n  #objective{position:absolute;left:50%;bottom:125px;transform:translateX(-50%);background:rgba(5,9,13,.75);padding:8px 16px;border-radius:8px;font-size:13px;display:none}\n</style>\n</head>\n<body>\n\n<div id=\"hud\">\n  <div id=\"crosshair\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hit\"><b></b><b></b><b></b><b></b></div>\n  <div id=\"dmg\"></div>\n  <div class=\"box\" id=\"top\">MODE <span id=\"modeName\">SQUAD ASSAULT</span> • ROUND <span id=\"round\">1</span> • ENEMIES <span id=\"enemyLeft\">0</span> • TEAM <span id=\"teamLeft\">0</span> • SCORE <span id=\"score\">0</span></div>\n  <div class=\"box\" id=\"cash\">CR <span id=\"hudCredits\">0</span></div>\n  <div class=\"box\" id=\"stance\">STANDING</div>\n  <div class=\"box\" id=\"hp\"><div style=\"font-size:11px;color:#9cadba\">HEALTH</div><div class=\"bar\"><div class=\"fill\" id=\"hpf\"></div></div></div>\n  <div class=\"box\" id=\"ar\"><div style=\"font-size:11px;color:#9cadba\">ARMOR</div><div class=\"bar\"><div class=\"fill\" id=\"arf\"></div></div></div>\n  <div class=\"box\" id=\"gun\"><div id=\"ammo\">30</div><div id=\"gunname\">PHANTOM-7</div><div id=\"mods\">No attachments</div></div>\n  <canvas id=\"minimap\" width=\"200\" height=\"200\"></canvas>\n  <div id=\"feed\"></div>\n  <div id=\"objective\"></div>\n</div>\n\n<div class=\"overlay\" id=\"lobby\">\n  <div class=\"lobby\">\n    <div class=\"side\">\n      <div class=\"logo\">STRIKE OPS 4</div>\n      <div class=\"nav active\" data-tab=\"play\">PLAY</div>\n      <div class=\"nav\" data-tab=\"loadout\">LOADOUT</div>\n      <div class=\"nav\" data-tab=\"workshop\">WORKSHOP</div>\n      <div class=\"nav\" data-tab=\"operators\">OPERATORS</div>\n      <div class=\"nav\" data-tab=\"store\">STORE</div>\n      <div class=\"grow\"></div>\n      <div class=\"profile\">\n        <div style=\"font-size:11px;color:#93a4b1\">CREDITS</div>\n        <div class=\"credits\">CR <span id=\"lobbyCredits\">0</span></div>\n      </div>\n    </div>\n\n    <div class=\"main\">\n      <div class=\"tab active\" id=\"tab-play\">\n        <h1>Deploy to Urban Siege</h1>\n        <p class=\"muted\">Fight alongside AI teammates against an enemy squad. Difficulty changes bot reaction time, accuracy, health, aggression, and squad size.</p>\n        <div class=\"grid\" id=\"modeList\"></div>\n        <div class=\"grid\" id=\"difficultyList\"></div>\n        <button class=\"deploy gold\" id=\"deployBtn\">START OPERATION</button>\n      </div>\n\n      <div class=\"tab\" id=\"tab-loadout\">\n        <h1>Primary & Secondary</h1>\n        <div class=\"grid\" id=\"weaponList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-workshop\">\n        <h1>Weapon Workshop</h1>\n        <p class=\"muted\">Every attachment has an advantage and a disadvantage. Install attachments separately on each weapon.</p>\n        <div class=\"grid\" id=\"modList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-operators\">\n        <h1>Operators</h1>\n        <div class=\"grid\" id=\"operatorList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-store\">\n        <h1>Store</h1>\n        <h2>Attachments</h2>\n        <div class=\"grid\" id=\"storeMods\"></div>\n        <h2>Operator Skins</h2>\n        <div class=\"grid\" id=\"storeOperators\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay\" id=\"end\" style=\"display:none\">\n  <div class=\"lobby\" style=\"width:min(650px,94vw);height:auto;display:block;padding:34px;text-align:center\">\n    <h1 id=\"endTitle\">OPERATION SUCCESS</h1>\n    <p class=\"muted\" id=\"endText\"></p>\n    <button class=\"deploy gold\" id=\"continueBtn\">RETURN TO LOBBY</button>\n  </div>\n</div>\n\n<script type=\"importmap\">\n{\"imports\":{\n  \"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\n  \"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"\n}}\n</script>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';\n\n/* ================= Save ================= */\nconst defaults={\n  credits:900,ownedOperators:['ranger'],equippedOperator:'ranger',\n  ownedMods:[],installedMods:{},primary:'rifle',secondary:'pistol',\n  difficulty:'regular',mode:'assault'\n};\nconst save=Object.assign({},defaults,JSON.parse(localStorage.getItem('strikeOps4')||'{}'));\nsave.installedMods??={};\nconst persist=()=>localStorage.setItem('strikeOps4',JSON.stringify(save));\n\n/* ================= Engine ================= */\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(76,innerWidth/innerHeight,.08,500);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.08;\ndocument.body.appendChild(renderer.domElement);\n\nconst controls=new PointerLockControls(camera,renderer.domElement);\ncamera.position.set(0,1.72,72);\n\n/* ================= Procedural textures ================= */\nfunction tex(draw,size=256,repeat=[1,1]){\n  const c=document.createElement('canvas');c.width=c.height=size;\n  draw(c.getContext('2d'),size);\n  const t=new THREE.CanvasTexture(c);\n  t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(...repeat);\n  t.anisotropy=renderer.capabilities.getMaxAnisotropy();\n  return t;\n}\nfunction grain(g,s,a,n=7000){\n  for(let i=0;i<n;i++){\n    g.fillStyle=`rgba(${Math.random()<.5?0:255},${Math.random()<.5?0:255},${Math.random()<.5?0:255},${a})`;\n    g.fillRect(Math.random()*s,Math.random()*s,Math.random()*3+1,Math.random()*3+1);\n  }\n}\nconst T={\n  asphalt:tex((g,s)=>{g.fillStyle='#4a4e52';g.fillRect(0,0,s,s);grain(g,s,.08,10000)},256,[22,22]),\n  concrete:tex((g,s)=>{\n    g.fillStyle='#94908a';g.fillRect(0,0,s,s);grain(g,s,.06,8000);\n    g.strokeStyle='rgba(0,0,0,.16)';g.lineWidth=2;\n    for(let i=0;i<8;i++){g.beginPath();g.moveTo(0,Math.random()*s);g.lineTo(s,Math.random()*s);g.stroke();}\n  },256,[6,6]),\n  plaster:tex((g,s)=>{\n    g.fillStyle='#c7b591';g.fillRect(0,0,s,s);grain(g,s,.05,7000);\n    g.fillStyle='rgba(115,92,58,.16)';\n    for(let i=0;i<45;i++)g.fillRect(Math.random()*s,Math.random()*s,Math.random()*30+6,Math.random()*9+2);\n  },256,[5,5]),\n  brick:tex((g,s)=>{\n    g.fillStyle='#796752';g.fillRect(0,0,s,s);g.fillStyle='#8f7458';\n    for(let y=0;y<s;y+=32)for(let x=(y/32%2)*32;x<s;x+=64)g.fillRect(x+2,y+2,60,28);\n    grain(g,s,.07,5000);\n  },256,[5,5]),\n  wood:tex((g,s)=>{\n    g.fillStyle='#7b5a34';g.fillRect(0,0,s,s);\n    for(let i=0;i<80;i++){\n      g.strokeStyle=`rgba(45,28,12,${Math.random()*.25+.08})`;g.lineWidth=Math.random()*3+1;\n      g.beginPath();g.moveTo(0,Math.random()*s);g.bezierCurveTo(s/3,Math.random()*s,s*.66,Math.random()*s,s,Math.random()*s);g.stroke();\n    }\n  },256,[4,4]),\n  metal:tex((g,s)=>{\n    g.fillStyle='#5d6873';g.fillRect(0,0,s,s);\n    for(let i=0;i<220;i++){\n      g.strokeStyle=`rgba(255,255,255,${Math.random()*.08})`;\n      g.beginPath();g.moveTo(Math.random()*s,0);g.lineTo(Math.random()*s,s);g.stroke();\n    }\n    grain(g,s,.05,3500);\n  },256,[3,3]),\n  tile:tex((g,s)=>{\n    g.fillStyle='#565d63';g.fillRect(0,0,s,s);g.strokeStyle='rgba(0,0,0,.35)';g.lineWidth=3;\n    for(let i=0;i<=s;i+=64){g.beginPath();g.moveTo(i,0);g.lineTo(i,s);g.stroke();g.beginPath();g.moveTo(0,i);g.lineTo(s,i);g.stroke();}\n    grain(g,s,.05,4000);\n  },256,[9,9]),\n  glass:tex((g,s)=>{\n    const grad=g.createLinearGradient(0,0,s,s);\n    grad.addColorStop(0,'#9fc4d8');grad.addColorStop(.5,'#6e8fa3');grad.addColorStop(1,'#b8d3e2');\n    g.fillStyle=grad;g.fillRect(0,0,s,s);\n    g.fillStyle='rgba(255,255,255,.18)';\n    for(let i=0;i<12;i++)g.fillRect(Math.random()*s,Math.random()*s,Math.random()*70+15,3);\n  },256,[2,2])\n};\n\nfunction mat(texture,color=0xffffff,rough=.82,metal=.05,tile=[1,1]){\n  const t=texture.clone();t.needsUpdate=true;\n  t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(...tile);\n  return new THREE.MeshStandardMaterial({map:t,color,roughness:rough,metalness:metal});\n}\n\n/* ================= Map ================= */\nlet world=new THREE.Group();scene.add(world);\nlet colliders=[],spawnPoint=new THREE.Vector3(0,1.72,72);\n\nfunction resetWorld(){\n  scene.remove(world);world=new THREE.Group();scene.add(world);colliders=[];\n}\nfunction box(x,y,z,w,h,d,m,collide=true){\n  const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);\n  o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;world.add(o);\n  if(collide)colliders.push(new THREE.Box3().setFromObject(o));\n  return o;\n}\n\n/* Large multi-room building */\nfunction bigBuilding(x,z,w,d,h,wallMat,floorMat){\n  const t=.4,door=3,doorH=2.7;\n\n  box(x,.09,z,w,.18,d,floorMat,false);\n\n  // Front wall: central double doorway\n  box(x-w/2+(w-door)/4,h/2,z-d/2,(w-door)/2,h,t,wallMat);\n  box(x+w/2-(w-door)/4,h/2,z-d/2,(w-door)/2,h,t,wallMat);\n  box(x,h-(h-doorH)/2,z-d/2,door,h-doorH,t,wallMat);\n\n  // Back and sides\n  box(x,h/2,z+d/2,w,h,t,wallMat);\n  box(x-w/2,h/2,z,t,h,d,wallMat);\n  box(x+w/2,h/2,z,t,h,d,wallMat);\n\n  // Interior rooms\n  box(x-w/4,h/2,z,t*.8,h,d*.62,wallMat);\n  box(x+w/4,h/2,z,t*.8,h,d*.62,wallMat);\n  box(x,h/2,z+d/4,w*.48,h*.82,t*.8,wallMat);\n\n  // Interior floor detail\n  box(x,.12,z-d/4,w*.55,.06,d*.35,mat(T.tile,0xb9b2a6,.75,.05,[4,3]),false);\n\n  // Windows\n  for(const sx of [-w/2,w/2]){\n    box(x+sx,h*.68,z,t+.08,h*.24,d*.35,mat(T.glass,0xffffff,.15,.1),false);\n    box(x+sx,h*.68,z+d/4,t+.08,h*.24,d*.25,mat(T.glass,0xffffff,.15,.1),false);\n  }\n\n  // Roof and parapet\n  box(x,h+.18,z,w,.36,d,mat(T.concrete,0x74706a,.9,0,[w/5,d/5]),false);\n  box(x,h+.55,z-d/2,w,.45,t,wallMat);\n  box(x,h+.55,z+d/2,w,.45,t,wallMat);\n}\n\nfunction container(x,z,rot,color){\n  const g=new THREE.Group();\n  const body=new THREE.Mesh(new THREE.BoxGeometry(13,5.2,5.2),mat(T.metal,color,.55,.65,[3,1]));\n  body.castShadow=true;body.receiveShadow=true;g.add(body);\n  for(let i=-5.5;i<=5.5;i+=2.2){\n    const rib=new THREE.Mesh(new THREE.BoxGeometry(.18,5.2,5.24),mat(T.metal,0x000000,.65,.35));\n    rib.position.x=i;g.add(rib);\n  }\n  g.position.set(x,2.6,z);g.rotation.y=rot;world.add(g);\n  colliders.push(new THREE.Box3().setFromObject(g));\n}\n\nfunction buildUrbanSiege(){\n  scene.background=new THREE.Color(0xa8bfce);\n  scene.fog=new THREE.Fog(0xa8bfce,65,230);\n\n  const ground=new THREE.Mesh(new THREE.PlaneGeometry(200,200),mat(T.asphalt,0xffffff,.93,0,[25,25]));\n  ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;world.add(ground);\n\n  const road=new THREE.Mesh(new THREE.PlaneGeometry(18,200),mat(T.asphalt,0x666a6e,.9,0,[4,28]));\n  road.rotation.x=-Math.PI/2;road.position.y=.02;world.add(road);\n\n  const plaster=mat(T.plaster,0xffffff,.88,0,[4,3]);\n  const brick=mat(T.brick,0xffffff,.9,0,[4,3]);\n  const concrete=mat(T.concrete,0xd8d3c8,.86,0,[4,4]);\n  const wood=mat(T.wood,0xffffff,.85,0,[2,2]);\n  const metalWall=mat(T.metal,0x8a97a3,.45,.7,[7,3]);\n\n  // Boundary\n  box(0,6,-95,194,12,3,concrete);\n  box(0,6,95,194,12,3,concrete);\n  box(-95,6,0,3,12,194,concrete);\n  box(95,6,0,3,12,194,concrete);\n\n  // Large central apartment block\n  bigBuilding(0,-25,42,30,10,brick,mat(T.tile,0xb4ac9d,.78,.05,[7,5]));\n\n  // West commercial building\n  bigBuilding(-55,18,32,26,9,plaster,mat(T.tile,0xb8b0a1,.78,.05,[6,4]));\n\n  // East office building\n  bigBuilding(55,18,34,28,11,concrete,mat(T.tile,0xa9b3ba,.7,.1,[7,5]));\n\n  // Small north warehouse\n  bigBuilding(0,52,36,24,8,metalWall,mat(T.concrete,0x9aa1a7,.85,.08,[6,4]));\n\n  // Street cover and alleys\n  box(-22,1.3,10,14,2.6,7,wood);\n  box(22,1.3,10,14,2.6,7,wood);\n  box(-35,1.5,-5,3,3,26,concrete);\n  box(35,1.5,-5,3,3,26,concrete);\n  box(-70,1.2,-50,16,2.4,10,wood);\n  box(70,1.2,-50,16,2.4,10,wood);\n  box(-70,1.2,60,16,2.4,10,wood);\n  box(70,1.2,60,16,2.4,10,wood);\n\n  container(-28,-62,0,0x8a4b3a);\n  container(-14,-62,0,0x2f5d8a);\n  container(28,-62,Math.PI/2,0x3f7a4d);\n  container(45,65,Math.PI/4,0x6b5a8a);\n  container(-45,65,-Math.PI/4,0x8a4b3a);\n\n  // Objective markers\n  const marker=(x,z,label)=>{\n    const c=document.createElement('canvas');c.width=c.height=128;\n    const g=c.getContext('2d');g.fillStyle='rgba(0,0,0,.42)';g.fillRect(0,0,128,128);\n    g.fillStyle='#ffcc33';g.font='bold 82px Arial';g.textAlign='center';g.textBaseline='middle';g.fillText(label,64,68);\n    const p=new THREE.Mesh(new THREE.PlaneGeometry(9,9),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(c),transparent:true}));\n    p.rotation.x=-Math.PI/2;p.position.set(x,.04,z);world.add(p);\n  };\n  marker(-55,18,'A');marker(55,18,'B');marker(0,52,'C');\n  spawnPoint.set(0,1.72,82);\n}\n\n/* ================= Lighting ================= */\nscene.add(new THREE.HemisphereLight(0xbfd8ee,0x4a4238,.85));\nconst sun=new THREE.DirectionalLight(0xfff0c8,2.15);\nsun.position.set(52,75,30);sun.castShadow=true;\nsun.shadow.mapSize.set(4096,4096);\nsun.shadow.camera.left=-110;sun.shadow.camera.right=110;\nsun.shadow.camera.top=110;sun.shadow.camera.bottom=-110;\nsun.shadow.bias=-.0004;\nscene.add(sun);\n\n/* ================= Player movement ================= */\nconst player={\n  hp:100,maxHp:100,armor:75,maxArmor:75,\n  vel:new THREE.Vector3(),grounded:true,\n  standHeight:1.72,crouchHeight:1.12,\n  crouching:false,sliding:false,slideTime:0,slideDir:new THREE.Vector3(),\n  radius:.42\n};\nconst keys={};\n\naddEventListener('keydown',e=>{\n  keys[e.code]=true;\n  if(e.code==='KeyR')reload();\n  if(e.code==='Digit1')equip(0);\n  if(e.code==='Digit2')equip(1);\n  if(e.code==='KeyC')startCrouchOrSlide();\n  if(e.code==='KeyB'&&roundActive){controls.unlock();openLobby('workshop');}\n});\naddEventListener('keyup',e=>{\n  keys[e.code]=false;\n  if(e.code==='KeyC')player.crouching=false;\n});\naddEventListener('mousedown',e=>{if(e.button===0)firing=true});\naddEventListener('mouseup',e=>{if(e.button===0)firing=false});\n\nfunction startCrouchOrSlide(){\n  const moving=keys['KeyW']||keys['KeyA']||keys['KeyS']||keys['KeyD'];\n  const sprinting=keys['ShiftLeft']&&moving;\n\n  if(sprinting&&player.grounded&&!player.sliding){\n    player.sliding=true;player.slideTime=.75;\n    const fwd=new THREE.Vector3();camera.getWorldDirection(fwd);fwd.y=0;fwd.normalize();\n    player.slideDir.copy(fwd);\n    beep(180,.22,'sawtooth',.05);\n  }\n  player.crouching=true;\n}\n\nfunction blocked(pos){\n  const h=player.crouching||player.sliding?player.crouchHeight:player.standHeight;\n  const p=new THREE.Box3(\n    new THREE.Vector3(pos.x-player.radius,pos.y-h,pos.z-player.radius),\n    new THREE.Vector3(pos.x+player.radius,pos.y,pos.z+player.radius)\n  );\n  return colliders.some(c=>p.intersectsBox(c));\n}\n\nfunction move(dt){\n  const w=weapons[current];\n  let speed=5.9*w.moveSpeed;\n  if(keys['ShiftLeft'])speed=9.1*w.moveSpeed;\n  if(player.crouching)speed*=.48;\n  if(player.sliding)speed=13.5;\n\n  const fwd=new THREE.Vector3();camera.getWorldDirection(fwd);fwd.y=0;fwd.normalize();\n  const right=new THREE.Vector3().crossVectors(fwd,new THREE.Vector3(0,1,0)).normalize();\n  const v=new THREE.Vector3();\n\n  if(!player.sliding){\n    if(keys['KeyW'])v.add(fwd);\n    if(keys['KeyS'])v.sub(fwd);\n    if(keys['KeyD'])v.add(right);\n    if(keys['KeyA'])v.sub(right);\n    if(v.lengthSq())v.normalize().multiplyScalar(speed*dt);\n  }else{\n    v.copy(player.slideDir).multiplyScalar(speed*dt);\n    player.slideTime-=dt;\n    if(player.slideTime<=0)player.sliding=false;\n  }\n\n  let n=camera.position.clone();n.x+=v.x;\n  if(!blocked(n))camera.position.x=n.x;\n  n=camera.position.clone();n.z+=v.z;\n  if(!blocked(n))camera.position.z=n.z;\n\n  player.vel.y-=24*dt;\n  camera.position.y+=player.vel.y*dt;\n\n  const targetHeight=player.crouching||player.sliding?player.crouchHeight:player.standHeight;\n  if(player.grounded){\n    camera.position.y+= (targetHeight-camera.position.y)*Math.min(1,dt*12);\n  }\n\n  if(camera.position.y<=targetHeight){\n    camera.position.y=targetHeight;player.vel.y=0;player.grounded=true;\n  }\n  if(keys['Space']&&player.grounded&&!player.crouching&&!player.sliding){\n    player.vel.y=8.3;player.grounded=false;\n  }\n\n  camera.position.x=THREE.MathUtils.clamp(camera.position.x,-91,91);\n  camera.position.z=THREE.MathUtils.clamp(camera.position.z,-91,91);\n\n  document.getElementById('stance').textContent=\n    player.sliding?'SLIDING':player.crouching?'CROUCHED':keys['ShiftLeft']?'SPRINTING':'STANDING';\n}\n\n/* ================= Weapons ================= */\nconst weaponCatalog={\n  rifle:{class:'ASSAULT RIFLE',name:'PHANTOM-7',damage:27,fireRate:.102,mag:30,reserve:120,spread:.011,recoil:.026,auto:true,range:200,pellets:1,moveSpeed:1,sound:520,price:0},\n  smg:{class:'SMG',name:'HORNET-9',damage:19,fireRate:.072,mag:35,reserve:140,spread:.019,recoil:.021,auto:true,range:100,pellets:1,moveSpeed:1.14,sound:680,price:450},\n  shotgun:{class:'SHOTGUN',name:'BREACHER-12',damage:15,fireRate:.82,mag:7,reserve:35,spread:.055,recoil:.075,auto:false,range:38,pellets:8,moveSpeed:.98,sound:190,price:650},\n  sniper:{class:'SNIPER',name:'LONGSHOT .338',damage:115,fireRate:1.45,mag:5,reserve:25,spread:.0012,recoil:.11,auto:false,range:400,pellets:1,moveSpeed:.83,sound:260,price:1100},\n  lmg:{class:'LMG',name:'BASTION-58',damage:25,fireRate:.093,mag:75,reserve:225,spread:.021,recoil:.035,auto:true,range:180,pellets:1,moveSpeed:.82,sound:430,price:950},\n  pistol:{class:'PISTOL',name:'VIPER .45',damage:39,fireRate:.23,mag:12,reserve:60,spread:.006,recoil:.019,auto:false,range:130,pellets:1,moveSpeed:1.1,sound:760,price:0}\n};\n\nconst modCatalog={\n  compensator:{name:'Compensator',price:200,adv:'-32% recoil, +4% damage',dis:'-6% movement speed',apply:w=>{w.recoil*=.68;w.damage*=1.04;w.moveSpeed*=.94}},\n  laser:{name:'Laser Sight',price:160,adv:'-28% hip-fire spread',dis:'-8% range',apply:w=>{w.spread*=.72;w.range*=.92}},\n  extendedMag:{name:'Extended Magazine',price:260,adv:'+55% magazine capacity',dis:'+12% reload time, -4% movement speed',apply:w=>{w.mag=Math.round(w.mag*1.55);w.moveSpeed*=.96;w.reloadPenalty=1.12}},\n  lightweight:{name:'Lightweight Frame',price:180,adv:'+14% movement speed',dis:'+18% recoil, -8% damage',apply:w=>{w.moveSpeed*=1.14;w.recoil*=1.18;w.damage*=.92}},\n  hollowPoint:{name:'Hollow Point',price:300,adv:'+22% damage',dis:'-20% range, -10% penetration',apply:w=>{w.damage*=1.22;w.range*=.8}},\n  suppressor:{name:'Suppressor',price:240,adv:'Quiet fire and reduced muzzle flash',dis:'-8% damage, -10% range',apply:w=>{w.damage*=.92;w.range*=.9;w.sound*=.6}},\n  foregrip:{name:'Vertical Foregrip',price:220,adv:'-22% recoil, -12% spread',dis:'-5% movement speed',apply:w=>{w.recoil*=.78;w.spread*=.88;w.moveSpeed*=.95}},\n  quickdraw:{name:'Quickdraw Grip',price:190,adv:'Faster handling and movement',dis:'+12% recoil',apply:w=>{w.moveSpeed*=1.08;w.recoil*=1.12}},\n  highCaliber:{name:'High-Caliber Rounds',price:380,adv:'+30% damage, better wall impact',dis:'-18% magazine capacity, +20% recoil',apply:w=>{w.damage*=1.3;w.mag=Math.max(3,Math.round(w.mag*.82));w.recoil*=1.2}},\n  bipod:{name:'Bipod',price:260,adv:'-35% recoil while crouched',dis:'-8% movement speed',apply:w=>{w.crouchBonus=.65;w.moveSpeed*=.92}}\n};\n\nfunction buildWeapon(id){\n  const w=structuredClone(weaponCatalog[id]);\n  w.id=id;w.ammo=w.mag;w.reloadPenalty??=1;w.crouchBonus??=1;\n  (save.installedMods[id]||[]).forEach(m=>modCatalog[m]?.apply(w));\n  return w;\n}\nlet weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];\nlet current=0;\n\nfunction equip(i){if(i<weapons.length){current=i;updateHUD();}}\n\nlet firing=false,lastShot=0,reloading=false;\nfunction reload(){\n  const w=weapons[current];\n  if(reloading||w.ammo===w.mag||w.reserve<=0)return;\n  reloading=true;updateHUD();beep(240,.07,'square',.05);\n  setTimeout(()=>{\n    const take=Math.min(w.mag-w.ammo,w.reserve);\n    w.ammo+=take;w.reserve-=take;reloading=false;updateHUD();beep(430,.06,'triangle',.05);\n  },1000*w.reloadPenalty);\n}\n\n/* ================= Audio ================= */\nlet audio;\nfunction beep(f,d=.08,type='square',v=.07){\n  audio??=new AudioContext();\n  const o=audio.createOscillator(),g=audio.createGain();\n  o.type=type;o.frequency.value=f;g.gain.value=v;\n  o.connect(g);g.connect(audio.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+d);\n  o.stop(audio.currentTime+d);\n}\n\n/* ================= Characters ================= */\nconst operatorCatalog={\n  ranger:{name:'Ranger',price:0,uniform:0x43503c,vest:0x2b3238,helmet:0x333b42,accent:0x6d7a55},\n  desert:{name:'Desert Recon',price:350,uniform:0xa98d5d,vest:0x5b4a31,helmet:0x8b7448,accent:0xc9ab72},\n  arctic:{name:'Arctic Trooper',price:500,uniform:0xc7d3dc,vest:0x59636d,helmet:0xdfe8ee,accent:0x8fa4b4},\n  night:{name:'Night Stalker',price:800,uniform:0x1d232a,vest:0x11161b,helmet:0x181e24,accent:0x2f3d4a},\n  forest:{name:'Forest Phantom',price:650,uniform:0x31472c,vest:0x222c21,helmet:0x2a3826,accent:0x4d6a41},\n  urban:{name:'Urban Assault',price:750,uniform:0x565f68,vest:0x2d343b,helmet:0x454e57,accent:0x7b8792},\n  crimson:{name:'Crimson Guard',price:1100,uniform:0x6c2229,vest:0x241417,helmet:0x39191d,accent:0xa8404a}\n};\n\nfunction soldier(op){\n  const o=operatorCatalog[op]||operatorCatalog.ranger;\n  const uniform=new THREE.MeshStandardMaterial({color:o.uniform,roughness:.82});\n  const vest=new THREE.MeshStandardMaterial({color:o.vest,roughness:.55,metalness:.22});\n  const helmet=new THREE.MeshStandardMaterial({color:o.helmet,roughness:.42,metalness:.28});\n  const skin=new THREE.MeshStandardMaterial({color:0xc99870,roughness:.72});\n  const accent=new THREE.MeshStandardMaterial({color:o.accent,roughness:.7});\n  const dark=new THREE.MeshStandardMaterial({color:0x181d21,roughness:.78});\n\n  const g=new THREE.Group();\n\n  const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.31,.58,7,18),uniform);\n  torso.position.y=1.22;g.add(torso);\n\n  const chest=new THREE.Mesh(new THREE.BoxGeometry(.62,.52,.38),vest);\n  chest.position.y=1.27;g.add(chest);\n\n  for(let i=-1;i<=1;i++){\n    const pouch=new THREE.Mesh(new THREE.BoxGeometry(.14,.17,.1),accent);\n    pouch.position.set(i*.17,1.1,.22);g.add(pouch);\n  }\n\n  const backpack=new THREE.Mesh(new THREE.BoxGeometry(.42,.48,.22),accent);\n  backpack.position.set(0,1.28,-.27);g.add(backpack);\n\n  const head=new THREE.Mesh(new THREE.SphereGeometry(.19,22,18),skin);\n  head.position.y=1.76;g.add(head);\n\n  const helm=new THREE.Mesh(new THREE.SphereGeometry(.215,22,16,0,Math.PI*2,0,Math.PI*.62),helmet);\n  helm.position.y=1.79;g.add(helm);\n\n  const goggles=new THREE.Mesh(new THREE.BoxGeometry(.33,.075,.08),accent);\n  goggles.position.set(0,1.78,.17);g.add(goggles);\n\n  const armGeo=new THREE.CapsuleGeometry(.085,.48,5,12);\n  const legGeo=new THREE.CapsuleGeometry(.11,.62,5,12);\n\n  const lArm=new THREE.Mesh(armGeo,uniform);lArm.position.set(-.37,1.25,0);g.add(lArm);\n  const rArm=new THREE.Mesh(armGeo,uniform);rArm.position.set(.37,1.25,0);g.add(rArm);\n  const lLeg=new THREE.Mesh(legGeo,uniform);lLeg.position.set(-.15,.55,0);g.add(lLeg);\n  const rLeg=new THREE.Mesh(legGeo,uniform);rLeg.position.set(.15,.55,0);g.add(rLeg);\n\n  const lKnee=new THREE.Mesh(new THREE.BoxGeometry(.17,.12,.17),dark);lKnee.position.set(-.15,.82,.06);g.add(lKnee);\n  const rKnee=new THREE.Mesh(new THREE.BoxGeometry(.17,.12,.17),dark);rKnee.position.set(.15,.82,.06);g.add(rKnee);\n  const lBoot=new THREE.Mesh(new THREE.BoxGeometry(.17,.14,.31),dark);lBoot.position.set(-.15,.07,.04);g.add(lBoot);\n  const rBoot=new THREE.Mesh(new THREE.BoxGeometry(.17,.14,.31),dark);rBoot.position.set(.15,.07,.04);g.add(rBoot);\n\n  const gun=new THREE.Mesh(new THREE.BoxGeometry(.09,.14,.78),new THREE.MeshStandardMaterial({color:0x23292f,roughness:.35,metalness:.85}));\n  gun.position.set(.29,1.23,.37);g.add(gun);\n\n  [torso,chest,head,helm,lArm,rArm,lLeg,rLeg].forEach(p=>p.castShadow=true);\n  scene.add(g);\n  return {g,lArm,rArm,lLeg,rLeg,head};\n}\n\n/* ================= Bots ================= */\nconst difficultyCatalog={\n  recruit:{name:'Recruit',enemyHp:80,accuracy:.32,reaction:1.5,aggression:.55,squad:3,enemySquad:3,reward:1},\n  regular:{name:'Regular',enemyHp:100,accuracy:.48,reaction:1.05,aggression:.72,squad:4,enemySquad:4,reward:1.25},\n  veteran:{name:'Veteran',enemyHp:125,accuracy:.63,reaction:.75,aggression:.85,squad:5,enemySquad:5,reward:1.6},\n  elite:{name:'Elite',enemyHp:150,accuracy:.78,reaction:.48,aggression:.95,squad:6,enemySquad:6,reward:2.1}\n};\n\nconst bots=[];\nfunction addBot(team,op){\n  const s=soldier(op);\n  let x,z;\n  do{x=(Math.random()*2-1)*82;z=(Math.random()*2-1)*82;}\n  while(Math.hypot(x-camera.position.x,z-camera.position.z)<25);\n  s.g.position.set(x,0,z);\n  const bot={\n    ...s,team,alive:true,\n    hp:team==='enemy'?difficultyCatalog[save.difficulty].enemyHp:110,\n    speed:team==='enemy'?3.1+Math.random()*1.3:3.4+Math.random(),\n    nextShot:0,phase:Math.random()*10,\n    weapon:team==='enemy'?['rifle','smg','shotgun','sniper','lmg'][Math.floor(Math.random()*5)]:'rifle'\n  };\n  bots.push(bot);\n}\nfunction clearBots(){bots.forEach(b=>scene.remove(b.g));bots.length=0;}\n\n/* ================= Combat ================= */\nconst tracers=[],ray=new THREE.Raycaster();\n\nfunction shoot(){\n  const now=performance.now()/1000,w=weapons[current];\n  if(reloading||now-lastShot<w.fireRate)return;\n  if(w.ammo<=0){beep(170,.07,'sawtooth',.04);reload();return;}\n\n  lastShot=now;w.ammo--;updateHUD();beep(w.sound,.055,'square',.065);\n\n  const baseDir=new THREE.Vector3();camera.getWorldDirection(baseDir);\n  let spread=w.spread;\n  if(player.crouching)spread*=.62;\n  if(player.sliding)spread*=2.4;\n  if(!player.grounded)spread*=2.8;\n\n  for(let p=0;p<w.pellets;p++){\n    const dir=baseDir.clone();\n    dir.x+=(Math.random()-.5)*spread;\n    dir.y+=(Math.random()-.5)*spread;\n    dir.z+=(Math.random()-.5)*spread;\n    dir.normalize();\n\n    ray.set(camera.position.clone(),dir);ray.far=w.range;\n    const targets=[];\n    bots.forEach(b=>{if(b.alive&&b.team==='enemy')targets.push(b.g)});\n    const hit=ray.intersectObjects(targets,true)[0];\n\n    const start=camera.position.clone().add(dir.clone().multiplyScalar(.65));\n    let end=start.clone().add(dir.clone().multiplyScalar(w.range));\n\n    if(hit){\n      end=hit.point.clone();\n      const bot=bots.find(b=>b.g===hit.object.parent);\n      if(bot){\n        const hs=hit.object===bot.head;\n        bot.hp-=hs?w.damage*3.2:w.damage;\n        document.getElementById('hit').style.opacity=1;\n        setTimeout(()=>document.getElementById('hit').style.opacity=0,75);\n        beep(hs?1350:920,.045,'sine',.05);\n\n        if(bot.hp<=0){\n          bot.alive=false;scene.remove(bot.g);\n          const reward=Math.round((hs?190:115)*difficultyCatalog[save.difficulty].reward);\n          save.credits+=reward;score+=hs?250:120;kills++;\n          feed(`${hs?'HEADSHOT':'ELIMINATED'} +CR${reward}`);\n          persist();updateHUD();beep(310,.16,'triangle',.08);\n        }\n      }\n    }\n\n    const line=new THREE.Line(\n      new THREE.BufferGeometry().setFromPoints([start,end]),\n      new THREE.LineBasicMaterial({color:0xffe38a,transparent:true,opacity:.72})\n    );\n    scene.add(line);tracers.push({line,life:.055});\n  }\n}\n\nfunction feed(text){\n  const f=document.getElementById('feed'),d=document.createElement('div');\n  d.className='feed';d.textContent=text;f.prepend(d);\n  setTimeout(()=>d.remove(),4200);\n}\n\nfunction damagePlayer(n){\n  if(player.armor>0){\n    const a=Math.min(player.armor,n*.58);\n    player.armor-=a;n-=a;\n  }\n  player.hp=Math.max(0,player.hp-n);updateHUD();\n  const d=document.getElementById('dmg');\n  d.style.opacity=.9;setTimeout(()=>d.style.opacity=0,100);\n  beep(130,.12,'sawtooth',.08);\n  if(player.hp<=0)endMatch(false);\n}\n\n/* ================= Bot AI ================= */\nfunction botCombat(bot,dt){\n  const targets=bot.team==='enemy'\n    ? [camera.position,...bots.filter(b=>b.alive&&b.team==='ally').map(b=>b.g.position)]\n    : bots.filter(b=>b.alive&&b.team==='enemy').map(b=>b.g.position);\n\n  if(!targets.length)return;\n\n  let target=targets[0],best=1e9;\n  targets.forEach(t=>{\n    const d=t.distanceTo? t.distanceTo(bot.g.position):bot.g.position.distanceTo(t);\n    if(d<best){best=d;target=t;}\n  });\n\n  const targetPos=target.isVector3?target:target;\n  const dir=new THREE.Vector3(targetPos.x-bot.g.position.x,0,targetPos.z-bot.g.position.z);\n  const dist=dir.length();dir.normalize();\n\n  const D=difficultyCatalog[save.difficulty];\n  const engageRange=bot.team==='enemy'?34:30;\n  const moveRange=bot.weapon==='shotgun'?9:bot.weapon==='sniper'?42:16;\n\n  if(dist>moveRange){\n    const next=bot.g.position.clone().add(dir.multiplyScalar(bot.speed*dt));next.y=0;\n    if(!blocked(next))bot.g.position.copy(next);\n  }else if(dist<moveRange*.55&&bot.team==='enemy'){\n    const next=bot.g.position.clone().sub(dir.multiplyScalar(bot.speed*.65*dt));next.y=0;\n    if(!blocked(next))bot.g.position.copy(next);\n  }\n\n  bot.g.lookAt(targetPos.x,0,targetPos.z);\n  bot.phase+=dt*9;\n  const swing=Math.sin(bot.phase)*.42;\n  bot.lLeg.rotation.x=swing;bot.rLeg.rotation.x=-swing;\n  bot.lArm.rotation.x=-swing*.55;bot.rArm.rotation.x=swing*.55;\n\n  const canSee=dist<engageRange;\n  if(canSee&&performance.now()/1000-bot.nextShot>(bot.team==='enemy'?D.reaction:1.05)){\n    bot.nextShot=performance.now()/1000;\n    const accuracy=bot.team==='enemy'?D.accuracy:.45;\n    if(Math.random()<accuracy*(bot.team==='ally'?.85:1)){\n      if(bot.team==='enemy')damagePlayer(7+Math.random()*9);\n      else{\n        const enemy=bots.find(b=>b.alive&&b.team==='enemy'&&b.g.position.distanceTo(bot.g.position)<engageRange);\n        if(enemy){\n          enemy.hp-=22+Math.random()*14;\n          if(enemy.hp<=0){\n            enemy.alive=false;scene.remove(enemy.g);\n            feed('ALLY ELIMINATION +CR45');\n            save.credits+=45;persist();updateHUD();\n          }\n        }\n      }\n    }\n    beep(bot.team==='enemy'?250:320,.05,'square',.04);\n  }\n}\n\n/* ================= Lobby ================= */\nlet score=0,kills=0,round=1,enemiesToSpawn=0,alliesToSpawn=0,roundActive=false;\n\nconst modeCatalog={\n  assault:{name:'Squad Assault',desc:'Your AI squad pushes the district while enemy bots defend. Eliminate the enemy force to win.'},\n  domination:{name:'Team Domination',desc:'Hold A, B, and C against the enemy squad. Enemy bots become more aggressive each round.'},\n  deathmatch:{name:'Bot Deathmatch',desc:'Continuous bot combat. First side to win the round elimination race takes the objective.'}\n};\n\nfunction openLobby(tab='play'){\n  document.getElementById('lobby').style.display='flex';\n  document.getElementById('hud').style.display='none';\n  document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.tab===tab));\n  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.id==='tab-'+tab));\n  renderLobby();\n}\ndocument.querySelectorAll('.nav').forEach(n=>n.onclick=()=>openLobby(n.dataset.tab));\n\nfunction card(title,desc,tags=[],actions=[]){\n  const c=document.createElement('div');c.className='card';\n  c.innerHTML=`<div class=\"row\"><h3>${title}</h3>${tags.map(t=>`<span class=\"tag ${t.type||''}\">${t.text}</span>`).join('')}</div><p>${desc}</p>`;\n  const r=document.createElement('div');r.className='row';\n  actions.forEach(a=>r.append(a));c.append(r);return c;\n}\nfunction btn(text,disabled,fn,ghost=false){\n  const b=document.createElement('button');b.textContent=text;b.disabled=disabled;\n  if(ghost)b.className='ghost';b.onclick=fn;return b;\n}\n\nfunction renderLobby(){\n  document.getElementById('lobbyCredits').textContent=save.credits;\n\n  const ml=document.getElementById('modeList');ml.innerHTML='';\n  Object.entries(modeCatalog).forEach(([id,m])=>{\n    const selected=save.mode===id;\n    const c=card(m.name,m.desc,[{text:selected?'SELECTED':'AVAILABLE',type:selected?'blue':''}],[\n      btn(selected?'SELECTED':'SELECT',selected,()=>{save.mode=id;persist();renderLobby();})\n    ]);\n    if(selected)c.classList.add('selected');\n    ml.append(c);\n  });\n\n  const dl=document.getElementById('difficultyList');dl.innerHTML='';\n  Object.entries(difficultyCatalog).forEach(([id,d])=>{\n    const selected=save.difficulty===id;\n    const c=card(d.name,`Enemy HP ${d.enemyHp} • Accuracy ${Math.round(d.accuracy*100)}% • Reaction ${d.reaction}s • Squads ${d.squad}v${d.enemySquad}`,[{text:selected?'SELECTED':'AVAILABLE',type:selected?'blue':''}],[\n      btn(selected?'SELECTED':'SELECT',selected,()=>{save.difficulty=id;persist();renderLobby();})\n    ]);\n    if(selected)c.classList.add('selected');\n    dl.append(c);\n  });\n\n  const wl=document.getElementById('weaponList');wl.innerHTML='';\n  Object.entries(weaponCatalog).forEach(([id,w])=>{\n    const isPrimary=save.primary===id,isSecondary=save.secondary===id;\n    wl.append(card(`${w.name} — ${w.class}`,`Damage ${w.damage}${w.pellets>1?` × ${w.pellets} pellets`:''} • Mag ${w.mag} • Range ${w.range}m • Speed ${Math.round(w.moveSpeed*100)}%`,[\n      {text:isPrimary?'PRIMARY':isSecondary?'SECONDARY':'AVAILABLE',type:isPrimary||isSecondary?'blue':''}\n    ],[\n      btn('PRIMARY',isPrimary,()=>{save.primary=id;weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];persist();renderLobby();},true),\n      btn('SECONDARY',isSecondary,()=>{save.secondary=id;weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];persist();renderLobby();},true)\n    ]));\n  });\n\n  const modList=document.getElementById('modList');modList.innerHTML='';\n  Object.entries(modCatalog).forEach(([id,m])=>{\n    const owned=save.ownedMods.includes(id);\n    const rifleOn=save.installedMods.rifle?.includes(id);\n    const pistolOn=save.installedMods.pistol?.includes(id);\n    modList.append(card(m.name,`<b style=\"color:#8dffb0\">+</b> ${m.adv}<br><b style=\"color:#ff9b9b\">−</b> ${m.dis}`,[{text:owned?'OWNED':`CR${m.price}`}],[\n      btn(owned?'OWNED':'BUY',owned||save.credits<m.price,()=>{save.credits-=m.price;save.ownedMods.push(id);persist();renderLobby();}),\n      btn('RIFLE',!owned||rifleOn,()=>{save.installedMods.rifle.push(id);weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];persist();renderLobby();},true),\n      btn('PISTOL',!owned||pistolOn,()=>{save.installedMods.pistol.push(id);weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];persist();renderLobby();},true)\n    ]));\n  });\n\n  const ol=document.getElementById('operatorList');ol.innerHTML='';\n  Object.entries(operatorCatalog).forEach(([id,o])=>{\n    const owned=save.ownedOperators.includes(id),equipped=save.equippedOperator===id;\n    const c=card(o.name,'Full soldier skin: uniform, plate carrier, pouches, backpack, helmet, goggles, knee pads, and boots.',[\n      {text:equipped?'EQUIPPED':owned?'OWNED':`CR${o.price}`}\n    ],[\n      btn(equipped?'EQUIPPED':owned?'EQUIP':(save.credits>=o.price?'BUY':'LOCKED'),equipped||(!owned&&save.credits<o.price),()=>{\n        if(!owned){save.credits-=o.price;save.ownedOperators.push(id);}\n        save.equippedOperator=id;persist();renderLobby();\n      })\n    ]);\n    if(equipped)c.classList.add('selected');\n    ol.append(c);\n  });\n\n  const sm=document.getElementById('storeMods');sm.innerHTML='';\n  Object.entries(modCatalog).forEach(([id,m])=>{\n    const owned=save.ownedMods.includes(id);\n    sm.append(card(m.name,`<b style=\"color:#8dffb0\">+</b> ${m.adv}<br><b style=\"color:#ff9b9b\">−</b> ${m.dis}`,[{text:owned?'OWNED':`CR${m.price}`}],[\n      btn(owned?'OWNED':'BUY',owned||save.credits<m.price,()=>{save.credits-=m.price;save.ownedMods.push(id);persist();renderLobby();})\n    ]));\n  });\n\n  const so=document.getElementById('storeOperators');so.innerHTML='';\n  Object.entries(operatorCatalog).forEach(([id,o])=>{\n    const owned=save.ownedOperators.includes(id);\n    so.append(card(o.name,'Detailed operator camouflage and gear color set.',[{text:owned?'OWNED':`CR${o.price}`}],[\n      btn(owned?'OWNED':'BUY',owned||save.credits<o.price,()=>{save.credits-=o.price;save.ownedOperators.push(id);persist();renderLobby();})\n    ]));\n  });\n}\n\n/* ================= Match ================= */\nfunction deploy(){\n  clearBots();resetWorld();buildUrbanSiege();\n  camera.position.copy(spawnPoint);\n  player.hp=player.maxHp;player.armor=player.maxArmor;\n  player.crouching=false;player.sliding=false;\n  weapons=[buildWeapon(save.primary),buildWeapon(save.secondary)];\n  current=0;score=0;kills=0;round=1;\n\n  const D=difficultyCatalog[save.difficulty];\n  enemiesToSpawn=D.enemySquad;\n  alliesToSpawn=D.squad-1;\n\n  document.getElementById('lobby').style.display='none';\n  document.getElementById('end').style.display='none';\n  document.getElementById('hud').style.display='block';\n  document.getElementById('modeName').textContent=modeCatalog[save.mode].name.toUpperCase();\n  updateHUD();\n  roundActive=true;controls.lock();\n}\n\nfunction endMatch(win){\n  roundActive=false;controls.unlock();\n  const D=difficultyCatalog[save.difficulty];\n  const reward=Math.round((300+round*110)*D.reward);\n  save.credits+=reward;persist();\n  document.getElementById('end').style.display='flex';\n  document.getElementById('endTitle').textContent=win?'OPERATION SUCCESS':'SQUAD WIPED';\n  document.getElementById('endTitle').style.color=win?'#8dffb0':'#ff5d5d';\n  document.getElementById('endText').textContent=`${modeCatalog[save.mode].name} • ${D.name} • Round ${round} • Score ${score} • Kills ${kills} • Bonus CR${reward}`;\n}\n\ndocument.getElementById('deployBtn').onclick=deploy;\ndocument.getElementById('continueBtn').onclick=()=>openLobby('play');\ncontrols.addEventListener('unlock',()=>{if(roundActive&&player.hp>0)openLobby('play');});\ncontrols.addEventListener('lock',()=>document.getElementById('lobby').style.display='none');\n\n/* ================= HUD ================= */\nfunction updateHUD(){\n  const w=weapons[current];\n  document.getElementById('ammo').textContent=reloading?'--':w.ammo;\n  document.getElementById('gunname').textContent=`${w.name} • ${w.class}`;\n  document.getElementById('mods').textContent=(save.installedMods[w.id]?.length?save.installedMods[w.id].map(i=>modCatalog[i].name).join(' • '):'No attachments');\n  document.getElementById('hpf').style.width=(player.hp/player.maxHp*100)+'%';\n  document.getElementById('arf').style.width=(player.armor/player.maxArmor*100)+'%';\n  document.getElementById('round').textContent=round;\n  document.getElementById('enemyLeft').textContent=bots.filter(b=>b.alive&&b.team==='enemy').length+enemiesToSpawn;\n  document.getElementById('teamLeft').textContent=bots.filter(b=>b.alive&&b.team==='ally').length+alliesToSpawn;\n  document.getElementById('score').textContent=score;\n  document.getElementById('hudCredits').textContent=save.credits;\n}\n\nconst mm=document.getElementById('minimap'),mc=mm.getContext('2d');\nfunction drawMinimap(){\n  mc.clearRect(0,0,200,200);\n  mc.fillStyle='rgba(5,9,13,.86)';mc.fillRect(0,0,200,200);\n  const s=200/192,c=100;\n  mc.fillStyle='#3b4753';\n  world.children.forEach(o=>{\n    if(o.geometry?.type!=='BoxGeometry')return;\n    mc.fillRect(c+o.position.x*s-2,c+o.position.z*s-2,4,4);\n  });\n  bots.forEach(b=>{\n    if(!b.alive)return;\n    mc.fillStyle=b.team==='enemy'?'#ff5d5d':'#5fa8ff';\n    mc.beginPath();mc.arc(c+b.g.position.x*s,c+b.g.position.z*s,3.4,0,7);mc.fill();\n  });\n  mc.fillStyle='#8dffb0';mc.beginPath();\n  mc.arc(c+camera.position.x*s,c+camera.position.z*s,4.5,0,7);mc.fill();\n}\n\n/* ================= Loop ================= */\nconst clock=new THREE.Clock();\nfunction animate(){\n  requestAnimationFrame(animate);\n  const dt=Math.min(clock.getDelta(),.05);\n\n  if(controls.isLocked&&roundActive){\n    move(dt);\n    const w=weapons[current];\n    let rate=w.fireRate;\n    if(player.crouching&&w.crouchBonus<1)rate*=w.crouchBonus;\n    if(firing&&(w.auto||performance.now()/1000-lastShot>rate))shoot();\n\n    bots.forEach(b=>{\n      if(!b.alive)return;\n      botCombat(b,dt);\n    });\n\n    const enemyAlive=bots.filter(b=>b.alive&&b.team==='enemy').length;\n    const allyAlive=bots.filter(b=>b.alive&&b.team==='ally').length;\n\n    if(enemyAlive<3&&enemiesToSpawn>0){addBot('enemy',Object.keys(operatorCatalog)[Math.floor(Math.random()*7)]);enemiesToSpawn--;updateHUD();}\n    if(allyAlive<2&&alliesToSpawn>0){addBot('ally',save.equippedOperator);alliesToSpawn--;updateHUD();}\n\n    if(enemyAlive===0&&enemiesToSpawn===0){\n      round++;roundActive=false;endMatch(true);\n    }\n    if(allyAlive===0&&alliesToSpawn===0&&player.hp<=0){\n      roundActive=false;endMatch(false);\n    }\n  }\n\n  for(let i=tracers.length-1;i>=0;i--){\n    tracers[i].life-=dt;\n    tracers[i].line.material.opacity=Math.max(0,tracers[i].life/.055);\n    if(tracers[i].life<=0){scene.remove(tracers[i].line);tracers.splice(i,1);}\n  }\n\n  drawMinimap();\n  renderer.render(scene,camera);\n}\n\naddEventListener('resize',()=>{\n  camera.aspect=innerWidth/innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth,innerHeight);\n});\n\nopenLobby('play');\nanimate();\n</script>\n</body>\n</html>"
    }
  ]
}