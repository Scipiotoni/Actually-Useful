    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>STRIKE OPS 2 — Dust District</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{overflow:hidden;background:#05070a;color:#e8eef2;font-family:Inter,Arial,sans-serif}\n  canvas{display:block}\n\n  .overlay{position:fixed;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;background:rgba(3,6,9,.88);backdrop-filter:blur(8px)}\n  .panel{width:min(960px,95vw);max-height:92vh;overflow:auto;background:#0d141b;border:1px solid #26313c;border-radius:16px;padding:28px;box-shadow:0 30px 100px #000}\n  h1{font-size:38px;letter-spacing:4px;color:#ffcc33;text-align:center}\n  h2{margin:20px 0 10px;color:#ffcc33;font-size:20px}\n  .muted{color:#94a5b3;font-size:14px;text-align:center;margin-top:6px}\n  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:14px}\n  .card{background:#121b24;border:1px solid #2a3743;border-radius:12px;padding:14px}\n  .card h3{font-size:16px;color:#fff}\n  .card p{font-size:12.5px;color:#9fb0bd;margin:6px 0 10px}\n  .row{display:flex;justify-content:space-between;align-items:center;gap:10px}\n  .tag{font-size:11px;color:#7dff9b;background:#12251a;border:1px solid #234a33;padding:3px 7px;border-radius:6px}\n  button{cursor:pointer;border:none;border-radius:8px;padding:9px 14px;font-weight:700;color:#08110a;background:#7dff9b;transition:.15s}\n  button:hover{transform:translateY(-1px)}\n  button.secondary{background:#233040;color:#dce6ee}\n  button.gold{background:#ffcc33;color:#201803}\n  button:disabled{opacity:.45;cursor:not-allowed;transform:none}\n  .big{width:100%;padding:14px;font-size:16px;margin-top:18px}\n  .credits{color:#ffcc33;font-weight:800}\n\n  #hud{position:fixed;inset:0;z-index:10;pointer-events:none;display:none}\n  #crosshair{position:absolute;left:50%;top:50%;width:30px;height:30px;transform:translate(-50%,-50%)}\n  #crosshair i{position:absolute;background:#8dffb0;box-shadow:0 0 2px #000}\n  #crosshair i:nth-child(1){left:14px;top:0;width:2px;height:9px}\n  #crosshair i:nth-child(2){left:14px;bottom:0;width:2px;height:9px}\n  #crosshair i:nth-child(3){top:14px;left:0;height:2px;width:9px}\n  #crosshair i:nth-child(4){top:14px;right:0;height:2px;width:9px}\n\n  .hudBox{position:absolute;background:rgba(6,10,14,.68);border:1px solid #2b3743;border-radius:10px;padding:10px 14px}\n  #health{left:22px;bottom:22px;width:280px}\n  #armor{left:22px;bottom:82px;width:280px}\n  .bar{height:8px;background:#202a34;border-radius:5px;overflow:hidden;margin-top:5px}\n  .fill{height:100%;width:100%;transition:width .12s}\n  #healthFill{background:linear-gradient(90deg,#37d067,#8dffb0)}\n  #armorFill{background:linear-gradient(90deg,#3f8cff,#8fc4ff)}\n  #ammo{right:22px;bottom:22px;text-align:right}\n  #ammoNum{font-size:32px;font-weight:900;color:#ffcc33}\n  #weaponName{font-size:12px;color:#9fb0bd;letter-spacing:1px}\n  #mods{font-size:11px;color:#7dff9b;margin-top:3px}\n  #topbar{left:50%;top:16px;transform:translateX(-50%);font-size:14px;letter-spacing:1px}\n  #creditsHud{right:22px;top:16px;color:#ffcc33;font-weight:800}\n  #minimap{position:absolute;right:22px;top:58px;width:190px;height:190px;background:rgba(4,8,12,.7);border:1px solid #2b3743;border-radius:10px}\n  #hitmarker{position:absolute;left:50%;top:50%;width:36px;height:36px;transform:translate(-50%,-50%) rotate(45deg);opacity:0}\n  #hitmarker b{position:absolute;width:13px;height:2px;background:#fff}\n  #hitmarker b:nth-child(1){left:0;top:0}\n  #hitmarker b:nth-child(2){right:0;top:0;transform:rotate(90deg)}\n  #hitmarker b:nth-child(3){left:0;bottom:0}\n  #hitmarker b:nth-child(4){right:0;bottom:0;transform:rotate(90deg)}\n  #damage{position:absolute;inset:0;background:radial-gradient(circle,transparent 35%,rgba(220,30,30,.55));opacity:0;transition:.2s}\n  #killfeed{position:absolute;right:22px;top:270px;width:280px;font-size:12px;text-align:right}\n  .feed{background:rgba(6,10,14,.7);border-right:3px solid #ff5d5d;padding:6px 9px;margin-bottom:5px;border-radius:5px}\n</style>\n</head>\n<body>\n\n<div id=\"hud\">\n  <div id=\"crosshair\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hitmarker\"><b></b><b></b><b></b><b></b></div>\n  <div id=\"damage\"></div>\n  <div class=\"hudBox\" id=\"topbar\">ROUND <span id=\"round\">1</span> • HOSTILES <span id=\"enemyCount\">0</span> • SCORE <span id=\"score\">0</span></div>\n  <div class=\"hudBox\" id=\"creditsHud\">CR <span id=\"credits\">500</span></div>\n  <div class=\"hudBox\" id=\"health\"><div style=\"font-size:11px;color:#9fb0bd\">HEALTH</div><div class=\"bar\"><div class=\"fill\" id=\"healthFill\"></div></div></div>\n  <div class=\"hudBox\" id=\"armor\"><div style=\"font-size:11px;color:#9fb0bd\">ARMOR</div><div class=\"bar\"><div class=\"fill\" id=\"armorFill\"></div></div></div>\n  <div class=\"hudBox\" id=\"ammo\">\n    <div id=\"ammoNum\">30</div>\n    <div id=\"weaponName\">PHANTOM-7</div>\n    <div id=\"mods\">No attachments</div>\n  </div>\n  <canvas id=\"minimap\" width=\"190\" height=\"190\"></canvas>\n  <div id=\"killfeed\"></div>\n</div>\n\n<div class=\"overlay\" id=\"menu\">\n  <div class=\"panel\">\n    <h1>STRIKE OPS 2</h1>\n    <div class=\"muted\">Dust District • Tactical browser FPS • Moddable weapons • Skin store</div>\n\n    <h2>Loadout</h2>\n    <div class=\"grid\" id=\"weaponShop\"></div>\n\n    <h2>Weapon Workshop</h2>\n    <div class=\"grid\" id=\"modShop\"></div>\n\n    <h2>Skin Store</h2>\n    <div class=\"grid\" id=\"skinShop\"></div>\n\n    <button class=\"big gold\" id=\"deployBtn\">DEPLOY TO DUST DISTRICT</button>\n    <div class=\"muted\">WASD move • Shift sprint • Space jump • Mouse fire • R reload • 1/2 weapons • B shop • Esc pause</div>\n  </div>\n</div>\n\n<div class=\"overlay\" id=\"endScreen\" style=\"display:none\">\n  <div class=\"panel\" style=\"text-align:center\">\n    <h1 id=\"endTitle\">ROUND COMPLETE</h1>\n    <div class=\"muted\" id=\"endText\"></div>\n    <button class=\"big gold\" id=\"againBtn\">CONTINUE</button>\n  </div>\n</div>\n\n<script type=\"importmap\">\n{\"imports\":{\n  \"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\n  \"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"\n}}\n</script>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';\n\n/* ---------------- Core ---------------- */\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x9fb7c9);\nscene.fog=new THREE.Fog(0xa8bfce,55,190);\n\nconst camera=new THREE.PerspectiveCamera(76,innerWidth/innerHeight,.08,400);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.05;\ndocument.body.appendChild(renderer.domElement);\n\nconst controls=new PointerLockControls(camera,renderer.domElement);\ncamera.position.set(0,1.72,46);\n\nscene.add(new THREE.HemisphereLight(0xbfd8ee,0x4b4238,.85));\nconst sun=new THREE.DirectionalLight(0xfff2d0,2.1);\nsun.position.set(45,65,25);\nsun.castShadow=true;\nsun.shadow.mapSize.set(4096,4096);\nsun.shadow.camera.left=-85; sun.shadow.camera.right=85;\nsun.shadow.camera.top=85; sun.shadow.camera.bottom=-85;\nsun.shadow.bias=-.0004;\nscene.add(sun);\n\n/* ---------------- Save system ---------------- */\nconst save=JSON.parse(localStorage.getItem('strikeOps2')||'{}');\nlet credits=save.credits??500;\nlet ownedSkins=save.skins??['default'];\nlet equippedSkins=save.equipped??{rifle:'default',pistol:'default'};\nlet ownedMods=save.mods??[];\nlet weaponMods=save.weaponMods??{rifle:[],pistol:[]};\nlet selectedWeapons=save.selected??['rifle','pistol'];\n\nfunction persist(){\n  localStorage.setItem('strikeOps2',JSON.stringify({credits,skins:ownedSkins,equipped:equippedSkins,mods:ownedMods,weaponMods,selected:selectedWeapons}));\n}\n\n/* ---------------- Map: Dust-inspired ---------------- */\nconst map=new THREE.Group(); scene.add(map);\nconst colliders=[];\n\nfunction mat(color,rough=.82,metal=.04){\n  return new THREE.MeshStandardMaterial({color,roughness:rough,metalness:metal});\n}\nfunction addBox(x,y,z,w,h,d,material,collide=true){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);\n  m.position.set(x,y,z); m.castShadow=true; m.receiveShadow=true; map.add(m);\n  if(collide) colliders.push(new THREE.Box3().setFromObject(m));\n  return m;\n}\n\n// Ground and roads\nconst sand=mat(0xc8b083,.96,0);\nconst road=mat(0x8d8578,.9,0);\nconst ground=new THREE.Mesh(new THREE.PlaneGeometry(170,170),sand);\nground.rotation.x=-Math.PI/2; ground.receiveShadow=true; map.add(ground);\n\nconst roadA=new THREE.Mesh(new THREE.PlaneGeometry(16,170),road);\nroadA.rotation.x=-Math.PI/2; roadA.position.set(0,.01,0); roadA.receiveShadow=true; map.add(roadA);\nconst roadB=new THREE.Mesh(new THREE.PlaneGeometry(170,14),road);\nroadB.rotation.x=-Math.PI/2; roadB.position.set(0,.01,10); roadB.receiveShadow=true; map.add(roadB);\n\n// Perimeter\nconst wall=mat(0xb59e78,.9,0);\naddBox(0,5,-80,164,10,3,wall); addBox(0,5,80,164,10,3,wall);\naddBox(-80,5,0,3,10,164,wall); addBox(80,5,0,3,10,164,wall);\n\n// A Site\nconst siteA=new THREE.Group(); map.add(siteA);\nconst plaster=mat(0xd6c5a3,.88,0);\nconst stone=mat(0x9d9484,.86,0);\nconst wood=mat(0x7c5b34,.85,0);\nconst metal=mat(0x6b7683,.35,.85);\nconst rust=mat(0x8a5a3a,.7,.35);\n\naddBox(-48,4,-42,28,8,3,plaster);       // A long wall\naddBox(-34,2,-30,3,4,22,plaster);       // A ramp structure\naddBox(-56,1,-24,12,2,12,wood);         // crates\naddBox(-56,3,-24,9,2,9,wood);\naddBox(-38,1.2,-52,8,2.4,8,stone);\naddBox(-64,2.5,-40,4,5,4,stone);\naddBox(-48,1,8,20,2,8,stone);           // A site platform\naddBox(-48,3,8,16,2,4,wood);\n\n// Mid / doors\naddBox(0,3,-18,18,6,3,plaster);\naddBox(-11,2,-10,4,4,4,stone);\naddBox(11,2,-10,4,4,4,stone);\naddBox(-4,1.4,2,8,2.8,3,metal);\naddBox(4,1.4,2,8,2.8,3,metal);\n\n// B Site\naddBox(42,3,-35,26,6,3,plaster);\naddBox(52,1.2,-22,10,2.4,10,wood);\naddBox(52,3.2,-22,7,2,7,wood);\naddBox(34,2,-18,3,4,18,plaster);\naddBox(62,1.5,2,8,3,14,stone);\naddBox(42,1,20,18,2,7,stone);\naddBox(42,3,20,14,2,3,wood);\naddBox(30,2.5,34,5,5,5,rust);\n\n// Connector corridors and cover\naddBox(-20,1.5,30,3,3,24,plaster);\naddBox(20,1.5,30,3,3,24,plaster);\naddBox(-30,1,-5,10,2,10,wood);\naddBox(30,1,-5,10,2,10,wood);\naddBox(-65,2,45,8,4,8,stone);\naddBox(65,2,45,8,4,8,stone);\naddBox(-15,1.2,55,12,2.4,6,wood);\naddBox(15,1.2,55,12,2.4,6,wood);\n\n// Site markers\nfunction siteMarker(x,z,label){\n  const c=document.createElement('canvas'); c.width=c.height=128;\n  const g=c.getContext('2d');\n  g.fillStyle='rgba(0,0,0,.45)'; g.fillRect(0,0,128,128);\n  g.fillStyle='#ffcc33'; g.font='bold 84px Arial'; g.textAlign='center'; g.textBaseline='middle';\n  g.fillText(label,64,68);\n  const tex=new THREE.CanvasTexture(c);\n  const plane=new THREE.Mesh(new THREE.PlaneGeometry(8,8),new THREE.MeshBasicMaterial({map:tex,transparent:true}));\n  plane.rotation.x=-Math.PI/2; plane.position.set(x,.03,z); map.add(plane);\n}\nsiteMarker(-48,8,'A'); siteMarker(42,20,'B');\n\n/* ---------------- Player ---------------- */\nconst player={\n  hp:100,maxHp:100,armor:50,maxArmor:50,\n  vel:new THREE.Vector3(),grounded:true,radius:.42,height:1.72\n};\n\nconst keys={};\naddEventListener('keydown',e=>{\n  keys[e.code]=true;\n  if(e.code==='KeyR') reload();\n  if(e.code==='Digit1') equip(0);\n  if(e.code==='Digit2') equip(1);\n  if(e.code==='KeyB'){controls.unlock();showMenu();}\n});\naddEventListener('keyup',e=>keys[e.code]=false);\n\n/* ---------------- Weapons, mods, skins ---------------- */\nconst baseWeapons={\n  rifle:{\n    name:'PHANTOM-7',price:0,damage:27,fireRate:.102,mag:30,reserve:90,\n    spread:.011,recoil:.026,auto:true,range:180,moveSpeed:1,sound:520,\n    skin:'default'\n  },\n  pistol:{\n    name:'VIPER .45',price:0,damage:39,fireRate:.23,mag:12,reserve:48,\n    spread:.006,recoil:.019,auto:false,range:120,moveSpeed:1.08,sound:760,\n    skin:'default'\n  }\n};\n\nconst modCatalog={\n  compensator:{name:'Compensator',price:180,desc:'-30% recoil, +4% damage',apply:w=>{w.recoil*=.7;w.damage*=1.04}},\n  laser:{name:'Laser Sight',price:140,desc:'-25% hip-fire spread',apply:w=>{w.spread*=.75}},\n  extendedMag:{name:'Extended Mag',price:220,desc:'+50% magazine size',apply:w=>{w.mag=Math.round(w.mag*1.5)}},\n  lightweight:{name:'Lightweight Frame',price:160,desc:'+12% movement speed',apply:w=>{w.moveSpeed*=1.12}},\n  hollowPoint:{name:'Hollow Point',price:260,desc:'+18% damage, -12% range',apply:w=>{w.damage*=1.18;w.range*=.88}},\n  suppressor:{name:'Suppressor',price:200,desc:'Quieter shots, slightly less damage',apply:w=>{w.damage*=.94;w.sound*=.7}}\n};\n\nconst skinCatalog={\n  default:{name:'Factory Standard',price:0,color:0x2f363d,metal:.75,rough:.35},\n  desert:{name:'Desert Viper',price:250,color:0xb08b4e,metal:.25,rough:.6},\n  arctic:{name:'Arctic Wolf',price:350,color:0xdfe8ee,metal:.15,rough:.45},\n  crimson:{name:'Crimson Circuit',price:600,color:0xb32434,metal:.55,rough:.28},\n  neon:{name:'Neon Vector',price:900,color:0x18e0b0,metal:.7,rough:.18},\n  gold:{name:'Royal Gold',price:1500,color:0xffc72e,metal:1,rough:.12}\n};\n\nfunction buildWeapon(id){\n  const w=structuredClone(baseWeapons[id]);\n  w.id=id;\n  (weaponMods[id]||[]).forEach(modId=>modCatalog[modId]?.apply(w));\n  w.ammo=w.mag;\n  w.skin=equippedSkins[id]||'default';\n  return w;\n}\nlet weapons=selectedWeapons.map(buildWeapon);\nlet current=0;\n\nfunction equip(i){\n  if(i>=weapons.length)return;\n  current=i; updateHUD();\n}\n\nlet firing=false,lastShot=0,reloading=false;\naddEventListener('mousedown',e=>{if(e.button===0)firing=true});\naddEventListener('mouseup',e=>{if(e.button===0)firing=false});\n\nfunction reload(){\n  const w=weapons[current];\n  if(reloading||w.ammo===w.mag||w.reserve<=0)return;\n  reloading=true; updateHUD();\n  beep(240,.07,'square',.05);\n  setTimeout(()=>{\n    const need=w.mag-w.ammo,take=Math.min(need,w.reserve);\n    w.ammo+=take; w.reserve-=take; reloading=false; updateHUD();\n    beep(420,.06,'triangle',.05);\n  },1150);\n}\n\n/* ---------------- Audio ---------------- */\nlet audio;\nfunction beep(f,d=.08,type='square',v=.07){\n  audio??=new AudioContext();\n  const o=audio.createOscillator(),g=audio.createGain();\n  o.type=type;o.frequency.value=f;g.gain.value=v;\n  o.connect(g);g.connect(audio.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+d);\n  o.stop(audio.currentTime+d);\n}\n\n/* ---------------- Humanoid enemies ---------------- */\nconst enemies=[];\nconst skinTone=mat(0xc99870,.72,0);\nconst uniform=mat(0x3b4650,.78,0);\nconst vest=mat(0x232a31,.55,.25);\nconst boot=mat(0x1d2328,.75,0);\n\nfunction makeHumanoid(){\n  const g=new THREE.Group();\n\n  const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.31,.58,6,16),uniform);\n  torso.position.y=1.22; torso.castShadow=true; g.add(torso);\n\n  const chest=new THREE.Mesh(new THREE.BoxGeometry(.58,.48,.34),vest);\n  chest.position.y=1.27; chest.castShadow=true; g.add(chest);\n\n  const head=new THREE.Mesh(new THREE.SphereGeometry(.19,20,16),skinTone);\n  head.position.y=1.76; head.castShadow=true; g.add(head);\n\n  const helmet=new THREE.Mesh(new THREE.SphereGeometry(.21,20,14,0,Math.PI*2,0,Math.PI*.62),mat(0x2a3138,.45,.3));\n  helmet.position.y=1.79; helmet.castShadow=true; g.add(helmet);\n\n  const armGeo=new THREE.CapsuleGeometry(.085,.48,4,10);\n  const legGeo=new THREE.CapsuleGeometry(.11,.62,4,10);\n\n  const lArm=new THREE.Mesh(armGeo,uniform); lArm.position.set(-.36,1.25,0); g.add(lArm);\n  const rArm=new THREE.Mesh(armGeo,uniform); rArm.position.set(.36,1.25,0); g.add(rArm);\n  const lLeg=new THREE.Mesh(legGeo,uniform); lLeg.position.set(-.15,.55,0); g.add(lLeg);\n  const rLeg=new THREE.Mesh(legGeo,uniform); rLeg.position.set(.15,.55,0); g.add(rLeg);\n\n  [lArm,rArm,lLeg,rLeg].forEach(p=>p.castShadow=true);\n\n  const gun=new THREE.Mesh(new THREE.BoxGeometry(.09,.13,.72),mat(0x22282e,.35,.85));\n  gun.position.set(.28,1.22,.34); g.add(gun);\n\n  scene.add(g);\n  return {g,lArm,rArm,lLeg,rLeg,head};\n}\n\nfunction spawnEnemy(){\n  const model=makeHumanoid();\n  const edge=70;\n  let x,z;\n  do{\n    x=(Math.random()*2-1)*edge;\n    z=(Math.random()*2-1)*edge;\n  }while(Math.hypot(x-camera.position.x,z-camera.position.z)<28);\n\n  model.g.position.set(x,0,z);\n  enemies.push({\n    ...model,hp:100,alive:true,\n    speed:2.35+Math.random()*1.5,\n    nextAttack:0,phase:Math.random()*10\n  });\n}\n\nfunction clearEnemies(){\n  enemies.forEach(e=>scene.remove(e.g));\n  enemies.length=0;\n}\n\n/* ---------------- Shooting ---------------- */\nconst tracers=[];\nconst ray=new THREE.Raycaster();\n\nfunction shoot(){\n  const now=performance.now()/1000,w=weapons[current];\n  if(reloading||now-lastShot<w.fireRate)return;\n  if(w.ammo<=0){beep(170,.07,'sawtooth',.04);reload();return;}\n\n  lastShot=now; w.ammo--; updateHUD();\n  beep(w.sound,.055,'square',.065);\n\n  const dir=new THREE.Vector3();\n  camera.getWorldDirection(dir);\n  const spread=w.spread*(player.grounded?1:2.1)*(keys['ShiftLeft']?1.35:1);\n  dir.x+=(Math.random()-.5)*spread;\n  dir.y+=(Math.random()-.5)*spread;\n  dir.z+=(Math.random()-.5)*spread;\n  dir.normalize();\n\n  ray.set(camera.position.clone(),dir);\n  ray.far=w.range;\n\n  const targets=[];\n  enemies.forEach(e=>{if(e.alive)targets.push(e.g)});\n  const hit=ray.intersectObjects(targets,true)[0];\n\n  const start=camera.position.clone().add(dir.clone().multiplyScalar(.65));\n  let end=start.clone().add(dir.clone().multiplyScalar(w.range));\n\n  if(hit){\n    end=hit.point.clone();\n    const enemy=enemies.find(e=>e.g===hit.object.parent);\n    if(enemy){\n      const headshot=hit.object===enemy.head;\n      const dmg=headshot?w.damage*3.4:w.damage;\n      enemy.hp-=dmg;\n      hitmarker();\n      beep(headshot?1350:920,.045,'sine',.05);\n\n      if(enemy.hp<=0){\n        enemy.alive=false; scene.remove(enemy.g);\n        const reward=headshot?180:110;\n        credits+=reward; score+=headshot?250:100; kills++;\n        addFeed(`${headshot?'HEADSHOT':'ELIMINATED'} +CR${reward}`);\n        updateHUD(); persist();\n        beep(310,.16,'triangle',.08);\n      }\n    }\n  }\n\n  const geo=new THREE.BufferGeometry().setFromPoints([start,end]);\n  const line=new THREE.Line(geo,new THREE.LineBasicMaterial({color:0xffe38a,transparent:true,opacity:.75}));\n  scene.add(line);\n  tracers.push({line,life:.055});\n}\n\nfunction hitmarker(){\n  const h=document.getElementById('hitmarker');\n  h.style.opacity=1; setTimeout(()=>h.style.opacity=0,85);\n}\nfunction addFeed(text){\n  const feed=document.getElementById('killfeed');\n  const d=document.createElement('div'); d.className='feed'; d.textContent=text;\n  feed.prepend(d);\n  setTimeout(()=>d.remove(),3600);\n}\nfunction damagePlayer(n){\n  if(player.armor>0){\n    const absorbed=Math.min(player.armor,n*.55);\n    player.armor-=absorbed; n-=absorbed;\n  }\n  player.hp=Math.max(0,player.hp-n);\n  updateHUD();\n  const f=document.getElementById('damage');\n  f.style.opacity=.9; setTimeout(()=>f.style.opacity=0,100);\n  beep(130,.12,'sawtooth',.08);\n  if(player.hp<=0)endGame(false);\n}\n\n/* ---------------- Movement ---------------- */\nfunction blocked(pos){\n  const p=new THREE.Box3(\n    new THREE.Vector3(pos.x-player.radius,pos.y-player.height,pos.z-player.radius),\n    new THREE.Vector3(pos.x+player.radius,pos.y,pos.z+player.radius)\n  );\n  return colliders.some(c=>p.intersectsBox(c));\n}\n\nfunction move(delta){\n  const w=weapons[current];\n  const sprint=keys['ShiftLeft'];\n  const speed=(sprint?9.2:5.9)*w.moveSpeed;\n\n  const fwd=new THREE.Vector3(); camera.getWorldDirection(fwd); fwd.y=0; fwd.normalize();\n  const right=new THREE.Vector3().crossVectors(fwd,new THREE.Vector3(0,1,0)).normalize();\n  const moveVec=new THREE.Vector3();\n\n  if(keys['KeyW'])moveVec.add(fwd);\n  if(keys['KeyS'])moveVec.sub(fwd);\n  if(keys['KeyD'])moveVec.add(right);\n  if(keys['KeyA'])moveVec.sub(right);\n  if(moveVec.lengthSq())moveVec.normalize().multiplyScalar(speed*delta);\n\n  let next=camera.position.clone(); next.x+=moveVec.x;\n  if(!blocked(next))camera.position.x=next.x;\n\n  next=camera.position.clone(); next.z+=moveVec.z;\n  if(!blocked(next))camera.position.z=next.z;\n\n  player.vel.y-=24*delta;\n  camera.position.y+=player.vel.y*delta;\n\n  if(camera.position.y<=player.height){\n    camera.position.y=player.height;\n    player.vel.y=0; player.grounded=true;\n  }\n  if(keys['Space']&&player.grounded){\n    player.vel.y=8.4; player.grounded=false;\n  }\n\n  camera.position.x=THREE.MathUtils.clamp(camera.position.x,-77,77);\n  camera.position.z=THREE.MathUtils.clamp(camera.position.z,-77,77);\n}\n\n/* ---------------- Shop UI ---------------- */\nfunction showMenu(){\n  document.getElementById('menu').style.display='flex';\n  renderShop();\n}\nfunction hideMenu(){\n  document.getElementById('menu').style.display='none';\n  controls.lock();\n}\n\nfunction renderShop(){\n  document.getElementById('credits').textContent=credits;\n\n  // Weapons\n  const ws=document.getElementById('weaponShop'); ws.innerHTML='';\n  Object.entries(baseWeapons).forEach(([id,w])=>{\n    const owned=selectedWeapons.includes(id);\n    const card=document.createElement('div'); card.className='card';\n    card.innerHTML=`<h3>${w.name}</h3><p>Damage ${w.damage} • Mag ${w.mag} • ${w.auto?'Automatic':'Semi-auto'}</p>`;\n    const row=document.createElement('div'); row.className='row';\n    const b=document.createElement('button');\n    b.textContent=owned?'EQUIPPED':'EQUIP';\n    b.disabled=owned;\n    b.onclick=()=>{if(!selectedWeapons.includes(id))selectedWeapons.push(id);weapons=selectedWeapons.map(buildWeapon);persist();renderShop();};\n    row.append(b); card.append(row); ws.append(card);\n  });\n\n  // Mods\n  const ms=document.getElementById('modShop'); ms.innerHTML='';\n  Object.entries(modCatalog).forEach(([id,m])=>{\n    const owned=ownedMods.includes(id);\n    const card=document.createElement('div'); card.className='card';\n    card.innerHTML=`<div class=\"row\"><h3>${m.name}</h3><span class=\"tag\">CR${m.price}</span></div><p>${m.desc}</p>`;\n    const row=document.createElement('div'); row.className='row';\n\n    const buy=document.createElement('button');\n    buy.textContent=owned?'OWNED':'BUY';\n    buy.disabled=owned||credits<m.price;\n    buy.onclick=()=>{credits-=m.price;ownedMods.push(id);persist();renderShop();};\n\n    const rifleB=document.createElement('button'); rifleB.className='secondary'; rifleB.textContent='Rifle';\n    rifleB.disabled=!owned||weaponMods.rifle.includes(id);\n    rifleB.onclick=()=>{weaponMods.rifle.push(id);weapons=selectedWeapons.map(buildWeapon);persist();renderShop();};\n\n    const pistolB=document.createElement('button'); pistolB.className='secondary'; pistolB.textContent='Pistol';\n    pistolB.disabled=!owned||weaponMods.pistol.includes(id);\n    pistolB.onclick=()=>{weaponMods.pistol.push(id);weapons=selectedWeapons.map(buildWeapon);persist();renderShop();};\n\n    row.append(buy,rifleB,pistolB); card.append(row); ms.append(card);\n  });\n\n  // Skins\n  const ss=document.getElementById('skinShop'); ss.innerHTML='';\n  Object.entries(skinCatalog).forEach(([id,s])=>{\n    const owned=ownedSkins.includes(id);\n    const card=document.createElement('div'); card.className='card';\n    card.innerHTML=`<div class=\"row\"><h3>${s.name}</h3><span class=\"tag\">CR${s.price}</span></div>\n      <p>Painted metal finish with custom PBR material values.</p>`;\n    const row=document.createElement('div'); row.className='row';\n\n    const buy=document.createElement('button');\n    buy.textContent=owned?'OWNED':'BUY';\n    buy.disabled=owned||credits<s.price;\n    buy.onclick=()=>{credits-=s.price;ownedSkins.push(id);persist();renderShop();};\n\n    const rifleB=document.createElement('button'); rifleB.className='secondary'; rifleB.textContent='Rifle';\n    rifleB.disabled=!owned||equippedSkins.rifle===id;\n    rifleB.onclick=()=>{equippedSkins.rifle=id;weapons=selectedWeapons.map(buildWeapon);persist();renderShop();};\n\n    const pistolB=document.createElement('button'); pistolB.className='secondary'; pistolB.textContent='Pistol';\n    pistolB.disabled=!owned||equippedSkins.pistol===id;\n    pistolB.onclick=()=>{equippedSkins.pistol=id;weapons=selectedWeapons.map(buildWeapon);persist();renderShop();};\n\n    row.append(buy,rifleB,pistolB); card.append(row); ss.append(card);\n  });\n}\n\n/* ---------------- HUD ---------------- */\nlet score=0,kills=0,round=1,enemiesToSpawn=4,roundActive=false;\n\nfunction updateHUD(){\n  const w=weapons[current];\n  document.getElementById('ammoNum').textContent=reloading?'--':w.ammo;\n  document.getElementById('weaponName').textContent=w.name;\n  document.getElementById('mods').textContent=(weaponMods[w.id]?.length?weaponMods[w.id].map(i=>modCatalog[i].name).join(' • '):'No attachments');\n  document.getElementById('healthFill').style.width=(player.hp/player.maxHp*100)+'%';\n  document.getElementById('armorFill').style.width=(player.armor/player.maxArmor*100)+'%';\n  document.getElementById('round').textContent=round;\n  document.getElementById('enemyCount').textContent=enemies.filter(e=>e.alive).length+Math.max(0,enemiesToSpawn);\n  document.getElementById('score').textContent=score;\n  document.getElementById('credits').textContent=credits;\n}\n\n/* ---------------- Minimap ---------------- */\nconst mm=document.getElementById('minimap'),mc=mm.getContext('2d');\nfunction drawMap(){\n  mc.clearRect(0,0,190,190);\n  mc.fillStyle='rgba(6,10,14,.88)';mc.fillRect(0,0,190,190);\n  const s=190/164,c=95;\n\n  mc.fillStyle='#39444f';\n  map.children.forEach(o=>{\n    if(o.geometry?.type!=='BoxGeometry')return;\n    mc.fillRect(c+o.position.x*s-2,c+o.position.z*s-2,4,4);\n  });\n\n  mc.fillStyle='#ffcc33';mc.font='bold 13px Arial';\n  mc.fillText('A',c-48*s,c+8*s);mc.fillText('B',c+42*s,c+20*s);\n\n  enemies.forEach(e=>{\n    if(!e.alive)return;\n    mc.fillStyle='#ff5d5d';\n    mc.beginPath();mc.arc(c+e.g.position.x*s,c+e.g.position.z*s,3.4,0,7);mc.fill();\n  });\n\n  mc.fillStyle='#8dffb0';\n  mc.beginPath();mc.arc(c+camera.position.x*s,c+camera.position.z*s,4.4,0,7);mc.fill();\n}\n\n/* ---------------- Rounds ---------------- */\nfunction startRound(){\n  roundActive=true;\n  enemiesToSpawn=3+round*2;\n  updateHUD();\n}\n\nfunction endGame(win){\n  roundActive=false; controls.unlock();\n  document.getElementById('endScreen').style.display='flex';\n  document.getElementById('endTitle').textContent=win?'ROUND SECURED':'YOU WERE ELIMINATED';\n  document.getElementById('endTitle').style.color=win?'#8dffb0':'#ff5d5d';\n  document.getElementById('endText').textContent=`Round ${round} • Score ${score} • Kills ${kills} • Credits earned this session: ${credits}`;\n}\n\ndocument.getElementById('deployBtn').onclick=()=>{\n  audio??=new AudioContext();\n  hideMenu();\n  document.getElementById('hud').style.display='block';\n  updateHUD(); startRound();\n};\ndocument.getElementById('againBtn').onclick=()=>{\n  if(player.hp<=0){\n    player.hp=player.maxHp;player.armor=player.maxArmor;\n    round=1;score=0;kills=0;enemiesToSpawn=4;\n    clearEnemies();\n    camera.position.set(0,player.height,46);\n  }else{\n    round++;player.hp=Math.min(player.maxHp,player.hp+35);\n    player.armor=Math.min(player.maxArmor,player.armor+25);\n    weapons.forEach(w=>w.reserve+=30);\n    clearEnemies();\n  }\n  document.getElementById('endScreen').style.display='none';\n  updateHUD();startRound();controls.lock();\n};\n\ncontrols.addEventListener('unlock',()=>{\n  if(roundActive&&player.hp>0)showMenu();\n});\ncontrols.addEventListener('lock',()=>document.getElementById('menu').style.display='none');\n\n/* ---------------- Loop ---------------- */\nconst clock=new THREE.Clock();\nfunction animate(){\n  requestAnimationFrame(animate);\n  const dt=Math.min(clock.getDelta(),.05);\n\n  if(controls.isLocked&&roundActive){\n    move(dt);\n    const w=weapons[current];\n    if(firing&&(w.auto||performance.now()/1000-lastShot>w.fireRate))shoot();\n\n    enemies.forEach(e=>{\n      if(!e.alive)return;\n      const target=new THREE.Vector3(camera.position.x,0,camera.position.z);\n      const pos=e.g.position;\n      const dir=target.clone().sub(pos).setY(0);\n      const dist=dir.length(); dir.normalize();\n\n      if(dist>8){\n        const next=pos.clone().add(dir.multiplyScalar(e.speed*dt)); next.y=0;\n        if(!blocked(next))e.g.position.copy(next);\n      }\n\n      e.g.lookAt(camera.position.x,0,camera.position.z);\n      e.phase+=dt*9;\n      const swing=Math.sin(e.phase)*.42;\n      e.lLeg.rotation.x=swing; e.rLeg.rotation.x=-swing;\n      e.lArm.rotation.x=-swing*.55; e.rArm.rotation.x=swing*.55;\n\n      if(dist<26&&performance.now()/1000-e.nextAttack>1.05){\n        e.nextAttack=performance.now()/1000;\n        if(Math.random()<.6)damagePlayer(6+Math.random()*7);\n        beep(230,.05,'square',.05);\n      }\n    });\n\n    const alive=enemies.filter(e=>e.alive).length;\n    if(alive<4&&enemiesToSpawn>0){spawnEnemy();enemiesToSpawn--;updateHUD();}\n    if(alive===0&&enemiesToSpawn===0){\n      const reward=220+round*90;\n      credits+=reward;persist();\n      addFeed(`ROUND BONUS +CR${reward}`);\n      endGame(true);\n    }\n  }\n\n  for(let i=tracers.length-1;i>=0;i--){\n    tracers[i].life-=dt;\n    tracers[i].line.material.opacity=Math.max(0,tracers[i].life/.055);\n    if(tracers[i].life<=0){scene.remove(tracers[i].line);tracers.splice(i,1);}\n  }\n\n  drawMap();\n  renderer.render(scene,camera);\n}\n\naddEventListener('resize',()=>{\n  camera.aspect=innerWidth/innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth,innerHeight);\n});\n\nrenderShop();\nupdateHUD();\nanimate();\n</script>\n</body>\n</html>"
    }
