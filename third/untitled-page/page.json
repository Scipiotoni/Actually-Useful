    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>OPERATION BLACKOUT — Enhanced</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{overflow:hidden;background:#04060a;font-family:'Segoe UI',Arial,sans-serif;color:#e8eef4}\ncanvas{display:block}\n#hud{position:fixed;inset:0;pointer-events:none;display:none}\n.cross{position:absolute;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%)}\n.cross i{position:absolute;background:#9dff7a;box-shadow:0 0 8px #9dff7a}\n.cross i:nth-child(1){left:50%;top:0;width:2px;height:10px;transform:translateX(-50%)}\n.cross i:nth-child(2){left:50%;bottom:0;width:2px;height:10px;transform:translateX(-50%)}\n.cross i:nth-child(3){top:50%;left:0;height:2px;width:10px;transform:translateY(-50%)}\n.cross i:nth-child(4){top:50%;right:0;height:2px;width:10px;transform:translateY(-50%)}\n#hitmark{position:absolute;left:50%;top:50%;width:32px;height:32px;transform:translate(-50%,-50%) rotate(45deg);opacity:0;transition:opacity .1s}\n#hitmark:before,#hitmark:after{content:\"\";position:absolute;background:#fff}\n#hitmark:before{left:50%;top:0;width:3px;height:100%;transform:translateX(-50%)}\n#hitmark:after{top:50%;left:0;height:3px;width:100%;transform:translateY(-50%)}\n#dmg{position:absolute;inset:0;background:radial-gradient(circle,transparent 38%,rgba(190,0,0,.75));opacity:0;transition:opacity .2s}\n#top{position:absolute;top:16px;left:50%;transform:translateX(-50%);display:flex;gap:12px}\n.chip{background:rgba(6,10,14,.75);border:1px solid rgba(255,204,85,.25);padding:8px 16px;border-radius:10px;font-size:13px;letter-spacing:2px}\n.chip b{color:#ffcc55}\n#feed{position:absolute;top:80px;right:20px;width:300px;text-align:right;font-size:12px}\n#feed div{background:rgba(6,10,14,.7);border-right:3px solid #ff5533;padding:6px 10px;margin-bottom:5px;border-radius:5px}\n#feed div.team{border-right-color:#39ff6a}\n#hpwrap{position:absolute;left:24px;bottom:24px;width:300px}\n#hpwrap .label{font-size:11px;letter-spacing:3px;opacity:.8;margin-bottom:6px}\n#hpbar{height:14px;background:rgba(0,0,0,.6);border:1px solid #333;border-radius:9px;overflow:hidden}\n#hpfill{height:100%;width:100%;background:linear-gradient(90deg,#39ff6a,#0f9d3a);transition:width .15s}\n#ammo{position:absolute;right:28px;bottom:22px;text-align:right}\n#wname{font-size:12px;letter-spacing:3px;color:#ffcc55}\n#anum{font-size:46px;font-weight:800}\n#ares{font-size:18px;opacity:.75}\n#minimap{position:absolute;left:24px;top:24px;width:160px;height:160px;background:rgba(4,9,13,.75);border:1px solid rgba(255,255,255,.15);border-radius:12px}\n.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;background:radial-gradient(circle at 50% 25%,rgba(28,44,62,.96),rgba(2,4,7,.99))}\n.lobby{width:min(940px,94vw);max-height:94vh;overflow:auto;background:linear-gradient(160deg,rgba(13,19,26,.97),rgba(5,8,11,.99));border:1px solid rgba(255,204,85,.25);border-radius:20px;padding:34px}\n.logo{font-size:46px;font-weight:900;letter-spacing:9px;text-align:center;background:linear-gradient(90deg,#ffcc55,#ff7a3d);-webkit-background-clip:text;background-clip:text;color:transparent}\n.sub{letter-spacing:4px;font-size:12px;color:#9fb0bd;text-align:center;margin:8px 0 24px}\n.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:22px}\n.card{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:16px}\n.card h3{font-size:12px;letter-spacing:3px;color:#ffcc55;margin-bottom:10px}\n.card p,.card li{font-size:12.5px;color:#c9d4dc;line-height:1.75}\n.card ul{list-style:none}\nselect{pointer-events:auto;width:100%;background:#121820;color:#fff;border:1px solid #334;padding:10px;border-radius:9px}\n.btn{pointer-events:auto;border:none;cursor:pointer;font-weight:800;letter-spacing:3px;padding:16px 38px;border-radius:11px;background:linear-gradient(90deg,#ffcc55,#ff9a3d);color:#12100a;font-size:16px}\n.btn.ghost{background:transparent;color:#ffcc55;border:1px solid rgba(255,204,85,.5)}\n.row{display:flex;gap:12px;justify-content:center}\n.hidden{display:none!important}\n#tip{position:absolute;left:50%;bottom:90px;transform:translateX(-50%);background:rgba(6,10,14,.8);padding:10px 18px;border-radius:10px;font-size:13px;color:#ffcc55;opacity:0;transition:opacity .3s}\n</style>\n</head>\n<body>\n<div id=\"hud\">\n  <div class=\"cross\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hitmark\"></div><div id=\"dmg\"></div>\n  <div id=\"top\">\n    <div class=\"chip\">SCORE <b id=\"score\">0</b></div>\n    <div class=\"chip\">SQUAD <b id=\"teamLeft\">3</b></div>\n    <div class=\"chip\">ENEMIES <b id=\"enemyLeft\">6</b></div>\n    <div class=\"chip\">TIME <b id=\"time\">0:00</b></div>\n  </div>\n  <div id=\"feed\"></div>\n  <div id=\"minimap\"><canvas id=\"mm\" width=\"160\" height=\"160\"></canvas></div>\n  <div id=\"hpwrap\"><div class=\"label\">HEALTH</div><div id=\"hpbar\"><div id=\"hpfill\"></div></div></div>\n  <div id=\"ammo\"><div id=\"wname\">AR-9 RIFLE</div><div><span id=\"anum\">30</span><span id=\"ares\"> / 150</span></div></div>\n  <div id=\"tip\">CLICK TO LOCK MOUSE</div>\n</div>\n\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"lobby\">\n    <div class=\"logo\">OPERATION BLACKOUT</div>\n    <div class=\"sub\">ADVANCED 3D TEAM ARENA • ENTERABLE BUILDINGS</div>\n    <div class=\"grid\">\n      <div class=\"card\"><h3>DEPLOYMENT</h3>\n        <p>Select difficulty and graphics, then deploy.</p>\n        <select id=\"diff\" style=\"margin-top:10px\"><option value=\"0.8\">Recruit</option><option value=\"1\" selected>Regular</option><option value=\"1.35\">Veteran</option></select>\n        <select id=\"quality\" style=\"margin-top:10px\"><option value=\"1\">High Graphics</option><option value=\"0.66\">Balanced</option><option value=\"0.45\">Performance</option></select>\n      </div>\n      <div class=\"card\"><h3>CONTROLS</h3><ul>\n        <li><b>W A S D</b> — Move</li><li><b>Mouse</b> — Look</li><li><b>Left click</b> — Fire</li>\n        <li><b>Shift</b> — Sprint</li><li><b>Space</b> — Jump</li><li><b>R</b> — Reload</li>\n        <li><b>1 / 2</b> — Weapons</li><li><b>Esc</b> — Pause</li></ul></div>\n      <div class=\"card\"><h3>MISSION</h3><p>Clear the town with 3 allies. Enter buildings through open doorways and eliminate all 6 enemies.</p></div>\n    </div>\n    <div class=\"row\"><button class=\"btn\" id=\"start\">DEPLOY</button><button class=\"btn ghost\" onclick=\"alert('Click DEPLOY, then click the game once to lock your mouse.')\">HOW TO PLAY</button></div>\n  </div>\n</div>\n\n<div id=\"pause\" class=\"screen hidden\"><div class=\"lobby\" style=\"width:min(500px,90vw);text-align:center\"><div class=\"logo\" style=\"font-size:34px\">PAUSED</div><div class=\"row\" style=\"margin-top:24px\"><button class=\"btn\" id=\"resume\">RESUME</button><button class=\"btn ghost\" onclick=\"location.reload()\">RESTART</button></div></div></div>\n<div id=\"end\" class=\"screen hidden\"><div class=\"lobby\" style=\"width:min(560px,90vw);text-align:center\"><div class=\"logo\" id=\"endTitle\">MISSION COMPLETE</div><div id=\"endStats\" style=\"margin:16px 0 24px;color:#c9d4dc;line-height:1.8\"></div><button class=\"btn\" onclick=\"location.reload()\">PLAY AGAIN</button></div></div>\n\n<script type=\"importmap\">\n{\"imports\":{\"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\"}}\n</script>\n<script type=\"module\">\nimport * as THREE from 'three';\n\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x182230);\nscene.fog=new THREE.Fog(0x182230,45,190);\nconst camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.08,500);\ncamera.rotation.order='YXZ';camera.position.set(0,1.7,34);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,2));\ndocument.body.appendChild(renderer.domElement);\n\nscene.add(new THREE.HemisphereLight(0xdceaff,0x2f3026,1.05));\nconst sun=new THREE.DirectionalLight(0xfff1cf,1.5);\nsun.position.set(45,70,25);sun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);scene.add(sun);\n\nconst world=new THREE.Group();scene.add(world);\nconst colliders=[];\nconst M=(c)=>new THREE.MeshStandardMaterial({color:c,roughness:.85,metalness:.05});\nfunction solid(w,h,d,x,y,z,c){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),M(c));\n  m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;world.add(m);\n  colliders.push({x,z,w,d});return m;\n}\nconst ground=new THREE.Mesh(new THREE.PlaneGeometry(130,130),M(0x4d5540));\nground.rotation.x=-Math.PI/2;ground.receiveShadow=true;world.add(ground);\nconst road=new THREE.Mesh(new THREE.PlaneGeometry(10,130),M(0x3a3d3b));\nroad.rotation.x=-Math.PI/2;road.position.y=.01;world.add(road);\nconst road2=road.clone();road2.rotation.z=Math.PI/2;world.add(road2);\n\nsolid(130,9,2,0,4.5,-65,0x6a7065);solid(130,9,2,0,4.5,65,0x6a7065);\nsolid(2,9,130,-65,4.5,0,0x6a7065);solid(2,9,130,65,4.5,0,0x6a7065);\n\nfunction building(x,z,w,d,h,door,color){\n  const t=.5;\n  solid(w,h,t,x,h/2,z-d/2,color);\n  solid(t,h,d,x-w/2,h/2,z,color);solid(t,h,d,x+w/2,h/2,z,color);\n  const side=(w-door)/2;\n  solid(side,h,t,x-(door/2+side/2),h/2,z+d/2,color);\n  solid(side,h,t,x+(door/2+side/2),h/2,z+d/2,color);\n  solid(door,h-2.4,t,x,h-1.2,z+d/2,color);\n  const roof=new THREE.Mesh(new THREE.BoxGeometry(w+.8,.4,d+.8),M(0x4a4f47));\n  roof.position.set(x,h+.2,z);roof.castShadow=true;world.add(roof);\n  const lamp=new THREE.PointLight(0xffd9a0,12,14);lamp.position.set(x,2.6,z);world.add(lamp);\n}\nbuilding(-26,-26,16,13,5.5,3.4,0x71766a);\nbuilding(28,28,18,14,6,3.6,0x69707c);\nbuilding(30,-28,14,12,5,3,0x76705f);\nbuilding(-30,28,15,13,5.5,3.4,0x6d7367);\n\n[[10,-10],[-12,-16],[16,6],[-20,10],[0,-30],[26,-18],[-38,-6],[8,24],[-8,-4],[38,14],[-24,30],[24,-40]].forEach(([x,z])=>{\n  solid(3.4,3.4,3.4,x,1.7,z,0x7d5c36);\n  solid(2.2,2.2,2.2,x+1.8,1.1,z+1.8,0x6b4d2c);\n});\n\nconst weapons={rifle:{name:'AR-9 RIFLE',mag:30,res:150,dmg:30,rate:.1,reload:1.7,auto:true,spread:.012},pistol:{name:'M7 SIDEARM',mag:12,res:60,dmg:48,rate:.3,reload:1.1,auto:false,spread:.005}};\nlet cur='rifle';const ammo={rifle:{...weapons.rifle},pistol:{...weapons.pistol}};\nconst gun=new THREE.Group();camera.add(gun);scene.add(camera);\nconst gb=new THREE.Mesh(new THREE.BoxGeometry(.12,.15,.8),M(0x23262b));gb.position.set(.3,-.23,-.55);gun.add(gb);\nconst br=new THREE.Mesh(new THREE.BoxGeometry(.05,.05,.45),M(0x101214));br.position.set(.3,-.2,-1.02);gun.add(br);\nconst flash=new THREE.Mesh(new THREE.SphereGeometry(.11),new THREE.MeshBasicMaterial({color:0xffdd66}));flash.position.set(.3,-.2,-1.25);flash.visible=false;gun.add(flash);\n\nconst player={hp:100,vy:0,ground:true,keys:{},last:0,reloading:0};\nlet yaw=0,pitch=0,locked=false,down=false;\nlet score=0,kills=0,playing=false,over=false,start=0,diff=1;\nconst allies=[],enemies=[];\n\nfunction soldier(shirt,pants,helmet){\n  const g=new THREE.Group();\n  const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.32,.55,4,10),M(shirt));torso.position.y=1.35;g.add(torso);\n  const vest=new THREE.Mesh(new THREE.BoxGeometry(.66,.52,.42),M(0x2c3136));vest.position.y=1.4;g.add(vest);\n  const head=new THREE.Mesh(new THREE.SphereGeometry(.2,18,14),M(0xd7a97d));head.position.y=1.94;g.add(head);\n  const helm=new THREE.Mesh(new THREE.SphereGeometry(.25,18,14,0,Math.PI*2,0,Math.PI*.62),M(helmet));helm.position.y=1.99;g.add(helm);\n  const legL=new THREE.Mesh(new THREE.CapsuleGeometry(.11,.62,4,8),M(pants));legL.position.set(-.16,.45,0);g.add(legL);\n  const legR=legL.clone();legR.position.x=.16;g.add(legR);\n  const armL=new THREE.Mesh(new THREE.CapsuleGeometry(.09,.5,4,8),M(shirt));armL.position.set(-.4,1.38,0);g.add(armL);\n  const armR=armL.clone();armR.position.x=.4;g.add(armR);\n  const rifle=new THREE.Group();\n  rifle.add(new THREE.Mesh(new THREE.BoxGeometry(.09,.13,.8),M(0x22262b)));\n  const barrel=new THREE.Mesh(new THREE.BoxGeometry(.04,.04,.38),M(0x111417));barrel.position.z=-.52;rifle.add(barrel);\n  rifle.position.set(.34,1.4,-.35);g.add(rifle);\n  const hb=new THREE.Sprite(new THREE.SpriteMaterial({color:0xff3333}));hb.scale.set(1.4,.1,1);hb.position.y=2.55;g.add(hb);\n  g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});\n  scene.add(g);\n  return {mesh:g,hp:100,max:100,bar:hb,cool:Math.random()*2,speed:2.6+Math.random(),legs:[legL,legR],walk:0};\n}\n[[-8,26],[8,26],[-18,20],[18,20]].forEach(p=>{const a=soldier(0x35583f,0x3b4034,0x31402f);a.mesh.position.set(p[0],0,p[1]);allies.push(a)});\n[[-30,-40],[32,-40],[-44,-16],[46,-16],[0,-52],[-22,-46]].forEach(p=>{const e=soldier(0x6d3a33,0x4a4038,0x3b3f36);e.mesh.position.set(p[0],0,p[1]);enemies.push(e)});\n\nfunction collide(pos,r=.45){\n  for(const c of colliders){\n    const hw=c.w/2+r,hd=c.d/2+r;\n    if(pos.x>c.x-hw&&pos.x<c.x+hw&&pos.z>c.z-hd&&pos.z<c.z+hd){\n      const dx1=(c.x+hw)-pos.x,dx2=pos.x-(c.x-hw),dz1=(c.z+hd)-pos.z,dz2=pos.z-(c.z-hd);\n      const m=Math.min(dx1,dx2,dz1,dz2);\n      if(m===dx1)pos.x=c.x+hw;else if(m===dx2)pos.x=c.x-hw;\n      else if(m===dz1)pos.z=c.z+hd;else pos.z=c.z-hd;\n    }\n  }\n  pos.x=THREE.MathUtils.clamp(pos.x,-62,62);pos.z=THREE.MathUtils.clamp(pos.z,-62,62);\n}\n\nconst ray=new THREE.Raycaster();\nfunction shoot(){\n  const w=weapons[cur],a=ammo[cur],now=performance.now()/1000;\n  if(player.reloading>0||now-player.last<w.rate)return;\n  if(a.mag<=0)return reload();\n  player.last=now;a.mag--;flash.visible=true;setTimeout(()=>flash.visible=false,45);\n  ray.setFromCamera(new THREE.Vector2((Math.random()-.5)*w.spread*40,(Math.random()-.5)*w.spread*40),camera);\n  const hit=ray.intersectObjects(enemies.map(e=>e.mesh),true)[0];\n  if(hit){let o=hit.object;while(o.parent&&!enemies.some(e=>e.mesh===o))o=o.parent;\n    const e=enemies.find(x=>x.mesh===o);\n    if(e){e.hp-=w.dmg;score+=10;hitmark();e.bar.scale.x=Math.max(.05,1.4*e.hp/e.max);\n      if(e.hp<=0){scene.remove(e.mesh);enemies.splice(enemies.indexOf(e),1);kills++;score+=150;feed('ENEMY ELIMINATED +150')}}}\n  hud();\n}\nfunction reload(){const w=weapons[cur],a=ammo[cur];if(player.reloading>0||a.mag===w.mag||!a.res)return;\n  player.reloading=w.reload;\n  setTimeout(()=>{const t=Math.min(w.mag-a.mag,a.res);a.mag+=t;a.res-=t;player.reloading=0;hud()},w.reload*1000)}\nfunction hitmark(){const h=document.getElementById('hitmark');h.style.opacity=1;setTimeout(()=>h.style.opacity=0,110)}\nfunction feed(t,team){const f=document.getElementById('feed'),d=document.createElement('div');d.textContent=t;if(team)d.className='team';f.prepend(d);setTimeout(()=>d.remove(),2600)}\nfunction hud(){const a=ammo[cur];document.getElementById('anum').textContent=a.mag;document.getElementById('ares').textContent=' / '+a.res;\n  document.getElementById('wname').textContent=weapons[cur].name;document.getElementById('score').textContent=score;\n  document.getElementById('teamLeft').textContent=allies.length;document.getElementById('enemyLeft').textContent=enemies.length;\n  document.getElementById('hpfill').style.width=Math.max(0,player.hp)+'%'}\nfunction end(win){over=true;playing=false;document.exitPointerLock();\n  document.getElementById('endTitle').textContent=win?'MISSION COMPLETE':'MISSION FAILED';\n  document.getElementById('endStats').innerHTML=`Score: <b>${score}</b><br>Kills: <b>${kills}</b><br>Time: <b>${Math.floor((performance.now()-start)/1000)}s</b>`;\n  document.getElementById('end').classList.remove('hidden')}\n\ndocument.addEventListener('pointerlockchange',()=>{\n  locked=document.pointerLockElement===renderer.domElement;\n  document.getElementById('tip').style.opacity=(!locked&&playing&&!over)?1:0;\n  if(!locked&&playing&&!over)document.getElementById('pause').classList.remove('hidden');\n});\nrenderer.domElement.addEventListener('click',()=>{if(playing&&!over&&!locked)renderer.domElement.requestPointerLock()});\ndocument.addEventListener('mousemove',e=>{\n  if(!locked)return;\n  yaw-=e.movementX*.0022;pitch-=e.movementY*.0022;\n  pitch=Math.max(-1.45,Math.min(1.45,pitch));\n  camera.rotation.y=yaw;camera.rotation.x=pitch;\n});\ndocument.addEventListener('keydown',e=>{player.keys[e.code]=true;\n  if(e.code==='KeyR')reload();if(e.code==='Digit1')cur='rifle';if(e.code==='Digit2')cur='pistol';hud()});\ndocument.addEventListener('keyup',e=>player.keys[e.code]=false);\nrenderer.domElement.addEventListener('mousedown',e=>{if(e.button===0){down=true;shoot()}});\ndocument.addEventListener('mouseup',()=>down=false);\n\ndocument.getElementById('start').onclick=()=>{\n  diff=+document.getElementById('diff').value;\n  renderer.setPixelRatio(Math.min(devicePixelRatio,2)*(+document.getElementById('quality').value));\n  document.getElementById('lobby').classList.add('hidden');\n  document.getElementById('hud').style.display='block';\n  playing=true;start=performance.now();\n  renderer.domElement.requestPointerLock();\n};\ndocument.getElementById('resume').onclick=()=>{document.getElementById('pause').classList.add('hidden');renderer.domElement.requestPointerLock()};\n\nconst mm=document.getElementById('mm').getContext('2d');\nfunction minimap(){\n  mm.clearRect(0,0,160,160);mm.fillStyle='rgba(16,26,22,.92)';mm.fillRect(0,0,160,160);\n  const dot=(x,z,c,r=3)=>{mm.fillStyle=c;mm.beginPath();mm.arc((x+65)/130*160,(z+65)/130*160,r,0,7);mm.fill()};\n  colliders.forEach(c=>dot(c.x,c.z,'rgba(120,130,120,.35)',2));\n  allies.forEach(a=>dot(a.mesh.position.x,a.mesh.position.z,'#39ff6a'));\n  enemies.forEach(e=>dot(e.mesh.position.x,e.mesh.position.z,'#ff4444'));\n  dot(camera.position.x,camera.position.z,'#ffcc55',4);\n  const d=new THREE.Vector3();camera.getWorldDirection(d);\n  const px=(camera.position.x+65)/130*160,pz=(camera.position.z+65)/130*160;\n  mm.strokeStyle='#ffcc55';mm.beginPath();mm.moveTo(px,pz);mm.lineTo(px+d.x*15,pz+d.z*15);mm.stroke();\n}\n\nfunction animateLegs(u,moving){\n  u.walk+=moving?.2:0;\n  u.legs[0].rotation.x=Math.sin(u.walk)*.6*(moving?1:0);\n  u.legs[1].rotation.x=-Math.sin(u.walk)*.6*(moving?1:0);\n}\nfunction ai(list,target,isEnemy){\n  list.forEach(u=>{\n    const tp=target===camera?camera.position:target.mesh.position;\n    const v=new THREE.Vector3().subVectors(tp,u.mesh.position);v.y=0;const dist=v.length();v.normalize();\n    let moving=false;\n    if(dist>(isEnemy?11:18)){u.mesh.position.addScaledVector(v,u.speed*diff*dt);moving=true}\n    u.mesh.rotation.y=Math.atan2(tp.x-u.mesh.position.x,tp.z-u.mesh.position.z);\n    animateLegs(u,moving);\n    u.cool-=dt;\n    if(u.cool<=0&&dist<50){u.cool=(isEnemy?1.1:1.5)+Math.random();\n      if(isEnemy){player.hp-=(5+Math.random()*5)*diff;const dg=document.getElementById('dmg');dg.style.opacity=.85;setTimeout(()=>dg.style.opacity=0,170);hud();if(player.hp<=0)end(false)}\n      else{const e=enemies[Math.floor(Math.random()*enemies.length)];if(e){e.hp-=16;e.bar.scale.x=Math.max(.05,1.4*e.hp/e.max);\n        if(e.hp<=0){scene.remove(e.mesh);enemies.splice(enemies.indexOf(e),1);score+=75;feed('ALLY ELIMINATED ENEMY +75',true)}}}\n    }\n  });\n}\n\nconst clock=new THREE.Clock();\nfunction animate(){\n  requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.05);\n  if(playing&&!over&&locked){\n    const speed=(player.keys.ShiftLeft?9.5:5.8)*dt;\n    const forward=new THREE.Vector3(-Math.sin(yaw),0,-Math.cos(yaw));\n    const right=new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw));\n    const move=new THREE.Vector3();\n    if(player.keys.KeyW)move.add(forward);\n    if(player.keys.KeyS)move.sub(forward);\n    if(player.keys.KeyD)move.add(right);\n    if(player.keys.KeyA)move.sub(right);\n    if(move.lengthSq()>0){move.normalize().multiplyScalar(speed);camera.position.add(move);collide(camera.position)}\n    if(player.keys.Space&&player.ground){player.vy=7.5;player.ground=false}\n    player.vy-=20*dt;camera.position.y+=player.vy*dt;\n    if(camera.position.y<=1.7){camera.position.y=1.7;player.vy=0;player.ground=true}\n    if(down&&weapons[cur].auto)shoot();\n    ai(enemies,camera,true);\n    if(enemies.length)ai(allies,enemies[0],false);\n    const t=Math.floor((performance.now()-start)/1000);\n    document.getElementById('time').textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');\n    minimap();\n    if(!enemies.length)end(true);\n  }\n  renderer.render(scene,camera);\n}\nanimate();\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});\n</script>\n</body>\n</html>"
    }
