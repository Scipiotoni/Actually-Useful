    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>OPERATION BLACKOUT</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --font-display:'Chakra Petch',sans-serif;\n  --font-body:'Inter',sans-serif;\n  --bg:#0b0e11; --panel:rgba(13,17,21,.82); --border:rgba(255,255,255,.12);\n  --text:#e8ecef; --muted:#93a1ab; --accent:#ffb648; --green:#7dff8e; --red:#ff5d5d;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{height:100%;overflow:hidden}\nbody{background:var(--bg);font-family:var(--font-body);color:var(--text);-webkit-font-smoothing:antialiased}\ncanvas#game{display:block;position:fixed;inset:0}\n#vignette{position:fixed;inset:0;pointer-events:none;box-shadow:inset 0 0 180px rgba(0,0,0,.55);z-index:2}\n\n/* ---------- HUD ---------- */\n#hud{position:fixed;inset:0;pointer-events:none;z-index:5;display:none;\n  text-shadow:0 1px 3px rgba(0,0,0,.8),0 0 8px rgba(0,0,0,.4)}\n#hud .num{font-variant-numeric:tabular-nums lining-nums}\n#topbar{position:absolute;top:14px;left:50%;transform:translateX(-50%);display:flex;gap:10px}\n.chip{background:rgba(10,13,16,.68);border:1px solid var(--border);border-radius:8px;padding:7px 14px;\n  font-size:12px;letter-spacing:1.5px;color:var(--muted);backdrop-filter:blur(6px)}\n.chip b{color:var(--text);font-weight:700;margin-left:6px}\n#hpwrap{position:absolute;left:22px;bottom:22px;width:250px}\n#hpwrap .label{font-size:10px;letter-spacing:3px;color:var(--muted);margin-bottom:5px}\n#hpbar{height:13px;background:rgba(0,0,0,.55);border:1px solid var(--border);border-radius:8px;overflow:hidden}\n#hpfill{height:100%;width:100%;background:linear-gradient(90deg,#6fe084,#2f9e4a);transition:width .12s}\n#hpwrap.low #hpfill{background:linear-gradient(90deg,#ff7a6e,#c0392b)}\n#ammo{position:absolute;right:24px;bottom:18px;text-align:right}\n#wname{font-size:11px;letter-spacing:3px;color:var(--accent);font-weight:600}\n#anum{font-size:42px;font-weight:700;line-height:1}\n#ares{font-size:16px;color:var(--muted)}\n#reload{position:absolute;left:50%;top:62%;transform:translateX(-50%);font-size:14px;letter-spacing:4px;color:var(--accent);opacity:0;transition:opacity .15s}\n#feed{position:absolute;top:64px;right:20px;width:300px;text-align:right;font-size:12px}\n#feed div{background:rgba(10,13,16,.6);border-right:3px solid var(--red);padding:5px 10px;margin-bottom:4px;border-radius:5px;animation:feedin .25s}\n#feed div.ally{border-right-color:var(--green)}\n@keyframes feedin{from{transform:translateX(20px);opacity:0}}\n#minimap{position:absolute;left:22px;top:20px;background:rgba(8,11,14,.72);border:1px solid var(--border);border-radius:10px;backdrop-filter:blur(4px)}\n#cross{position:absolute;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%)}\n#cross i{position:absolute;background:#eaf7ee;box-shadow:0 0 4px rgba(0,0,0,.8)}\n#cross i:nth-child(1){left:50%;top:0;width:2px;height:9px;transform:translateX(-50%)}\n#cross i:nth-child(2){left:50%;bottom:0;width:2px;height:9px;transform:translateX(-50%)}\n#cross i:nth-child(3){top:50%;left:0;height:2px;width:9px;transform:translateY(-50%)}\n#cross i:nth-child(4){top:50%;right:0;height:2px;width:9px;transform:translateY(-50%)}\n#hitmark{position:absolute;left:50%;top:50%;width:26px;height:26px;transform:translate(-50%,-50%) rotate(45deg);opacity:0;transition:opacity .08s}\n#hitmark:before,#hitmark:after{content:\"\";position:absolute;background:#fff}\n#hitmark:before{left:50%;top:0;width:2.5px;height:100%;transform:translateX(-50%)}\n#hitmark:after{top:50%;left:0;height:2.5px;width:100%;transform:translateY(-50%)}\n#dmg{position:fixed;inset:0;background:radial-gradient(circle,transparent 42%,rgba(180,10,10,.55));opacity:0;transition:opacity .25s;pointer-events:none;z-index:4}\n#hint{position:absolute;left:50%;bottom:110px;transform:translateX(-50%);font-size:12px;letter-spacing:2px;color:var(--muted);background:rgba(10,13,16,.7);border:1px solid var(--border);border-radius:8px;padding:8px 16px;opacity:0;transition:opacity .3s}\n#fps{position:fixed;top:0;right:0;z-index:99;background:rgba(0,0,0,.7);color:#7dff8e;font:11px/1.5 monospace;padding:5px 8px;pointer-events:none;display:none;white-space:pre}\n\n/* ---------- Screens ---------- */\n.screen{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;background:linear-gradient(105deg,rgba(6,8,10,.94) 0%,rgba(6,8,10,.55) 55%,rgba(6,8,10,.25) 100%)}\n.screen.center{background:rgba(5,7,9,.88);backdrop-filter:blur(6px)}\n.panel{width:min(980px,94vw);max-height:94vh;overflow:auto;pointer-events:auto}\n.eyebrow{font-size:11px;letter-spacing:6px;color:var(--accent);margin-bottom:10px}\nh1.logo{font-family:var(--font-display);font-size:clamp(44px,7vw,76px);font-weight:700;letter-spacing:4px;line-height:.95;color:#fff}\nh1.logo span{color:var(--accent)}\n.sub{color:var(--muted);font-size:14px;margin-top:10px;max-width:520px;line-height:1.6}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin-top:26px}\n.card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:16px;backdrop-filter:blur(10px)}\n.card h3{font-family:var(--font-display);font-size:12px;letter-spacing:3px;color:var(--accent);margin-bottom:10px}\n.card p,.card li{font-size:13px;color:#c3ced6;line-height:1.7}\n.card ul{list-style:none}\nkbd{background:rgba(255,255,255,.09);border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;padding:1px 7px;font:600 11px var(--font-body);color:#fff}\n.row{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:26px}\n.btn{pointer-events:auto;cursor:pointer;border:none;border-radius:10px;padding:16px 42px;\n  font:700 15px var(--font-display);letter-spacing:3px;color:#141007;\n  background:linear-gradient(90deg,#ffc25e,#ff9a35);transition:transform .15s,box-shadow .15s;box-shadow:0 8px 24px rgba(255,170,60,.25)}\n.btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(255,170,60,.4)}\n.btn.ghost{background:transparent;color:var(--accent);border:1px solid rgba(255,182,72,.5);box-shadow:none}\n.btn.ghost:hover{border-color:var(--accent);background:rgba(255,182,72,.08)}\n.seg{display:flex;gap:6px;flex-wrap:wrap}\n.seg button{pointer-events:auto;cursor:pointer;background:rgba(255,255,255,.05);border:1px solid var(--border);color:#c3ced6;border-radius:8px;padding:7px 12px;font:600 12px var(--font-body);transition:all .15s}\n.seg button.on{background:rgba(255,182,72,.15);border-color:var(--accent);color:var(--accent)}\ninput[type=range]{pointer-events:auto;width:100%;accent-color:var(--accent)}\n.stat{font-size:13px;color:var(--muted)} .stat b{color:var(--text)}\n#endStats{margin:18px 0 6px;line-height:2;color:#c3ced6} #endStats b{color:var(--accent)}\n.center-box{text-align:center;background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:44px 60px;backdrop-filter:blur(12px);pointer-events:auto}\n.hidden{display:none!important}\n#loadErr{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;background:#0b0e11;color:var(--text);font-size:15px;text-align:center;line-height:2}\n</style>\n</head>\n<body>\n<canvas id=\"game\"></canvas>\n<div id=\"vignette\"></div>\n<div id=\"dmg\"></div>\n\n<div id=\"hud\">\n  <div id=\"topbar\">\n    <div class=\"chip\">SCORE <b class=\"num\" id=\"score\">0</b></div>\n    <div class=\"chip\">SQUAD <b class=\"num\" id=\"allyCount\">3</b></div>\n    <div class=\"chip\">HOSTILES <b class=\"num\" id=\"enemyCount\">6</b></div>\n    <div class=\"chip\">TIME <b class=\"num\" id=\"time\">0:00</b></div>\n  </div>\n  <div id=\"feed\"></div>\n  <canvas id=\"minimap\" width=\"160\" height=\"160\"></canvas>\n  <div id=\"hpwrap\"><div class=\"label\">HEALTH</div><div id=\"hpbar\"><div id=\"hpfill\"></div></div></div>\n  <div id=\"ammo\"><div id=\"wname\">AR-9 CARBINE</div><div><span id=\"anum\" class=\"num\">30</span><span id=\"ares\" class=\"num\"> / 150</span></div></div>\n  <div id=\"reload\">RELOADING</div>\n  <div id=\"cross\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hitmark\"></div>\n  <div id=\"hint\"></div>\n</div>\n<div id=\"fps\"></div>\n<div id=\"loadErr\"><div>Failed to load the 3D engine from the CDN.<br>Check your internet connection and reload the page.</div></div>\n\n<!-- LOBBY -->\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"panel\">\n    <div class=\"eyebrow\">TACTICAL FPS // SECTOR 7</div>\n    <h1 class=\"logo\">OPERATION <span>BLACKOUT</span></h1>\n    <p class=\"sub\">Clear the compound of all hostiles with your AI fireteam. Buildings can be entered — use doorways, watch windows, and check your corners.</p>\n    <div class=\"cards\">\n      <div class=\"card\"><h3>MISSION</h3><p>Eliminate every hostile soldier in the compound. Your squad fights with you. Hostiles patrol, hunt, and use doorways.</p></div>\n      <div class=\"card\"><h3>DIFFICULTY</h3><div class=\"seg\" id=\"diffSeg\">\n        <button data-v=\"0.7\">RECRUIT</button><button data-v=\"1\" class=\"on\">REGULAR</button><button data-v=\"1.45\">VETERAN</button></div>\n        <p class=\"stat\" style=\"margin-top:8px\">Affects enemy accuracy, damage and reaction speed.</p></div>\n      <div class=\"card\"><h3>FORCE SIZE</h3>\n        <p class=\"stat\">Hostiles <b id=\"enLbl\">6</b></p><input type=\"range\" id=\"enRange\" min=\"3\" max=\"12\" value=\"6\">\n        <p class=\"stat\">Squad mates <b id=\"alLbl\">3</b></p><input type=\"range\" id=\"alRange\" min=\"0\" max=\"4\" value=\"3\"></div>\n      <div class=\"card\"><h3>CONTROLS</h3><ul>\n        <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> Move &nbsp;<kbd>SHIFT</kbd> Sprint</li>\n        <li><kbd>SPACE</kbd> Jump &nbsp;<kbd>R</kbd> Reload</li>\n        <li><kbd>1</kbd>/<kbd>2</kbd> Weapons &nbsp;<kbd>ESC</kbd> Pause</li>\n        <li>Mouse — aim &nbsp; Left click — fire</li></ul></div>\n      <div class=\"card\"><h3>SENSITIVITY</h3><input type=\"range\" id=\"sens\" min=\"0.4\" max=\"3\" step=\"0.1\" value=\"1.4\"><p class=\"stat\" style=\"margin-top:6px\">If mouse capture is blocked, hold <b>right-click</b> and drag to look.</p></div>\n      <div class=\"card\"><h3>LOADOUT</h3><p><b>AR-9 Carbine</b> — full auto, 30 rnd mag.<br><b>M7 Sidearm</b> — semi auto, high damage.</p></div>\n    </div>\n    <div class=\"row\"><button class=\"btn\" id=\"deploy\">DEPLOY</button></div>\n  </div>\n</div>\n\n<!-- PAUSE -->\n<div id=\"pause\" class=\"screen center hidden\"><div class=\"center-box\">\n  <h1 class=\"logo\" style=\"font-size:44px\">PAUSED</h1>\n  <div class=\"row\" style=\"justify-content:center\"><button class=\"btn\" id=\"resume\">RESUME</button><button class=\"btn ghost\" id=\"restart1\">RESTART</button></div>\n</div></div>\n\n<!-- END -->\n<div id=\"end\" class=\"screen center hidden\"><div class=\"center-box\">\n  <h1 class=\"logo\" id=\"endTitle\" style=\"font-size:44px\">MISSION COMPLETE</h1>\n  <div id=\"endStats\"></div>\n  <div class=\"row\" style=\"justify-content:center\"><button class=\"btn\" id=\"restart2\">REDEPLOY</button></div>\n</div></div>\n\n<script type=\"importmap\">\n{\"imports\":{\"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\"}}\n</script>\n<script type=\"module\">\nimport * as THREE from 'three';\n\n/* ============================================================\n   SETUP\n============================================================ */\nconst canvas=document.getElementById('game');\nconst renderer=new THREE.WebGLRenderer({canvas,antialias:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.05;\n\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0xb9c4c9);\nscene.fog=new THREE.Fog(0xb9c4c9,45,175);\nconst camera=new THREE.PerspectiveCamera(74,innerWidth/innerHeight,.1,500);\ncamera.rotation.order='YXZ';\n\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});\n\n/* ---------- lights ---------- */\nscene.add(new THREE.HemisphereLight(0xdfe8ef,0x4a463a,.85));\nconst sun=new THREE.DirectionalLight(0xffe6bd,1.7);\nsun.position.set(60,80,30); sun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nconst sc=sun.shadow.camera; sc.left=-75;sc.right=75;sc.top=75;sc.bottom=-75;sc.far=250;\nsun.shadow.bias=-0.0006;\nsc.updateProjectionMatrix();\nscene.add(sun);\n\n/* ============================================================\n   PROCEDURAL TEXTURES\n============================================================ */\nfunction makeTex(draw,size=256){\n  const c=document.createElement('canvas');c.width=c.height=size;\n  const x=c.getContext('2d');draw(x,size);\n  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.colorSpace=THREE.SRGBColorSpace;\n  t.anisotropy=8;return t;\n}\nfunction noise(x,size,alpha,base){\n  const img=x.getImageData(0,0,size,size),d=img.data;\n  for(let i=0;i<d.length;i+=4){const n=(Math.random()-.5)*alpha*255;d[i]+=n;d[i+1]+=n;d[i+2]+=n;}\n  x.putImageData(img,0,0);\n}\nconst texAsphalt=makeTex((x,s)=>{x.fillStyle='#34383b';x.fillRect(0,0,s,s);noise(x,s,.35);\n  x.strokeStyle='rgba(0,0,0,.35)';x.lineWidth=2;\n  for(let i=0;i<5;i++){x.beginPath();x.moveTo(Math.random()*s,0);x.lineTo(Math.random()*s,s);x.stroke();}\n  x.fillStyle='rgba(0,0,0,.18)';for(let i=0;i<14;i++)x.fillRect(Math.random()*s,Math.random()*s,Math.random()*40,Math.random()*8);});\nconst texConcrete=makeTex((x,s)=>{x.fillStyle='#8d9092';x.fillRect(0,0,s,s);noise(x,s,.22);\n  x.strokeStyle='rgba(0,0,0,.25)';x.lineWidth=3;\n  x.beginPath();x.moveTo(0,s*.5);x.lineTo(s,s*.5);x.stroke();\n  x.fillStyle='rgba(60,50,35,.18)';for(let i=0;i<10;i++)x.fillRect(Math.random()*s,Math.random()*s,Math.random()*30,Math.random()*30);});\nconst texWood=makeTex((x,s)=>{x.fillStyle='#7a5a38';x.fillRect(0,0,s,s);\n  for(let i=0;i<6;i++){x.fillStyle=i%2?'#6e5031':'#83613d';x.fillRect(0,i*s/6,s,s/6-2);}\n  noise(x,s,.18);});\nconst texMetal=makeTex((x,s)=>{x.fillStyle='#5c666e';x.fillRect(0,0,s,s);noise(x,s,.15);\n  x.fillStyle='rgba(0,0,0,.3)';for(let i=0;i<8;i++)x.fillRect(0,i*s/8,s,3);});\n\nconst M={\n  ground:new THREE.MeshStandardMaterial({map:texAsphalt,roughness:.95}),\n  wall:new THREE.MeshStandardMaterial({map:texConcrete,roughness:.9}),\n  roof:new THREE.MeshStandardMaterial({color:0x6e7072,roughness:.95}),\n  wood:new THREE.MeshStandardMaterial({map:texWood,roughness:.9}),\n  metal:new THREE.MeshStandardMaterial({map:texMetal,roughness:.6,metalness:.35}),\n  dark:new THREE.MeshStandardMaterial({color:0x23262a,roughness:.7}),\n  lamp:new THREE.MeshBasicMaterial({color:0xfff3d0}),\n};\n\n/* ============================================================\n   WORLD + COLLISION\n============================================================ */\nconst world=new THREE.Group();scene.add(world);\nconst solids=[];   // AABBs {x0,x1,z0,z1,y0,y1}\nconst shootables=[];// meshes bullets can hit (walls etc.)\nfunction addSolid(x0,x1,z0,z1,y0,y1){solids.push({x0,x1,z0,z1,y0,y1})}\n\nfunction box(w,h,d,x,y,z,mat,solid=true,shadow=true){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);\n  m.position.set(x,y,z);m.castShadow=shadow;m.receiveShadow=true;\n  world.add(m);shootables.push(m);\n  if(solid)addSolid(x-w/2,x+w/2,z-d/2,z+d/2,y-h/2,y+h/2);\n  return m;\n}\n\n/* ground */\n{\n  const g=new THREE.Mesh(new THREE.PlaneGeometry(140,140),M.ground);\n  g.rotation.x=-Math.PI/2;g.position.y=0;g.receiveShadow=true;\n  texAsphalt.repeat.set(26,26);world.add(g);shootables.push(g);\n}\n/* perimeter walls */\nbox(116,7,2,0,3.5,-58,M.wall);box(116,7,2,0,3.5,58,M.wall);\nbox(2,7,116,-58,3.5,0,M.wall);box(2,7,116,58,3.5,0,M.wall);\n\n/* wall segment helpers for buildings */\nfunction wallX(x0,x1,y0,y1,z){box(x1-x0,y1-y0,.4,(x0+x1)/2,(y0+y1)/2,z,M.wall)}\nfunction wallZ(z0,z1,y0,y1,x){box(.4,y1-y0,z1-z0,x,(y0+y1)/2,(z0+z1)/2,M.wall)}\n\nfunction building(cx,cz,w,d,h,doorSide){\n  const H=h, x0=cx-w/2,x1=cx+w/2,z0=cz-d/2,z1=cz+d/2;\n  const DW=2.8, bandLo=2.1, bandHi=3.3; // door width, window band\n  // north (z0) / south (z1) walls\n  for(const side of ['N','S']){\n    const z=side==='N'?z0:z1;\n    if(doorSide===side){\n      const dm=(x0+x1)/2;\n      wallX(x0,dm-DW/2,0,H,z); wallX(dm+DW/2,x1,0,H,z);\n      wallX(dm-DW/2,dm+DW/2,2.6,H,z); // lintel above door\n    }else{\n      const w1=[x0+w/4-1.1,x0+w/4+1.1], w2=[x1-w/4-1.1,x1-w/4+1.1];\n      wallX(x0,w1[0],0,H,z); wallX(w1[1],w2[0],0,H,z); wallX(w2[1],x1,0,H,z);\n      for(const wn of [w1,w2]){wallX(wn[0],wn[1],0,bandLo,z);wallX(wn[0],wn[1],bandHi,H,z)}\n    }\n  }\n  // west (x0) / east (x1) walls\n  for(const side of ['W','E']){\n    const x=side==='W'?x0:x1;\n    if(doorSide===side){\n      const dm=(z0+z1)/2;\n      wallZ(z0,dm-DW/2,0,H,x); wallZ(dm+DW/2,z1,0,H,x);\n      wallZ(dm-DW/2,dm+DW/2,2.6,H,x); // lintel above door\n    }else{\n      const w1=[z0+d/4-1.1,z0+d/4+1.1], w2=[z1-d/4-1.1,z1-d/4+1.1];\n      wallZ(z0,w1[0],0,H,x); wallZ(w1[1],w2[0],0,H,x); wallZ(w2[1],z1,0,H,x);\n      for(const wn of [w1,w2]){wallZ(wn[0],wn[1],0,bandLo,x);wallZ(wn[0],wn[1],bandHi,H,x)}\n    }\n  }\n  // roof + interior light\n  box(w+.6,.35,d+.6,cx,H+.17,cz,M.roof,false);\n  addSolid(x0-.3,x1+.3,z0-.3,z1+.3,H+.17,H+.52);\n  box(w*.5,.1,d*.5,cx,H-.08,cz,M.lamp,false,false);\n  const pl=new THREE.PointLight(0xffe9c4,34,Math.max(w,d)*1.6,1.1);pl.position.set(cx,H-.5,cz);scene.add(pl);\n  // ceiling panel (unlit material — guarantees a visible ceiling, since a center light grazes the roof)\n  const ceil=new THREE.Mesh(new THREE.PlaneGeometry(w-.8,d-.8),new THREE.MeshBasicMaterial({color:0x8f897d}));\n  ceil.rotation.x=Math.PI/2;ceil.position.set(cx,H-.05,cz);world.add(ceil);shootables.push(ceil);\n  // interior crates\n  box(1.6,1.6,1.6,cx-w/4,0.8,cz+d/4,M.wood);\n  box(1.2,1.2,1.2,cx+w/4,0.6,cz-d/4,M.metal);\n}\n\nbuilding(-28,-18,20,14,4.2,'S');\nbuilding( 28, 20,20,14,4.2,'N');\nbuilding(  2,-42,16,11,4.2,'S');\nbuilding(-32, 36,14,12,4.2,'E');\n\n/* containers + cover */\nbox(6,2.6,2.6,-6,1.3,10,M.metal); box(6,2.6,2.6,14,1.3,-4,M.metal);\nbox(2.6,2.6,6,24,1.3,-16,M.metal); box(2.6,2.6,6,-16,1.3,24,M.metal);\nbox(6,2.6,2.6,8,1.3,30,M.metal); box(2.6,2.6,6,-12,1.3,-30,M.metal);\nfor(const [x,z] of [[10,-10],[-14,6],[18,14],[-24,-34],[30,-28],[-4,22],[38,4],[-40,-6],[16,40],[-20,44]]){\n  box(2,2,2,x,1,z,M.wood); box(1.5,1.5,1.5,x+2.1,.75,z+.4,M.wood);\n}\n/* sandbag-style low walls */\nfor(const [x,z,r] of [[0,-14,0],[6,-14,0],[-6,28,0],[34,-34,0],[-36,16,0],[20,32,0]]){\n  box(4.5,1.1,.8,x,.55,z,M.dark);\n}\n\n/* ============================================================\n   NAV GRID + A*\n============================================================ */\nconst HALF=58, CELL=1, GRID=Math.ceil(HALF*2/CELL);\nconst blocked=new Uint8Array(GRID*GRID);\nfunction bakeGrid(){\n  for(let i=0;i<GRID;i++)for(let j=0;j<GRID;j++){\n    const x=-HALF+i*CELL+CELL/2, z=-HALF+j*CELL+CELL/2;\n    let b=0;\n    for(const s of solids){\n      if(s.y0>1.4)continue;\n      if(x>s.x0-.5&&x<s.x1+.5&&z>s.z0-.5&&z<s.z1+.5){b=1;break}\n    }\n    blocked[i*GRID+j]=b;\n  }\n}\nbakeGrid();\nconst gi=(x,z)=>[Math.min(GRID-1,Math.max(0,Math.floor(x+HALF))),Math.min(GRID-1,Math.max(0,Math.floor(z+HALF)))];\nfunction walkableAt(x,z){const [i,j]=gi(x,z);return !blocked[i*GRID+j]}\nfunction gridLOS(x1,z1,x2,z2){\n  const d=Math.hypot(x2-x1,z2-z1),steps=Math.ceil(d/.5);\n  for(let i=1;i<steps;i++){const t=i/steps;if(!walkableAt(x1+(x2-x1)*t,z1+(z2-z1)*t))return false}\n  return true;\n}\nfunction findPath(sx,sz,tx,tz){\n  let [si,sj]=gi(sx,sz),[ti,tj]=gi(tx,tz);\n  if(blocked[ti*GRID+tj]){ // snap target to nearest open cell\n    outer:for(let r=1;r<8;r++)for(let di=-r;di<=r;di++)for(let dj=-r;dj<=r;dj++){\n      if(!blocked[(ti+di)*GRID+(tj+dj)]){ti+=di;tj+=dj;break outer}\n    }\n  }\n  if(blocked[si*GRID+sj]){outer2:for(let r=1;r<8;r++)for(let di=-r;di<=r;di++)for(let dj=-r;dj<=r;dj++){\n      if(!blocked[(si+di)*GRID+(sj+dj)]){si+=di;sj+=dj;break outer2}}}\n  const open=[[si,sj]],came=new Map(),gS=new Map([[si*GRID+sj,0]]);\n  const key=(i,j)=>i*GRID+j, H=(i,j)=>Math.hypot(ti-i,tj-j);\n  const openSet=new Set([key(si,sj)]);\n  let iter=0;\n  while(open.length&&iter++<6000){\n    let bi=0,bf=Infinity;\n    for(let k=0;k<open.length;k++){const [i,j]=open[k];const f=gS.get(key(i,j))+H(i,j);if(f<bf){bf=f;bi=k}}\n    const [ci,cj]=open.splice(bi,1)[0];openSet.delete(key(ci,cj));\n    if(ci===ti&&cj===tj){ // rebuild + smooth\n      const path=[];let k=key(ti,tj);\n      while(k!==undefined&&came.has(k)){path.unshift([k%GRID-HALF,Math.floor(k/GRID)-HALF]);k=came.get(k)}\n      path.unshift([sx,sz]);path.push([tx,tz]);\n      const sm=[path[0]];let a=0;\n      for(let b2=2;b2<path.length;b2++){if(!gridLOS(path[a][0],path[a][1],path[b2][0],path[b2][1])){sm.push(path[b2-1]);a=b2-1}}\n      sm.push(path[path.length-1]);return sm;\n    }\n    for(let di=-1;di<=1;di++)for(let dj=-1;dj<=1;dj++){\n      if(!di&&!dj)continue;\n      const ni=ci+di,nj=cj+dj;\n      if(ni<0||nj<0||ni>=GRID||nj>=GRID)continue;\n      if(blocked[ni*GRID+nj])continue;\n      if(di&&dj&&(blocked[(ci+di)*GRID+cj]||blocked[ci*GRID+cj+dj]))continue; // no corner cutting\n      const nk=key(ni,nj),ng=gS.get(key(ci,cj))+Math.hypot(di,dj);\n      if(gS.get(nk)===undefined||ng<gS.get(nk)){\n        gS.set(nk,ng);came.set(nk,key(ci,cj));\n        if(!openSet.has(nk)){open.push([ni,nj]);openSet.add(nk)}\n      }\n    }\n  }\n  return null;\n}\n\n/* ============================================================\n   PLAYER CONTROLS (custom — no PointerLockControls)\n============================================================ */\nconst P={x:0,y:0,z:46,vy:0,yaw:0,pitch:0,hp:100,r:.38};\nlet sens=1.4, locked=false, lockFailed=false, dragLook=false;\nlet state='lobby'; // lobby | playing | paused | ended\nconst keys={};\n// pointer-lock API (may be unavailable in sandboxed frames — game falls back to drag-look)\nconst RPL='request'+'Pointer'+'Lock', EPL='exit'+'Pointer'+'Lock', PLC='pointerlock'+'change', PLE='pointerlock'+'error', PLEL='pointerLock'+'Element';\nconst supportsLock=typeof canvas[RPL]==='function';\n\naddEventListener('keydown',e=>{\n  if(e.code==='Escape'){if(state==='playing')pauseGame();return}\n  keys[e.code]=true;\n  if(state!=='playing')return;\n  if(e.code==='KeyR')startReload();\n  if(e.code==='Digit1')switchWeapon('rifle');\n  if(e.code==='Digit2')switchWeapon('pistol');\n  if(e.code==='F3'){e.preventDefault();fpsEl.style.display=fpsEl.style.display==='none'?'block':'none'}\n});\naddEventListener('keyup',e=>keys[e.code]=false);\naddEventListener('blur',()=>{for(const k in keys)keys[k]=false;firing=false});\n\ncanvas.addEventListener('contextmenu',e=>e.preventDefault());\ncanvas.addEventListener('mousedown',e=>{\n  if(state!=='playing')return;\n  if(e.button===0)firing=true;\n  if(e.button===2)dragLook=true;\n  if(!locked&&!lockFailed)tryLock();\n});\naddEventListener('mouseup',e=>{if(e.button===0)firing=false;if(e.button===2)dragLook=false});\naddEventListener('mousemove',e=>{\n  if(state!=='playing')return;\n  if(locked||dragLook){\n    P.yaw-=e.movementX*.0022*sens;\n    P.pitch=THREE.MathUtils.clamp(P.pitch-e.movementY*.0022*sens,-Math.PI/2+.04,Math.PI/2-.04);\n  }\n});\nfunction tryLock(){\n  if(!supportsLock){lockFailed=true;return}\n  try{\n    const p=canvas[RPL].call(canvas);\n    if(p&&p.catch)p.catch(()=>{lockFailed=true;showHint('Mouse capture unavailable — hold RIGHT-CLICK and drag to aim')});\n  }catch(err){lockFailed=true;showHint('Mouse capture unavailable — hold RIGHT-CLICK and drag to aim')}\n}\nfunction onLockChange(){\n  locked=document[PLEL]===canvas;\n  if(!locked&&state==='playing')pauseGame();\n}\ndocument.addEventListener(PLC,onLockChange);\ndocument.addEventListener(PLE,()=>{lockFailed=true;showHint('Mouse capture unavailable — hold RIGHT-CLICK and drag to aim')});\n\n/* collision-aware movement */\nfunction circleHit(px,pz,s,r){\n  const cx=THREE.MathUtils.clamp(px,s.x0,s.x1),cz=THREE.MathUtils.clamp(pz,s.z0,s.z1);\n  return (px-cx)**2+(pz-cz)**2<r*r;\n}\nfunction overlapsPlayerVert(s,y,h){return s.y0<y+h&&s.y1>y}\nfunction tryMove(px,pz,dx,dz,r,y,h){\n  const steps=Math.max(1,Math.ceil((Math.abs(dx)+Math.abs(dz))/.25));\n  dx/=steps;dz/=steps;\n  for(let s=0;s<steps;s++){\n    let nx=px+dx;\n    if(dx!==0)for(const b of solids){if(!overlapsPlayerVert(b,y,h))continue;if(circleHit(nx,pz,b,r))nx=dx>0?b.x0-r:b.x1+r}\n    px=nx;\n    let nz=pz+dz;\n    if(dz!==0)for(const b of solids){if(!overlapsPlayerVert(b,y,h))continue;if(circleHit(px,nz,b,r))nz=dz>0?b.z0-r:b.z1+r}\n    pz=nz;\n  }\n  return [px,pz];\n}\n\n/* ============================================================\n   WEAPONS\n============================================================ */\nconst WEAPONS={\n  rifle:{name:'AR-9 CARBINE',mag:30,res:210,dmg:26,rate:.098,reload:1.8,auto:true,spread:.011,kick:.028},\n  pistol:{name:'M7 SIDEARM',mag:12,res:72,dmg:48,rate:.28,reload:1.2,auto:false,spread:.006,kick:.05},\n};\nlet cur='rifle';\nconst ammo={rifle:{...WEAPONS.rifle},pistol:{...WEAPONS.pistol}};\nlet firing=false,lastShot=0,reloading=0;\n\nconst gunGroup=new THREE.Group();camera.add(gunGroup);scene.add(camera);\nconst gunMat=new THREE.MeshStandardMaterial({color:0x24272c,roughness:.55,metalness:.25});\nconst gunMat2=new THREE.MeshStandardMaterial({color:0x17191d,roughness:.4,metalness:.4});\nlet gunParts=[];\nfunction buildViewModel(kind){\n  gunParts.forEach(m=>gunGroup.remove(m));gunParts=[];\n  const add=(w,h,d,x,y,z,m=gunMat)=>{const mm=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);mm.position.set(x,y,z);gunGroup.add(mm);gunParts.push(mm);return mm};\n  if(kind==='rifle'){\n    add(.09,.13,.62,.30,-.26,-.5);           // body\n    add(.05,.06,.34,.30,-.19,-.85,gunMat2);    // barrel shroud\n    add(.03,.03,.16,.30,-.185,-1.06,gunMat2);  // barrel\n    add(.07,.2,.1,.30,-.38,-.42,gunMat2);      // magazine\n    add(.08,.12,.26,.30,-.27,-.05);            // stock\n    add(.02,.05,.09,.30,-.16,-.62,gunMat2);    // front sight\n    add(.05,.05,.05,.30,-.15,-.28,gunMat2);    // rear sight\n  }else{\n    add(.07,.11,.3,.3,-.25,-.42);              // slide\n    add(.06,.14,.09,.3,-.33,-.3,gunMat2);      // grip\n    add(.05,.05,.14,.3,-.25,-.6,gunMat2);      // barrel\n  }\n  const flash=new THREE.Mesh(new THREE.SphereGeometry(.09,8,8),new THREE.MeshBasicMaterial({color:0xffd98a}));\n  flash.position.set(.3,-.21,kind==='rifle'?-1.16:-.68);flash.visible=false;gunGroup.add(flash);gunParts.push(flash);\n  gunFlash=flash;\n}\nlet gunFlash=null,gunKick=0,gunRaise=0;\nbuildViewModel('rifle');\n\nconst raycaster=new THREE.Raycaster();\nconst _dir=new THREE.Vector3(),_muz=new THREE.Vector3();\nfunction shoot(){\n  const w=WEAPONS[cur],a=ammo[cur],t=performance.now()/1000;\n  if(reloading>0||t-lastShot<w.rate)return;\n  if(a.mag<=0){startReload();return}\n  lastShot=t;a.mag--;gunKick=1;gunFlash.visible=true;setTimeout(()=>gunFlash.visible=false,45);\n  sfxShot(cur);\n  // apply current aim to the camera before raycasting (first frame / synchronous calls)\n  camera.rotation.set(P.pitch,P.yaw,0);\n  camera.updateMatrixWorld();\n  // convert angular spread (radians) to NDC offset for the raycaster\n  const ndcPerRad=1/Math.tan(camera.fov*0.5*Math.PI/180);\n  const sx=(Math.random()-.5)*2*w.spread*ndcPerRad;\n  const sy=(Math.random()-.5)*2*w.spread*ndcPerRad;\n  raycaster.setFromCamera({x:sx,y:sy},camera);\n  const targets=[...shootables];\n  for(const b of bots)if(b.alive&&!b.ally)targets.push(...b.hitParts);\n  const hits=raycaster.intersectObjects(targets,false);\n  if(hits.length){\n    const h=hits[0];\n    const bot=h.object.userData.bot;\n    if(bot&&bot.alive){\n      bot.hp-=w.dmg;bot.flash();\n      hitmark();sfxHit();\n      if(bot.hp<=0)killBot(bot,true);\n    }else{\n      spark(h.point);\n    }\n  }\n  updateHUD();\n}\nfunction startReload(){\n  const w=WEAPONS[cur],a=ammo[cur];\n  if(reloading>0||a.mag>=w.mag||a.res<=0)return;\n  reloading=w.reload;sfxReload();\n}\nfunction switchWeapon(k){\n  if(cur===k||reloading>0)return;\n  cur=k;gunRaise=1;buildViewModel(k);updateHUD();\n}\n\n/* ============================================================\n   SOLDIERS (bots)\n============================================================ */\nconst bots=[];\nconst skinM=new THREE.MeshStandardMaterial({color:0xd8a878,roughness:.8});\nfunction makeBot(ally){\n  const g=new THREE.Group();\n  const shirt=new THREE.MeshStandardMaterial({color:ally?0x3c5a3e:0x6e3b30,roughness:.85});\n  const pants=new THREE.MeshStandardMaterial({color:ally?0x39413a:0x463c33,roughness:.85});\n  const helm=new THREE.MeshStandardMaterial({color:ally?0x31402f:0x3d4136,roughness:.7});\n  const vestM=new THREE.MeshStandardMaterial({color:0x2c3136,roughness:.8});\n  const mk=(geo,mat,x,y,z,parent=g)=>{const m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.castShadow=true;parent.add(m);return m};\n  const hitParts=[];\n  const torso=mk(new THREE.BoxGeometry(.6,.72,.32),shirt,0,1.32,0);\n  const vest=mk(new THREE.BoxGeometry(.66,.46,.4),vestM,0,1.36,0);\n  const head=mk(new THREE.SphereGeometry(.2,14,10),skinM,0,1.9,0);\n  const helmet=mk(new THREE.SphereGeometry(.24,14,10,0,Math.PI*2,0,Math.PI*.6),helm,0,1.96,0);\n  mk(new THREE.BoxGeometry(.32,.05,.16),helm,0,1.9,-.18);      // helmet brim\n  const legL=mk(new THREE.BoxGeometry(.19,.82,.21),pants,-.15,.42,0);\n  const legR=mk(new THREE.BoxGeometry(.19,.82,.21),pants,.15,.42,0);\n  const armL=mk(new THREE.BoxGeometry(.14,.58,.16),shirt,-.38,1.32,0);\n  const armR=mk(new THREE.BoxGeometry(.14,.58,.16),shirt,.38,1.32,0);\n  mk(new THREE.BoxGeometry(.16,.1,.24),pants,-.15,.05,.02);    // boots\n  mk(new THREE.BoxGeometry(.16,.1,.24),pants,.15,.05,.02);\n  // rifle\n  const rifle=new THREE.Group();rifle.position.set(.32,1.34,-.3);g.add(rifle);\n  const rb=new THREE.Mesh(new THREE.BoxGeometry(.08,.12,.7),gunMat);rifle.add(rb);\n  const rl=new THREE.Mesh(new THREE.BoxGeometry(.035,.035,.3),gunMat2);rl.position.z=-.48;rifle.add(rl);\n  const rm=new THREE.Mesh(new THREE.BoxGeometry(.06,.18,.09),gunMat2);rm.position.set(0,-.14,.06);rifle.add(rm);\n  const muzFlash=new THREE.Mesh(new THREE.SphereGeometry(.08,6,6),new THREE.MeshBasicMaterial({color:0xffd98a}));\n  muzFlash.position.z=-.66;muzFlash.visible=false;rifle.add(muzFlash);\n  // health bar\n  const bar=new THREE.Sprite(new THREE.SpriteMaterial({color:ally?0x7dff8e:0xff5d5d}));\n  bar.scale.set(1,.09,1);bar.position.y=2.5;g.add(bar);\n  scene.add(g);\n  hitParts.push(torso,vest,head,helmet,legL,legR,armL,armR);\n  const bot={mesh:g,hp:100,ally,alive:true,bar,muzFlash,legL,legR,rifle,hitParts,\n    cool:1+Math.random()*2,walk:0,path:null,pathI:0,repath:0,speed:2.6+Math.random()*.8,\n    flash(){this.bar.scale.x=Math.max(.06,1*this.hp/100);this.bar.material.opacity=1}};\n  hitParts.forEach(m=>m.userData.bot=bot);\n  bots.push(bot);\n  return bot;\n}\nfunction killBot(bot,byPlayer){\n  bot.alive=false;scene.remove(bot.mesh);\n  if(byPlayer){score+=150;kills++;feed('HOSTILE ELIMINATED  +150');sfxKill()}\n  else feed('SQUAD MATE DOWN');\n  updateHUD();\n}\n\n/* spawn points */\nconst enemySpawns=[[-44,-44],[44,-44],[-10,-34],[30,-30],[-34,-8],[40,0],[0,-30],[18,-42],[-44,20],[46,26],[24,44],[-20,-46]];\nconst allySpawns=[[-8,40],[8,40],[-15,36],[15,36]];\nlet enemyTotal=0;\n\n/* ============================================================\n   BOT AI\n============================================================ */\nconst _v1=new THREE.Vector3(),_v2=new THREE.Vector3();\nfunction hasLOS(fromX,fromY,fromZ,tx,ty,tz){\n  _v1.set(fromX,fromY,fromZ);_v2.set(tx-fromX,ty-fromY,tz-fromZ);\n  const d=_v2.length();_v2.normalize();\n  raycaster.set(_v1,_v2);raycaster.far=d-.5;\n  const hits=raycaster.intersectObjects(shootables,false);\n  raycaster.far=Infinity;\n  return hits.length===0;\n}\nfunction botUpdate(b,dt){\n  if(!b.alive)return;\n  // pick target\n  let tx,tz,ty=1.6,tEnemy=null;\n  if(b.ally){\n    let best=null,bd=1e9;\n    for(const e of bots)if(e.alive&&!e.ally){const d=(e.mesh.position.x-P.x)**2+(e.mesh.position.z-P.z)**2;if(d<bd){bd=d;best=e}}\n    if(best){tEnemy=best;tx=best.mesh.position.x;tz=best.mesh.position.z}\n    else{tx=P.x;tz=P.z}\n  }else{\n    tx=P.x;tz=P.z;\n  }\n  const bx=b.mesh.position.x,bz=b.mesh.position.z;\n  const dist=Math.hypot(tx-bx,tz-bz);\n  const los=hasLOS(bx,1.6,bz,tx,ty,tz);\n  let moving=false;\n  const engage=b.ally?(dist<42&&los):(dist<38&&los);\n  if(engage){\n    // face target + fire\n    b.mesh.rotation.y=Math.atan2(tx-bx,tz-bz);\n    b.cool-=dt;\n    if(b.cool<=0){\n      b.cool=(b.ally?1.3:1.05)/diff+(Math.random()*.6);\n      b.muzFlash.visible=true;setTimeout(()=>b.muzFlash.visible=false,60);\n      if(b.ally&&tEnemy){\n        tEnemy.hp-=16+Math.random()*10;tEnemy.flash();\n        if(tEnemy.hp<=0){killBot(tEnemy,false);score+=75;feed('SQUAD KILL  +75',true)}\n      }else if(!b.ally){\n        const acc=Math.min(.75,.3*diff);\n        if(Math.random()<acc){P.hp-=(6+Math.random()*6)*diff;lastHurt=performance.now();damageFlash();sfxHurt();updateHUD();\n          if(P.hp<=0&&state==='playing')endGame(false)}\n      }\n    }\n  }else{\n    // path toward target\n    b.repath-=dt;\n    if(b.repath<=0||!b.path){b.repath=1.6+Math.random();b.path=findPath(bx,bz,tx,tz);b.pathI=0}\n    if(b.path&&b.pathI<b.path.length){\n      const wp=b.path[b.pathI];\n      const dx=wp[0]-bx,dz=wp[1]-bz,dd=Math.hypot(dx,dz);\n      if(dd<1)b.pathI++;\n      else{\n        const sp=b.speed*dt;\n        const [nx,nz]=tryMove(bx,bz,dx/dd*sp,dz/dd*sp,.42,0,1.8);\n        b.mesh.position.x=nx;b.mesh.position.z=nz;\n        b.mesh.rotation.y=Math.atan2(dx,dz);\n        moving=true;\n      }\n    }\n  }\n  // walk anim\n  b.walk+=moving?.16:0;\n  const s=moving?Math.sin(b.walk)*.5:0;\n  b.legL.rotation.x=s;b.legR.rotation.x=-s;\n}\n\n/* ============================================================\n   FX (sparks)\n============================================================ */\nconst sparks=[];\nfunction spark(p){\n  for(let i=0;i<4;i++){\n    const m=new THREE.Mesh(new THREE.BoxGeometry(.05,.05,.05),new THREE.MeshBasicMaterial({color:0xffca7a}));\n    m.position.copy(p);scene.add(m);\n    sparks.push({m,v:new THREE.Vector3((Math.random()-.5)*4,Math.random()*3,(Math.random()-.5)*4),t:.4});\n  }\n}\nfunction updateSparks(dt){\n  for(let i=sparks.length-1;i>=0;i--){\n    const s=sparks[i];s.t-=dt;s.v.y-=9*dt;\n    s.m.position.addScaledVector(s.v,dt);\n    if(s.t<=0){scene.remove(s.m);s.m.geometry.dispose();sparks.splice(i,1)}\n  }\n}\n\n/* ============================================================\n   AUDIO (procedural WebAudio)\n============================================================ */\nlet AC=null,master=null;\nfunction initAudio(){\n  if(AC)return;\n  try{\n    AC=new (window.AudioContext||window.webkitAudioContext)();\n    master=AC.createGain();master.gain.value=.5;master.connect(AC.destination);\n    // ambient wind\n    const buf=AC.createBuffer(1,AC.sampleRate*2,AC.sampleRate);\n    const d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=(Math.random()*2-1)*.4;\n    const src=AC.createBufferSource();src.buffer=buf;src.loop=true;\n    const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=380;\n    const g=AC.createGain();g.gain.value=.05;\n    src.connect(f).connect(g).connect(master);src.start();\n  }catch(e){}\n}\nfunction env(g,a,dur){g.gain.setValueAtTime(a,AC.currentTime);g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+dur)}\nfunction sfxShot(kind){\n  if(!AC)return;const t=AC.currentTime;\n  const o=AC.createOscillator(),g=AC.createGain();o.type='square';\n  o.frequency.setValueAtTime(kind==='rifle'?190:150,t);o.frequency.exponentialRampToValueAtTime(45,t+.12);\n  env(g,.22,.13);o.connect(g).connect(master);o.start(t);o.stop(t+.14);\n  const n=AC.createBufferSource();const b=AC.createBuffer(1,AC.sampleRate*.1,AC.sampleRate);\n  const dd=b.getChannelData(0);for(let i=0;i<dd.length;i++)dd[i]=(Math.random()*2-1)*(1-i/dd.length);\n  n.buffer=b;const ng=AC.createGain();env(ng,.18,.1);n.connect(ng).connect(master);n.start(t);\n}\nfunction sfxHit(){if(!AC)return;const t=AC.currentTime;const o=AC.createOscillator(),g=AC.createGain();\n  o.type='sine';o.frequency.setValueAtTime(1250,t);o.frequency.exponentialRampToValueAtTime(900,t+.07);\n  env(g,.14,.07);o.connect(g).connect(master);o.start(t);o.stop(t+.08)}\nfunction sfxKill(){if(!AC)return;const t=AC.currentTime;[520,780,1040].forEach((f,i)=>{const o=AC.createOscillator(),g=AC.createGain();\n  o.type='sine';o.frequency.value=f;env(g,.12,.18);o.connect(g).connect(master);o.start(t+i*.07);o.stop(t+i*.07+.2)})}\nfunction sfxHurt(){if(!AC)return;const t=AC.currentTime;const o=AC.createOscillator(),g=AC.createGain();\n  o.type='sawtooth';o.frequency.setValueAtTime(110,t);o.frequency.exponentialRampToValueAtTime(55,t+.18);\n  env(g,.25,.2);o.connect(g).connect(master);o.start(t);o.stop(t+.22)}\nfunction sfxReload(){if(!AC)return;const t=AC.currentTime;[0,.35,.7].forEach((d,i)=>{const o=AC.createOscillator(),g=AC.createGain();\n  o.type='square';o.frequency.value=300+i*120;env(g,.06,.06);o.connect(g).connect(master);o.start(t+d);o.stop(t+d+.08)})}\n\n/* ============================================================\n   HUD\n============================================================ */\nconst $=id=>document.getElementById(id);\nconst hpfill=$('hpfill'),hpwrap=$('hpwrap'),dmgEl=$('dmg');\nlet score=0,kills=0,startTime=0,lastHurt=0;\nfunction updateHUD(){\n  const a=ammo[cur];\n  $('anum').textContent=a.mag;$('ares').textContent=' / '+a.res;\n  $('wname').textContent=WEAPONS[cur].name;\n  $('score').textContent=score;\n  $('allyCount').textContent=bots.filter(b=>b.alive&&b.ally).length;\n  $('enemyCount').textContent=bots.filter(b=>b.alive&&!b.ally).length;\n  hpfill.style.width=Math.max(0,P.hp)+'%';\n  hpwrap.classList.toggle('low',P.hp<35);\n}\nfunction hitmark(){const h=$('hitmark');h.style.opacity=1;setTimeout(()=>h.style.opacity=0,110)}\nfunction feed(t,ally){const f=$('feed'),d=document.createElement('div');d.textContent=t;if(ally)d.className='ally';\n  f.prepend(d);setTimeout(()=>d.remove(),3000)}\nfunction damageFlash(){dmgEl.style.opacity=.85;setTimeout(()=>dmgEl.style.opacity=0,180)}\nfunction showHint(t){const h=$('hint');h.textContent=t;h.style.opacity=1;setTimeout(()=>h.style.opacity=0,5000)}\n\n/* minimap */\nconst mm=$('minimap').getContext('2d');\nfunction drawMinimap(){\n  mm.clearRect(0,0,160,160);\n  mm.fillStyle='rgba(18,24,28,.9)';mm.fillRect(0,0,160,160);\n  const S=160/124; // world -62..62\n  const px=x=>(x+62)*S,pz=z=>(z+62)*S;\n  mm.fillStyle='rgba(150,160,168,.5)';\n  for(const b of [[-28,-18,20,14],[28,20,20,14],[2,-42,16,11],[-32,36,14,12]])\n    mm.fillRect(px(b[0]-b[2]/2),pz(b[1]-b[3]/2),b[2]*S,b[3]*S);\n  for(const b of bots){\n    if(!b.alive)continue;\n    mm.fillStyle=b.ally?'#7dff8e':'#ff5d5d';\n    mm.beginPath();mm.arc(px(b.mesh.position.x),pz(b.mesh.position.z),3,0,7);mm.fill();\n  }\n  // player arrow\n  mm.save();mm.translate(px(P.x),pz(P.z));mm.rotate(-P.yaw+Math.PI);\n  mm.fillStyle='#ffb648';mm.beginPath();mm.moveTo(0,-6);mm.lineTo(4,4);mm.lineTo(-4,4);mm.closePath();mm.fill();\n  mm.restore();\n}\n\n/* debug overlay */\nconst fpsEl=$('fps');let fpsFrames=0,fpsLast=performance.now();\nfunction updateFPS(){\n  fpsFrames++;const n=performance.now();\n  if(n-fpsLast>=1000){\n    const fps=fpsFrames*1000/(n-fpsLast);\n    const i=renderer.info;\n    fpsEl.textContent=`FPS ${fps.toFixed(0)}  Draw ${i.render.calls}  Tri ${(i.render.triangles/1000).toFixed(0)}k`;\n    fpsFrames=0;fpsLast=n;\n  }\n}\n\n/* ============================================================\n   GAME FLOW\n============================================================ */\nlet diff=1;\nfunction startGame(){\n  // reset player\n  P.x=0;P.z=46;P.y=0;P.vy=0;P.yaw=0;P.pitch=0;P.hp=100;\n  score=0;kills=0;firing=false;reloading=0;cur='rifle';\n  ammo.rifle={...WEAPONS.rifle};ammo.pistol={...WEAPONS.pistol};\n  buildViewModel('rifle');\n  // clear bots\n  for(const b of bots)scene.remove(b.mesh);\n  bots.length=0;\n  enemySpawns.slice(0,enemyCount).forEach(([x,z])=>{const b=makeBot(false);b.mesh.position.set(x,0,z)});\n  allySpawns.slice(0,allyCount).forEach(([x,z])=>{const b=makeBot(true);b.mesh.position.set(x,0,z)});\n  enemyTotal=enemyCount;\n  startTime=performance.now();\n  state='playing';\n  $('lobby').classList.add('hidden');$('pause').classList.add('hidden');$('end').classList.add('hidden');\n  $('hud').style.display='block';\n  $('feed').innerHTML='';\n  updateHUD();\n  tryLock();\n}\nfunction pauseGame(){\n  if(state!=='playing')return;\n  state='paused';firing=false;\n  $('pause').classList.remove('hidden');\n  if(document[PLEL])document[EPL].call(document);\n}\nfunction resumeGame(){\n  state='playing';$('pause').classList.add('hidden');tryLock();\n}\nfunction endGame(win){\n  state='ended';firing=false;\n  if(document[PLEL])document[EPL].call(document);\n  $('endTitle').textContent=win?'MISSION COMPLETE':'MISSION FAILED';\n  $('endTitle').style.color=win?'#7dff8e':'#ff5d5d';\n  const t=Math.floor((performance.now()-startTime)/1000);\n  $('endStats').innerHTML=`Score <b>${score}</b> &nbsp;·&nbsp; Kills <b>${kills}</b> &nbsp;·&nbsp; Time <b>${Math.floor(t/60)}:${String(t%60).padStart(2,'0')}</b><br>Hostiles remaining <b>${bots.filter(b=>b.alive&&!b.ally).length}</b>`;\n  $('end').classList.remove('hidden');\n}\n\n/* lobby controls */\nlet enemyCount=6,allyCount=3;\n$('enRange').addEventListener('input',e=>{enemyCount=+e.target.value;$('enLbl').textContent=enemyCount});\n$('alRange').addEventListener('input',e=>{allyCount=+e.target.value;$('alLbl').textContent=allyCount});\n$('sens').addEventListener('input',e=>{sens=+e.target.value});\n$('diffSeg').addEventListener('click',e=>{\n  if(e.target.tagName!=='BUTTON')return;\n  $('diffSeg').querySelectorAll('button').forEach(b=>b.classList.remove('on'));\n  e.target.classList.add('on');diff=+e.target.dataset.v;\n});\n$('deploy').addEventListener('click',()=>{initAudio();startGame()});\n$('resume').addEventListener('click',resumeGame);\n$('restart1').addEventListener('click',startGame);\n$('restart2').addEventListener('click',startGame);\n\n/* ============================================================\n   MAIN LOOP\n============================================================ */\nconst clock=new THREE.Clock();\nlet bob=0;\nfunction animate(){\n  requestAnimationFrame(animate);\n  const dt=Math.min(clock.getDelta(),.08);\n  renderer.info.reset();\n  updateFPS();\n\n  if(state==='lobby'){\n    // orbiting backdrop camera\n    const t=performance.now()*.00008;\n    camera.position.set(Math.cos(t)*52,26,Math.sin(t)*52);\n    camera.lookAt(0,2,-6);\n  }\n\n  gunGroup.visible=(state==='playing');\n  if(state==='playing'){\n    /* --- movement --- */\n    let f=(keys.KeyW?1:0)-(keys.KeyS?1:0);\n    let s=(keys.KeyD?1:0)-(keys.KeyA?1:0);\n    const len=Math.hypot(f,s)||1;f/=len;s/=len;\n    const sprint=keys.ShiftLeft||keys.ShiftRight;\n    const dist=(sprint?8.2:5.4)*dt;\n    const dx=(s*Math.cos(P.yaw)-f*Math.sin(P.yaw))*dist;\n    const dz=(-s*Math.sin(P.yaw)-f*Math.cos(P.yaw))*dist;\n    [P.x,P.z]=tryMove(P.x,P.z,dx,dz,P.r,P.y,1.75);\n    const movingNow=(f||s);\n    if(movingNow)bob+=dt*(sprint?11:8);\n    /* jump */\n    if(keys.Space&&P.y<=0.001)P.vy=6.4;\n    P.vy-=17*dt;P.y=Math.max(0,P.y+P.vy*dt);if(P.y===0)P.vy=Math.max(0,P.vy);\n    /* camera */\n    const bobY=movingNow?Math.sin(bob)*.03:0;\n    camera.position.set(P.x,P.y+1.66+bobY,P.z);\n    camera.rotation.set(P.pitch,P.yaw,0);\n    /* weapon view model */\n    gunKick=Math.max(0,gunKick-dt*9);\n    gunRaise=Math.max(0,gunRaise-dt*4);\n    gunGroup.position.set(\n      Math.sin(bob*.5)*.006,\n      -gunRaise*.3+Math.cos(bob)*.006+gunKick*.03,\n      gunKick*.09);\n    gunGroup.rotation.x=gunKick*.1;\n    /* fire */\n    if(firing&&WEAPONS[cur].auto)shoot();\n    /* reload timer */\n    if(reloading>0){\n      reloading-=dt;\n      $('reload').style.opacity=1;\n      if(reloading<=0){\n        reloading=0;$('reload').style.opacity=0;\n        const w=WEAPONS[cur],a=ammo[cur];\n        const take=Math.min(w.mag-a.mag,a.res);a.mag+=take;a.res-=take;updateHUD();\n      }\n    }\n    /* health regen */\n    if(P.hp<100&&performance.now()-lastHurt>5000){P.hp=Math.min(100,P.hp+7*dt);updateHUD()}\n    /* bots */\n    for(const b of bots)botUpdate(b,dt);\n    /* win check */\n    if(!bots.some(b=>b.alive&&!b.ally))endGame(true);\n    /* timer */\n    const t=Math.floor((performance.now()-startTime)/1000);\n    $('time').textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');\n    drawMinimap();\n  }\n\n  updateSparks(dt);\n  renderer.render(scene,camera);\n}\nanimate();\nwindow.__ready=true;\n</script>\n<script>\n// show a clear error if the 3D engine fails to load from CDN\nsetTimeout(()=>{if(!window.__ready)document.getElementById('loadErr').style.display='flex'},8000);\n</script>\n</body>\n</html>"
    }
  ]
}