    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>STRIKE OPS 3 — Lobby Edition</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box}\n  body{overflow:hidden;background:#04070b;color:#e9eff4;font-family:Inter,Arial,sans-serif}\n  canvas{display:block}\n\n  .overlay{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#070c12,#101a23 60%,#05080c)}\n  .lobby{width:min(1120px,96vw);height:min(720px,94vh);display:flex;background:#0b1218;border:1px solid #26323e;border-radius:18px;overflow:hidden;box-shadow:0 40px 120px #000}\n  .side{width:250px;background:#080e14;border-right:1px solid #222d38;padding:22px 16px;display:flex;flex-direction:column;gap:8px}\n  .logo{font-size:27px;font-weight:900;color:#ffcc33;letter-spacing:3px;margin-bottom:18px}\n  .nav{padding:12px 14px;border-radius:10px;background:#111a23;color:#a9b8c4;cursor:pointer;border:1px solid transparent;font-weight:700}\n  .nav.active{background:#17232e;color:#fff;border-color:#33465a}\n  .spacer{flex:1}\n  .playerCard{background:#111a23;border:1px solid #26323e;border-radius:12px;padding:12px}\n  .credits{color:#ffcc33;font-weight:900;font-size:20px}\n\n  .main{flex:1;padding:26px;overflow:auto}\n  .tab{display:none}\n  .tab.active{display:block}\n  h1{font-size:30px;letter-spacing:2px}\n  h2{color:#ffcc33;margin:18px 0 10px;font-size:18px}\n  p.muted{color:#93a4b1;font-size:13.5px;margin-top:5px}\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:13px;margin-top:12px}\n  .card{background:#111a23;border:1px solid #26323e;border-radius:13px;padding:15px}\n  .card h3{font-size:16px}\n  .card p{font-size:12.5px;color:#9cadba;margin:6px 0 10px}\n  .row{display:flex;gap:8px;justify-content:space-between;align-items:center}\n  .tag{font-size:11px;color:#8dffb0;background:#12251a;border:1px solid #234a33;padding:3px 7px;border-radius:6px}\n  .tag.blue{color:#8fc4ff;background:#101f30;border-color:#264563}\n  button{border:none;border-radius:8px;padding:9px 13px;font-weight:800;cursor:pointer;background:#8dffb0;color:#06120b;transition:.15s}\n  button:hover:not(:disabled){transform:translateY(-1px)}\n  button:disabled{opacity:.4;cursor:not-allowed}\n  button.ghost{background:#212e3b;color:#dce6ee}\n  button.gold{background:#ffcc33;color:#231a03}\n  .deploy{width:100%;margin-top:22px;padding:16px;font-size:17px;letter-spacing:1px}\n  .selected{outline:2px solid #ffcc33;outline-offset:-2px}\n\n  #hud{position:fixed;inset:0;z-index:10;pointer-events:none;display:none}\n  #crosshair{position:absolute;left:50%;top:50%;width:30px;height:30px;transform:translate(-50%,-50%)}\n  #crosshair i{position:absolute;background:#8dffb0;box-shadow:0 0 2px #000}\n  #crosshair i:nth-child(1){left:14px;top:0;width:2px;height:9px}\n  #crosshair i:nth-child(2){left:14px;bottom:0;width:2px;height:9px}\n  #crosshair i:nth-child(3){top:14px;left:0;width:9px;height:2px}\n  #crosshair i:nth-child(4){top:14px;right:0;width:9px;height:2px}\n  .box{position:absolute;background:rgba(5,9,13,.7);border:1px solid #2b3743;border-radius:10px;padding:10px 14px}\n  #top{left:50%;top:15px;transform:translateX(-50%);font-size:14px}\n  #cash{right:22px;top:15px;color:#ffcc33;font-weight:900}\n  #hp{left:22px;bottom:22px;width:280px}\n  #ar{left:22px;bottom:82px;width:280px}\n  .bar{height:8px;background:#202a34;border-radius:5px;overflow:hidden;margin-top:5px}\n  .fill{height:100%;width:100%;transition:.12s}\n  #hpf{background:linear-gradient(90deg,#37d067,#8dffb0)}\n  #arf{background:linear-gradient(90deg,#3f8cff,#8fc4ff)}\n  #gun{right:22px;bottom:22px;text-align:right}\n  #ammo{font-size:32px;font-weight:900;color:#ffcc33}\n  #gunname{font-size:12px;color:#9cadba}\n  #mods{font-size:11px;color:#8dffb0;margin-top:3px}\n  #map{position:absolute;right:22px;top:58px;width:190px;height:190px;background:rgba(4,8,12,.72);border:1px solid #2b3743;border-radius:10px}\n  #feed{position:absolute;right:22px;top:265px;width:300px;font-size:12px;text-align:right}\n  .feed{background:rgba(5,9,13,.72);border-right:3px solid #ff5d5d;padding:6px 9px;margin-bottom:5px;border-radius:5px}\n  #hit{position:absolute;left:50%;top:50%;width:36px;height:36px;transform:translate(-50%,-50%) rotate(45deg);opacity:0}\n  #hit b{position:absolute;width:13px;height:2px;background:#fff}\n  #hit b:nth-child(1){left:0;top:0}\n  #hit b:nth-child(2){right:0;top:0;transform:rotate(90deg)}\n  #hit b:nth-child(3){left:0;bottom:0}\n  #hit b:nth-child(4){right:0;bottom:0;transform:rotate(90deg)}\n  #dmg{position:absolute;inset:0;background:radial-gradient(circle,transparent 38%,rgba(220,25,25,.55));opacity:0;transition:.2s}\n  #interact{position:absolute;left:50%;bottom:130px;transform:translateX(-50%);background:rgba(5,9,13,.75);padding:8px 14px;border-radius:8px;font-size:13px;display:none}\n</style>\n</head>\n<body>\n\n<div id=\"hud\">\n  <div id=\"crosshair\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hit\"><b></b><b></b><b></b><b></b></div>\n  <div id=\"dmg\"></div>\n  <div class=\"box\" id=\"top\">MAP <span id=\"mapName\">DUST DISTRICT</span> • ROUND <span id=\"round\">1</span> • HOSTILES <span id=\"left\">0</span> • SCORE <span id=\"score\">0</span></div>\n  <div class=\"box\" id=\"cash\">CR <span id=\"hudCredits\">0</span></div>\n  <div class=\"box\" id=\"hp\"><div style=\"font-size:11px;color:#9cadba\">HEALTH</div><div class=\"bar\"><div class=\"fill\" id=\"hpf\"></div></div></div>\n  <div class=\"box\" id=\"ar\"><div style=\"font-size:11px;color:#9cadba\">ARMOR</div><div class=\"bar\"><div class=\"fill\" id=\"arf\"></div></div></div>\n  <div class=\"box\" id=\"gun\"><div id=\"ammo\">30</div><div id=\"gunname\">PHANTOM-7</div><div id=\"mods\">No attachments</div></div>\n  <canvas id=\"map\" width=\"190\" height=\"190\"></canvas>\n  <div id=\"feed\"></div>\n  <div id=\"interact\">Press <b>E</b> to enter building</div>\n</div>\n\n<div class=\"overlay\" id=\"lobby\">\n  <div class=\"lobby\">\n    <div class=\"side\">\n      <div class=\"logo\">STRIKE OPS 3</div>\n      <div class=\"nav active\" data-tab=\"deploy\">DEPLOY</div>\n      <div class=\"nav\" data-tab=\"maps\">MAPS</div>\n      <div class=\"nav\" data-tab=\"operators\">OPERATORS</div>\n      <div class=\"nav\" data-tab=\"loadout\">LOADOUT</div>\n      <div class=\"nav\" data-tab=\"store\">STORE</div>\n      <div class=\"spacer\"></div>\n      <div class=\"playerCard\">\n        <div style=\"font-size:11px;color:#93a4b1\">CREDITS</div>\n        <div class=\"credits\">CR <span id=\"lobbyCredits\">0</span></div>\n        <div style=\"font-size:11px;color:#93a4b1;margin-top:8px\" id=\"saveInfo\"></div>\n      </div>\n    </div>\n\n    <div class=\"main\">\n      <div class=\"tab active\" id=\"tab-deploy\">\n        <h1>Ready to Deploy</h1>\n        <p class=\"muted\">Select a map, operator, and weapons. Your progress saves automatically.</p>\n        <div class=\"grid\" id=\"deploySummary\"></div>\n        <button class=\"deploy gold\" id=\"deployBtn\">ENTER MATCH</button>\n      </div>\n\n      <div class=\"tab\" id=\"tab-maps\">\n        <h1>Select Map</h1>\n        <div class=\"grid\" id=\"mapList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-operators\">\n        <h1>Operator Skins</h1>\n        <p class=\"muted\">Operator skins change uniform camouflage, vest color, helmet, and gear accents.</p>\n        <div class=\"grid\" id=\"operatorList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-loadout\">\n        <h1>Loadout</h1>\n        <div class=\"grid\" id=\"loadoutList\"></div>\n        <h2>Attachments</h2>\n        <div class=\"grid\" id=\"attachmentList\"></div>\n      </div>\n\n      <div class=\"tab\" id=\"tab-store\">\n        <h1>Store</h1>\n        <p class=\"muted\">Earn credits from eliminations, headshots, and completed rounds.</p>\n        <h2>Weapon Skins</h2>\n        <div class=\"grid\" id=\"skinList\"></div>\n        <h2>Attachments</h2>\n        <div class=\"grid\" id=\"storeAttachments\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"overlay\" id=\"end\" style=\"display:none\">\n  <div class=\"lobby\" style=\"width:min(620px,94vw);height:auto;display:block;padding:34px;text-align:center\">\n    <h1 id=\"endTitle\">ROUND SECURED</h1>\n    <p class=\"muted\" id=\"endText\"></p>\n    <button class=\"deploy gold\" id=\"continueBtn\">RETURN TO LOBBY</button>\n  </div>\n</div>\n\n<script type=\"importmap\">\n{\"imports\":{\n  \"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\n  \"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"\n}}\n</script>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';\n\n/* ============ Save ============ */\nconst DEFAULT_SAVE={\n  credits:750, ownedSkins:['default'], equippedSkin:'default',\n  ownedOperators:['ranger'], equippedOperator:'ranger',\n  ownedMods:[], installedMods:{rifle:[],pistol:[]},\n  selectedWeapons:['rifle','pistol'], selectedMap:'dust'\n};\nconst save=Object.assign({},DEFAULT_SAVE,JSON.parse(localStorage.getItem('strikeOps3')||'{}'));\nconst persist=()=>localStorage.setItem('strikeOps3',JSON.stringify(save));\n\n/* ============ Renderer ============ */\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(76,innerWidth/innerHeight,.08,500);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.08;\ndocument.body.appendChild(renderer.domElement);\n\nconst controls=new PointerLockControls(camera,renderer.domElement);\ncamera.position.set(0,1.72,48);\n\n/* ============ Procedural textures ============ */\nfunction canvasTexture(draw,size=256,repeat=[1,1]){\n  const c=document.createElement('canvas'); c.width=c.height=size;\n  draw(c.getContext('2d'),size);\n  const t=new THREE.CanvasTexture(c);\n  t.wrapS=t.wrapT=THREE.RepeatWrapping;\n  t.repeat.set(...repeat);\n  t.anisotropy=renderer.capabilities.getMaxAnisotropy();\n  t.needsUpdate=true;\n  return t;\n}\nfunction noise(g,s,alpha,n=5000){\n  for(let i=0;i<n;i++){\n    g.fillStyle=`rgba(${Math.random()<.5?0:255},${Math.random()<.5?0:255},${Math.random()<.5?0:255},${alpha})`;\n    g.fillRect(Math.random()*s,Math.random()*s,Math.random()*3+1,Math.random()*3+1);\n  }\n}\nconst TEX={\n  concrete:canvasTexture((g,s)=>{\n    g.fillStyle='#8f8b83';g.fillRect(0,0,s,s);noise(g,s,.06,7000);\n    g.strokeStyle='rgba(0,0,0,.18)';g.lineWidth=2;\n    for(let i=0;i<6;i++){g.beginPath();g.moveTo(0,Math.random()*s);g.lineTo(s,Math.random()*s);g.stroke();}\n  },256,[6,6]),\n  plaster:canvasTexture((g,s)=>{\n    g.fillStyle='#c9b691';g.fillRect(0,0,s,s);noise(g,s,.05,6500);\n    g.fillStyle='rgba(120,95,60,.18)';\n    for(let i=0;i<35;i++)g.fillRect(Math.random()*s,Math.random()*s,Math.random()*25+5,Math.random()*8+2);\n  },256,[5,5]),\n  brick:canvasTexture((g,s)=>{\n    g.fillStyle='#7d6a55';g.fillRect(0,0,s,s);\n    g.fillStyle='#93765c';\n    for(let y=0;y<s;y+=32)for(let x=(y/32%2)*32;x<s;x+=64)g.fillRect(x+2,y+2,60,28);\n    noise(g,s,.07,4500);\n  },256,[5,5]),\n  wood:canvasTexture((g,s)=>{\n    g.fillStyle='#7b5a34';g.fillRect(0,0,s,s);\n    for(let i=0;i<70;i++){\n      g.strokeStyle=`rgba(45,28,12,${Math.random()*.25+.08})`;\n      g.lineWidth=Math.random()*3+1;g.beginPath();\n      g.moveTo(0,Math.random()*s);g.bezierCurveTo(s/3,Math.random()*s,s*.66,Math.random()*s,s,Math.random()*s);g.stroke();\n    }\n  },256,[4,4]),\n  metal:canvasTexture((g,s)=>{\n    g.fillStyle='#5d6873';g.fillRect(0,0,s,s);\n    for(let i=0;i<180;i++){\n      g.strokeStyle=`rgba(255,255,255,${Math.random()*.08})`;\n      g.beginPath();g.moveTo(Math.random()*s,0);g.lineTo(Math.random()*s,s);g.stroke();\n    }\n    noise(g,s,.05,3000);\n  },256,[3,3]),\n  tile:canvasTexture((g,s)=>{\n    g.fillStyle='#535a60';g.fillRect(0,0,s,s);\n    g.strokeStyle='rgba(0,0,0,.35)';g.lineWidth=3;\n    for(let i=0;i<=s;i+=64){g.beginPath();g.moveTo(i,0);g.lineTo(i,s);g.stroke();g.beginPath();g.moveTo(0,i);g.lineTo(s,i);g.stroke();}\n    noise(g,s,.05,3500);\n  },256,[8,8]),\n  asphalt:canvasTexture((g,s)=>{\n    g.fillStyle='#4b4f53';g.fillRect(0,0,s,s);noise(g,s,.08,9000);\n  },256,[14,14]),\n  sand:canvasTexture((g,s)=>{\n    g.fillStyle='#c3a878';g.fillRect(0,0,s,s);noise(g,s,.07,10000);\n  },256,[18,18]),\n  snow:canvasTexture((g,s)=>{\n    g.fillStyle='#dfe8ee';g.fillRect(0,0,s,s);noise(g,s,.05,7000);\n  },256,[18,18])\n};\n\nfunction material(tex,color=0xffffff,rough=.82,metal=.05,tile=[1,1]){\n  const t=tex.clone(); t.needsUpdate=true; t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(...tile);\n  return new THREE.MeshStandardMaterial({map:t,color,roughness:rough,metalness:metal});\n}\n\n/* ============ Maps ============ */\nlet currentMapGroup=null,mapColliders=[],mapName='DUST DISTRICT',playerSpawn=new THREE.Vector3(0,1.72,48);\n\nconst mapCatalog={\n  dust:{name:'Dust District',desc:'Sun-bleached Middle-Eastern town with enterable buildings, mid doors, and two bombsites.',environment:0xa9c0d2,sun:0xfff0c8,ground:TEX.sand},\n  warehouse:{name:'Dock Warehouse',desc:'Industrial port map with stacked containers, offices, catwalks, and close-quarters fights.',environment:0x8ea3b5,sun:0xdfe9f5,ground:TEX.asphalt},\n  winter:{name:'Winter Compound',desc:'Snow-covered military compound with barracks, a central bunker, and long sightlines.',environment:0xb9c8d6,sun:0xeaf2ff,ground:TEX.snow}\n};\n\nfunction clearMap(){\n  if(currentMapGroup)scene.remove(currentMapGroup);\n  currentMapGroup=new THREE.Group(); scene.add(currentMapGroup);\n  mapColliders=[];\n}\n\nfunction addBox(parent,x,y,z,w,h,d,material,collide=true){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);\n  m.position.set(x,y,z); m.castShadow=true; m.receiveShadow=true;\n  parent.add(m);\n  if(collide)mapColliders.push(new THREE.Box3().setFromObject(m));\n  return m;\n}\n\n// Building with doorway and interior\nfunction building(parent,x,z,w,d,h,wallMat,floorMat,roofColor=0x6d6252){\n  const t=.35, doorW=2.4, doorH=2.45;\n\n  // Floor\n  addBox(parent,x,.08,z,w,.16,d,floorMat,false);\n\n  // Front wall with doorway\n  addBox(parent,x-w/2+ (w-doorW)/4,h/2,z-d/2,(w-doorW)/2,h,t,wallMat);\n  addBox(parent,x+w/2-(w-doorW)/4,h/2,z-d/2,(w-doorW)/2,h,t,wallMat);\n  addBox(parent,x,h-(h-doorH)/2,z-d/2,doorW,h-doorH,t,wallMat);\n\n  // Other walls\n  addBox(parent,x,h/2,z+d/2,w,h,t,wallMat);\n  addBox(parent,x-w/2,h/2,z,t,h,d,wallMat);\n  addBox(parent,x+w/2,h/2,z,t,h,d,wallMat);\n\n  // Interior dividing wall\n  addBox(parent,x,h/2,z+1.2,w*.55,h*.82,t,wallMat);\n\n  // Roof\n  const roof=addBox(parent,x,h+.16,z,w,.32,d,material(TEX.concrete,roofColor,.9,0,[w/4,d/4]),false);\n  roof.castShadow=true;\n\n  // Window frames\n  addBox(parent,x-w/2,h*.68,z,t+.06,h*.22,1.4,material(TEX.metal,0x333a41,.35,.85),false);\n  addBox(parent,x+w/2,h*.68,z,t+.06,h*.22,1.4,material(TEX.metal,0x333a41,.35,.85),false);\n}\n\nfunction container(parent,x,z,rot=0,color=0x8a4b3a){\n  const g=new THREE.Group();\n  const m=material(TEX.metal,color,.55,.65,[3,1]);\n  const c=new THREE.Mesh(new THREE.BoxGeometry(12,5,5),m);\n  c.castShadow=true;c.receiveShadow=true;g.add(c);\n  for(let i=-5;i<=5;i+=2.5){\n    const rib=new THREE.Mesh(new THREE.BoxGeometry(.16,5,5.06),material(TEX.metal,0x000000,.6,.4));\n    rib.position.x=i;g.add(rib);\n  }\n  g.position.set(x,2.5,z);g.rotation.y=rot;parent.add(g);\n  const box=new THREE.Box3().setFromObject(g);mapColliders.push(box);\n}\n\nfunction buildDust(){\n  mapName='DUST DISTRICT';\n  scene.background=new THREE.Color(mapCatalog.dust.environment);\n  scene.fog=new THREE.Fog(mapCatalog.dust.environment,60,210);\n\n  const ground=new THREE.Mesh(new THREE.PlaneGeometry(180,180),material(TEX.sand,0xffffff,.97,0,[22,22]));\n  ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;currentMapGroup.add(ground);\n\n  const road=new THREE.Mesh(new THREE.PlaneGeometry(16,180),material(TEX.asphalt,0xffffff,.9,0,[4,24]));\n  road.rotation.x=-Math.PI/2;road.position.y=.02;currentMapGroup.add(road);\n\n  const wallMat=material(TEX.plaster,0xffffff,.88,0,[3,2]);\n  const stoneMat=material(TEX.concrete,0xdad4c8,.88,0,[3,3]);\n  const woodMat=material(TEX.wood,0xffffff,.85,0,[2,2]);\n\n  addBox(currentMapGroup,0,5,-84,172,10,3,stoneMat);\n  addBox(currentMapGroup,0,5,84,172,10,3,stoneMat);\n  addBox(currentMapGroup,-84,5,0,3,10,172,stoneMat);\n  addBox(currentMapGroup,84,5,0,3,10,172,stoneMat);\n\n  building(currentMapGroup,-45,-35,20,16,6.5,wallMat,material(TEX.tile,0xb9b2a4,.8,0,[4,3]));\n  building(currentMapGroup,42,-30,24,18,7,wallMat,material(TEX.tile,0xb2aa9a,.8,0,[5,4]));\n  building(currentMapGroup,-15,35,18,14,6,wallMat,material(TEX.tile,0xbfb6a6,.8,0,[4,3]));\n  building(currentMapGroup,25,42,22,16,7.5,wallMat,material(TEX.tile,0xb5ac9b,.8,0,[5,4]));\n\n  addBox(currentMapGroup,-48,1.2,-8,14,2.4,10,woodMat);\n  addBox(currentMapGroup,-48,3.4,-8,10,2,7,woodMat);\n  addBox(currentMapGroup,48,1.2,8,14,2.4,10,woodMat);\n  addBox(currentMapGroup,0,2,-18,20,4,3,stoneMat);\n  addBox(currentMapGroup,-25,1.5,10,3,3,24,stoneMat);\n  addBox(currentMapGroup,25,1.5,10,3,3,24,stoneMat);\n  addBox(currentMapGroup,-65,2,45,8,4,8,stoneMat);\n  addBox(currentMapGroup,65,2,-45,8,4,8,stoneMat);\n\n  const marker=(x,z,l)=>{\n    const c=document.createElement('canvas');c.width=c.height=128;\n    const g=c.getContext('2d');g.fillStyle='rgba(0,0,0,.42)';g.fillRect(0,0,128,128);\n    g.fillStyle='#ffcc33';g.font='bold 82px Arial';g.textAlign='center';g.textBaseline='middle';g.fillText(l,64,68);\n    const p=new THREE.Mesh(new THREE.PlaneGeometry(8,8),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(c),transparent:true}));\n    p.rotation.x=-Math.PI/2;p.position.set(x,.04,z);currentMapGroup.add(p);\n  };\n  marker(-45,8,'A');marker(42,20,'B');\n  playerSpawn.set(0,1.72,62);\n}\n\nfunction buildWarehouse(){\n  mapName='DOCK WAREHOUSE';\n  scene.background=new THREE.Color(mapCatalog.warehouse.environment);\n  scene.fog=new THREE.Fog(mapCatalog.warehouse.environment,45,170);\n\n  const ground=new THREE.Mesh(new THREE.PlaneGeometry(170,170),material(TEX.asphalt,0xffffff,.92,0,[20,20]));\n  ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;currentMapGroup.add(ground);\n\n  const concrete=material(TEX.concrete,0xb8bcc0,.88,0,[4,4]);\n  const metalWall=material(TEX.metal,0x8a97a3,.45,.7,[6,3]);\n  const wood=material(TEX.wood,0xffffff,.85,0,[2,2]);\n\n  addBox(currentMapGroup,0,6,-80,164,12,3,metalWall);\n  addBox(currentMapGroup,0,6,80,164,12,3,metalWall);\n  addBox(currentMapGroup,-80,6,0,3,12,164,metalWall);\n  addBox(currentMapGroup,80,6,0,3,12,164,metalWall);\n\n  building(currentMapGroup,-38,-38,26,20,8,concrete,material(TEX.tile,0x9aa3aa,.7,.1,[5,4]),0x4d565e);\n  building(currentMapGroup,38,35,28,20,8,concrete,material(TEX.tile,0x9aa3aa,.7,.1,[5,4]),0x4d565e);\n\n  container(currentMapGroup,-20,0,0,0x8a4b3a);\n  container(currentMapGroup,-20,12,0,0x2f5d8a);\n  container(currentMapGroup,20,-10,Math.PI/2,0x3f7a4d);\n  container(currentMapGroup,32,18,Math.PI/2,0x8a4b3a);\n  container(currentMapGroup,0,-40,0,0x6b5a8a);\n  container(currentMapGroup,-45,35,Math.PI/4,0x2f5d8a);\n\n  addBox(currentMapGroup,0,1.2,20,24,2.4,6,wood);\n  addBox(currentMapGroup,-10,3.4,20,16,2,4,wood);\n  addBox(currentMapGroup,10,3.4,20,16,2,4,wood);\n  addBox(currentMapGroup,0,5,-10,30,10,2,metalWall);\n  addBox(currentMapGroup,-58,1.5,-55,10,3,10,concrete);\n  addBox(currentMapGroup,58,1.5,55,10,3,10,concrete);\n\n  playerSpawn.set(0,1.72,64);\n}\n\nfunction buildWinter(){\n  mapName='WINTER COMPOUND';\n  scene.background=new THREE.Color(mapCatalog.winter.environment);\n  scene.fog=new THREE.Fog(mapCatalog.winter.environment,45,175);\n\n  const ground=new THREE.Mesh(new THREE.PlaneGeometry(180,180),material(TEX.snow,0xffffff,.95,0,[22,22]));\n  ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;currentMapGroup.add(ground);\n\n  const concrete=material(TEX.concrete,0xd6dde3,.85,0,[4,4]);\n  const brick=material(TEX.brick,0xd9d2c5,.9,0,[4,3]);\n  const wood=material(TEX.wood,0xd8c7ab,.85,0,[2,2]);\n\n  addBox(currentMapGroup,0,5,-84,172,10,3,concrete);\n  addBox(currentMapGroup,0,5,84,172,10,3,concrete);\n  addBox(currentMapGroup,-84,5,0,3,10,172,concrete);\n  addBox(currentMapGroup,84,5,0,3,10,172,concrete);\n\n  building(currentMapGroup,-42,-38,24,18,7,brick,wood,0x5a626b);\n  building(currentMapGroup,42,-38,24,18,7,brick,wood,0x5a626b);\n  building(currentMapGroup,0,38,30,20,8,concrete,material(TEX.tile,0xa9b3ba,.7,.1,[6,4]),0x4e5860);\n\n  // Central bunker\n  addBox(currentMapGroup,0,2,0,22,4,18,concrete);\n  addBox(currentMapGroup,0,4.5,0,18,3,14,concrete);\n  addBox(currentMapGroup,0,1.6,9.1,4,3.2,.4,material(TEX.metal,0x3b444d,.4,.8),false);\n\n  addBox(currentMapGroup,-25,1.2,-10,12,2.4,6,wood);\n  addBox(currentMapGroup,25,1.2,-10,12,2.4,6,wood);\n  addBox(currentMapGroup,-60,1.5,20,8,3,12,concrete);\n  addBox(currentMapGroup,60,1.5,-20,8,3,12,concrete);\n  addBox(currentMapGroup,-15,1,55,16,2,8,wood);\n  addBox(currentMapGroup,15,1,55,16,2,8,wood);\n\n  playerSpawn.set(0,1.72,68);\n}\n\nconst mapBuilders={dust:buildDust,warehouse:buildWarehouse,winter:buildWinter};\n\n/* ============ Lighting ============ */\nconst hemi=new THREE.HemisphereLight(0xbfd8ee,0x4a4238,.85);scene.add(hemi);\nconst sun=new THREE.DirectionalLight(0xfff0c8,2.1);\nsun.position.set(48,70,28);sun.castShadow=true;\nsun.shadow.mapSize.set(4096,4096);\nsun.shadow.camera.left=-95;sun.shadow.camera.right=95;\nsun.shadow.camera.top=95;sun.shadow.camera.bottom=-95;\nsun.shadow.bias=-.0004;\nscene.add(sun);\n\nfunction setEnvironment(mapId){\n  const m=mapCatalog[mapId];\n  hemi.color.set(m.environment);\n  sun.color.set(m.sun);\n}\n\n/* ============ Player ============ */\nconst player={hp:100,maxHp:100,armor:50,maxArmor:50,vel:new THREE.Vector3(),grounded:true,radius:.42,height:1.72};\nconst keys={};\naddEventListener('keydown',e=>{\n  keys[e.code]=true;\n  if(e.code==='KeyR')reload();\n  if(e.code==='Digit1')equip(0);\n  if(e.code==='Digit2')equip(1);\n  if(e.code==='KeyB'&&roundActive){controls.unlock();openLobby('store');}\n});\naddEventListener('keyup',e=>keys[e.code]=false);\n\n/* ============ Weapons / mods / skins ============ */\nconst baseWeapons={\n  rifle:{name:'PHANTOM-7',damage:27,fireRate:.102,mag:30,reserve:90,spread:.011,recoil:.026,auto:true,range:190,moveSpeed:1,sound:520},\n  pistol:{name:'VIPER .45',damage:39,fireRate:.23,mag:12,reserve:48,spread:.006,recoil:.019,auto:false,range:130,moveSpeed:1.08,sound:760}\n};\nconst modCatalog={\n  compensator:{name:'Compensator',price:180,desc:'-30% recoil, +4% damage',apply:w=>{w.recoil*=.7;w.damage*=1.04}},\n  laser:{name:'Laser Sight',price:140,desc:'-25% spread',apply:w=>{w.spread*=.75}},\n  extendedMag:{name:'Extended Mag',price:220,desc:'+50% magazine',apply:w=>{w.mag=Math.round(w.mag*1.5)}},\n  lightweight:{name:'Lightweight Frame',price:160,desc:'+12% movement speed',apply:w=>{w.moveSpeed*=1.12}},\n  hollowPoint:{name:'Hollow Point',price:260,desc:'+18% damage, -12% range',apply:w=>{w.damage*=1.18;w.range*=.88}},\n  suppressor:{name:'Suppressor',price:200,desc:'Quieter fire, -6% damage',apply:w=>{w.damage*=.94;w.sound*=.65}}\n};\nconst skinCatalog={\n  default:{name:'Factory Standard',price:0,color:0x2f363d,metal:.75,rough:.35},\n  desert:{name:'Desert Viper',price:250,color:0xb08b4e,metal:.25,rough:.6},\n  arctic:{name:'Arctic Wolf',price:350,color:0xdfe8ee,metal:.15,rough:.45},\n  crimson:{name:'Crimson Circuit',price:600,color:0xb32434,metal:.55,rough:.28},\n  neon:{name:'Neon Vector',price:900,color:0x18e0b0,metal:.7,rough:.18},\n  gold:{name:'Royal Gold',price:1500,color:0xffc72e,metal:1,rough:.12}\n};\n\nconst operatorCatalog={\n  ranger:{name:'Ranger',price:0,uniform:0x43503c,vest:0x2b3238,helmet:0x333b42,accent:0x6d7a55},\n  desert:{name:'Desert Recon',price:350,uniform:0xa98d5d,vest:0x5b4a31,helmet:0x8b7448,accent:0xc9ab72},\n  arctic:{name:'Arctic Trooper',price:500,uniform:0xc7d3dc,vest:0x59636d,helmet:0xdfe8ee,accent:0x8fa4b4},\n  night:{name:'Night Stalker',price:800,uniform:0x1d232a,vest:0x11161b,helmet:0x181e24,accent:0x2f3d4a},\n  forest:{name:'Forest Phantom',price:650,uniform:0x31472c,vest:0x222c21,helmet:0x2a3826,accent:0x4d6a41},\n  urban:{name:'Urban Assault',price:750,uniform:0x565f68,vest:0x2d343b,helmet:0x454e57,accent:0x7b8792}\n};\n\nfunction buildWeapon(id){\n  const w=structuredClone(baseWeapons[id]); w.id=id; w.ammo=w.mag;\n  (save.installedMods[id]||[]).forEach(m=>modCatalog[m]?.apply(w));\n  return w;\n}\nlet weapons=save.selectedWeapons.map(buildWeapon);\nlet current=0;\n\nfunction equip(i){if(i<weapons.length){current=i;updateHUD();}}\n\nlet firing=false,lastShot=0,reloading=false;\naddEventListener('mousedown',e=>{if(e.button===0)firing=true});\naddEventListener('mouseup',e=>{if(e.button===0)firing=false});\n\nfunction reload(){\n  const w=weapons[current];\n  if(reloading||w.ammo===w.mag||w.reserve<=0)return;\n  reloading=true;updateHUD();beep(240,.07,'square',.05);\n  setTimeout(()=>{\n    const take=Math.min(w.mag-w.ammo,w.reserve);\n    w.ammo+=take;w.reserve-=take;reloading=false;updateHUD();beep(420,.06,'triangle',.05);\n  },1150);\n}\n\n/* ============ Audio ============ */\nlet audio;\nfunction beep(f,d=.08,type='square',v=.07){\n  audio??=new AudioContext();\n  const o=audio.createOscillator(),g=audio.createGain();\n  o.type=type;o.frequency.value=f;g.gain.value=v;\n  o.connect(g);g.connect(audio.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+d);\n  o.stop(audio.currentTime+d);\n}\n\n/* ============ Soldiers ============ */\nconst enemies=[];\nfunction soldierMaterials(op){\n  const o=operatorCatalog[op]||operatorCatalog.ranger;\n  return {\n    uniform:new THREE.MeshStandardMaterial({color:o.uniform,roughness:.82}),\n    vest:new THREE.MeshStandardMaterial({color:o.vest,roughness:.55,metalness:.22}),\n    helmet:new THREE.MeshStandardMaterial({color:o.helmet,roughness:.42,metalness:.28}),\n    skin:new THREE.MeshStandardMaterial({color:0xc99870,roughness:.72}),\n    accent:new THREE.MeshStandardMaterial({color:o.accent,roughness:.7}),\n    boots:new THREE.MeshStandardMaterial({color:0x181d21,roughness:.78})\n  };\n}\n\nfunction makeSoldier(op){\n  const m=soldierMaterials(op),g=new THREE.Group();\n\n  const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.31,.58,7,18),m.uniform);\n  torso.position.y=1.22;torso.castShadow=true;g.add(torso);\n\n  const vest=new THREE.Mesh(new THREE.BoxGeometry(.6,.5,.36),m.vest);\n  vest.position.y=1.27;vest.castShadow=true;g.add(vest);\n\n  const pouch=new THREE.Mesh(new THREE.BoxGeometry(.42,.16,.1),m.accent);\n  pouch.position.set(0,1.08,.21);g.add(pouch);\n\n  const head=new THREE.Mesh(new THREE.SphereGeometry(.19,22,18),m.skin);\n  head.position.y=1.76;head.castShadow=true;g.add(head);\n\n  const helmet=new THREE.Mesh(new THREE.SphereGeometry(.215,22,16,0,Math.PI*2,0,Math.PI*.62),m.helmet);\n  helmet.position.y=1.79;helmet.castShadow=true;g.add(helmet);\n\n  const goggles=new THREE.Mesh(new THREE.BoxGeometry(.32,.07,.08),m.accent);\n  goggles.position.set(0,1.78,.17);g.add(goggles);\n\n  const armGeo=new THREE.CapsuleGeometry(.085,.48,5,12);\n  const legGeo=new THREE.CapsuleGeometry(.11,.62,5,12);\n\n  const lArm=new THREE.Mesh(armGeo,m.uniform);lArm.position.set(-.37,1.25,0);g.add(lArm);\n  const rArm=new THREE.Mesh(armGeo,m.uniform);rArm.position.set(.37,1.25,0);g.add(rArm);\n  const lLeg=new THREE.Mesh(legGeo,m.uniform);lLeg.position.set(-.15,.55,0);g.add(lLeg);\n  const rLeg=new THREE.Mesh(legGeo,m.uniform);rLeg.position.set(.15,.55,0);g.add(rLeg);\n  const lBoot=new THREE.Mesh(new THREE.BoxGeometry(.17,.14,.3),m.boots);lBoot.position.set(-.15,.07,.04);g.add(lBoot);\n  const rBoot=new THREE.Mesh(new THREE.BoxGeometry(.17,.14,.3),m.boots);rBoot.position.set(.15,.07,.04);g.add(rBoot);\n\n  const gun=new THREE.Mesh(new THREE.BoxGeometry(.09,.14,.75),new THREE.MeshStandardMaterial({color:0x23292f,roughness:.35,metalness:.85}));\n  gun.position.set(.29,1.23,.36);g.add(gun);\n\n  [torso,vest,head,helmet,lArm,rArm,lLeg,rLeg].forEach(p=>p.castShadow=true);\n  scene.add(g);\n  return {g,lArm,rArm,lLeg,rLeg,head};\n}\n\nfunction spawnEnemy(){\n  const ops=Object.keys(operatorCatalog);\n  const op=ops[Math.floor(Math.random()*ops.length)];\n  const s=makeSoldier(op);\n  let x,z;\n  do{\n    x=(Math.random()*2-1)*72;\n    z=(Math.random()*2-1)*72;\n  }while(Math.hypot(x-camera.position.x,z-camera.position.z)<30);\n  s.g.position.set(x,0,z);\n  enemies.push({...s,hp:100,alive:true,speed:2.35+Math.random()*1.55,nextAttack:0,phase:Math.random()*10});\n}\nfunction clearEnemies(){enemies.forEach(e=>scene.remove(e.g));enemies.length=0;}\n\n/* ============ Combat ============ */\nconst tracers=[],ray=new THREE.Raycaster();\n\nfunction shoot(){\n  const now=performance.now()/1000,w=weapons[current];\n  if(reloading||now-lastShot<w.fireRate)return;\n  if(w.ammo<=0){beep(170,.07,'sawtooth',.04);reload();return;}\n\n  lastShot=now;w.ammo--;updateHUD();beep(w.sound,.055,'square',.065);\n\n  const dir=new THREE.Vector3();camera.getWorldDirection(dir);\n  const spread=w.spread*(player.grounded?1:2.15)*(keys['ShiftLeft']?1.35:1);\n  dir.x+=(Math.random()-.5)*spread;dir.y+=(Math.random()-.5)*spread;dir.z+=(Math.random()-.5)*spread;dir.normalize();\n\n  ray.set(camera.position.clone(),dir);ray.far=w.range;\n  const targets=[];enemies.forEach(e=>{if(e.alive)targets.push(e.g)});\n  const hit=ray.intersectObjects(targets,true)[0];\n\n  const start=camera.position.clone().add(dir.clone().multiplyScalar(.65));\n  let end=start.clone().add(dir.clone().multiplyScalar(w.range));\n\n  if(hit){\n    end=hit.point.clone();\n    const enemy=enemies.find(e=>e.g===hit.object.parent);\n    if(enemy){\n      const hs=hit.object===enemy.head;\n      enemy.hp-=hs?w.damage*3.4:w.damage;\n      document.getElementById('hit').style.opacity=1;\n      setTimeout(()=>document.getElementById('hit').style.opacity=0,80);\n      beep(hs?1350:920,.045,'sine',.05);\n\n      if(enemy.hp<=0){\n        enemy.alive=false;scene.remove(enemy.g);\n        const reward=hs?180:110;\n        save.credits+=reward;score+=hs?250:100;kills++;\n        feed(`${hs?'HEADSHOT':'ELIMINATED'} +CR${reward}`);\n        persist();updateHUD();beep(310,.16,'triangle',.08);\n      }\n    }\n  }\n\n  const line=new THREE.Line(\n    new THREE.BufferGeometry().setFromPoints([start,end]),\n    new THREE.LineBasicMaterial({color:0xffe38a,transparent:true,opacity:.72})\n  );\n  scene.add(line);tracers.push({line,life:.055});\n}\n\nfunction feed(text){\n  const f=document.getElementById('feed'),d=document.createElement('div');\n  d.className='feed';d.textContent=text;f.prepend(d);\n  setTimeout(()=>d.remove(),3800);\n}\n\nfunction damagePlayer(n){\n  if(player.armor>0){\n    const a=Math.min(player.armor,n*.55);\n    player.armor-=a;n-=a;\n  }\n  player.hp=Math.max(0,player.hp-n);updateHUD();\n  const d=document.getElementById('dmg');\n  d.style.opacity=.9;setTimeout(()=>d.style.opacity=0,100);\n  beep(130,.12,'sawtooth',.08);\n  if(player.hp<=0)endMatch(false);\n}\n\n/* ============ Movement / collision ============ */\nfunction blocked(pos){\n  const p=new THREE.Box3(\n    new THREE.Vector3(pos.x-player.radius,pos.y-player.height,pos.z-player.radius),\n    new THREE.Vector3(pos.x+player.radius,pos.y,pos.z+player.radius)\n  );\n  return mapColliders.some(c=>p.intersectsBox(c));\n}\n\nfunction move(dt){\n  const w=weapons[current];\n  const speed=(keys['ShiftLeft']?9.2:5.9)*w.moveSpeed;\n  const fwd=new THREE.Vector3();camera.getWorldDirection(fwd);fwd.y=0;fwd.normalize();\n  const right=new THREE.Vector3().crossVectors(fwd,new THREE.Vector3(0,1,0)).normalize();\n  const v=new THREE.Vector3();\n\n  if(keys['KeyW'])v.add(fwd);\n  if(keys['KeyS'])v.sub(fwd);\n  if(keys['KeyD'])v.add(right);\n  if(keys['KeyA'])v.sub(right);\n  if(v.lengthSq())v.normalize().multiplyScalar(speed*dt);\n\n  let n=camera.position.clone();n.x+=v.x;\n  if(!blocked(n))camera.position.x=n.x;\n  n=camera.position.clone();n.z+=v.z;\n  if(!blocked(n))camera.position.z=n.z;\n\n  player.vel.y-=24*dt;\n  camera.position.y+=player.vel.y*dt;\n  if(camera.position.y<=player.height){\n    camera.position.y=player.height;player.vel.y=0;player.grounded=true;\n  }\n  if(keys['Space']&&player.grounded){player.vel.y=8.4;player.grounded=false;}\n\n  camera.position.x=THREE.MathUtils.clamp(camera.position.x,-80,80);\n  camera.position.z=THREE.MathUtils.clamp(camera.position.z,-80,80);\n}\n\n/* ============ Lobby UI ============ */\nlet score=0,kills=0,round=1,enemiesToSpawn=4,roundActive=false;\n\nfunction openLobby(tab='deploy'){\n  document.getElementById('lobby').style.display='flex';\n  document.getElementById('hud').style.display='none';\n  document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.tab===tab));\n  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.id==='tab-'+tab));\n  renderLobby();\n}\n\ndocument.querySelectorAll('.nav').forEach(n=>{\n  n.onclick=()=>openLobby(n.dataset.tab);\n});\n\nfunction card(title,desc,tags=[],actions=[]){\n  const c=document.createElement('div');c.className='card';\n  c.innerHTML=`<div class=\"row\"><h3>${title}</h3>${tags.map(t=>`<span class=\"tag ${t.blue?'blue':''}\">${t.text}</span>`).join('')}</div><p>${desc}</p>`;\n  const row=document.createElement('div');row.className='row';\n  actions.forEach(a=>row.append(a));\n  c.append(row);return c;\n}\nfunction btn(text,disabled,fn,ghost=false){\n  const b=document.createElement('button');\n  b.textContent=text;b.disabled=disabled;if(ghost)b.className='ghost';\n  b.onclick=fn;return b;\n}\n\nfunction renderLobby(){\n  document.getElementById('lobbyCredits').textContent=save.credits;\n  document.getElementById('saveInfo').textContent=`${save.selectedMap.toUpperCase()} • ${operatorCatalog[save.equippedOperator].name}`;\n\n  // Deploy summary\n  const ds=document.getElementById('deploySummary');ds.innerHTML='';\n  const m=mapCatalog[save.selectedMap],op=operatorCatalog[save.equippedOperator];\n  ds.append(card(m.name,m.desc,[{text:'SELECTED',blue:true}],[]));\n  ds.append(card(op.name,'Current operator camouflage and equipment colors.',[{text:'EQUIPPED'}],[]));\n  ds.append(card('Weapons',save.selectedWeapons.map(id=>baseWeapons[id].name).join(' • '),[],[]));\n\n  // Maps\n  const ml=document.getElementById('mapList');ml.innerHTML='';\n  Object.entries(mapCatalog).forEach(([id,m])=>{\n    const selected=save.selectedMap===id;\n    const c=card(m.name,m.desc,[{text:selected?'SELECTED':'AVAILABLE',blue:selected}],[\n      btn(selected?'SELECTED':'SELECT',selected,()=>{save.selectedMap=id;persist();renderLobby();})\n    ]);\n    if(selected)c.classList.add('selected');\n    ml.append(c);\n  });\n\n  // Operators\n  const ol=document.getElementById('operatorList');ol.innerHTML='';\n  Object.entries(operatorCatalog).forEach(([id,o])=>{\n    const owned=save.ownedOperators.includes(id),equipped=save.equippedOperator===id;\n    const c=card(o.name,`Uniform, vest, helmet, and accent colors themed for ${o.name}.`,[\n      {text:equipped?'EQUIPPED':owned?'OWNED':`CR${o.price}`}\n    ],[\n      btn(equipped?'EQUIPPED':owned?'EQUIP':(save.credits>=o.price?'BUY':'LOCKED'),equipped||(!owned&&save.credits<o.price),()=>{\n        if(!owned){save.credits-=o.price;save.ownedOperators.push(id);}\n        save.equippedOperator=id;persist();renderLobby();\n      })\n    ]);\n    if(equipped)c.classList.add('selected');\n    ol.append(c);\n  });\n\n  // Loadout\n  const ll=document.getElementById('loadoutList');ll.innerHTML='';\n  Object.entries(baseWeapons).forEach(([id,w])=>{\n    const selected=save.selectedWeapons.includes(id);\n    ll.append(card(w.name,`Damage ${w.damage} • Magazine ${w.mag} • ${w.auto?'Automatic':'Semi-automatic'}`,[\n      {text:selected?'EQUIPPED':'AVAILABLE',blue:selected}\n    ],[\n      btn(selected?'EQUIPPED':'EQUIP',selected,()=>{save.selectedWeapons.push(id);weapons=save.selectedWeapons.map(buildWeapon);persist();renderLobby();})\n    ]));\n  });\n\n  const al=document.getElementById('attachmentList');al.innerHTML='';\n  Object.entries(modCatalog).forEach(([id,m])=>{\n    const owned=save.ownedMods.includes(id);\n    const rifleInstalled=save.installedMods.rifle.includes(id);\n    const pistolInstalled=save.installedMods.pistol.includes(id);\n    al.append(card(m.name,m.desc,[{text:owned?'OWNED':`CR${m.price}`}],[\n      btn(owned?'OWNED':'BUY',owned||save.credits<m.price,()=>{save.credits-=m.price;save.ownedMods.push(id);persist();renderLobby();}),\n      btn('RIFLE',!owned||rifleInstalled,()=>{save.installedMods.rifle.push(id);weapons=save.selectedWeapons.map(buildWeapon);persist();renderLobby();},true),\n      btn('PISTOL',!owned||pistolInstalled,()=>{save.installedMods.pistol.push(id);weapons=save.selectedWeapons.map(buildWeapon);persist();renderLobby();},true)\n    ]));\n  });\n\n  // Store skins\n  const sl=document.getElementById('skinList');sl.innerHTML='';\n  Object.entries(skinCatalog).forEach(([id,s])=>{\n    const owned=save.ownedSkins.includes(id),equipped=save.equippedSkin===id;\n    sl.append(card(s.name,'Weapon finish using custom metalness and roughness values.',[\n      {text:equipped?'EQUIPPED':owned?'OWNED':`CR${s.price}`}\n    ],[\n      btn(equipped?'EQUIPPED':owned?'EQUIP':(save.credits>=s.price?'BUY':'LOCKED'),equipped||(!owned&&save.credits<s.price),()=>{\n        if(!owned){save.credits-=s.price;save.ownedSkins.push(id);}\n        save.equippedSkin=id;persist();renderLobby();\n      })\n    ]));\n  });\n\n  const sa=document.getElementById('storeAttachments');sa.innerHTML='';\n  Object.entries(modCatalog).forEach(([id,m])=>{\n    const owned=save.ownedMods.includes(id);\n    sa.append(card(m.name,m.desc,[{text:owned?'OWNED':`CR${m.price}`}],[\n      btn(owned?'OWNED':'BUY',owned||save.credits<m.price,()=>{save.credits-=m.price;save.ownedMods.push(id);persist();renderLobby();})\n    ]));\n  });\n}\n\n/* ============ Match flow ============ */\nfunction deploy(){\n  clearEnemies();clearMap();\n  mapBuilders[save.selectedMap]();\n  setEnvironment(save.selectedMap);\n  camera.position.copy(playerSpawn);\n  player.hp=player.maxHp;player.armor=player.maxArmor;\n  weapons=save.selectedWeapons.map(buildWeapon);\n  current=0;score=0;kills=0;round=1;enemiesToSpawn=4;\n  document.getElementById('lobby').style.display='none';\n  document.getElementById('end').style.display='none';\n  document.getElementById('hud').style.display='block';\n  updateHUD();roundActive=true;controls.lock();\n}\n\nfunction endMatch(win){\n  roundActive=false;controls.unlock();\n  const reward=250+round*90;\n  save.credits+=reward;persist();\n  document.getElementById('end').style.display='flex';\n  document.getElementById('endTitle').textContent=win?'ROUND SECURED':'MISSION FAILED';\n  document.getElementById('endTitle').style.color=win?'#8dffb0':'#ff5d5d';\n  document.getElementById('endText').textContent=`${mapName} • Round ${round} • Score ${score} • Kills ${kills} • Round bonus CR${reward}`;\n}\n\ndocument.getElementById('deployBtn').onclick=deploy;\ndocument.getElementById('continueBtn').onclick=()=>openLobby('deploy');\n\ncontrols.addEventListener('unlock',()=>{if(roundActive&&player.hp>0)openLobby('deploy');});\ncontrols.addEventListener('lock',()=>document.getElementById('lobby').style.display='none');\n\n/* ============ HUD / minimap ============ */\nfunction updateHUD(){\n  const w=weapons[current];\n  document.getElementById('ammo').textContent=reloading?'--':w.ammo;\n  document.getElementById('gunname').textContent=w.name;\n  document.getElementById('mods').textContent=(save.installedMods[w.id]?.length?save.installedMods[w.id].map(i=>modCatalog[i].name).join(' • '):'No attachments');\n  document.getElementById('hpf').style.width=(player.hp/player.maxHp*100)+'%';\n  document.getElementById('arf').style.width=(player.armor/player.maxArmor*100)+'%';\n  document.getElementById('mapName').textContent=mapName;\n  document.getElementById('round').textContent=round;\n  document.getElementById('left').textContent=enemies.filter(e=>e.alive).length+Math.max(0,enemiesToSpawn);\n  document.getElementById('score').textContent=score;\n  document.getElementById('hudCredits').textContent=save.credits;\n}\n\nconst mm=document.getElementById('map'),mc=mm.getContext('2d');\nfunction drawMinimap(){\n  mc.clearRect(0,0,190,190);\n  mc.fillStyle='rgba(5,9,13,.85)';mc.fillRect(0,0,190,190);\n  const s=190/168,c=95;\n  mc.fillStyle='#3b4753';\n  currentMapGroup?.children.forEach(o=>{\n    if(o.geometry?.type!=='BoxGeometry')return;\n    mc.fillRect(c+o.position.x*s-2,c+o.position.z*s-2,4,4);\n  });\n  enemies.forEach(e=>{\n    if(!e.alive)return;\n    mc.fillStyle='#ff5d5d';mc.beginPath();\n    mc.arc(c+e.g.position.x*s,c+e.g.position.z*s,3.3,0,7);mc.fill();\n  });\n  mc.fillStyle='#8dffb0';mc.beginPath();\n  mc.arc(c+camera.position.x*s,c+camera.position.z*s,4.4,0,7);mc.fill();\n}\n\n/* ============ Loop ============ */\nconst clock=new THREE.Clock();\nfunction animate(){\n  requestAnimationFrame(animate);\n  const dt=Math.min(clock.getDelta(),.05);\n\n  if(controls.isLocked&&roundActive){\n    move(dt);\n    const w=weapons[current];\n    if(firing&&(w.auto||performance.now()/1000-lastShot>w.fireRate))shoot();\n\n    enemies.forEach(e=>{\n      if(!e.alive)return;\n      const target=new THREE.Vector3(camera.position.x,0,camera.position.z);\n      const dir=target.clone().sub(e.g.position).setY(0);\n      const dist=dir.length();dir.normalize();\n\n      if(dist>8){\n        const next=e.g.position.clone().add(dir.multiplyScalar(e.speed*dt));next.y=0;\n        if(!blocked(next))e.g.position.copy(next);\n      }\n\n      e.g.lookAt(camera.position.x,0,camera.position.z);\n      e.phase+=dt*9;\n      const swing=Math.sin(e.phase)*.42;\n      e.lLeg.rotation.x=swing;e.rLeg.rotation.x=-swing;\n      e.lArm.rotation.x=-swing*.55;e.rArm.rotation.x=swing*.55;\n\n      if(dist<27&&performance.now()/1000-e.nextAttack>1.05){\n        e.nextAttack=performance.now()/1000;\n        if(Math.random()<.6)damagePlayer(6+Math.random()*7);\n        beep(230,.05,'square',.05);\n      }\n    });\n\n    const alive=enemies.filter(e=>e.alive).length;\n    if(alive<4&&enemiesToSpawn>0){spawnEnemy();enemiesToSpawn--;updateHUD();}\n    if(alive===0&&enemiesToSpawn===0){\n      round++;roundActive=false;\n      endMatch(true);\n    }\n  }\n\n  for(let i=tracers.length-1;i>=0;i--){\n    tracers[i].life-=dt;\n    tracers[i].line.material.opacity=Math.max(0,tracers[i].life/.055);\n    if(tracers[i].life<=0){scene.remove(tracers[i].line);tracers.splice(i,1);}\n  }\n\n  drawMinimap();\n  renderer.render(scene,camera);\n}\n\naddEventListener('resize',()=>{\n  camera.aspect=innerWidth/innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth,innerHeight);\n});\n\nopenLobby('deploy');\nanimate();\n</script>\n</body>\n</html>"
    }
  ]
}