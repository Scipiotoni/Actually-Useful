    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>OPERATION BLACKOUT — Realistic Soldiers</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{overflow:hidden;background:#05070a;font-family:'Segoe UI',Arial,sans-serif;color:#fff}\ncanvas{display:block}\n#hud{position:fixed;inset:0;pointer-events:none;display:none}\n.cross{position:absolute;left:50%;top:50%;width:26px;height:26px;transform:translate(-50%,-50%)}\n.cross i{position:absolute;background:#8dff70;box-shadow:0 0 6px #8dff70}\n.cross i:nth-child(1){left:50%;top:0;width:2px;height:9px;transform:translateX(-50%)}\n.cross i:nth-child(2){left:50%;bottom:0;width:2px;height:9px;transform:translateX(-50%)}\n.cross i:nth-child(3){top:50%;left:0;height:2px;width:9px;transform:translateY(-50%)}\n.cross i:nth-child(4){top:50%;right:0;height:2px;width:9px;transform:translateY(-50%)}\n#hitmark{position:absolute;left:50%;top:50%;width:30px;height:30px;transform:translate(-50%,-50%) rotate(45deg);opacity:0;transition:opacity .1s}\n#hitmark:before,#hitmark:after{content:\"\";position:absolute;background:#fff}\n#hitmark:before{left:50%;top:0;width:3px;height:100%;transform:translateX(-50%)}\n#hitmark:after{top:50%;left:0;height:3px;width:100%;transform:translateY(-50%)}\n#dmg{position:absolute;inset:0;background:radial-gradient(circle,transparent 40%,rgba(190,0,0,.7));opacity:0;transition:opacity .2s}\n#top{position:absolute;top:16px;left:50%;transform:translateX(-50%);display:flex;gap:14px}\n.chip{background:rgba(8,12,16,.72);border:1px solid rgba(255,204,85,.25);padding:8px 16px;border-radius:8px;font-size:13px;letter-spacing:2px}\n.chip b{color:#ffcc55}\n#feed{position:absolute;top:78px;right:20px;width:280px;text-align:right;font-size:12px}\n#feed div{background:rgba(8,12,16,.65);border-right:3px solid #ff5533;padding:6px 10px;margin-bottom:5px;border-radius:4px}\n#feed div.team{border-right-color:#39ff6a}\n#hpwrap{position:absolute;left:24px;bottom:24px;width:280px}\n#hpwrap .label{font-size:11px;letter-spacing:3px;opacity:.8;margin-bottom:6px}\n#hpbar{height:14px;background:rgba(0,0,0,.55);border:1px solid #333;border-radius:8px;overflow:hidden}\n#hpfill{height:100%;width:100%;background:linear-gradient(90deg,#39ff6a,#0f9d3a);transition:width .15s}\n#ammo{position:absolute;right:28px;bottom:22px;text-align:right;text-shadow:0 0 10px #000}\n#wname{font-size:12px;letter-spacing:3px;color:#ffcc55}\n#anum{font-size:44px;font-weight:800}\n#ares{font-size:18px;opacity:.75}\n#reload{position:absolute;left:50%;top:60%;transform:translateX(-50%);font-size:15px;letter-spacing:4px;color:#ffcc55;opacity:0}\n#minimap{position:absolute;left:24px;top:24px;width:150px;height:150px;background:rgba(5,10,14,.7);border:1px solid rgba(255,255,255,.15);border-radius:10px}\n.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;background:radial-gradient(circle at 50% 30%,rgba(30,45,60,.95),rgba(3,5,8,.98))}\n.menu{width:min(860px,92vw);background:linear-gradient(160deg,rgba(14,20,26,.96),rgba(6,9,12,.98));border:1px solid rgba(255,204,85,.22);border-radius:18px;padding:38px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.7)}\n.logo{font-size:50px;font-weight:900;letter-spacing:10px;background:linear-gradient(90deg,#ffcc55,#ff7a3d);-webkit-background-clip:text;background-clip:text;color:transparent}\n.sub{letter-spacing:4px;font-size:12px;color:#9fb0bd;margin:8px 0 26px}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;text-align:left;margin-bottom:24px}\n.card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px}\n.card h3{font-size:13px;letter-spacing:3px;color:#ffcc55;margin-bottom:10px}\n.card p,.card li{font-size:13px;color:#c9d4dc;line-height:1.7}\n.card ul{list-style:none}\n.btn{pointer-events:auto;border:none;cursor:pointer;font-weight:800;letter-spacing:3px;padding:16px 36px;border-radius:10px;background:linear-gradient(90deg,#ffcc55,#ff9a3d);color:#12100a;font-size:16px}\n.btn:hover{transform:translateY(-2px)}\n.btn.ghost{background:transparent;color:#ffcc55;border:1px solid rgba(255,204,85,.5)}\n.row{display:flex;gap:12px;justify-content:center}\n.hidden{display:none!important}\nselect{pointer-events:auto;background:#121820;color:#fff;border:1px solid #334;padding:10px;border-radius:8px}\n</style>\n</head>\n<body>\n<div id=\"hud\">\n  <div class=\"cross\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hitmark\"></div><div id=\"dmg\"></div>\n  <div id=\"top\">\n    <div class=\"chip\">SCORE <b id=\"score\">0</b></div>\n    <div class=\"chip\">SQUAD <b id=\"teamLeft\">3</b></div>\n    <div class=\"chip\">ENEMIES <b id=\"enemyLeft\">6</b></div>\n    <div class=\"chip\">TIME <b id=\"time\">0:00</b></div>\n  </div>\n  <div id=\"feed\"></div>\n  <div id=\"minimap\"><canvas id=\"mm\" width=\"150\" height=\"150\"></canvas></div>\n  <div id=\"hpwrap\"><div class=\"label\">HEALTH</div><div id=\"hpbar\"><div id=\"hpfill\"></div></div></div>\n  <div id=\"ammo\"><div id=\"wname\">AR-9 RIFLE</div><div><span id=\"anum\">30</span><span id=\"ares\"> / 150</span></div></div>\n  <div id=\"reload\">RELOADING</div>\n</div>\n\n<div id=\"menu\" class=\"screen\">\n  <div class=\"menu\">\n    <div class=\"logo\">OPERATION BLACKOUT</div>\n    <div class=\"sub\">3D TEAM ARENA • REALISTIC SOLDIERS</div>\n    <div class=\"grid\">\n      <div class=\"card\"><h3>MISSION</h3><p>Lead your 3-operator squad against 6 enemy soldiers. Enemies patrol, chase, take cover, and return fire.</p></div>\n      <div class=\"card\"><h3>CONTROLS</h3><ul><li>Click game — Lock mouse and look around</li><li>WASD — Move</li><li>Left click — Fire</li><li>Shift — Sprint • Space — Jump</li><li>R — Reload • 1/2 — Weapons</li><li>Esc — Pause</li></ul></div>\n      <div class=\"card\"><h3>DIFFICULTY</h3><p><select id=\"diff\"><option value=\"0.8\">Recruit</option><option value=\"1\" selected>Regular</option><option value=\"1.35\">Veteran</option></select></p></div>\n      <div class=\"card\"><h3>LOADOUT</h3><p>AR-9 automatic rifle and M7 sidearm. Enemies wear helmets, tactical vests, and carry rifles.</p></div>\n    </div>\n    <div class=\"row\"><button class=\"btn\" id=\"start\">DEPLOY</button><button class=\"btn ghost\" id=\"how\">HOW TO PLAY</button></div>\n  </div>\n</div>\n\n<div id=\"pause\" class=\"screen hidden\"><div class=\"menu\"><div class=\"logo\" style=\"font-size:38px\">PAUSED</div><div class=\"row\" style=\"margin-top:24px\"><button class=\"btn\" id=\"resume\">RESUME</button><button class=\"btn ghost\" onclick=\"location.reload()\">RESTART</button></div></div></div>\n<div id=\"end\" class=\"screen hidden\"><div class=\"menu\"><div class=\"logo\" id=\"endTitle\">MISSION COMPLETE</div><div id=\"endStats\" style=\"margin:16px 0 26px;color:#c9d4dc;line-height:1.8\"></div><button class=\"btn\" onclick=\"location.reload()\">PLAY AGAIN</button></div></div>\n\n<script type=\"importmap\">\n{\"imports\":{\"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\",\"three/addons/\":\"https://unpkg.com/three@0.160.0/examples/jsm/\"}}\n</script>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport {PointerLockControls} from 'three/addons/controls/PointerLockControls.js';\n\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x151d27);\nscene.fog=new THREE.Fog(0x151d27,35,160);\nconst camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.1,400);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,2));\ndocument.body.appendChild(renderer.domElement);\n\nconst controls=new PointerLockControls(camera,renderer.domElement);\ncamera.position.set(0,1.7,26);\n\nscene.add(new THREE.HemisphereLight(0xcfe0ff,0x2b2c22,1));\nconst sun=new THREE.DirectionalLight(0xfff0cc,1.25);sun.position.set(35,55,20);scene.add(sun);\n\nconst world=new THREE.Group();scene.add(world);\nconst mat=c=>new THREE.MeshLambertMaterial({color:c});\nfunction box(w,h,d,x,y,z,c){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c));m.position.set(x,y,z);world.add(m);return m}\nbox(110,.5,110,0,-.25,0,0x4b5340);\nbox(110,10,2,0,5,-55,0x646a5d);box(110,10,2,0,5,55,0x646a5d);\nbox(2,10,110,-55,5,0,0x646a5d);box(2,10,110,55,5,0,0x646a5d);\n[[10,-10],[-12,-16],[16,6],[-20,10],[0,-26],[26,-18],[-32,-6],[8,22],[-8,-4],[32,12],[-24,24],[24,-32]].forEach(([x,z])=>{box(3.5,3.5,3.5,x,1.75,z,0x7a5a35);box(2.2,2.2,2.2,x+1.7,1.1,z+1.7,0x6a4c2c)});\nbox(18,9,12,-32,4.5,-32,0x565b52);box(18,9,12,32,4.5,32,0x565b52);box(10,5,10,0,2.5,0,0x3f443c);\n\nconst weapons={rifle:{name:'AR-9 RIFLE',mag:30,res:150,dmg:28,rate:.1,reload:1.7,auto:true,spread:.012},pistol:{name:'M7 SIDEARM',mag:12,res:60,dmg:45,rate:.3,reload:1.1,auto:false,spread:.005}};\nlet cur='rifle';const ammo={rifle:{...weapons.rifle},pistol:{...weapons.pistol}};\nconst gun=new THREE.Group();camera.add(gun);scene.add(camera);\nconst gb=new THREE.Mesh(new THREE.BoxGeometry(.12,.15,.78),mat(0x23262b));gb.position.set(.3,-.23,-.55);gun.add(gb);\nconst br=new THREE.Mesh(new THREE.BoxGeometry(.05,.05,.42),mat(0x101214));br.position.set(.3,-.2,-1);gun.add(br);\nconst flash=new THREE.Mesh(new THREE.SphereGeometry(.1),new THREE.MeshBasicMaterial({color:0xffdd66}));flash.position.set(.3,-.2,-1.22);flash.visible=false;gun.add(flash);\n\nconst player={hp:100,vy:0,ground:true,keys:{},last:0,reloading:0};\nlet score=0,kills=0,playing=false,over=false,start=0,diff=1;\nconst allies=[],enemies=[];\n\nfunction soldier(shirt,pants,helmet){\n  const g=new THREE.Group();\n  const skin=0xd7a97d;\n  const torso=new THREE.Mesh(new THREE.BoxGeometry(.62,.75,.34),mat(shirt));torso.position.y=1.35;g.add(torso);\n  const vest=new THREE.Mesh(new THREE.BoxGeometry(.68,.5,.42),mat(0x2f3438));vest.position.y=1.38;g.add(vest);\n  const head=new THREE.Mesh(new THREE.SphereGeometry(.21,16,12),mat(skin));head.position.y=1.93;g.add(head);\n  const helm=new THREE.Mesh(new THREE.SphereGeometry(.25,16,12,0,Math.PI*2,0,Math.PI*.62),mat(helmet));helm.position.y=1.98;g.add(helm);\n  const brim=new THREE.Mesh(new THREE.BoxGeometry(.34,.05,.18),mat(helmet));brim.position.set(0,1.93,-.2);g.add(brim);\n  const legL=new THREE.Mesh(new THREE.BoxGeometry(.2,.85,.22),mat(pants));legL.position.set(-.16,.43,0);g.add(legL);\n  const legR=legL.clone();legR.position.x=.16;g.add(legR);\n  const armL=new THREE.Mesh(new THREE.BoxGeometry(.15,.62,.17),mat(shirt));armL.position.set(-.4,1.35,0);g.add(armL);\n  const armR=armL.clone();armR.position.x=.4;g.add(armR);\n  const rifle=new THREE.Group();\n  const body=new THREE.Mesh(new THREE.BoxGeometry(.09,.13,.75),mat(0x22262b));rifle.add(body);\n  const barrel=new THREE.Mesh(new THREE.BoxGeometry(.04,.04,.35),mat(0x111417));barrel.position.z=-.5;rifle.add(barrel);\n  const magazine=new THREE.Mesh(new THREE.BoxGeometry(.07,.2,.12),mat(0x191c20));magazine.position.set(0,-.15,.05);rifle.add(magazine);\n  rifle.position.set(.34,1.38,-.35);g.add(rifle);\n  const bg=new THREE.Sprite(new THREE.SpriteMaterial({color:0x111}));bg.scale.set(1.5,.16,1);bg.position.y=2.55;g.add(bg);\n  const hb=new THREE.Sprite(new THREE.SpriteMaterial({color:0xff3333}));hb.scale.set(1.4,.1,1);hb.position.y=2.55;g.add(hb);\n  scene.add(g);\n  return {mesh:g,hp:100,max:100,bar:hb,cool:Math.random()*2,speed:2.5+Math.random(),legs:[legL,legR],walk:0};\n}\nfunction spawnTeams(){\n  [[-7,20],[7,20],[-15,15],[15,15]].forEach(p=>{const a=soldier(0x35583f,0x3b4034,0x31402f);a.mesh.position.set(p[0],0,p[1]);allies.push(a)});\n  [[-28,-32],[28,-32],[-38,-12],[38,-12],[0,-42],[-18,-38]].forEach(p=>{const e=soldier(0x6d3a33,0x4a4038,0x3b3f36);e.mesh.position.set(p[0],0,p[1]);enemies.push(e)});\n}\nspawnTeams();\n\nconst ray=new THREE.Raycaster();\nfunction shoot(){\n  const w=weapons[cur],a=ammo[cur],now=performance.now()/1000;\n  if(player.reloading>0||now-player.last<w.rate)return;\n  if(a.mag<=0)return reload();\n  player.last=now;a.mag--;flash.visible=true;setTimeout(()=>flash.visible=false,45);\n  gun.position.z=.45;setTimeout(()=>gun.position.z=0,70);\n  ray.setFromCamera(new THREE.Vector2((Math.random()-.5)*w.spread*40,(Math.random()-.5)*w.spread*40),camera);\n  const hit=ray.intersectObjects(enemies.map(e=>e.mesh),true)[0];\n  if(hit){let o=hit.object;while(o.parent&&!enemies.some(e=>e.mesh===o))o=o.parent;\n    const e=enemies.find(x=>x.mesh===o);\n    if(e){e.hp-=w.dmg;score+=10;hitmark();e.bar.scale.x=Math.max(.05,1.4*e.hp/e.max);\n      if(e.hp<=0){scene.remove(e.mesh);enemies.splice(enemies.indexOf(e),1);kills++;score+=150;feed('ENEMY ELIMINATED +150')}}}\n  hud();\n}\nfunction reload(){const w=weapons[cur],a=ammo[cur];if(player.reloading>0||a.mag===w.mag||!a.res)return;\n  player.reloading=w.reload;document.getElementById('reload').style.opacity=1;\n  setTimeout(()=>{const t=Math.min(w.mag-a.mag,a.res);a.mag+=t;a.res-=t;player.reloading=0;document.getElementById('reload').style.opacity=0;hud()},w.reload*1000)}\nfunction hitmark(){const h=document.getElementById('hitmark');h.style.opacity=1;setTimeout(()=>h.style.opacity=0,110)}\nfunction feed(t,team){const f=document.getElementById('feed'),d=document.createElement('div');d.textContent=t;if(team)d.className='team';f.prepend(d);setTimeout(()=>d.remove(),2600)}\nfunction hud(){const a=ammo[cur];document.getElementById('anum').textContent=a.mag;document.getElementById('ares').textContent=' / '+a.res;\n  document.getElementById('wname').textContent=weapons[cur].name;document.getElementById('score').textContent=score;\n  document.getElementById('teamLeft').textContent=allies.length;document.getElementById('enemyLeft').textContent=enemies.length;\n  document.getElementById('hpfill').style.width=Math.max(0,player.hp)+'%'}\nfunction end(win){over=true;playing=false;controls.unlock();\n  document.getElementById('endTitle').textContent=win?'MISSION COMPLETE':'MISSION FAILED';\n  document.getElementById('endStats').innerHTML=`Score: <b>${score}</b><br>Kills: <b>${kills}</b><br>Time: <b>${Math.floor((performance.now()-start)/1000)}s</b>`;\n  document.getElementById('end').classList.remove('hidden')}\n\naddEventListener('keydown',e=>{player.keys[e.code]=true;if(e.code==='KeyR')reload();if(e.code==='Digit1')cur='rifle';if(e.code==='Digit2')cur='pistol';hud()});\naddEventListener('keyup',e=>player.keys[e.code]=false);\nlet down=false;\nrenderer.domElement.addEventListener('mousedown',e=>{if(e.button===0){down=true;shoot()}});\naddEventListener('mouseup',()=>down=false);\ncontrols.addEventListener('unlock',()=>{if(playing&&!over)document.getElementById('pause').classList.remove('hidden')});\ndocument.getElementById('start').onclick=()=>{diff=+document.getElementById('diff').value;document.getElementById('menu').classList.add('hidden');document.getElementById('hud').style.display='block';controls.lock();playing=true;start=performance.now()};\ndocument.getElementById('how').onclick=()=>alert('Click DEPLOY, then click the game once to lock the mouse. Use WASD to walk and move the mouse to look around.');\ndocument.getElementById('resume').onclick=()=>{document.getElementById('pause').classList.add('hidden');controls.lock()};\n\nconst mm=document.getElementById('mm').getContext('2d');\nfunction minimap(){\n  mm.clearRect(0,0,150,150);mm.fillStyle='rgba(20,30,25,.9)';mm.fillRect(0,0,150,150);\n  const dot=(x,z,c)=>{mm.fillStyle=c;mm.beginPath();mm.arc((x+55)/110*150,(z+55)/110*150,3,0,7);mm.fill()};\n  allies.forEach(a=>dot(a.mesh.position.x,a.mesh.position.z,'#39ff6a'));\n  enemies.forEach(e=>dot(e.mesh.position.x,e.mesh.position.z,'#ff4444'));\n  dot(camera.position.x,camera.position.z,'#ffcc55');\n  const d=new THREE.Vector3();camera.getWorldDirection(d);\n  const px=(camera.position.x+55)/110*150,pz=(camera.position.z+55)/110*150;\n  mm.strokeStyle='#ffcc55';mm.beginPath();mm.moveTo(px,pz);mm.lineTo(px+d.x*14,pz+d.z*14);mm.stroke();\n}\n\nconst clock=new THREE.Clock();\nfunction animateLegs(u,moving){\n  u.walk+=moving?0.18:0;\n  u.legs[0].rotation.x=Math.sin(u.walk)*.55*(moving?1:0);\n  u.legs[1].rotation.x=-Math.sin(u.walk)*.55*(moving?1:0);\n}\nfunction ai(list,target,isEnemy){\n  list.forEach(u=>{\n    const tp=target===camera?camera.position:target.mesh.position;\n    const v=new THREE.Vector3().subVectors(tp,u.mesh.position);v.y=0;const dist=v.length();v.normalize();\n    let moving=false;\n    if(dist>(isEnemy?10:16)){u.mesh.position.addScaledVector(v,u.speed*diff*dt);moving=true}\n    const angle=Math.atan2(tp.x-u.mesh.position.x,tp.z-u.mesh.position.z);\n    u.mesh.rotation.y=angle;\n    animateLegs(u,moving);\n    u.cool-=dt;\n    if(u.cool<=0&&dist<45){u.cool=(isEnemy?1.1:1.5)+Math.random();\n      if(isEnemy){player.hp-=(5+Math.random()*5)*diff;const dg=document.getElementById('dmg');dg.style.opacity=.85;setTimeout(()=>dg.style.opacity=0,170);hud();if(player.hp<=0)end(false)}\n      else{const e=enemies[Math.floor(Math.random()*enemies.length)];if(e){e.hp-=15;e.bar.scale.x=Math.max(.05,1.4*e.hp/e.max);\n        if(e.hp<=0){scene.remove(e.mesh);enemies.splice(enemies.indexOf(e),1);score+=75;feed('ALLY ELIMINATED ENEMY +75',true)}}}\n    }\n  });\n}\nfunction animate(){\n  requestAnimationFrame(animate);const dt=Math.min(clock.getDelta(),.05);\n  if(playing&&!over&&controls.isLocked){\n    const sprint=player.keys.ShiftLeft;\n    const speed=(sprint?9:5.5)*dt;\n    let f=0,r=0;\n    if(player.keys.KeyW)f+=1;if(player.keys.KeyS)f-=1;\n    if(player.keys.KeyD)r+=1;if(player.keys.KeyA)r-=1;\n    controls.moveForward(f*speed);\n    controls.moveRight(r*speed);\n    camera.position.x=THREE.MathUtils.clamp(camera.position.x,-52,52);\n    camera.position.z=THREE.MathUtils.clamp(camera.position.z,-52,52);\n    if(player.keys.Space&&player.ground){player.vy=7.5;player.ground=false}\n    player.vy-=20*dt;camera.position.y+=player.vy*dt;\n    if(camera.position.y<=1.7){camera.position.y=1.7;player.vy=0;player.ground=true}\n    if(down&&weapons[cur].auto)shoot();\n    ai(enemies,camera,true);\n    if(enemies.length)ai(allies,enemies[0],false);\n    const t=Math.floor((performance.now()-start)/1000);\n    document.getElementById('time').textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');\n    minimap();\n    if(!enemies.length)end(true);\n  }\n  renderer.render(scene,camera);\n}\nanimate();\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});\n</script>\n</body>\n</html>"
    }
  ]
}