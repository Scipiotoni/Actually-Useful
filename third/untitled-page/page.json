    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>STRIKE OPS — Browser FPS</title>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { overflow:hidden; background:#000; font-family:Arial, sans-serif; color:#fff; }\n  canvas { display:block; }\n\n  #menu {\n    position:fixed; inset:0; z-index:20;\n    display:flex; align-items:center; justify-content:center;\n    background:radial-gradient(circle at center, #14202c, #05080c);\n  }\n  .panel {\n    width:min(680px, 92vw); padding:34px; border-radius:18px;\n    background:rgba(10,16,22,.92); border:1px solid #2b3a48;\n    box-shadow:0 25px 80px rgba(0,0,0,.7); text-align:center;\n  }\n  h1 { font-size:44px; letter-spacing:5px; color:#ffcc33; text-shadow:0 0 24px rgba(255,204,51,.35); }\n  .sub { margin:8px 0 22px; color:#9fb0bd; font-size:15px; }\n  .keys { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; text-align:left; margin-bottom:24px; }\n  .key { background:#101820; border:1px solid #26333f; padding:10px 12px; border-radius:9px; font-size:13px; color:#c8d4dc; }\n  b { color:#ffcc33; }\n  button {\n    padding:14px 34px; font-size:17px; font-weight:bold; cursor:pointer;\n    color:#101820; background:#ffcc33; border:none; border-radius:10px;\n    transition:.15s; letter-spacing:1px;\n  }\n  button:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(255,204,51,.3); }\n\n  #hud { position:fixed; inset:0; z-index:10; pointer-events:none; display:none; }\n  #crosshair {\n    position:absolute; left:50%; top:50%; width:26px; height:26px;\n    transform:translate(-50%,-50%);\n  }\n  #crosshair::before, #crosshair::after {\n    content:\"\"; position:absolute; background:#7dff9b; box-shadow:0 0 3px #000;\n  }\n  #crosshair::before { left:50%; top:0; width:2px; height:100%; transform:translateX(-50%); }\n  #crosshair::after { top:50%; left:0; height:2px; width:100%; transform:translateY(-50%); }\n\n  #healthbar {\n    position:absolute; left:24px; bottom:24px; width:270px;\n    background:rgba(0,0,0,.55); border:1px solid #32404d; border-radius:10px; padding:10px;\n  }\n  .label { font-size:11px; color:#9fb0bd; margin-bottom:5px; letter-spacing:1px; }\n  .bar { height:9px; background:#222c35; border-radius:5px; overflow:hidden; }\n  .fill { height:100%; width:100%; background:linear-gradient(90deg,#39d353,#7dff9b); transition:width .15s; }\n\n  #ammo {\n    position:absolute; right:24px; bottom:24px; text-align:right;\n    background:rgba(0,0,0,.55); border:1px solid #32404d; border-radius:10px; padding:10px 16px;\n  }\n  #ammoNum { font-size:30px; font-weight:bold; color:#ffcc33; }\n  #ammoMax { font-size:13px; color:#9fb0bd; }\n\n  #roundInfo {\n    position:absolute; top:18px; left:50%; transform:translateX(-50%);\n    background:rgba(0,0,0,.55); border:1px solid #32404d; border-radius:10px;\n    padding:8px 18px; font-size:15px; letter-spacing:1px;\n  }\n  #score { color:#7dff9b; font-weight:bold; }\n  #kills { color:#ffcc33; font-weight:bold; }\n\n  #hitmarker {\n    position:absolute; left:50%; top:50%; width:34px; height:34px;\n    transform:translate(-50%,-50%) rotate(45deg); opacity:0;\n  }\n  #hitmarker div {\n    position:absolute; background:#fff; width:12px; height:2px;\n  }\n  #hitmarker div:nth-child(1) { left:0; top:0; }\n  #hitmarker div:nth-child(2) { right:0; top:0; transform:rotate(90deg); }\n  #hitmarker div:nth-child(3) { left:0; bottom:0; }\n  #hitmarker div:nth-child(4) { right:0; bottom:0; transform:rotate(90deg); }\n\n  #damageFlash {\n    position:absolute; inset:0; background:rgba(255,0,0,.28); opacity:0; transition:opacity .25s;\n  }\n\n  #minimap {\n    position:absolute; right:24px; top:24px; width:170px; height:170px;\n    background:rgba(0,0,0,.6); border:1px solid #32404d; border-radius:10px;\n  }\n\n  #endScreen {\n    position:fixed; inset:0; z-index:25; display:none;\n    align-items:center; justify-content:center; background:rgba(0,0,0,.82);\n  }\n</style>\n</head>\n<body>\n\n<div id=\"menu\">\n  <div class=\"panel\">\n    <h1>STRIKE OPS</h1>\n    <div class=\"sub\">Tactical browser FPS • Eliminate all hostiles to win the round</div>\n    <div class=\"keys\">\n      <div class=\"key\"><b>WASD</b> — Move</div>\n      <div class=\"key\"><b>Mouse</b> — Aim</div>\n      <div class=\"key\"><b>Left Click</b> — Fire</div>\n      <div class=\"key\"><b>R</b> — Reload</div>\n      <div class=\"key\"><b>Shift</b> — Sprint</div>\n      <div class=\"key\"><b>Space</b> — Jump</div>\n      <div class=\"key\"><b>1 / 2</b> — Rifle / Pistol</div>\n      <div class=\"key\"><b>Esc</b> — Pause</div>\n    </div>\n    <button id=\"startBtn\">DEPLOY</button>\n  </div>\n</div>\n\n<div id=\"hud\">\n  <div id=\"crosshair\"></div>\n  <div id=\"hitmarker\"><div></div><div></div><div></div><div></div></div>\n  <div id=\"damageFlash\"></div>\n  <div id=\"roundInfo\">ROUND <span id=\"round\">1</span> • ENEMIES <span id=\"enemiesLeft\">0</span> • SCORE <span id=\"score\">0</span> • KILLS <span id=\"kills\">0</span></div>\n  <div id=\"healthbar\">\n    <div class=\"label\">HEALTH</div>\n    <div class=\"bar\"><div class=\"fill\" id=\"healthFill\"></div></div>\n  </div>\n  <div id=\"ammo\">\n    <div id=\"ammoNum\">30</div>\n    <div id=\"ammoMax\">/ 90 • RIFLE</div>\n  </div>\n  <canvas id=\"minimap\" width=\"170\" height=\"170\"></canvas>\n</div>\n\n<div id=\"endScreen\">\n  <div class=\"panel\">\n    <h1 id=\"endTitle\">ROUND COMPLETE</h1>\n    <div class=\"sub\" id=\"endText\"></div>\n    <button id=\"restartBtn\">PLAY AGAIN</button>\n  </div>\n</div>\n\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"three\": \"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\n    \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"\n  }\n}\n</script>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x0b1016);\nscene.fog = new THREE.Fog(0x0b1016, 35, 130);\n\nconst camera = new THREE.PerspectiveCamera(78, innerWidth/innerHeight, .1, 300);\nconst renderer = new THREE.WebGLRenderer({ antialias:true });\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\ndocument.body.appendChild(renderer.domElement);\n\nconst controls = new PointerLockControls(camera, renderer.domElement);\n\n// Lighting\nscene.add(new THREE.HemisphereLight(0x8fb4d8, 0x1a222b, .75));\nconst sun = new THREE.DirectionalLight(0xfff0c8, 1.35);\nsun.position.set(28, 46, 18);\nsun.castShadow = true;\nsun.shadow.mapSize.set(2048, 2048);\nsun.shadow.camera.left = -70;\nsun.shadow.camera.right = 70;\nsun.shadow.camera.top = 70;\nsun.shadow.camera.bottom = -70;\nscene.add(sun);\n\n// Arena\nconst world = new THREE.Group();\nscene.add(world);\n\nconst ground = new THREE.Mesh(\n  new THREE.PlaneGeometry(150, 150),\n  new THREE.MeshStandardMaterial({ color:0x2c343c, roughness:.95 })\n);\nground.rotation.x = -Math.PI/2;\nground.receiveShadow = true;\nworld.add(ground);\n\nfunction box(x,y,z,w,h,d,color,rough=.8){\n  const m = new THREE.Mesh(\n    new THREE.BoxGeometry(w,h,d),\n    new THREE.MeshStandardMaterial({ color, roughness:rough })\n  );\n  m.position.set(x,y,z);\n  m.castShadow = true;\n  m.receiveShadow = true;\n  world.add(m);\n  return m;\n}\n\n// Outer walls\nconst wallColor = 0x3a4652;\nbox(0, 5, -60, 120, 10, 2, wallColor);\nbox(0, 5, 60, 120, 10, 2, wallColor);\nbox(-60, 5, 0, 2, 10, 120, wallColor);\nbox(60, 5, 0, 2, 10, 120, wallColor);\n\n// Map structures\nconst crate = 0x7a5a34;\nconst concrete = 0x4b5661;\nconst metal = 0x5c6a77;\n\nbox(-22, 1, -18, 8, 2, 8, crate);\nbox(-22, 3, -18, 6, 2, 6, crate);\nbox(20, 1, -24, 10, 2, 6, concrete);\nbox(0, 2, -34, 26, 4, 2, concrete);\nbox(-34, 1.5, 12, 2, 3, 22, metal);\nbox(34, 1.5, 12, 2, 3, 22, metal);\nbox(0, 1, 18, 16, 2, 4, concrete);\nbox(-12, 2.5, 34, 4, 5, 4, crate);\nbox(12, 2.5, 34, 4, 5, 4, crate);\nbox(0, 4, 0, 6, 8, 6, concrete);\nbox(-42, 1, -38, 10, 2, 10, crate);\nbox(42, 1, 38, 10, 2, 10, crate);\nbox(-45, 2, 35, 6, 4, 6, metal);\nbox(45, 2, -35, 6, 4, 6, metal);\n\n// Collision boxes\nconst colliders = [];\nworld.children.forEach(o => {\n  if (o !== ground) {\n    const b = new THREE.Box3().setFromObject(o);\n    colliders.push(b);\n  }\n});\n\n// Player\nconst player = {\n  health:100, maxHealth:100,\n  velocity:new THREE.Vector3(),\n  onGround:true,\n  radius:.45,\n  height:1.7\n};\ncamera.position.set(0, player.height, 45);\n\nconst keys = {};\naddEventListener('keydown', e => {\n  keys[e.code] = true;\n  if (e.code === 'KeyR') reload();\n  if (e.code === 'Digit1') switchWeapon(0);\n  if (e.code === 'Digit2') switchWeapon(1);\n});\naddEventListener('keyup', e => keys[e.code] = false);\n\n// Weapons\nconst weapons = [\n  { name:'RIFLE', damage:26, fireRate:.105, mag:30, reserve:90, spread:.012, recoil:.025, auto:true, sound:520 },\n  { name:'PISTOL', damage:38, fireRate:.24, mag:12, reserve:48, spread:.006, recoil:.018, auto:false, sound:760 }\n];\nlet currentWeapon = 0;\nweapons.forEach(w => { w.ammo = w.mag; });\n\nlet shooting = false;\nlet lastShot = 0;\nlet reloading = false;\n\naddEventListener('mousedown', e => {\n  if (e.button === 0) shooting = true;\n});\naddEventListener('mouseup', e => {\n  if (e.button === 0) shooting = false;\n});\n\nfunction switchWeapon(i){\n  if (i === currentWeapon || reloading) return;\n  currentWeapon = i;\n  updateHUD();\n}\n\nfunction reload(){\n  const w = weapons[currentWeapon];\n  if (reloading || w.ammo === w.mag || w.reserve <= 0) return;\n  reloading = true;\n  setTimeout(() => {\n    const need = w.mag - w.ammo;\n    const take = Math.min(need, w.reserve);\n    w.ammo += take;\n    w.reserve -= take;\n    reloading = false;\n    updateHUD();\n  }, 1100);\n}\n\n// Audio\nlet audioCtx;\nfunction beep(freq, duration=.08, type='square', volume=.08){\n  if (!audioCtx) audioCtx = new AudioContext();\n  const o = audioCtx.createOscillator();\n  const g = audioCtx.createGain();\n  o.type = type;\n  o.frequency.value = freq;\n  g.gain.value = volume;\n  o.connect(g);\n  g.connect(audioCtx.destination);\n  o.start();\n  g.gain.exponentialRampToValueAtTime(.0001, audioCtx.currentTime + duration);\n  o.stop(audioCtx.currentTime + duration);\n}\n\n// Enemies\nconst enemies = [];\nconst enemyGeo = new THREE.CapsuleGeometry(.45, 1, 6, 12);\nconst enemyMat = new THREE.MeshStandardMaterial({ color:0xd94b3a, roughness:.55 });\nconst enemyHeadMat = new THREE.MeshStandardMaterial({ color:0x2a2f36 });\n\nfunction spawnEnemy(){\n  const g = new THREE.Group();\n\n  const body = new THREE.Mesh(enemyGeo, enemyMat);\n  body.position.y = 1;\n  body.castShadow = true;\n  g.add(body);\n\n  const head = new THREE.Mesh(new THREE.SphereGeometry(.32, 16, 12), enemyHeadMat);\n  head.position.y = 2;\n  head.castShadow = true;\n  g.add(head);\n\n  const edge = 52;\n  const x = (Math.random()*2-1) * edge;\n  const z = (Math.random()*2-1) * edge;\n  g.position.set(x, 0, z);\n\n  scene.add(g);\n  enemies.push({\n    mesh:g, head, health:100,\n    speed:2.5 + Math.random()*1.6,\n    lastAttack:0,\n    alive:true\n  });\n}\n\nfunction clearEnemies(){\n  enemies.forEach(e => scene.remove(e.mesh));\n  enemies.length = 0;\n}\n\n// Bullets / tracers\nconst tracers = [];\nfunction shoot(){\n  const now = performance.now()/1000;\n  const w = weapons[currentWeapon];\n\n  if (reloading || now - lastShot < w.fireRate) return;\n  if (w.ammo <= 0){\n    beep(180, .08, 'sawtooth', .04);\n    reload();\n    return;\n  }\n\n  lastShot = now;\n  w.ammo--;\n  updateHUD();\n  beep(w.sound, .06, 'square', .07);\n\n  const dir = new THREE.Vector3();\n  camera.getWorldDirection(dir);\n\n  dir.x += (Math.random()-.5) * w.spread;\n  dir.y += (Math.random()-.5) * w.spread;\n  dir.z += (Math.random()-.5) * w.spread;\n  dir.normalize();\n\n  const ray = new THREE.Raycaster(camera.position.clone(), dir, 0, 180);\n  const targets = [];\n  enemies.forEach(e => { if (e.alive) targets.push(e.mesh); });\n  const hits = ray.intersectObjects(targets, true);\n\n  // Tracer\n  const start = camera.position.clone().add(dir.clone().multiplyScalar(.7));\n  let end = start.clone().add(dir.clone().multiplyScalar(120));\n\n  if (hits.length){\n    end = hits[0].point.clone();\n    const enemyGroup = hits[0].object.parent;\n    const enemy = enemies.find(e => e.mesh === enemyGroup);\n\n    if (enemy){\n      const isHead = hits[0].object === enemy.head;\n      const dmg = isHead ? w.damage * 3.2 : w.damage;\n      enemy.health -= dmg;\n      showHitmarker();\n      beep(isHead ? 1250 : 900, .05, 'sine', .05);\n\n      if (enemy.health <= 0){\n        enemy.alive = false;\n        scene.remove(enemy.mesh);\n        score += isHead ? 250 : 100;\n        kills++;\n        updateHUD();\n        beep(300, .18, 'triangle', .09);\n      }\n    }\n  }\n\n  const geometry = new THREE.BufferGeometry().setFromPoints([start, end]);\n  const line = new THREE.Line(geometry, new THREE.LineBasicMaterial({ color:0xffe27a, transparent:true, opacity:.8 }));\n  scene.add(line);\n  tracers.push({ line, life:.06 });\n}\n\nfunction showHitmarker(){\n  const h = document.getElementById('hitmarker');\n  h.style.opacity = 1;\n  setTimeout(() => h.style.opacity = 0, 90);\n}\n\nfunction damagePlayer(amount){\n  player.health = Math.max(0, player.health - amount);\n  updateHUD();\n\n  const flash = document.getElementById('damageFlash');\n  flash.style.opacity = .8;\n  setTimeout(() => flash.style.opacity = 0, 90);\n  beep(140, .12, 'sawtooth', .09);\n\n  if (player.health <= 0) endGame(false);\n}\n\n// Collision\nfunction collides(position){\n  const p = new THREE.Box3(\n    new THREE.Vector3(position.x-player.radius, position.y-player.height, position.z-player.radius),\n    new THREE.Vector3(position.x+player.radius, position.y, position.z+player.radius)\n  );\n  return colliders.some(c => p.intersectsBox(c));\n}\n\nfunction moveWithCollision(delta){\n  const speed = keys['ShiftLeft'] ? 9.5 : 5.8;\n  const forward = new THREE.Vector3();\n  const right = new THREE.Vector3();\n\n  camera.getWorldDirection(forward);\n  forward.y = 0;\n  forward.normalize();\n  right.crossVectors(forward, new THREE.Vector3(0,1,0)).normalize();\n\n  const move = new THREE.Vector3();\n  if (keys['KeyW']) move.add(forward);\n  if (keys['KeyS']) move.sub(forward);\n  if (keys['KeyD']) move.add(right);\n  if (keys['KeyA']) move.sub(right);\n\n  if (move.lengthSq() > 0) move.normalize().multiplyScalar(speed * delta);\n\n  const next = camera.position.clone();\n  next.x += move.x;\n  if (!collides(next)) camera.position.x = next.x;\n\n  next.copy(camera.position);\n  next.z += move.z;\n  if (!collides(next)) camera.position.z = next.z;\n\n  // Gravity and jump\n  player.velocity.y -= 23 * delta;\n  camera.position.y += player.velocity.y * delta;\n\n  if (camera.position.y <= player.height){\n    camera.position.y = player.height;\n    player.velocity.y = 0;\n    player.onGround = true;\n  }\n\n  if (keys['Space'] && player.onGround){\n    player.velocity.y = 8.2;\n    player.onGround = false;\n  }\n\n  // Arena bounds\n  camera.position.x = THREE.MathUtils.clamp(camera.position.x, -57, 57);\n  camera.position.z = THREE.MathUtils.clamp(camera.position.z, -57, 57);\n}\n\n// HUD\nlet score = 0;\nlet kills = 0;\nlet round = 1;\nlet enemiesToSpawn = 4;\nlet roundActive = false;\n\nfunction updateHUD(){\n  const w = weapons[currentWeapon];\n  document.getElementById('ammoNum').textContent = reloading ? '--' : w.ammo;\n  document.getElementById('ammoMax').textContent = `/ ${w.reserve} • ${w.name}`;\n  document.getElementById('healthFill').style.width = player.health + '%';\n  document.getElementById('round').textContent = round;\n  document.getElementById('score').textContent = score;\n  document.getElementById('kills').textContent = kills;\n  document.getElementById('enemiesLeft').textContent = enemies.filter(e => e.alive).length + Math.max(0, enemiesToSpawn);\n}\n\nfunction startRound(){\n  roundActive = true;\n  enemiesToSpawn = 3 + round * 2;\n  updateHUD();\n}\n\nfunction endGame(win){\n  roundActive = false;\n  controls.unlock();\n  document.getElementById('endScreen').style.display = 'flex';\n  document.getElementById('endTitle').textContent = win ? 'VICTORY' : 'YOU DIED';\n  document.getElementById('endTitle').style.color = win ? '#7dff9b' : '#ff5d5d';\n  document.getElementById('endText').textContent =\n    `Round ${round} • Score ${score} • Kills ${kills}`;\n}\n\nfunction restart(){\n  player.health = player.maxHealth;\n  score = 0;\n  kills = 0;\n  round = 1;\n  enemiesToSpawn = 4;\n  weapons.forEach(w => { w.ammo = w.mag; w.reserve = w.name === 'RIFLE' ? 90 : 48; });\n  camera.position.set(0, player.height, 45);\n  clearEnemies();\n  document.getElementById('endScreen').style.display = 'none';\n  updateHUD();\n  startRound();\n  controls.lock();\n}\n\ndocument.getElementById('startBtn').onclick = () => {\n  document.getElementById('menu').style.display = 'none';\n  document.getElementById('hud').style.display = 'block';\n  audioCtx = new AudioContext();\n  updateHUD();\n  startRound();\n  controls.lock();\n};\n\ndocument.getElementById('restartBtn').onclick = restart;\n\ncontrols.addEventListener('unlock', () => {\n  if (roundActive && player.health > 0){\n    document.getElementById('menu').style.display = 'flex';\n    document.getElementById('startBtn').textContent = 'RESUME';\n  }\n});\n\ncontrols.addEventListener('lock', () => {\n  document.getElementById('menu').style.display = 'none';\n});\n\n// Minimap\nconst minimap = document.getElementById('minimap');\nconst mctx = minimap.getContext('2d');\n\nfunction drawMinimap(){\n  mctx.clearRect(0,0,170,170);\n  mctx.fillStyle = 'rgba(8,12,16,.9)';\n  mctx.fillRect(0,0,170,170);\n\n  const scale = 170/120;\n  const cx = 85, cy = 85;\n\n  mctx.fillStyle = '#3c4a56';\n  world.children.forEach(o => {\n    if (o === ground) return;\n    const p = o.position;\n    mctx.fillRect(cx + p.x*scale - 2, cy + p.z*scale - 2, 4, 4);\n  });\n\n  enemies.forEach(e => {\n    if (!e.alive) return;\n    mctx.fillStyle = '#ff5d5d';\n    mctx.beginPath();\n    mctx.arc(cx + e.mesh.position.x*scale, cy + e.mesh.position.z*scale, 3.5, 0, Math.PI*2);\n    mctx.fill();\n  });\n\n  mctx.fillStyle = '#7dff9b';\n  mctx.beginPath();\n  mctx.arc(cx + camera.position.x*scale, cy + camera.position.z*scale, 4.5, 0, Math.PI*2);\n  mctx.fill();\n}\n\n// Game loop\nconst clock = new THREE.Clock();\n\nfunction animate(){\n  requestAnimationFrame(animate);\n  const delta = Math.min(clock.getDelta(), .05);\n\n  if (controls.isLocked && roundActive){\n    moveWithCollision(delta);\n\n    const w = weapons[currentWeapon];\n    if (shooting && (w.auto || !shooting || performance.now()/1000 - lastShot > w.fireRate)){\n      shoot();\n    }\n\n    // Enemy AI\n    const playerPos = camera.position;\n    enemies.forEach(enemy => {\n      if (!enemy.alive) return;\n\n      const target = new THREE.Vector3(playerPos.x, 0, playerPos.z);\n      const pos = enemy.mesh.position;\n      const dir = target.clone().sub(pos).setY(0);\n\n      const distance = dir.length();\n      dir.normalize();\n\n      if (distance > 7){\n        const next = pos.clone().add(dir.multiplyScalar(enemy.speed * delta));\n        next.y = 0;\n        if (!collides(next)) enemy.mesh.position.copy(next);\n      }\n\n      enemy.mesh.lookAt(playerPos.x, 0, playerPos.z);\n\n      if (distance < 24 && performance.now()/1000 - enemy.lastAttack > 1.1){\n        enemy.lastAttack = performance.now()/1000;\n        if (Math.random() < .58){\n          damagePlayer(7 + Math.random()*7);\n        }\n        beep(220, .05, 'square', .05);\n      }\n    });\n\n    // Round progression\n    const alive = enemies.filter(e => e.alive).length;\n    if (alive < 4 && enemiesToSpawn > 0){\n      spawnEnemy();\n      enemiesToSpawn--;\n      updateHUD();\n    }\n\n    if (alive === 0 && enemiesToSpawn === 0){\n      round++;\n      player.health = Math.min(player.maxHealth, player.health + 35);\n      weapons.forEach(w => w.reserve += 30);\n      updateHUD();\n      endGame(true);\n    }\n  }\n\n  // Tracers\n  for (let i = tracers.length-1; i >= 0; i--){\n    tracers[i].life -= delta;\n    tracers[i].line.material.opacity = Math.max(0, tracers[i].life / .06);\n    if (tracers[i].life <= 0){\n      scene.remove(tracers[i].line);\n      tracers.splice(i,1);\n    }\n  }\n\n  drawMinimap();\n  renderer.render(scene, camera);\n}\n\naddEventListener('resize', () => {\n  camera.aspect = innerWidth/innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth, innerHeight);\n});\n\nanimate();\n</script>\n</body>\n</html>"
    }
  ]
}