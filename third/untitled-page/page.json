      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>OPERATION BLACKOUT — City Royale</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{overflow:hidden;background:#04060a;font-family:'Segoe UI',Arial,sans-serif;color:#eaf1f7}\ncanvas{display:block}\n#hud{position:fixed;inset:0;pointer-events:none;display:none}\n.cross{position:absolute;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%)}\n.cross i{position:absolute;background:#9dff7a;box-shadow:0 0 8px #9dff7a}\n.cross i:nth-child(1){left:50%;top:0;width:2px;height:10px;transform:translateX(-50%)}\n.cross i:nth-child(2){left:50%;bottom:0;width:2px;height:10px;transform:translateX(-50%)}\n.cross i:nth-child(3){top:50%;left:0;height:2px;width:10px;transform:translateY(-50%)}\n.cross i:nth-child(4){top:50%;right:0;height:2px;width:10px;transform:translateY(-50%)}\n#hitmark{position:absolute;left:50%;top:50%;width:32px;height:32px;transform:translate(-50%,-50%) rotate(45deg);opacity:0;transition:opacity .1s}\n#hitmark:before,#hitmark:after{content:\"\";position:absolute;background:#fff}\n#hitmark:before{left:50%;top:0;width:3px;height:100%;transform:translateX(-50%)}\n#hitmark:after{top:50%;left:0;height:3px;width:100%;transform:translateY(-50%)}\n#dmg{position:absolute;inset:0;background:radial-gradient(circle,transparent 38%,rgba(190,0,0,.75));opacity:0;transition:opacity .2s}\n#top{position:absolute;top:16px;left:50%;transform:translateX(-50%);display:flex;gap:12px}\n.chip{background:rgba(6,10,14,.78);border:1px solid rgba(120,200,255,.25);padding:8px 16px;border-radius:12px;font-size:13px;letter-spacing:2px;backdrop-filter:blur(8px)}\n.chip b{color:#7fd4ff}\n#feed{position:absolute;top:82px;right:20px;width:310px;text-align:right;font-size:12px}\n#feed div{background:rgba(6,10,14,.72);border-right:3px solid #ff5533;padding:6px 10px;margin-bottom:5px;border-radius:6px}\n#feed div.team{border-right-color:#39ff6a}\n#hpwrap{position:absolute;left:24px;bottom:24px;width:310px}\n#hpwrap .label{font-size:11px;letter-spacing:3px;opacity:.8;margin-bottom:6px}\n#hpbar{height:15px;background:rgba(0,0,0,.6);border:1px solid #333;border-radius:10px;overflow:hidden}\n#hpfill{height:100%;width:100%;background:linear-gradient(90deg,#7dffb0,#12a35a);transition:width .15s}\n#ammo{position:absolute;right:28px;bottom:22px;text-align:right;text-shadow:0 0 12px #000}\n#wname{font-size:12px;letter-spacing:3px;color:#7fd4ff}\n#anum{font-size:46px;font-weight:800}\n#ares{font-size:18px;opacity:.75}\n#minimap{position:absolute;left:24px;top:24px;width:170px;height:170px;background:rgba(4,9,14,.78);border:1px solid rgba(255,255,255,.16);border-radius:14px}\n#tip{position:absolute;left:50%;bottom:95px;transform:translateX(-50%);background:rgba(6,10,14,.85);padding:10px 20px;border-radius:12px;font-size:13px;letter-spacing:2px;color:#7fd4ff;opacity:0;transition:opacity .3s}\n.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:20;background:radial-gradient(circle at 50% 20%,rgba(24,48,78,.97),rgba(2,5,9,.99))}\n.lobby{width:min(1000px,95vw);max-height:95vh;overflow:auto;background:linear-gradient(155deg,rgba(10,18,28,.97),rgba(4,7,11,.99));border:1px solid rgba(110,190,255,.28);border-radius:22px;padding:32px;box-shadow:0 30px 100px rgba(0,0,0,.8)}\n.logo{font-size:44px;font-weight:900;letter-spacing:8px;text-align:center;background:linear-gradient(90deg,#7fd4ff,#a56bff,#ff7ac8);-webkit-background-clip:text;background-clip:text;color:transparent}\n.sub{letter-spacing:4px;font-size:12px;color:#8fa6b8;text-align:center;margin:8px 0 22px}\n.grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:16px;margin-bottom:20px}\n.card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:16px}\n.card h3{font-size:12px;letter-spacing:3px;color:#7fd4ff;margin-bottom:10px}\n.card p,.card li{font-size:12.5px;color:#c8d6e2;line-height:1.75}\n.card ul{list-style:none}\nselect{pointer-events:auto;width:100%;background:#101823;color:#fff;border:1px solid #2c3d4d;padding:10px;border-radius:10px}\n.colors{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}\n.swatch{pointer-events:auto;width:34px;height:34px;border-radius:9px;cursor:pointer;border:2px solid transparent}\n.swatch.sel{border-color:#7fd4ff;transform:scale(1.08)}\n.btn{pointer-events:auto;border:none;cursor:pointer;font-weight:800;letter-spacing:3px;padding:16px 40px;border-radius:12px;background:linear-gradient(90deg,#7fd4ff,#a56bff);color:#081018;font-size:16px}\n.btn:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(120,190,255,.3)}\n.btn.ghost{background:transparent;color:#7fd4ff;border:1px solid rgba(127,212,255,.5)}\n.row{display:flex;gap:12px;justify-content:center}\n.hidden{display:none!important}\n</style>\n</head>\n<body>\n<div id=\"hud\">\n  <div class=\"cross\"><i></i><i></i><i></i><i></i></div>\n  <div id=\"hitmark\"></div><div id=\"dmg\"></div>\n  <div id=\"top\">\n    <div class=\"chip\">SCORE <b id=\"score\">0</b></div>\n    <div class=\"chip\">SQUAD <b id=\"teamLeft\">3</b></div>\n    <div class=\"chip\">ENEMIES <b id=\"enemyLeft\">8</b></div>\n    <div class=\"chip\">TIME <b id=\"time\">0:00</b></div>\n  </div>\n  <div id=\"feed\"></div>\n  <div id=\"minimap\"><canvas id=\"mm\" width=\"170\" height=\"170\"></canvas></div>\n  <div id=\"hpwrap\"><div class=\"label\">HEALTH</div><div id=\"hpbar\"><div id=\"hpfill\"></div></div></div>\n  <div id=\"ammo\"><div id=\"wname\">AR-9 RIFLE</div><div><span id=\"anum\">30</span><span id=\"ares\"> / 180</span></div></div>\n  <div id=\"tip\">CLICK TO LOCK MOUSE</div>\n</div>\n\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"lobby\">\n    <div class=\"logo\">OPERATION BLACKOUT</div>\n    <div class=\"sub\">CITY ROYALE • ENTERABLE SKYSCRAPERS • SQUAD DEPLOYMENT</div>\n    <div class=\"grid\">\n      <div class=\"card\"><h3>OPERATOR</h3><p>Choose your uniform color. Your character model updates in the city.</p>\n        <div class=\"colors\" id=\"colors\"></div>\n      </div>\n      <div class=\"card\"><h3>DEPLOYMENT</h3><p>Select match difficulty and graphics quality.</p>\n        <select id=\"diff\" style=\"margin-top:10px\"><option value=\"0.8\">Recruit</option><option value=\"1\" selected>Regular</option><option value=\"1.35\">Veteran</option></select>\n        <select id=\"quality\" style=\"margin-top:10px\"><option value=\"1\">High Graphics</option><option value=\"0.7\">Balanced</option><option value=\"0.5\">Performance</option></select>\n      </div>\n      <div class=\"card\"><h3>CONTROLS</h3><ul>\n        <li><b>W A S D</b> — Move</li><li><b>Mouse</b> — Look</li><li><b>Left click</b> — Fire</li>\n        <li><b>Shift</b> — Sprint</li><li><b>Space</b> — Jump</li><li><b>R</b> — Reload</li>\n        <li><b>1 / 2</b> — Weapons</li><li><b>Esc</b> — Pause</li></ul></div>\n    </div>\n    <div class=\"grid\">\n      <div class=\"card\" style=\"grid-column:span 3\"><h3>MISSION BRIEFING</h3><p>Deploy into Neon City with your 3-operator squad. Hunt 8 enemy soldiers across streets, plazas, and enterable skyscraper lobbies. Clear all enemies to win.</p></div>\n    </div>\n    <div class=\"row\"><button class=\"btn\" id=\"start\">ENTER CITY</button><button class=\"btn ghost\" onclick=\"alert('Click ENTER CITY, then click the 3D city once to lock your mouse. WASD moves you in the direction you look.')\">HOW TO PLAY</button></div>\n  </div>\n</div>\n\n<div id=\"pause\" class=\"screen hidden\"><div class=\"lobby\" style=\"width:min(500px,90vw);text-align:center\"><div class=\"logo\" style=\"font-size:34px\">PAUSED</div><div class=\"row\" style=\"margin-top:24px\"><button class=\"btn\" id=\"resume\">RESUME</button><button class=\"btn ghost\" onclick=\"location.reload()\">RESTART</button></div></div></div>\n<div id=\"end\" class=\"screen hidden\"><div class=\"lobby\" style=\"width:min(580px,90vw);text-align:center\"><div class=\"logo\" id=\"endTitle\">CITY CLEARED</div><div id=\"endStats\" style=\"margin:16px 0 24px;color:#c8d6e2;line-height:1.8\"></div><button class=\"btn\" onclick=\"location.reload()\">PLAY AGAIN</button></div></div>\n\n<script type=\"importmap\">\n{\"imports\":{\"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\"}}\n</script>\n<script type=\"module\">\nimport * as THREE from 'three';\n\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x0d1522);\nscene.fog=new THREE.Fog(0x0d1522,60,260);\nconst camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.08,600);\ncamera.rotation.order='YXZ';camera.position.set(0,1.7,52);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,2));\ndocument.body.appendChild(renderer.domElement);\n\nscene.add(new THREE.HemisphereLight(0x9fc7ff,0x1a2030,.85));\nconst moon=new THREE.DirectionalLight(0xbfd8ff,1.1);\nmoon.position.set(60,90,40);moon.castShadow=true;\nmoon.shadow.mapSize.set(2048,2048);moon.shadow.camera.left=-90;moon.shadow.camera.right=90;\nmoon.shadow.camera.top=90;moon.shadow.camera.bottom=-90;scene.add(moon);\n\nconst world=new THREE.Group();scene.add(world);\nconst colliders=[];\nconst M=(c,r=.75,m=.08)=>new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});\nfunction solid(w,h,d,x,y,z,c,opts={}){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),M(c,opts.rough??.75,opts.metal??.08));\n  m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;world.add(m);\n  if(!opts.noCollide)colliders.push({x,z,w,d});\n  return m;\n}\n// City ground, roads, sidewalks\nconst ground=new THREE.Mesh(new THREE.PlaneGeometry(190,190),M(0x2b3138,.95));\nground.rotation.x=-Math.PI/2;ground.receiveShadow=true;world.add(ground);\nfor(let i=-80;i<=80;i+=20){\n  const r=new THREE.Mesh(new THREE.PlaneGeometry(8,190),M(0x22262b,.95));\n  r.rotation.x=-Math.PI/2;r.position.set(i,.01,0);r.receiveShadow=true;world.add(r);\n  const r2=r.clone();r2.rotation.z=Math.PI/2;world.add(r2);\n}\n// Neon street lights\nfor(let i=-70;i<=70;i+=25){\n  for(const [x,z] of [[i,8],[i,-8],[8,i],[-8,i]]){\n    const pole=new THREE.Mesh(new THREE.CylinderGeometry(.08,.08,5),M(0x30363d,.5,.5));\n    pole.position.set(x,2.5,z);world.add(pole);\n    const lamp=new THREE.PointLight(0x8fd0ff,18,20);lamp.position.set(x,5,z);world.add(lamp);\n  }\n}\n\n// Enterable skyscraper: glass lobby with open entrances on all sides\nfunction skyscraper(x,z,w,d,level\n"
    }
  ]
}