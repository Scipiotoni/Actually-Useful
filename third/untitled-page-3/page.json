    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MTB RIDERS — Realistic 3D Mountain Biking</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,Arial,sans-serif}\nbody{overflow:hidden;background:#04070d;color:#fff}\ncanvas{display:block}\n.screen{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:linear-gradient(180deg,#0b1626,#04070d);z-index:20}\n.screen.active{display:flex}\n.panel{width:min(1050px,95vw);max-height:92vh;overflow:auto;background:rgba(9,15,26,.94);border:1px solid #22405f;border-radius:20px;padding:30px;box-shadow:0 0 80px #00a2ff22}\nh1{font-size:46px;letter-spacing:4px;color:#4ee1ff;text-shadow:0 0 30px #00b7ff}\nh2{margin:20px 0 10px;color:#9ad9ff}\np{color:#b8c7d9;line-height:1.5}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px}\n.card{background:#0e182a;border:1px solid #26507a;border-radius:14px;padding:16px}\n.card b{color:#4ee1ff}\nbutton{cursor:pointer;border:0;border-radius:10px;padding:12px 18px;font-weight:700;background:linear-gradient(90deg,#00a2ff,#7b5cff);color:#fff;transition:.2s}\nbutton:hover{transform:translateY(-2px);box-shadow:0 8px 22px #00a2ff55}\nbutton:disabled{opacity:.4;cursor:not-allowed;transform:none}\nbutton.ghost{background:#142238;border:1px solid #2f5c86}\nbutton.danger{background:#8f1d2c}\ninput,select{width:100%;padding:11px;border-radius:9px;border:1px solid #2f5c86;background:#091322;color:#fff;margin-top:6px}\nlabel{font-size:12px;color:#9fb4cc}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.small{font-size:12px;color:#7f93aa}\n.hidden{display:none!important}\n#hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:5}\n#hud.active{display:block}\n.hudbox{position:absolute;background:rgba(3,9,18,.62);border:1px solid #22405f;border-radius:12px;padding:10px 14px;backdrop-filter:blur(5px)}\n#speed{left:20px;bottom:20px;font-size:32px;font-weight:800;color:#4ee1ff}\n#trick{left:50%;top:75px;transform:translateX(-50%);font-size:28px;color:#ffe45e;text-align:center}\n#score{right:20px;top:20px;font-size:18px}\n#mapname{left:20px;top:20px}\n#controls{right:20px;bottom:20px;font-size:12px;color:#b8c7d9;max-width:330px}\n#toasts{position:fixed;right:20px;top:80px;z-index:30;display:flex;flex-direction:column;gap:8px}\n.toast{background:#0b1a2d;border:1px solid #00b7ff;border-radius:10px;padding:10px 14px;animation:fade 4s forwards}\n@keyframes fade{0%{opacity:0;transform:translateX(30px)}10%,80%{opacity:1;transform:none}100%{opacity:0}}\n#editorUI{position:fixed;left:20px;top:20px;z-index:10;display:none;background:rgba(4,10,20,.88);border:1px solid #22405f;border-radius:12px;padding:14px;width:300px}\n#editorUI.active{display:block}\n#lobbyOptions{margin-top:16px;padding:16px;background:#0a1322;border:1px dashed #2f5c86;border-radius:12px}\n.tag{display:inline-block;background:#12233c;border:1px solid #2b4a75;padding:4px 8px;border-radius:20px;font-size:11px;margin:2px}\n</style>\n</head>\n<body>\n\n<div id=\"menu\" class=\"screen active\">\n  <div class=\"panel\">\n    <h1>MTB RIDERS</h1>\n    <p>A more realistic 3D mountain-bike experience: terrain physics, air tricks, career progression, freeride, custom trails and a 50-rider lobby.</p>\n\n    <div class=\"grid\">\n      <div class=\"card\"><b>Rider name</b><input id=\"username\" value=\"Rider\" maxlength=\"18\"></div>\n      <div class=\"card\"><b>Camera</b><select id=\"cameraMode\"><option value=\"third\">Third person</option><option value=\"first\">First person / bars</option></select></div>\n      <div class=\"card\"><b>Graphics</b><select id=\"quality\"><option value=\"high\">High — shadows, fog, dense scenery</option><option value=\"medium\">Medium</option><option value=\"low\">Low — best performance</option></select></div>\n      <div class=\"card\"><b>Difficulty</b><select id=\"difficulty\"><option>Chill</option><option selected>Normal</option><option>Pro</option></select></div>\n    </div>\n\n    <h2>Play</h2>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Career</b><p>Ride 50 progressive maps, earn XP and unlock bikes.</p><button onclick=\"startGame('career')\">Start career</button></div>\n      <div class=\"card\"><b>Freeride</b><p>Explore an open mountain, hit jumps and throw tricks.</p><button onclick=\"startGame('free')\">Enter freeride</button></div>\n      <div class=\"card\"><b>Multiplayer lobby</b><p>Create or join a lobby with up to 50 riders.</p><button class=\"ghost\" onclick=\"openLobby()\">Open lobby</button></div>\n      <div class=\"card\"><b>Map creator</b><p>Build custom trails with jumps, drops, trees and checkpoints.</p><button class=\"ghost\" onclick=\"startGame('editor')\">Open creator</button></div>\n    </div>\n\n    <h2>Garage</h2>\n    <div id=\"bikeGarage\" class=\"grid\"></div>\n\n    <h2>Tricks</h2>\n    <p class=\"small\">Get airborne, hold <b>SHIFT</b>, then press a number key. Release SHIFT before landing to score.</p>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Barspin</b><p>SHIFT + 1</p></div>\n      <div class=\"card\"><b>360</b><p>SHIFT + 2</p></div>\n      <div class=\"card\"><b>Backflip</b><p>SHIFT + 3</p></div>\n      <div class=\"card\"><b>No-foot can</b><p>SHIFT + 4</p></div>\n      <div class=\"card\"><b>Superman</b><p>SHIFT + 5</p></div>\n      <div class=\"card\"><b>Tailwhip</b><p>SHIFT + 6</p></div>\n    </div>\n  </div>\n</div>\n\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"panel\">\n    <h1>RACE LOBBY</h1>\n    <p>Lobby supports up to 50 riders. This browser-only version fills empty slots with AI riders; true online multiplayer requires a server.</p>\n\n    <div class=\"row\" style=\"margin-top:16px\">\n      <button onclick=\"startGame('race')\">Start race</button>\n      <button class=\"ghost\" onclick=\"startGame('free')\">Freeride together</button>\n      <button class=\"ghost\" onclick=\"showScreen('menu')\">Back</button>\n      <button class=\"ghost\" onclick=\"toggleLobbyOptions()\">⚙ Hidden lobby options</button>\n    </div>\n\n    <div id=\"lobbyOptions\" class=\"hidden\">\n      <div class=\"grid\">\n        <div class=\"card\"><label>Lobby name</label><input id=\"lobbyName\" value=\"Shred Squad\"></div>\n        <div class=\"card\"><label>Max riders</label><select id=\"maxRiders\"><option>10</option><option>20</option><option selected>50</option></select></div>\n        <div class=\"card\"><label>AI difficulty</label><select id=\"botSkill\"><option value=\".45\">Casual</option><option value=\".7\" selected>Competitive</option><option value=\".92\">Insane</option></select></div>\n        <div class=\"card\"><label>Map type</label><select id=\"lobbyMap\"><option value=\"forest\">Forest trail</option><option value=\"desert\">Desert ridge</option><option value=\"snow\">Snow mountain</option></select></div>\n      </div>\n      <div class=\"row\" style=\"margin-top:12px\">\n        <button class=\"ghost\" onclick=\"togglePrivate()\">🔒 Make lobby private</button>\n        <button class=\"ghost\" onclick=\"fillLobby()\">Fill with AI riders</button>\n        <button class=\"danger\" onclick=\"clearLobby()\">Clear lobby</button>\n      </div>\n      <p class=\"small\" id=\"lobbyStatus\">Public lobby • 1 / 50 riders</p>\n    </div>\n\n    <h2>Riders</h2>\n    <div id=\"lobbyList\" class=\"grid\"></div>\n  </div>\n</div>\n\n<div id=\"hud\">\n  <div class=\"hudbox\" id=\"mapname\">FREERIDE</div>\n  <div class=\"hudbox\" id=\"speed\">0 km/h</div>\n  <div class=\"hudbox\" id=\"score\">Score: 0</div>\n  <div class=\"hudbox\" id=\"trick\"></div>\n  <div class=\"hudbox\" id=\"controls\">\n    W / ↑ — pedal<br>\n    S / ↓ — brake<br>\n    A D / ← → — steer<br>\n    SPACE — bunny hop<br>\n    SHIFT + 1-6 — trick<br>\n    C — camera<br>\n    R — respawn<br>\n    ESC — menu\n  </div>\n</div>\n\n<div id=\"editorUI\">\n  <b>MAP CREATOR</b>\n  <select id=\"objectType\" style=\"margin-top:8px\">\n    <option value=\"ramp\">Jump ramp</option>\n    <option value=\"drop\">Drop</option>\n    <option value=\"tree\">Tree</option>\n    <option value=\"rock\">Rock</option>\n    <option value=\"checkpoint\">Checkpoint</option>\n  </select>\n  <p class=\"small\">Left-click: place object<br>Right-click: remove nearest object</p>\n  <div class=\"row\" style=\"margin-top:10px\">\n    <button onclick=\"saveCustomMap()\">Save map</button>\n    <button class=\"ghost\" onclick=\"exitEditor()\">Exit</button>\n  </div>\n</div>\n\n<div id=\"toasts\"></div>\n\n<script type=\"module\">\nimport * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';\n\nconst state={mode:'free',username:'Rider',score:0,mapIndex:1,totalMaps:50,editor:false,camera:'third',quality:'high',private:false,lobbyCount:1};\nlet selectedBike=0,unlocked=1,xp=0;\n\nconst bikes=[\n {name:'Trail Ripper',speed:1,handling:1,jump:1,color:0x00a2ff,price:0},\n {name:'Downhill Beast',speed:1.25,handling:.85,jump:1.15,color:0xff3b3b,price:500},\n {name:'Slopestyle Pro',speed:1.05,handling:1.15,jump:1.35,color:0xffd400,price:1200},\n {name:'Enduro Elite',speed:1.15,handling:1.05,jump:1.2,color:0x22ff88,price:2000},\n {name:'Carbon XC',speed:1.35,handling:1.2,jump:.9,color:0xffffff,price:3500},\n {name:'Freeride Monster',speed:1.2,handling:.95,jump:1.5,color:0xff7b00,price:5000}\n];\n\nconst achievements=[\n {id:'first_air',name:'First Air',done:false},\n {id:'backflip',name:'Backflip Master',done:false},\n {id:'barspin',name:'Barspin Legend',done:false},\n {id:'superman',name:'Superman',done:false},\n {id:'nofoot',name:'No-Foot Can',done:false},\n {id:'score5000',name:'5,000 Points',done:false},\n {id:'creator',name:'Trail Builder',done:false}\n];\n\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(72,innerWidth/innerHeight,.1,1800);\nconst renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.05;\ndocument.body.appendChild(renderer.domElement);\n\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});\n\nconst hemi=new THREE.HemisphereLight(0xbfd8ff,0x3d2f20,.85);\nconst sun=new THREE.DirectionalLight(0xfff2d0,2.4);\nsun.position.set(100,150,70);\nsun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nsun.shadow.camera.left=-180;sun.shadow.camera.right=180;\nsun.shadow.camera.top=180;sun.shadow.camera.bottom=-180;\nscene.add(hemi,sun);\n\nconst skyGeo=new THREE.SphereGeometry(1200,32,20);\nconst skyMat=new THREE.ShaderMaterial({side:THREE.BackSide,uniforms:{},vertexShader:`varying vec3 vPos;void main(){vPos=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,fragmentShader:`varying vec3 vPos;void main(){float h=normalize(vPos).y;vec3 top=vec3(.15,.35,.75);vec3 bottom=vec3(.75,.82,.9);gl_FragColor=vec4(mix(bottom,top,max(h,0.)),1.);}`});\nscene.add(new THREE.Mesh(skyGeo,skyMat));\nscene.fog=new THREE.Fog(0x9db8cf,120,900);\n\nconst keys={};\naddEventListener('keydown',e=>{\n keys[e.code]=true;\n if(e.code==='KeyC')state.camera=state.camera==='third'?'first':'third';\n if(e.code==='KeyR')respawn();\n if(e.code==='Escape')showScreen('menu');\n if(keys.ShiftLeft||keys.ShiftRight){\n  if(e.code==='Digit1')queueTrick('Barspin');\n  if(e.code==='Digit2')queueTrick('360');\n  if(e.code==='Digit3')queueTrick('Backflip');\n  if(e.code==='Digit4')queueTrick('No-Foot Can');\n  if(e.code==='Digit5')queueTrick('Superman');\n  if(e.code==='Digit6')queueTrick('Tailwhip');\n }\n});\naddEventListener('keyup',e=>keys[e.code]=false);\n\nfunction showScreen(id){\n document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n document.getElementById(id).classList.add('active');\n document.getElementById('hud').classList.toggle('active',id==='hud');\n document.getElementById('editorUI').classList.toggle('active',id==='hud'&&state.editor);\n}\n\nfunction toast(text){\n const t=document.createElement('div');t.className='toast';t.textContent=text;\n document.getElementById('toasts').appendChild(t);\n setTimeout(()=>t.remove(),4200);\n}\n\nfunction buildGarage(){\n const g=document.getElementById('bikeGarage');g.innerHTML='';\n bikes.forEach((b,i)=>{\n  const d=document.createElement('div');d.className='card';\n  d.innerHTML=`<b>${b.name}</b><p>Speed ${b.speed.toFixed(2)} • Handling ${b.handling.toFixed(2)} • Air ${b.jump.toFixed(2)}</p><p class=\"small\">${i<unlocked?'Unlocked':'Locked — '+b.price+' XP'}</p>`;\n  const btn=document.createElement('button');\n  btn.textContent=i<unlocked?(selectedBike===i?'Selected':'Select'):'Locked';\n  btn.disabled=i>=unlocked;\n  btn.onclick=()=>{selectedBike=i;buildGarage();toast(b.name+' selected')};\n  d.appendChild(btn);g.appendChild(d);\n });\n}\nbuildGarage();\n\nfunction terrainHeight(x,z,mapType='forest'){\n let h=Math.sin(x*.028)*10+Math.cos(z*.033)*10+Math.sin((x+z)*.015)*18;\n h+=Math.sin(x*.09)*2.2+Math.cos(z*.11)*2.2;\n if(mapType==='desert')h*=.65;\n if(mapType==='snow')h*=1.35;\n return h;\n}\n\nlet terrain,trackGroup,checkpoints=[],rider,bike;\nlet pos=new THREE.Vector3(0,25,0),vel=new THREE.Vector3(),yaw=0;\nlet airborne=false,currentTrick='',trickTimer=0,spin=0,flip=0,airTime=0,suspension=0;\nlet lobbyRiders=[],lobbySettings={name:'Shred Squad',max:50,skill:.7,map:'forest'};\n\nfunction clearWorld(){\n if(terrain)scene.remove(terrain);\n if(trackGroup)scene.remove(trackGroup);\n checkpoints=[];\n}\n\nfunction createWorld(mapType='forest',custom=null){\n clearWorld();\n trackGroup=new THREE.Group();scene.add(trackGroup);\n const size=custom?320:760;\n const seg=state.quality==='low'?80:state.quality==='medium'?130:190;\n const geo=new THREE.PlaneGeometry(size,size,seg,seg);\n geo.rotateX(-Math.PI/2);\n const p=geo.attributes.position;\n for(let i=0;i<p.count;i++){\n  const x=p.getX(i),z=p.getZ(i);\n  p.setY(i,custom?0:terrainHeight(x,z,mapType));\n }\n geo.computeVertexNormals();\n const color=mapType==='desert'?0xb98a4e:mapType==='snow'?0xe8f0f5:0x4c7f3d;\n terrain=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color,roughness:.95,flatShading:true}));\n terrain.receiveShadow=true;\n scene.add(terrain);\n\n const trail=new THREE.Mesh(new THREE.PlaneGeometry(18,size*.92),new THREE.MeshStandardMaterial({color:mapType==='snow'?0xc9d4dc:0x7a5230,roughness:1}));\n trail.rotation.x=-Math.PI/2;trail.position.y=.12;trackGroup.add(trail);\n\n const objects=custom?custom.objects:[];\n const count=custom?objects.length:state.quality==='low'?45:85;\n for(let i=0;i<count;i++){\n  const o=custom?objects[i]:{\n   type:['ramp','drop','tree','rock','checkpoint'][Math.floor(Math.random()*5)],\n   x:(Math.random()-.5)*(size*.8),\n   z:(Math.random()-.5)*(size*.8)\n  };\n  addObject(o,mapType);\n }\n respawn();\n document.getElementById('mapname').textContent=custom?('CUSTOM: '+custom.name):mapType.toUpperCase()+' FREERIDE';\n}\n\nfunction addObject(o,mapType='forest'){\n let mesh;\n if(o.type==='ramp'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(15,1.6,24),new THREE.MeshStandardMaterial({color:0x8a5a30,roughness:.9}));\n  mesh.rotation.x=-.24;\n }else if(o.type==='drop'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(17,9,11),new THREE.MeshStandardMaterial({color:0x6b4526,roughness:1}));\n }else if(o.type==='tree'){\n  mesh=new THREE.Group();\n  const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.65,1,11,7),new THREE.MeshStandardMaterial({color:0x5b3a1e,roughness:1}));\n  const leaves=new THREE.Mesh(new THREE.ConeGeometry(5.5,14,9),new THREE.MeshStandardMaterial({color:mapType==='snow'?0x2d5b40:0x1e6b28,roughness:.85}));\n  leaves.position.y=10;mesh.add(trunk,leaves);\n }else if(o.type==='rock'){\n  mesh=new THREE.Mesh(new THREE.DodecahedronGeometry(3.2,0),new THREE.MeshStandardMaterial({color:0x7c7c7c,roughness:1}));\n }else{\n  mesh=new THREE.Mesh(new THREE.TorusGeometry(7,.8,10,28),new THREE.MeshStandardMaterial({color:0x00e5ff,emissive:0x0090aa,emissiveIntensity:1.4}));\n  mesh.rotation.x=Math.PI/2;\n  checkpoints.push(mesh);\n }\n mesh.position.set(o.x,terrainHeight(o.x,o.z,mapType)+(o.type==='drop'?4.5:0),o.z);\n mesh.castShadow=true;mesh.userData.object=o;\n trackGroup.add(mesh);\n}\n\nfunction createRider(){\n if(rider)scene.remove(rider);\n rider=new THREE.Group();\n const bikeColor=bikes[selectedBike].color;\n const frame=new THREE.Mesh(new THREE.BoxGeometry(.55,.28,2.5),new THREE.MeshStandardMaterial({color:bikeColor,metalness:.75,roughness:.25}));\n const wheels=[];\n for(let i=0;i<2;i++){\n  const w=new THREE.Mesh(new THREE.TorusGeometry(.68,.14,12,32),new THREE.MeshStandardMaterial({color:0x101010,roughness:.7}));\n  w.rotation.y=Math.PI/2;w.position.set(0,.68,i?-.98:.98);wheels.push(w);rider.add(w);\n }\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(.33,1,6,14),new THREE.MeshStandardMaterial({color:0x1d2531,roughness:.6}));\n body.position.set(0,1.55,-.18);\n const helmet=new THREE.Mesh(new THREE.SphereGeometry(.35,20,16),new THREE.MeshStandardMaterial({color:0xff2d55,metalness:.45,roughness:.25}));\n helmet.position.set(0,2.18,-.12);\n rider.add(frame,body,helmet,wheels[0],wheels[1]);\n rider.traverse(m=>{if(m.isMesh)m.castShadow=true});\n scene.add(rider);bike=rider;\n}\n\nfunction respawn(){\n pos.set(0,terrainHeight(0,0)+2,0);\n vel.set(0,0,0);yaw=0;airborne=false;currentTrick='';spin=0;flip=0;\n}\n\nfunction queueTrick(name){\n if(!airborne){document.getElementById('trick').textContent='Get airborne first!';return}\n currentTrick=name;trickTimer=1.25;spin=0;flip=0;\n document.getElementById('trick').textContent=name+'!';\n}\n\nfunction updateRider(dt){\n const b=bikes[selectedBike];\n const forward=new THREE.Vector3(Math.sin(yaw),0,Math.cos(yaw));\n let throttle=0;\n if(keys.KeyW||keys.ArrowUp)throttle=1;\n if(keys.KeyS||keys.ArrowDown)throttle=-.5;\n if(keys.KeyA||keys.ArrowLeft)yaw+=dt*2.2*b.handling;\n if(keys.KeyD||keys.ArrowRight)yaw-=dt*2.2*b.handling;\n\n const ground=terrainHeight(pos.x,pos.z);\n const onGround=pos.y<=ground+.4;\n\n if(onGround){\n  if(!airborne&&keys.Space&&vel.length()>3){\n   vel.y=11*b.jump;airborne=true;airTime=0;\n  }\n  if(airborne){\n   airborne=false;\n   if(currentTrick){\n    const points={'Barspin':350,'360':500,'Backflip':900,'No-Foot Can':700,'Superman':1100,'Tailwhip':450}[currentTrick]||300;\n    state.score+=points;xp+=Math.round(points/10);\n    toast(currentTrick+' landed! +'+points+' points');\n    checkAchievements(currentTrick);currentTrick='';\n   }\n  }\n  vel.y=0;\n  if(keys.Space)vel.multiplyScalar(.92);\n  suspension=Math.max(0,suspension-dt*6);\n }else{\n  airborne=true;airTime+=dt;suspension=Math.min(1,suspension+dt*3);\n  if(keys.ShiftLeft||keys.ShiftRight){\n   if(currentTrick==='Barspin')spin+=dt*10;\n   if(currentTrick==='360')yaw+=dt*6.5;\n   if(currentTrick==='Backflip')flip+=dt*6.5;\n   if(['No-Foot Can','Superman','Tailwhip'].includes(currentTrick))bike.rotation.z=Math.sin(airTime*11)*.4;\n  }\n }\n\n vel.addScaledVector(forward,throttle*dt*40*b.speed);\n vel.y-=34*dt;\n vel.multiplyScalar(1-dt*.045);\n pos.addScaledVector(vel,dt);\n\n if(pos.y<ground){\n  pos.y=ground;\n  if(vel.y<-20){toast('Hard landing! -100 points');state.score=Math.max(0,state.score-100)}\n  vel.y=0;vel.multiplyScalar(.94);suspension=.6;\n }\n pos.x=Math.max(-350,Math.min(350,pos.x));\n pos.z=Math.max(-350,Math.min(350,pos.z));\n\n bike.position.copy(pos);\n bike.position.y+=Math.sin(performance.now()*.01)*suspension*.08;\n bike.rotation.y=yaw;\n bike.rotation.x=flip;\n bike.rotation.z=spin*.25;\n bike.children[2].position.y=currentTrick==='Superman'?2.55:1.55;\n bike.children[2].position.z=currentTrick==='No-Foot Can'?-.85:-.12;\n\n document.getElementById('speed').textContent=Math.round(vel.length()*3.6)+' km/h';\n document.getElementById('score').textContent='Score: '+Math.round(state.score)+' | XP: '+xp;\n\n if(trickTimer>0){trickTimer-=dt;if(trickTimer<=0&&!airborne)currentTrick=''}\n if(airTime>.35)unlock('first_air');\n}\n\nfunction checkAchievements(t){\n if(t==='Backflip')unlock('backflip');\n if(t==='Barspin')unlock('barspin');\n if(t==='Superman')unlock('superman');\n if(t==='No-Foot Can')unlock('nofoot');\n if(state.score>=5000)unlock('score5000');\n}\n\nfunction unlock(id){\n const a=achievements.find(a=>a.id===id);\n if(a&&!a.done){a.done=true;toast('🏆 Achievement unlocked: '+a.name)}\n}\n\nfunction updateCamera(){\n const target=bike.position;\n if(state.camera==='third'){\n  const back=new THREE.Vector3(Math.sin(yaw),0,Math.cos(yaw)).multiplyScalar(10);\n  const desired=new THREE.Vector3(target.x-back.x,target.y+5,target.z-back.z);\n  camera.position.lerp(desired,.16);\n }else{\n  camera.position.set(target.x+Math.sin(yaw)*.25,target.y+2.25,target.z+Math.cos(yaw)*.25);\n }\n camera.lookAt(target.x,target.y+1.7,target.z);\n}\n\nfunction openLobby(){showScreen('lobby');fillLobby()}\nfunction toggleLobbyOptions(){document.getElementById('lobbyOptions').classList.toggle('hidden')}\nfunction togglePrivate(){\n state.private=!state.private;\n document.getElementById('lobbyStatus').textContent=(state.private?'Private':'Public')+' lobby • '+lobbyRiders.length+' / '+document.getElementById('maxRiders').value+' riders';\n toast(state.private?'Lobby set to private':'Lobby set to public');\n}\nfunction clearLobby(){lobbyRiders=[];renderLobby();toast('Lobby cleared')}\nfunction fillLobby(){\n lobbySettings.name=document.getElementById('lobbyName').value||'Shred Squad';\n lobbySettings.max=parseInt(document.getElementById('maxRiders').value);\n lobbySettings.skill=parseFloat(document.getElementById('botSkill').value);\n lobbySettings.map=document.getElementById('lobbyMap').value;\n lobbyRiders=[{name:state.username||'Rider',you:true,skill:1}];\n for(let i=lobbyRiders.length;i<lobbySettings.max;i++){\n  lobbyRiders.push({name:'Rider_'+(i+1),you:false,skill:lobbySettings.skill*(.65+Math.random()*.35)});\n }\n renderLobby();\n document.getElementById('lobbyStatus').textContent=(state.private?'Private':'Public')+' lobby • '+lobbyRiders.length+' / '+lobbySettings.max+' riders • '+lobbySettings.map;\n}\nfunction renderLobby(){\n const list=document.getElementById('lobbyList');list.innerHTML='';\n lobbyRiders.forEach(r=>{\n  const d=document.createElement('div');d.className='card';\n  d.innerHTML=`<b>${r.name}</b><p class=\"small\">${r.you?'You':'AI rider'} • Skill ${Math.round(r.skill*100)}%</p>`;\n  list.appendChild(d);\n });\n}\n\nfunction startGame(mode){\n state.mode=mode;\n state.username=document.getElementById('username').value||'Rider';\n state.camera=document.getElementById('cameraMode').value;\n state.quality=document.getElementById('quality').value;\n state.editor=mode==='editor';\n\n const mapType=mode==='race'||mode==='free'?(document.getElementById('lobbyMap')?.value||'forest'):'forest';\n createWorld(mapType);\n createRider();\n showScreen('hud');\n\n if(mode==='career'){document.getElementById('mapname').textContent='CAREER MAP '+state.mapIndex+' / '+state.totalMaps;toast('Career map '+state.mapIndex+' started')}\n if(mode==='free')toast('Freeride started — ride anywhere');\n if(mode==='race')toast('Race started — '+lobbyRiders.length+' riders in lobby');\n if(mode==='editor')toast('Map creator active');\n}\n\nfunction exitEditor(){state.editor=false;showScreen('menu')}\n\nfunction saveCustomMap(){\n const objects=[];\n trackGroup.children.forEach(m=>{if(m.userData.object)objects.push(m.userData.object)});\n const map={name:'Custom Trail '+(Date.now()%10000),objects};\n const saved=JSON.parse(localStorage.getItem('mtb_custom_maps')||'[]');\n localStorage.setItem('mtb_custom_maps',JSON.stringify([map,...saved].slice(0,25)));\n unlock('creator');toast('Custom map saved locally');\n}\n\nrenderer.domElement.addEventListener('pointerdown',e=>{\n if(!state.editor)return;\n const ndc=new THREE.Vector2((e.clientX/innerWidth)*2-1,-(e.clientY/innerHeight)*2+1);\n const ray=new THREE.Raycaster();ray.setFromCamera(ndc,camera);\n const hit=ray.intersectObject(terrain)[0];\n if(!hit)return;\n if(e.button===2){\n  let closest=null,best=1e9;\n  trackGroup.children.forEach(m=>{\n   if(!m.userData.object)return;\n   const d=m.position.distanceTo(hit.point);\n   if(d<best){best=d;closest=m}\n  });\n  if(closest)trackGroup.remove(closest);\n }else{\n  addObject({type:document.getElementById('objectType').value,x:hit.point.x,z:hit.point.z});\n }\n});\nrenderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());\n\nconst clock=new THREE.Clock();\nfunction animate(){\n requestAnimationFrame(animate);\n const dt=Math.min(clock.getDelta(),.05);\n if(document.getElementById('hud').classList.contains('active')){\n  updateRider(dt);\n  updateCamera();\n  checkpoints.forEach(c=>{if(bike&&bike.position.distanceTo(c.position)<9)c.material.color.set(0x22ff88)});\n }\n renderer.render(scene,camera);\n}\nanimate();\n</script>\n</body>\n</html>"
    }
