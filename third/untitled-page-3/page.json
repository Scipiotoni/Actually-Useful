    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MTB RIDERS — 3D Mountain Biking</title>\n<style>\n  *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,Helvetica,sans-serif}\n  body{overflow:hidden;background:#05070d;color:#fff}\n  canvas{display:block}\n  .screen{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 20%,#16233d,#05070d 70%);z-index:10}\n  .screen.active{display:flex}\n  .panel{width:min(950px,94vw);max-height:92vh;overflow:auto;background:rgba(10,16,28,.92);border:1px solid #2b4a75;border-radius:18px;padding:28px;box-shadow:0 0 60px #00b7ff33}\n  h1{font-size:44px;letter-spacing:3px;color:#4ee1ff;text-shadow:0 0 25px #00b7ff}\n  h2{margin:18px 0 10px;color:#8fd8ff}\n  p{color:#b8c7d9;line-height:1.5}\n  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:16px}\n  .card{background:#101a2c;border:1px solid #27476e;border-radius:12px;padding:14px}\n  .card b{color:#4ee1ff}\n  button{cursor:pointer;border:0;border-radius:10px;padding:12px 18px;font-weight:bold;background:linear-gradient(90deg,#00a2ff,#7b5cff);color:#fff;transition:.2s}\n  button:hover{transform:translateY(-2px);box-shadow:0 8px 20px #00a2ff55}\n  button.ghost{background:#16233a;border:1px solid #31567f}\n  input,select{width:100%;padding:11px;border-radius:9px;border:1px solid #31567f;background:#0b1322;color:#fff;margin-top:6px}\n  label{font-size:13px;color:#9fb4cc}\n  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n  .small{font-size:12px;color:#7f93aa}\n  #hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:5}\n  #hud.active{display:block}\n  .hudbox{position:absolute;background:rgba(4,10,20,.65);border:1px solid #2b4a75;border-radius:12px;padding:10px 14px}\n  #speed{left:20px;bottom:20px;font-size:30px;font-weight:bold;color:#4ee1ff}\n  #trick{left:50%;top:70px;transform:translateX(-50%);font-size:26px;color:#ffe45e;text-align:center}\n  #score{right:20px;top:20px;font-size:20px}\n  #mapname{left:20px;top:20px}\n  #controls{right:20px;bottom:20px;font-size:12px;color:#b8c7d9;max-width:330px}\n  #toasts{position:fixed;right:20px;top:80px;z-index:8;display:flex;flex-direction:column;gap:8px}\n  .toast{background:#0d1a2c;border:1px solid #00b7ff;border-radius:10px;padding:10px 14px;animation:fade 4s forwards}\n  @keyframes fade{0%{opacity:0;transform:translateX(30px)}10%,80%{opacity:1;transform:none}100%{opacity:0}}\n  #editorUI{position:fixed;left:20px;top:20px;z-index:6;display:none;background:rgba(5,10,20,.85);border:1px solid #2b4a75;border-radius:12px;padding:14px;width:290px}\n  #editorUI.active{display:block}\n  .tag{display:inline-block;background:#12233c;border:1px solid #2b4a75;padding:4px 8px;border-radius:20px;font-size:11px;margin:2px}\n</style>\n</head>\n<body>\n\n<div id=\"menu\" class=\"screen active\">\n  <div class=\"panel\">\n    <h1>MTB RIDERS</h1>\n    <p>Realistic-style 3D mountain biking: tricks, career, freeride, custom maps and a 50-rider lobby.</p>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Rider name</b><input id=\"username\" placeholder=\"Enter username\" value=\"Rider\"></div>\n      <div class=\"card\"><b>Camera</b><select id=\"cameraMode\"><option value=\"third\">Third person</option><option value=\"first\">First person</option></select></div>\n      <div class=\"card\"><b>Graphics</b><select id=\"quality\"><option value=\"high\">High</option><option value=\"medium\">Medium</option><option value=\"low\">Low</option></select></div>\n      <div class=\"card\"><b>Difficulty</b><select id=\"difficulty\"><option>Chill</option><option selected>Normal</option><option>Pro</option></select></div>\n    </div>\n    <h2>Game modes</h2>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Career</b><p>Progress through 50 staged maps, earn XP and unlock bikes.</p><button onclick=\"startGame('career')\">Start career</button></div>\n      <div class=\"card\"><b>Freeride</b><p>Explore, session jumps and land huge tricks.</p><button class=\"ghost\" onclick=\"startGame('free')\">Enter freeride</button></div>\n      <div class=\"card\"><b>Race lobby</b><p>Up to 50 riders, checkpoint race and live standings.</p><button class=\"ghost\" onclick=\"startGame('race')\">Join lobby</button></div>\n      <div class=\"card\"><b>Map creator</b><p>Build custom trails with ramps, rails, trees and checkpoints.</p><button class=\"ghost\" onclick=\"startGame('editor')\">Open creator</button></div>\n    </div>\n    <h2>Garage</h2>\n    <div class=\"grid\" id=\"bikeGarage\"></div>\n    <h2>Tricks</h2>\n    <p class=\"small\">Hold <b>SHIFT</b> to prep a trick, then press a trick key while airborne. Land cleanly to score.</p>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Barspin</b><p>SHIFT + 1</p></div>\n      <div class=\"card\"><b>360</b><p>SHIFT + 2</p></div>\n      <div class=\"card\"><b>Backflip</b><p>SHIFT + 3</p></div>\n      <div class=\"card\"><b>No-foot can</b><p>SHIFT + 4</p></div>\n      <div class=\"card\"><b>Superman</b><p>SHIFT + 5</p></div>\n      <div class=\"card\"><b>Whip</b><p>SHIFT + 6</p></div>\n    </div>\n  </div>\n</div>\n\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"panel\">\n    <h1>LOBBY</h1>\n    <p>Online-style lobby. Real internet multiplayer requires a server; this build fills the lobby with AI riders.</p>\n    <div class=\"row\">\n      <button onclick=\"startGame('race')\">Start race</button>\n      <button class=\"ghost\" onclick=\"startGame('free')\">Freeride</button>\n      <button class=\"ghost\" onclick=\"showScreen('menu')\">Back</button>\n    </div>\n    <h2>Riders</h2>\n    <div id=\"lobbyList\" class=\"grid\"></div>\n  </div>\n</div>\n\n<div id=\"hud\">\n  <div class=\"hudbox\" id=\"mapname\">MAP</div>\n  <div class=\"hudbox\" id=\"speed\">0 km/h</div>\n  <div class=\"hudbox\" id=\"score\">Score: 0</div>\n  <div class=\"hudbox\" id=\"trick\"></div>\n  <div class=\"hudbox\" id=\"controls\">\n    WASD / arrows — ride<br>\n    SPACE — brake / stop<br>\n    SHIFT + 1-6 — trick<br>\n    C — camera<br>\n    R — reset<br>\n    ESC — menu\n  </div>\n</div>\n\n<div id=\"editorUI\">\n  <b>MAP CREATOR</b>\n  <div class=\"row\" style=\"margin-top:8px\">\n    <select id=\"objectType\">\n      <option value=\"ramp\">Jump ramp</option>\n      <option value=\"drop\">Drop</option>\n      <option value=\"tree\">Tree</option>\n      <option value=\"rock\">Rock</option>\n      <option value=\"checkpoint\">Checkpoint</option>\n    </select>\n  </div>\n  <p class=\"small\">Click terrain to place. Right-click removes nearest object.</p>\n  <div class=\"row\" style=\"margin-top:10px\">\n    <button onclick=\"saveCustomMap()\">Save map</button>\n    <button class=\"ghost\" onclick=\"exitEditor()\">Exit</button>\n  </div>\n</div>\n\n<div id=\"toasts\"></div>\n\n<script type=\"module\">\nimport * as THREE from 'https://unpkg.com/three@0.160.0/build/three.module.js';\n\nconst state={mode:'free',username:'Rider',score:0,mapIndex:1,totalMaps:50,editor:false,paused:false,camera:'third',quality:'high'};\nconst bikes=[\n {name:'Trail Ripper',speed:1,handling:1,jump:1,color:0x00a2ff,price:0},\n {name:'Downhill Beast',speed:1.25,handling:.85,jump:1.15,color:0xff3b3b,price:500},\n {name:'Slopestyle Pro',speed:1.05,handling:1.15,jump:1.35,color:0xffd400,price:1200},\n {name:'Enduro Elite',speed:1.15,handling:1.05,jump:1.2,color:0x22ff88,price:2000},\n {name:'Carbon XC',speed:1.35,handling:1.2,jump:.9,color:0xffffff,price:3500},\n {name:'Freeride Monster',speed:1.2,handling:.95,jump:1.5,color:0xff7b00,price:5000}\n];\nlet selectedBike=0, unlocked=1, xp=0;\nconst achievements=[\n {id:'first_air',name:'First Air',done:false},\n {id:'backflip',name:'Backflip Master',done:false},\n {id:'barspin',name:'Barspin Legend',done:false},\n {id:'superman',name:'Superman',done:false},\n {id:'nofoot',name:'No-Foot Can',done:false},\n {id:'score5000',name:'5,000 Points',done:false},\n {id:'career10',name:'Career Map 10',done:false},\n {id:'creator',name:'Map Creator',done:false}\n];\n\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x87b7e8);\nscene.fog=new THREE.Fog(0x87b7e8,80,650);\nconst camera=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,.1,1500);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\ndocument.body.appendChild(renderer.domElement);\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});\n\nconst sun=new THREE.DirectionalLight(0xffffff,2.2);\nsun.position.set(80,140,60);sun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nscene.add(sun,new THREE.AmbientLight(0xbfd8ff,.8));\n\nconst keys={};\naddEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='KeyC')state.camera=state.camera==='third'?'first':'third';if(e.code==='KeyR')resetRider();if(e.code==='Escape')showScreen('menu');if(e.code==='Digit1')queueTrick('Barspin');if(e.code==='Digit2')queueTrick('360');if(e.code==='Digit3')queueTrick('Backflip');if(e.code==='Digit4')queueTrick('No-Foot Can');if(e.code==='Digit5')queueTrick('Superman');if(e.code==='Digit6')queueTrick('Whip');});\naddEventListener('keyup',e=>keys[e.code]=false);\n\nfunction showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');document.getElementById('hud').classList.toggle('active',id==='hud');document.getElementById('editorUI').classList.toggle('active',id==='hud'&&state.editor);}\nfunction toast(text){const t=document.createElement('div');t.className='toast';t.textContent=text;document.getElementById('toasts').appendChild(t);setTimeout(()=>t.remove(),4000);}\n\nfunction buildGarage(){\n const g=document.getElementById('bikeGarage');g.innerHTML='';\n bikes.forEach((b,i)=>{\n  const d=document.createElement('div');d.className='card';\n  d.innerHTML=`<b>${b.name}</b><p>Speed ${b.speed} • Handling ${b.handling} • Air ${b.jump}</p><p class=\"small\">${i<unlocked?'Unlocked':'Locked • '+b.price+' XP'}</p>`;\n  const btn=document.createElement('button');btn.textContent=i<unlocked?(selectedBike===i?'Selected':'Select'):'Locked';\n  btn.disabled=i>=unlocked;btn.onclick=()=>{selectedBike=i;buildGarage();toast(b.name+' selected')};\n  d.appendChild(btn);g.appendChild(d);\n });\n}\nbuildGarage();\n\nfunction noise(x,z){return Math.sin(x*.035)*8+Math.cos(z*.042)*8+Math.sin((x+z)*.018)*14+Math.sin(x*.11)*2+Math.cos(z*.13)*2}\nfunction heightAt(x,z){return noise(x,z)}\n\nlet terrain,trackGroup,checkpoints=[],rider,bike,velocity=new THREE.Vector3(),riderPos=new THREE.Vector3(0,20,0),riderYaw=0,airborne=false,trickQueue=[],trickTimer=0,currentTrick='',spin=0,flip=0,airTime=0;\n\nfunction createWorld(mapIndex=1,custom=null){\n if(terrain)scene.remove(terrain);\n if(trackGroup)scene.remove(trackGroup);\n trackGroup=new THREE.Group();scene.add(trackGroup);checkpoints=[];\n const size=custom?300:700,seg=state.quality==='low'?70:state.quality==='medium'?110:160;\n const geo=new THREE.PlaneGeometry(size,size,seg,seg);\n geo.rotateX(-Math.PI/2);\n const pos=geo.attributes.position;\n for(let i=0;i<pos.count;i++){\n  const x=pos.getX(i),z=pos.getZ(i);\n  let h=noise(x,z);\n  if(custom){h=custom.height?custom.height:0;}\n  pos.setY(i,h);\n }\n geo.computeVertexNormals();\n terrain=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:custom?0x3f7d3f:0x4f8b45,roughness:.9,flatShading:true}));\n terrain.receiveShadow=true;scene.add(terrain);\n\n const dirt=new THREE.Mesh(new THREE.PlaneGeometry(16,size*.9),new THREE.MeshStandardMaterial({color:0x7a5230,roughness:1}));\n dirt.rotation.x=-Math.PI/2;dirt.position.y=.15;trackGroup.add(dirt);\n\n const objects=custom?custom.objects:[];\n const count=custom?objects.length:35+mapIndex;\n for(let i=0;i<count;i++){\n  const o=custom?objects[i]:{type:['ramp','drop','tree','rock','checkpoint'][Math.floor(Math.random()*5)],x:(Math.random()-.5)*500,z:(Math.random()-.5)*500};\n  addObject(o);\n }\n riderPos.set(0,heightAt(0,0)+2,0);velocity.set(0,0,0);riderYaw=0;\n document.getElementById('mapname').textContent=custom?('CUSTOM: '+custom.name):('CAREER MAP '+mapIndex+' / '+state.totalMaps);\n}\n\nfunction addObject(o){\n let mesh;\n if(o.type==='ramp'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(14,1.5,22),new THREE.MeshStandardMaterial({color:0x8a5a30}));\n  mesh.rotation.x=-.22;\n }else if(o.type==='drop'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(16,8,10),new THREE.MeshStandardMaterial({color:0x6b4526}));\n }else if(o.type==='tree'){\n  mesh=new THREE.Group();\n  const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.7,1,10),new THREE.MeshStandardMaterial({color:0x5b3a1e}));\n  const leaves=new THREE.Mesh(new THREE.ConeGeometry(5,12,8),new THREE.MeshStandardMaterial({color:0x1f6b2a}));\n  leaves.position.y=9;mesh.add(trunk,leaves);\n }else if(o.type==='rock'){\n  mesh=new THREE.Mesh(new THREE.DodecahedronGeometry(3,0),new THREE.MeshStandardMaterial({color:0x777777,roughness:1}));\n }else{\n  mesh=new THREE.Mesh(new THREE.TorusGeometry(6,.7,8,24),new THREE.MeshStandardMaterial({color:0x00e5ff,emissive:0x0088aa}));\n  mesh.rotation.x=Math.PI/2;checkpoints.push(new THREE.Vector3(o.x,2,o.z));\n }\n mesh.position.set(o.x,heightAt(o.x,o.z)+(o.type==='drop'?4:0),o.z);\n mesh.castShadow=true;mesh.userData.object=o;trackGroup.add(mesh);\n}\n\nfunction createRider(){\n if(rider)scene.remove(rider);\n rider=new THREE.Group();\n const frame=new THREE.Mesh(new THREE.BoxGeometry(.5,.25,2.4),new THREE.MeshStandardMaterial({color:bikes[selectedBike].color,metalness:.7,roughness:.25}));\n const wheels=[];\n for(let i=0;i<2;i++){\n  const w=new THREE.Mesh(new THREE.TorusGeometry(.65,.13,10,28),new THREE.MeshStandardMaterial({color:0x111111}));\n  w.rotation.y=Math.PI/2;w.position.set(0,.65,i?-.95:.95);wheels.push(w);rider.add(w);\n }\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(.32,.9,6,12),new THREE.MeshStandardMaterial({color:0x222a38}));\n body.position.set(0,1.5,-.15);\n const helmet=new THREE.Mesh(new THREE.SphereGeometry(.33,18,14),new THREE.MeshStandardMaterial({color:0xff2d55,metalness:.4,roughness:.3}));\n helmet.position.set(0,2.15,-.1);\n rider.add(frame,body,helmet,wheels[0],wheels[1]);\n rider.traverse(m=>{if(m.isMesh)m.castShadow=true});\n scene.add(rider);bike=rider;\n}\n\nfunction queueTrick(name){\n if(!airborne){document.getElementById('trick').textContent='Get airborne first!';return}\n currentTrick=name;trickTimer=1.2;spin=0;flip=0;\n document.getElementById('trick').textContent=name+'!';\n}\n\nfunction resetRider(){riderPos.set(0,heightAt(0,0)+2,0);velocity.set(0,0,0);riderYaw=0;airborne=false;currentTrick='';}\n\nfunction updateRider(dt){\n const b=bikes[selectedBike];\n const forward=new THREE.Vector3(Math.sin(riderYaw),0,Math.cos(riderYaw));\n let throttle=0;\n if(keys.KeyW||keys.ArrowUp)throttle=1;\n if(keys.KeyS||keys.ArrowDown)throttle=-.45;\n if(keys.KeyA||keys.ArrowLeft)riderYaw+=dt*2.1*b.handling;\n if(keys.KeyD||keys.ArrowRight)riderYaw-=dt*2.1*b.handling;\n\n const ground=heightAt(riderPos.x,riderPos.z);\n const onGround=riderPos.y<=ground+.35;\n if(onGround){\n  airborne=false;airTime=0;spin=0;flip=0;\n  if(currentTrick){\n   const points={'Barspin':350,'360':500,'Backflip':900,'No-Foot Can':700,'Superman':1100,'Whip':450}[currentTrick]||300;\n   state.score+=points;toast(currentTrick+' landed! +'+points+' points');checkAchievements(currentTrick);currentTrick='';\n  }\n  velocity.y=0;\n  if(keys.Space)velocity.multiplyScalar(.9);\n }else{\n  airborne=true;airTime+=dt;\n  if(keys.ShiftLeft||keys.ShiftRight){\n   if(currentTrick==='Barspin')spin+=dt*9;\n   if(currentTrick==='360')riderYaw+=dt*6;\n   if(currentTrick==='Backflip')flip+=dt*6;\n   if(currentTrick==='No-Foot Can'||currentTrick==='Superman'||currentTrick==='Whip')bike.rotation.z=Math.sin(airTime*10)*.35;\n  }\n }\n\n velocity.addScaledVector(forward,throttle*dt*38*b.speed);\n velocity.y-=32*dt;\n riderPos.addScaledVector(velocity,dt);\n\n if(riderPos.y<ground){riderPos.y=ground;if(velocity.y<-18){toast('Hard landing!');state.score=Math.max(0,state.score-100)}velocity.y=0;velocity.multiplyScalar(.94)}\n riderPos.x=Math.max(-330,Math.min(330,riderPos.x));riderPos.z=Math.max(-330,Math.min(330,riderPos.z));\n\n bike.position.copy(riderPos);\n bike.rotation.y=riderYaw;\n bike.rotation.x=flip;\n bike.rotation.z=spin*.2;\n bike.children[2].position.y=currentTrick==='Superman'?2.4:1.5;\n bike.children[2].position.z=currentTrick==='No-Foot Can'?-.8:-.1;\n\n const speed=velocity.length()*3.6;\n document.getElementById('speed').textContent=Math.round(speed)+' km/h';\n document.getElementById('score').textContent='Score: '+Math.round(state.score)+' | XP: '+xp;\n\n if(trickTimer>0){trickTimer-=dt;if(trickTimer<=0&&!airborne)currentTrick=''}\n if(airTime>0.4&&!state.flags?.air){state.flags={air:true};unlock('first_air','First Air unlocked!')}\n}\n\nfunction checkAchievements(t){\n if(t==='Backflip')unlock('backflip');\n if(t==='Barspin')unlock('barspin');\n if(t==='Superman')unlock('superman');\n if(t==='No-Foot Can')unlock('nofoot');\n if(state.score>=5000)unlock('score5000');\n}\nfunction unlock(id,msg){const a=achievements.find(a=>a.id===id);if(a&&!a.done){a.done=true;toast('🏆 Achievement: '+a.name)}}\n\nfunction updateCamera(){\n const target=bike.position;\n if(state.camera==='third'){\n  const back=new THREE.Vector3(Math.sin(riderYaw),0,Math.cos(riderYaw)).multiplyScalar(9);\n  camera.position.lerp(new THREE.Vector3(target.x-back.x,target.y+4.5,target.z-back.z),.15);\n }else{\n  camera.position.copy(target).add(new THREE.Vector3(Math.sin(riderYaw)*.2,2.1,Math.cos(riderYaw)*.2));\n }\n camera.lookAt(target.x,target.y+1.6,target.z);\n}\n\nlet clock=new THREE.Clock(),raceTime=0,lobbyRiders=[];\nfunction makeLobby(){\n lobbyRiders=[];const list=document.getElementById('lobbyList');list.innerHTML='';\n for(let i=0;i<50;i++){\n  const r={name:i===0?state.username:'Rider_'+(i+1),skill:Math.random()};\n  lobbyRiders.push(r);\n  const d=document.createElement('div');d.className='card';d.innerHTML=`<b>${r.name}</b><p class=\"small\">${i===0?'You':'AI rider'} • Skill ${Math.round(r.skill*100)}%</p>`;list.appendChild(d);\n }\n}\n\nfunction startGame(mode){\n state.mode=mode;state.username=document.getElementById('username').value||'Rider';\n state.camera=document.getElementById('cameraMode').value;\n state.quality=document.getElementById('quality').value;\n if(mode==='lobby'){makeLobby();showScreen('lobby');return}\n state.editor=mode==='editor';\n createWorld(mode==='career'?state.mapIndex:1);\n createRider();\n showScreen('hud');\n if(mode==='editor')toast('Map creator active — click terrain to build');\n if(mode==='career')toast('Career map '+state.mapIndex+' started');\n if(mode==='race')toast('Race started — 50 riders in lobby');\n}\n\nfunction exitEditor(){state.editor=false;showScreen('menu')}\n\nfunction saveCustomMap(){\n const objects=[];trackGroup.children.forEach(m=>{if(m.userData.object)objects.push(m.userData.object)});\n const map={name:'Custom Trail '+Date.now()%10000,objects};\n localStorage.setItem('mtb_custom_maps',JSON.stringify([map,...JSON.parse(localStorage.getItem('mtb_custom_maps')||'[]')].slice(0,20)));\n unlock('creator','Custom map saved!');\n toast('Map saved locally');\n}\n\nrenderer.domElement.addEventListener('pointerdown',e=>{\n if(!state.editor)return;\n const ndc=new THREE.Vector2((e.clientX/innerWidth)*2-1,-(e.clientY/innerHeight)*2+1);\n const ray=new THREE.Raycaster();ray.setFromCamera(ndc,camera);\n const hit=ray.intersectObject(terrain)[0];\n if(!hit)return;\n if(e.button===2){\n  let closest=null,best=1e9;\n  trackGroup.children.forEach(m=>{if(!m.userData.object)return;const d=m.position.distanceTo(hit.point);if(d<best){best=d;closest=m}});\n  if(closest)trackGroup.remove(closest);\n }else{\n  const type=document.getElementById('objectType').value;\n  addObject({type,x:hit.point.x,z:hit.point.z});\n }\n});\nrenderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());\n\nfunction animate(){\n requestAnimationFrame(animate);\n const dt=Math.min(clock.getDelta(),.05);\n if(document.getElementById('hud').classList.contains('active')){\n  updateRider(dt);updateCamera();\n  checkpoints.forEach(c=>{if(bike.position.distanceTo(c)<8){c.material.color.set(0x22ff88)}});\n }\n renderer.render(scene,camera);\n}\nanimate();\n</script>\n</body>\n</html>"
    }
  ]
}