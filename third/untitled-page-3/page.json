    {
      "name": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>MTB RIDERS — 3D Mountain Biking</title>\n<script type=\"importmap\">\n{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\"}}\n</script>\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}\nbody{overflow:hidden;background:#05070d;color:#fff}\ncanvas{display:block}\n.screen{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:linear-gradient(180deg,#0a1626,#04070d);z-index:20}\n.screen.active{display:flex}\n.panel{width:min(1100px,96vw);max-height:94vh;overflow:auto;background:rgba(8,14,25,.95);border:1px solid #254a70;border-radius:20px;padding:28px}\nh1{font-size:44px;color:#4ee1ff;text-shadow:0 0 25px #00a2ff}\nh2{margin:18px 0 10px;color:#9ad9ff}\nh3{margin:12px 0 6px;color:#7fd4ff}\np{color:#b8c7d9;line-height:1.5}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px}\n.card{background:#0e182a;border:1px solid #26507a;border-radius:14px;padding:15px}\n.card b{color:#4ee1ff}\nbutton{cursor:pointer;border:0;border-radius:10px;padding:12px 18px;font-weight:bold;background:linear-gradient(90deg,#00a2ff,#7b5cff);color:#fff}\nbutton:hover{filter:brightness(1.15)}\nbutton.ghost{background:#152439;border:1px solid #2f5c86}\nbutton.danger{background:#8f1d2c}\nbutton:disabled{opacity:.45;cursor:not-allowed}\ninput,select,textarea{width:100%;padding:11px;border-radius:9px;border:1px solid #2f5c86;background:#091322;color:#fff;margin-top:6px}\nlabel{font-size:12px;color:#9fb4cc}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.small{font-size:12px;color:#7f93aa}\n.hidden{display:none!important}\n#hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:5}\n#hud.active{display:block}\n.hudbox{position:absolute;background:rgba(3,9,18,.65);border:1px solid #254a70;border-radius:12px;padding:10px 14px}\n#speed{left:20px;bottom:20px;font-size:32px;font-weight:bold;color:#4ee1ff}\n#trick{left:50%;top:70px;transform:translateX(-50%);font-size:27px;color:#ffe45e;text-align:center}\n#score{right:20px;top:20px}\n#mapname{left:20px;top:20px}\n#controls{right:20px;bottom:20px;font-size:12px;color:#b8c7d9;max-width:330px}\n#toasts{position:fixed;right:20px;top:80px;z-index:40;display:flex;flex-direction:column;gap:8px}\n.toast{background:#0b1a2d;border:1px solid #00b7ff;border-radius:10px;padding:10px 14px;animation:fade 4s forwards}\n@keyframes fade{0%{opacity:0;transform:translateX(30px)}10%,80%{opacity:1;transform:none}100%{opacity:0}}\n#editorUI{position:fixed;left:20px;top:20px;z-index:10;display:none;background:rgba(4,10,20,.88);border:1px solid #254a70;border-radius:12px;padding:14px;width:300px}\n#editorUI.active{display:block}\n#lobbyTabs{display:flex;gap:8px;margin:16px 0}\n.lobbyTab{padding:10px 16px;border-radius:10px;background:#12233c;border:1px solid #2f5c86;cursor:pointer}\n.lobbyTab.active{background:#00a2ff;color:#04121f;font-weight:bold}\n#playerGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;max-height:330px;overflow:auto}\n.player{background:#0d182a;border:1px solid #26507a;border-radius:12px;padding:10px}\n.player.you{border-color:#00e5ff;box-shadow:0 0 18px #00e5ff33}\n.player.ready{border-color:#22ff88}\n#chat{height:180px;overflow:auto;background:#08111e;border:1px solid #254a70;border-radius:12px;padding:10px;margin-top:10px}\n.chatLine{margin-bottom:6px;font-size:13px}\n.chatLine b{color:#4ee1ff}\n</style>\n</head>\n<body>\n\n<div id=\"menu\" class=\"screen active\">\n  <div class=\"panel\">\n    <h1>MTB RIDERS</h1>\n    <p>3D mountain biking with tricks, career, freeride, custom maps and a 50-player lobby.</p>\n\n    <div class=\"grid\">\n      <div class=\"card\"><b>Rider name</b><input id=\"username\" value=\"Rider\" maxlength=\"18\"></div>\n      <div class=\"card\"><b>Camera</b><select id=\"cameraMode\"><option value=\"third\">Third person</option><option value=\"first\">First person</option></select></div>\n      <div class=\"card\"><b>Graphics</b><select id=\"quality\"><option value=\"high\">High</option><option value=\"medium\">Medium</option><option value=\"low\">Low</option></select></div>\n      <div class=\"card\"><b>Difficulty</b><select id=\"difficulty\"><option>Chill</option><option selected>Normal</option><option>Pro</option></select></div>\n    </div>\n\n    <h2>Play</h2>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Career</b><p>Ride 50 progressive maps and earn XP.</p><button id=\"careerBtn\">Start career</button></div>\n      <div class=\"card\"><b>Freeride</b><p>Explore, jump and throw tricks.</p><button id=\"freeBtn\">Enter freeride</button></div>\n      <div class=\"card\"><b>Multiplayer lobby</b><p>Up to 50 riders, ready-up, chat and races.</p><button id=\"lobbyBtn\">Open lobby</button></div>\n      <div class=\"card\"><b>Map creator</b><p>Build custom trails with jumps and checkpoints.</p><button id=\"editorBtn\">Open creator</button></div>\n    </div>\n\n    <h2>Garage</h2>\n    <div id=\"bikeGarage\" class=\"grid\"></div>\n\n    <h2>Tricks</h2>\n    <p class=\"small\">Get airborne, hold SHIFT, then press 1-6. Release SHIFT before landing to score.</p>\n    <div class=\"grid\">\n      <div class=\"card\"><b>Barspin</b><p>SHIFT + 1</p></div>\n      <div class=\"card\"><b>360</b><p>SHIFT + 2</p></div>\n      <div class=\"card\"><b>Backflip</b><p>SHIFT + 3</p></div>\n      <div class=\"card\"><b>No-foot can</b><p>SHIFT + 4</p></div>\n      <div class=\"card\"><b>Superman</b><p>SHIFT + 5</p></div>\n      <div class=\"card\"><b>Tailwhip</b><p>SHIFT + 6</p></div>\n    </div>\n  </div>\n</div>\n\n<div id=\"lobby\" class=\"screen\">\n  <div class=\"panel\">\n    <h1>RACE LOBBY</h1>\n    <p id=\"lobbyStatus\">Public lobby • 1 / 50 riders</p>\n\n    <div id=\"lobbyTabs\">\n      <div class=\"lobbyTab active\" data-tab=\"players\">Players</div>\n      <div class=\"lobbyTab\" data-tab=\"settings\">Lobby settings</div>\n      <div class=\"lobbyTab\" data-tab=\"chat\">Lobby chat</div>\n      <div class=\"lobbyTab\" data-tab=\"race\">Race setup</div>\n    </div>\n\n    <div id=\"tab-players\">\n      <div class=\"row\">\n        <button id=\"readyBtn\">Ready up</button>\n        <button class=\"ghost\" id=\"fillBtn\">Fill with AI riders</button>\n        <button class=\"ghost\" id=\"clearBtn\">Clear lobby</button>\n        <button class=\"ghost\" id=\"backBtn\">Back</button>\n      </div>\n      <div id=\"playerGrid\" style=\"margin-top:14px\"></div>\n    </div>\n\n    <div id=\"tab-settings\" class=\"hidden\">\n      <div class=\"grid\">\n        <div class=\"card\"><label>Lobby name</label><input id=\"lobbyName\" value=\"Shred Squad\"></div>\n        <div class=\"card\"><label>Max riders</label><select id=\"maxRiders\"><option>10</option><option>20</option><option selected>50</option></select></div>\n        <div class=\"card\"><label>Lobby type</label><select id=\"lobbyType\"><option value=\"public\">Public</option><option value=\"private\">Private</option></select></div>\n        <div class=\"card\"><label>Join code</label><input id=\"joinCode\" value=\"MTB-1234\"></div>\n        <div class=\"card\"><label>AI skill</label><select id=\"botSkill\"><option value=\".45\">Casual</option><option value=\".7\" selected>Competitive</option><option value=\".92\">Insane</option></select></div>\n        <div class=\"card\"><label>Map theme</label><select id=\"lobbyMap\"><option value=\"forest\">Forest</option><option value=\"desert\">Desert</option><option value=\"snow\">Snow</option></select></div>\n      </div>\n      <div class=\"row\" style=\"margin-top:14px\">\n        <button class=\"ghost\" id=\"applyLobbyBtn\">Apply settings</button>\n      </div>\n    </div>\n\n    <div id=\"tab-chat\" class=\"hidden\">\n      <div id=\"chat\"></div>\n      <div class=\"row\" style=\"margin-top:10px\">\n        <input id=\"chatInput\" placeholder=\"Type a message...\">\n        <button id=\"sendChatBtn\">Send</button>\n      </div>\n    </div>\n\n    <div id=\"tab-race\" class=\"hidden\">\n      <div class=\"grid\">\n        <div class=\"card\"><label>Race mode</label><select id=\"raceMode\"><option>Checkpoint race</option><option>Trick attack</option><option>Freeride session</option></select></div>\n        <div class=\"card\"><label>Laps</label><select id=\"raceLaps\"><option>1</option><option selected>2</option><option>3</option></select></div>\n        <div class=\"card\"><label>Collisions</label><select id=\"raceCollisions\"><option>Off</option><option selected>On</option></select></div>\n        <div class=\"card\"><label>Countdown</label><select id=\"raceCountdown\"><option>3 seconds</option><option selected>5 seconds</option><option>10 seconds</option></select></div>\n      </div>\n      <div class=\"row\" style=\"margin-top:14px\">\n        <button id=\"startRaceBtn\">Start race</button>\n        <button class=\"ghost\" id=\"freeRideBtn\">Freeride together</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id=\"hud\">\n  <div class=\"hudbox\" id=\"mapname\">FREERIDE</div>\n  <div class=\"hudbox\" id=\"speed\">0 km/h</div>\n  <div class=\"hudbox\" id=\"score\">Score: 0</div>\n  <div class=\"hudbox\" id=\"trick\"></div>\n  <div class=\"hudbox\" id=\"controls\">\n    W / ↑ — pedal<br>\n    S / ↓ — brake<br>\n    A D / ← → — steer<br>\n    SPACE — bunny hop<br>\n    SHIFT + 1-6 — trick<br>\n    C — camera<br>\n    R — respawn<br>\n    ESC — menu\n  </div>\n</div>\n\n<div id=\"editorUI\">\n  <b>MAP CREATOR</b>\n  <select id=\"objectType\" style=\"margin-top:8px\">\n    <option value=\"ramp\">Jump ramp</option>\n    <option value=\"drop\">Drop</option>\n    <option value=\"tree\">Tree</option>\n    <option value=\"rock\">Rock</option>\n    <option value=\"checkpoint\">Checkpoint</option>\n  </select>\n  <p class=\"small\">Left-click: place<br>Right-click: remove nearest</p>\n  <div class=\"row\" style=\"margin-top:10px\">\n    <button id=\"saveMapBtn\">Save map</button>\n    <button class=\"ghost\" id=\"exitEditorBtn\">Exit</button>\n  </div>\n</div>\n\n<div id=\"toasts\"></div>\n\n<script type=\"module\">\nimport * as THREE from 'three';\n\nconst state={mode:'free',username:'Rider',score:0,mapIndex:1,totalMaps:50,editor:false,camera:'third',quality:'high'};\nlet selectedBike=0,unlocked=1,xp=0,ready=false;\nlet lobbyRiders=[],lobbySettings={name:'Shred Squad',max:50,type:'public',code:'MTB-1234',skill:.7,map:'forest'};\n\nconst bikes=[\n {name:'Trail Ripper',speed:1,handling:1,jump:1,color:0x00a2ff,price:0},\n {name:'Downhill Beast',speed:1.25,handling:.85,jump:1.15,color:0xff3b3b,price:500},\n {name:'Slopestyle Pro',speed:1.05,handling:1.15,jump:1.35,color:0xffd400,price:1200},\n {name:'Enduro Elite',speed:1.15,handling:1.05,jump:1.2,color:0x22ff88,price:2000},\n {name:'Carbon XC',speed:1.35,handling:1.2,jump:.9,color:0xffffff,price:3500},\n {name:'Freeride Monster',speed:1.2,handling:.95,jump:1.5,color:0xff7b00,price:5000}\n];\n\nconst achievements=[\n {id:'first_air',name:'First Air',done:false},\n {id:'backflip',name:'Backflip Master',done:false},\n {id:'barspin',name:'Barspin Legend',done:false},\n {id:'superman',name:'Superman',done:false},\n {id:'nofoot',name:'No-Foot Can',done:false},\n {id:'score5000',name:'5,000 Points',done:false},\n {id:'creator',name:'Trail Builder',done:false}\n];\n\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(72,innerWidth/innerHeight,.1,1800);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\ndocument.body.appendChild(renderer.domElement);\n\naddEventListener('resize',()=>{\n camera.aspect=innerWidth/innerHeight;\n camera.updateProjectionMatrix();\n renderer.setSize(innerWidth,innerHeight);\n});\n\nscene.add(new THREE.HemisphereLight(0xbfd8ff,0x3d2f20,.9));\nconst sun=new THREE.DirectionalLight(0xfff2d0,2.4);\nsun.position.set(100,150,70);\nsun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nscene.add(sun);\n\nscene.fog=new THREE.Fog(0x9db8cf,120,900);\n\nconst keys={};\naddEventListener('keydown',e=>{\n keys[e.code]=true;\n if(e.code==='KeyC')state.camera=state.camera==='third'?'first':'third';\n if(e.code==='KeyR')respawn();\n if(e.code==='Escape')showScreen('menu');\n if(e.shiftKey){\n  const tricks={Digit1:'Barspin',Digit2:'360',Digit3:'Backflip',Digit4:'No-Foot Can',Digit5:'Superman',Digit6:'Tailwhip'};\n  if(tricks[e.code])queueTrick(tricks[e.code]);\n }\n});\naddEventListener('keyup',e=>keys[e.code]=false);\n\nfunction showScreen(id){\n document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));\n document.getElementById(id).classList.add('active');\n document.getElementById('hud').classList.toggle('active',id==='hud');\n document.getElementById('editorUI').classList.toggle('active',id==='hud'&&state.editor);\n}\n\nfunction toast(text){\n const t=document.createElement('div');\n t.className='toast';t.textContent=text;\n document.getElementById('toasts').appendChild(t);\n setTimeout(()=>t.remove(),4200);\n}\n\nfunction buildGarage(){\n const g=document.getElementById('bikeGarage');\n g.innerHTML='';\n bikes.forEach((b,i)=>{\n  const d=document.createElement('div');\n  d.className='card';\n  d.innerHTML=`<b>${b.name}</b><p>Speed ${b.speed} • Handling ${b.handling} • Air ${b.jump}</p><p class=\"small\">${i<unlocked?'Unlocked':'Locked — '+b.price+' XP'}</p>`;\n  const btn=document.createElement('button');\n  btn.textContent=i<unlocked?(selectedBike===i?'Selected':'Select'):'Locked';\n  btn.disabled=i>=unlocked;\n  btn.onclick=()=>{selectedBike=i;buildGarage();toast(b.name+' selected')};\n  d.appendChild(btn);\n  g.appendChild(d);\n });\n}\nbuildGarage();\n\nfunction terrainHeight(x,z,mapType='forest'){\n let h=Math.sin(x*.028)*10+Math.cos(z*.033)*10+Math.sin((x+z)*.015)*18;\n h+=Math.sin(x*.09)*2.2+Math.cos(z*.11)*2.2;\n if(mapType==='desert')h*=.65;\n if(mapType==='snow')h*=1.35;\n return h;\n}\n\nlet terrain,trackGroup,checkpoints=[],rider,bike;\nlet pos=new THREE.Vector3(0,25,0),vel=new THREE.Vector3(),yaw=0;\nlet airborne=false,currentTrick='',trickTimer=0,spin=0,flip=0,airTime=0,suspension=0;\n\nfunction clearWorld(){\n if(terrain)scene.remove(terrain);\n if(trackGroup)scene.remove(trackGroup);\n checkpoints=[];\n}\n\nfunction createWorld(mapType='forest'){\n clearWorld();\n trackGroup=new THREE.Group();\n scene.add(trackGroup);\n\n const size=760;\n const seg=state.quality==='low'?80:state.quality==='medium'?130:190;\n const geo=new THREE.PlaneGeometry(size,size,seg,seg);\n geo.rotateX(-Math.PI/2);\n const p=geo.attributes.position;\n\n for(let i=0;i<p.count;i++){\n  const x=p.getX(i),z=p.getZ(i);\n  p.setY(i,terrainHeight(x,z,mapType));\n }\n geo.computeVertexNormals();\n\n const color=mapType==='desert'?0xb98a4e:mapType==='snow'?0xe8f0f5:0x4c7f3d;\n terrain=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color,roughness:.95,flatShading:true}));\n terrain.receiveShadow=true;\n scene.add(terrain);\n\n const trail=new THREE.Mesh(\n  new THREE.PlaneGeometry(18,size*.92),\n  new THREE.MeshStandardMaterial({color:mapType==='snow'?0xc9d4dc:0x7a5230,roughness:1})\n );\n trail.rotation.x=-Math.PI/2;\n trail.position.y=.12;\n trackGroup.add(trail);\n\n const count=state.quality==='low'?45:85;\n for(let i=0;i<count;i++){\n  addObject({\n   type:['ramp','drop','tree','rock','checkpoint'][Math.floor(Math.random()*5)],\n   x:(Math.random()-.5)*(size*.8),\n   z:(Math.random()-.5)*(size*.8)\n  },mapType);\n }\n\n respawn();\n document.getElementById('mapname').textContent=mapType.toUpperCase()+' FREERIDE';\n}\n\nfunction addObject(o,mapType='forest'){\n let mesh;\n if(o.type==='ramp'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(15,1.6,24),new THREE.MeshStandardMaterial({color:0x8a5a30}));\n  mesh.rotation.x=-.24;\n }else if(o.type==='drop'){\n  mesh=new THREE.Mesh(new THREE.BoxGeometry(17,9,11),new THREE.MeshStandardMaterial({color:0x6b4526}));\n }else if(o.type==='tree'){\n  mesh=new THREE.Group();\n  const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.65,1,11,7),new THREE.MeshStandardMaterial({color:0x5b3a1e}));\n  const leaves=new THREE.Mesh(new THREE.ConeGeometry(5.5,14,9),new THREE.MeshStandardMaterial({color:mapType==='snow'?0x2d5b40:0x1e6b28}));\n  leaves.position.y=10;\n  mesh.add(trunk,leaves);\n }else if(o.type==='rock'){\n  mesh=new THREE.Mesh(new THREE.DodecahedronGeometry(3.2,0),new THREE.MeshStandardMaterial({color:0x7c7c7c}));\n }else{\n  mesh=new THREE.Mesh(new THREE.TorusGeometry(7,.8,10,28),new THREE.MeshStandardMaterial({color:0x00e5ff,emissive:0x0090aa,emissiveIntensity:1.4}));\n  mesh.rotation.x=Math.PI/2;\n  checkpoints.push(mesh);\n }\n mesh.position.set(o.x,terrainHeight(o.x,o.z,mapType)+(o.type==='drop'?4.5:0),o.z);\n mesh.castShadow=true;\n mesh.userData.object=o;\n trackGroup.add(mesh);\n}\n\nfunction createRider(){\n if(rider)scene.remove(rider);\n rider=new THREE.Group();\n const frame=new THREE.Mesh(new THREE.BoxGeometry(.55,.28,2.5),new THREE.MeshStandardMaterial({color:bikes[selectedBike].color,metalness:.75,roughness:.25}));\n const wheels=[];\n for(let i=0;i<2;i++){\n  const w=new THREE.Mesh(new THREE.TorusGeometry(.68,.14,12,32),new THREE.MeshStandardMaterial({color:0x101010}));\n  w.rotation.y=Math.PI/2;\n  w.position.set(0,.68,i?-.98:.98);\n  wheels.push(w);\n  rider.add(w);\n }\n const body=new THREE.Mesh(new THREE.CapsuleGeometry(.33,1,6,14),new THREE.MeshStandardMaterial({color:0x1d2531}));\n body.position.set(0,1.55,-.18);\n const helmet=new THREE.Mesh(new THREE.SphereGeometry(.35,20,16),new THREE.MeshStandardMaterial({color:0xff2d55,metalness:.45,roughness:.25}));\n helmet.position.set(0,2.18,-.12);\n rider.add(frame,body,helmet);\n rider.traverse(m=>{if(m.isMesh)m.castShadow=true});\n scene.add(rider);\n bike=rider;\n}\n\nfunction respawn(){\n pos.set(0,terrainHeight(0,0)+2,0);\n vel.set(0,0,0);\n yaw=0;\n airborne=false;\n currentTrick='';\n spin=0;\n flip=0;\n}\n\nfunction queueTrick(name){\n if(!airborne){\n  document.getElementById('trick').textContent='Get airborne first!';\n  return;\n }\n currentTrick=name;\n trickTimer=1.25;\n spin=0;\n flip=0;\n document.getElementById('trick').textContent=name+'!';\n}\n\nfunction updateRider(dt){\n const b=bikes[selectedBike];\n const forward=new THREE.Vector3(Math.sin(yaw),0,Math.cos(yaw));\n let throttle=0;\n\n if(keys.KeyW||keys.ArrowUp)throttle=1;\n if(keys.KeyS||keys.ArrowDown)throttle=-.5;\n if(keys.KeyA||keys.ArrowLeft)yaw+=dt*2.2*b.handling;\n if(keys.KeyD||keys.ArrowRight)yaw-=dt*2.2*b.handling;\n\n const ground=terrainHeight(pos.x,pos.z);\n const onGround=pos.y<=ground+.4;\n\n if(onGround){\n  if(!airborne&&keys.Space&&vel.length()>3){\n   vel.y=11*b.jump;\n   airborne=true;\n   airTime=0;\n  }\n  if(airborne){\n   airborne=false;\n   if(currentTrick){\n    const points={'Barspin':350,'360':500,'Backflip':900,'No-Foot Can':700,'Superman':1100,'Tailwhip':450}[currentTrick]||300;\n    state.score+=points;\n    xp+=Math.round(points/10);\n    toast(currentTrick+' landed! +'+points+' points');\n    checkAchievements(currentTrick);\n    currentTrick='';\n   }\n  }\n  vel.y=0;\n  if(keys.Space)vel.multiplyScalar(.92);\n  suspension=Math.max(0,suspension-dt*6);\n }else{\n  airborne=true;\n  airTime+=dt;\n  suspension=Math.min(1,suspension+dt*3);\n\n  if(keys.ShiftLeft||keys.ShiftRight){\n   if(currentTrick==='Barspin')spin+=dt*10;\n   if(currentTrick==='360')yaw+=dt*6.5;\n   if(currentTrick==='Backflip')flip+=dt*6.5;\n   if(['No-Foot Can','Superman','Tailwhip'].includes(currentTrick))bike.rotation.z=Math.sin(airTime*11)*.4;\n  }\n }\n\n vel.addScaledVector(forward,throttle*dt*40*b.speed);\n vel.y-=34*dt;\n vel.multiplyScalar(1-dt*.045);\n pos.addScaledVector(vel,dt);\n\n if(pos.y<ground){\n  pos.y=ground;\n  if(vel.y<-20){\n   toast('Hard landing! -100 points');\n   state.score=Math.max(0,state.score-100);\n  }\n  vel.y=0;\n  vel.multiplyScalar(.94);\n  suspension=.6;\n }\n\n pos.x=Math.max(-350,Math.min(350,pos.x));\n pos.z=Math.max(-350,Math.min(350,pos.z));\n\n bike.position.copy(pos);\n bike.position.y+=Math.sin(performance.now()*.01)*suspension*.08;\n bike.rotation.y=yaw;\n bike.rotation.x=flip;\n bike.rotation.z=spin*.25;\n\n document.getElementById('speed').textContent=Math.round(vel.length()*3.6)+' km/h';\n document.getElementById('score').textContent='Score: '+Math.round(state.score)+' | XP: '+xp;\n\n if(trickTimer>0){\n  trickTimer-=dt;\n  if(trickTimer<=0&&!airborne)currentTrick='';\n }\n if(airTime>.35)unlock('first_air');\n}\n\nfunction checkAchievements(t){\n if(t==='Backflip')unlock('backflip');\n if(t==='Barspin')unlock('barspin');\n if(t==='Superman')unlock('superman');\n if(t==='No-Foot Can')unlock('nofoot');\n if(state.score>=5000)unlock('score5000');\n}\n\nfunction unlock(id){\n const a=achievements.find(a=>a.id===id);\n if(a&&!a.done){\n  a.done=true;\n  toast('🏆 Achievement unlocked: '+a.name);\n }\n}\n\nfunction updateCamera(){\n const target=bike.position;\n if(state.camera==='third'){\n  const back=new THREE.Vector3(Math.sin(yaw),0,Math.cos(yaw)).multiplyScalar(10);\n  camera.position.lerp(new THREE.Vector3(target.x-back.x,target.y+5,target.z-back.z),.16);\n }else{\n  camera.position.set(target.x+Math.sin(yaw)*.25,target.y+2.25,target.z+Math.cos(yaw)*.25);\n }\n camera.lookAt(target.x,target.y+1.7,target.z);\n}\n\nfunction renderLobby(){\n const grid=document.getElementById('playerGrid');\n grid.innerHTML='';\n lobbyRiders.forEach(r=>{\n  const d=document.createElement('div');\n  d.className='player'+(r.you?' you':'')+(r.ready?' ready':'');\n  d.innerHTML=`<b>${r.name}</b><p class=\"small\">${r.you?'You':'AI rider'} • ${r.ready?'Ready':'Not ready'} • Skill ${Math.round(r.skill*100)}%</p>`;\n  grid.appendChild(d);\n });\n document.getElementById('lobbyStatus').textContent=\n  `${lobbySettings.type==='private'?'Private':'Public'} lobby • ${lobbyRiders.length} / ${lobbySettings.max} riders • ${lobbySettings.map} • Code: ${lobbySettings.code}`;\n}\n\nfunction fillLobby(){\n lobbySettings.name=document.getElementById('lobbyName').value||'Shred Squad';\n lobbySettings.max=parseInt(document.getElementById('maxRiders').value);\n lobbySettings.type=document.getElementById('lobbyType').value;\n lobbySettings.code=document.getElementById('joinCode').value||'MTB-1234';\n lobbySettings.skill=parseFloat(document.getElementById('botSkill').value);\n lobbySettings.map=document.getElementById('lobbyMap').value;\n\n lobbyRiders=[{name:state.username||'Rider',you:true,ready,skill:1}];\n for(let i=1;i<lobbySettings.max;i++){\n  lobbyRiders.push({\n   name:'Rider_'+(i+1),\n   you:false,\n   ready:Math.random()>.35,\n   skill:lobbySettings.skill*(.65+Math.random()*.35)\n  });\n }\n renderLobby();\n toast('Lobby filled with '+lobbyRiders.length+' riders');\n}\n\nfunction addChat(name,text){\n const chat=document.getElementById('chat');\n const line=document.createElement('div');\n line.className='chatLine';\n line.innerHTML=`<b>${name}:</b> ${text}`;\n chat.appendChild(line);\n chat.scrollTop=chat.scrollHeight;\n}\n\nfunction startGame(mode){\n state.mode=mode;\n state.username=document.getElementById('username').value||'Rider';\n state.camera=document.getElementById('cameraMode').value;\n state.quality=document.getElementById('quality').value;\n state.editor=mode==='editor';\n\n const mapType=lobbySettings.map||'forest';\n createWorld(mapType);\n createRider();\n showScreen('hud');\n\n if(mode==='career'){\n  document.getElementById('mapname').textContent='CAREER MAP '+state.mapIndex+' / '+state.totalMaps;\n  toast('Career map '+state.mapIndex+' started');\n }\n if(mode==='free')toast('Freeride started');\n if(mode==='race')toast('Race started — '+lobbyRiders.length+' riders');\n if(mode==='editor')toast('Map creator active');\n}\n\nfunction exitEditor(){\n state.editor=false;\n showScreen('menu');\n}\n\nfunction saveCustomMap(){\n const objects=[];\n trackGroup.children.forEach(m=>{\n  if(m.userData.object)objects.push(m.userData.object);\n });\n const map={name:'Custom Trail '+(Date.now()%10000),objects};\n const saved=JSON.parse(localStorage.getItem('mtb_custom_maps')||'[]');\n localStorage.setItem('mtb_custom_maps',JSON.stringify([map,...saved].slice(0,25)));\n unlock('creator');\n toast('Custom map saved locally');\n}\n\nrenderer.domElement.addEventListener('pointerdown',e=>{\n if(!state.editor)return;\n const ndc=new THREE.Vector2((e.clientX/innerWidth)*2-1,-(e.clientY/innerHeight)*2+1);\n const ray=new THREE.Raycaster();\n ray.setFromCamera(ndc,camera);\n const hit=ray.intersectObject(terrain)[0];\n if(!hit)return;\n\n if(e.button===2){\n  let closest=null,best=1e9;\n  trackGroup.children.forEach(m=>{\n   if(!m.userData.object)return;\n   const d=m.position.distanceTo(hit.point);\n   if(d<best){best=d;closest=m}\n  });\n  if(closest)trackGroup.remove(closest);\n }else{\n  addObject({type:document.getElementById('objectType').value,x:hit.point.x,z:hit.point.z});\n }\n});\nrenderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());\n\ndocument.getElementById('careerBtn').onclick=()=>startGame('career');\ndocument.getElementById('freeBtn').onclick=()=>startGame('free');\ndocument.getElementById('lobbyBtn').onclick=()=>{lobbyRiders=[{name:document.getElementById('username').value||'Rider',you:true,ready:false,skill:1}];renderLobby();showScreen('lobby')};\ndocument.getElementById('editorBtn').onclick=()=>startGame('editor');\ndocument.getElementById('readyBtn').onclick=()=>{ready=!ready;lobbyRiders[0].ready=ready;renderLobby();toast(ready?'You are ready':'You are not ready')};\ndocument.getElementById('fillBtn').onclick=fillLobby;\ndocument.getElementById('clearBtn').onclick=()=>{lobbyRiders=[{name:document.getElementById('username').value||'Rider',you:true,ready:false,skill:1}];renderLobby()};\ndocument.getElementById('backBtn').onclick=()=>showScreen('menu');\ndocument.getElementById('applyLobbyBtn').onclick=()=>{fillLobby();toast('Lobby settings applied')};\ndocument.getElementById('startRaceBtn').onclick=()=>startGame('race');\ndocument.getElementById('freeRideBtn').onclick=()=>startGame('free');\ndocument.getElementById('sendChatBtn').onclick=()=>{\n const input=document.getElementById('chatInput');\n if(input.value.trim()){\n  addChat(state.username||'Rider',input.value);\n  input.value='';\n }\n};\ndocument.getElementById('saveMapBtn').onclick=saveCustomMap;\ndocument.getElementById('exitEditorBtn').onclick=exitEditor;\n\ndocument.querySelectorAll('.lobbyTab').forEach(tab=>{\n tab.onclick=()=>{\n  document.querySelectorAll('.lobbyTab').forEach(t=>t.classList.remove('active'));\n  tab.classList.add('active');\n  ['players','settings','chat','race'].forEach(id=>{\n   document.getElementById('tab-'+id).classList.toggle('hidden',id!==tab.dataset.tab);\n  });\n };\n});\n\nconst clock=new THREE.Clock();\nfunction animate(){\n requestAnimationFrame(animate);\n const dt=Math.min(clock.getDelta(),.05);\n if(document.getElementById('hud').classList.contains('active')){\n  updateRider(dt);\n  updateCamera();\n  checkpoints.forEach(c=>{\n   if(bike&&bike.position.distanceTo(c.position)<9)c.material.color.set(0x22ff88);\n  });\n }\n renderer.render(scene,camera);\n}\nanimate();\n</script>\n</body>\n</html>"
    }
  ]
